spy":0.0296,"r20_spy":-0.0069}},{"id":"VOD 2027 Q2","t":"VOD","d":"2026-11-10","time":"bmo","w":6366,"n":49,"url":"https://www.fool.com/earnings/call-transcripts/2026/11/10/vodafone-vod-q2-2027-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[15,7,8,24.05],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0121,"r5":-0.0242,"r1_spy":-0.0084,"r5_spy":-0.0073}}],"quotes":[{"c":"VOD 2019 Q1","e":"vod","d":"2019-07-26","l":"streaming","r":"management","s":"Margherita Della Valle","x":"A new over the top football streaming service has just been launched offering full access to La Liga champions league and Europa League content.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/26/vodafone-group-plc-vod-q1-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q1","e":"vod","d":"2019-07-26","l":"tariffs","r":"management","s":"Margherita Della Valle","x":"In April, we announced a new range of mobile tariffs designed to simplify our product portfolio and deliver better value to customers while also supporting or enhancing ARPU.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/26/vodafone-group-plc-vod-q1-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q1","e":"vod","d":"2019-07-26","l":"tariffs","r":"management","s":"Margherita Della Valle","x":"Additionally, as Nick has already highlighted, IN April we launched new simplified tariffs that include speed-tiered, unlimited data bundles, a first for the Spanish market.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/26/vodafone-group-plc-vod-q1-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q1","e":"vod","d":"2019-07-26","l":"pricing_power","r":"management","s":"Margherita Della Valle","x":"However, the broadband market slowed a result of price increases implemented by most operators in the quarter.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/26/vodafone-group-plc-vod-q1-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q1","e":"vod","d":"2019-07-26","l":"pricing_power","r":"management","s":"Margherita Della Valle","x":"Looking ahead, our fixed revenues will benefit from the 2.99-euro price increase on our customer consumer broadband base that takes effect in July.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/26/vodafone-group-plc-vod-q1-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q1","e":"vod","d":"2019-07-26","l":"cost_cuts","r":"management","s":"Nick Read","x":"So, they're moving at pace in terms of restructuring the cost base of the company.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/26/vodafone-group-plc-vod-q1-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q2","e":"vod","d":"2019-11-12","l":"tariffs","r":"management","s":"Nick Read","x":"Three quarters of branded mobile customers and almost 40% of broadband customers are now on convergence tariffs, supporting record mobile net adds and good fixed performance.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/13/vodafone-group-plc-vod-q2-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q2","e":"vod","d":"2019-11-12","l":"tariffs","r":"management","s":"Nick Read","x":"Importantly, the SoHo segment, which is predominantly mobile and represents around 25% of our business revenues, has been dragged by consumer price plans, resulting in only 20% of SoHo's taking business tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/13/vodafone-group-plc-vod-q2-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q2","e":"vod","d":"2019-11-12","l":"pricing_power","r":"management","s":"Nick Read","x":"In broadband we saw -- in cable -- sorry, we grew in cable, but lost DSL customers due to ULL price increases and the migration of Unity customers onto our network.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/13/vodafone-group-plc-vod-q2-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q2","e":"vod","d":"2019-11-12","l":"pricing_power","r":"management","s":"Nick Read","x":"Following our price increases, we saw an uptick in churn as expected.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/13/vodafone-group-plc-vod-q2-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q2","e":"vod","d":"2019-11-12","l":"cost_cuts","r":"management","s":"Nick Read","x":"And as we transform our operating model through digital we're achieving meaningful net cost savings which Margherita will expand on in more detail.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/13/vodafone-group-plc-vod-q2-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q2","e":"vod","d":"2019-11-12","l":"cost_cuts","r":"management","s":"Margherita Della Valle","x":"But I would like to focus on the structural opportunity for cost reduction from digital first and the progress we have already made against our targets in each area.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/13/vodafone-group-plc-vod-q2-2019-earnings-call-trans.aspx"},{"c":"VOD 2019 Q3","e":"vod","d":"2020-02-05","l":"tariffs","r":"management","s":"Nick Read","x":"Clearly, the bigger challenge that we face within enterprise is SOHOs moving to consumer tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/05/vodafone-group-plc-vod-q3-2020-earnings-call-trans.aspx"},{"c":"VOD 2019 Q3","e":"vod","d":"2020-02-05","l":"tariffs","r":"management","s":"Nick Read","x":"So, I think drive fixed, drive SOHOs on to dedicated traffic -- dedicated tariffs, push behind our IoT global platform where we have a competitive advantage and obviously, develop our cloud offering.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/05/vodafone-group-plc-vod-q3-2020-earnings-call-trans.aspx"},{"c":"VOD 2019 Q3","e":"vod","d":"2020-02-05","l":"pricing_power","r":"management","s":"Margherita Della Valle","x":"On the right of the slide, you can see that quarterly trends in Europe were unchanged, with the ongoing recovery in Spain and acceleration in the UK being offset by the lapping of the prior year price increase in Italy.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/05/vodafone-group-plc-vod-q3-2020-earnings-call-trans.aspx"},{"c":"VOD 2019 Q3","e":"vod","d":"2020-02-05","l":"pricing_power","r":"management","s":"Margherita Della Valle","x":"This 2 percentage point down reflects the lapping of prior year price increases in both mobile and fixed.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/05/vodafone-group-plc-vod-q3-2020-earnings-call-trans.aspx"},{"c":"VOD 2019 Q3","e":"vod","d":"2020-02-05","l":"cost_cuts","r":"management","s":"Margherita Della Valle","x":"We have now reached agreement with the Works Council on our restructuring plans and we start rebranding the business to Vodafone later this month.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/05/vodafone-group-plc-vod-q3-2020-earnings-call-trans.aspx"},{"c":"VOD 2019 Q4","e":"vod","d":"2020-05-12","l":"cost_cuts","r":"management","s":"Margherita Della Valle","x":"To give you a view on how we intend to achieve this, we have extended our original customer care cost reduction target from 30% by FY '21 to 50% by FY '23.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/12/vodafone-group-plc-vod-q4-2020-earnings-call-trans.aspx"},{"c":"VOD 2019 Q4","e":"vod","d":"2020-05-12","l":"cost_cuts","r":"management","s":"Margherita Della Valle","x":"Despite the step-up in restructuring from the Liberty integration, this allowed us to generate net free cash flow for the year of EUR4.9 billion.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/12/vodafone-group-plc-vod-q4-2020-earnings-call-trans.aspx"},{"c":"VOD 2020 Q1","e":"vod","d":"2020-07-24","l":"pricing_power","r":"management","s":"Margherita Della Valle","x":"This was the only area in Europe with a non-COVID related slowdown with increased competition in two markets, Greece and Ireland, as well as the lapping of prior year price increases in Romania.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/24/vodafone-group-plc-vod-q1-2021-earnings-call-trans.aspx"},{"c":"VOD 2020 Q1","e":"vod","d":"2020-07-24","l":"pricing_power","r":"management","s":"Margherita Della Valle","x":"And in Italy, we already guided toward a more neutral mobile number portability numbers as soon as we left the price increases of six months ago.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/24/vodafone-group-plc-vod-q1-2021-earnings-call-trans.aspx"},{"c":"VOD 2020 Q1","e":"vod","d":"2020-07-24","l":"cost_cuts","r":"management","s":"Margherita Della Valle","x":"To date, in Vodafone business, we have not seen any significant impact from company closures, headcount reductions or any material collection issues.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/24/vodafone-group-plc-vod-q1-2021-earnings-call-trans.aspx"},{"c":"VOD 2020 Q2","e":"vod","d":"2020-11-16","l":"tariffs","r":"management","s":"Nick Read","x":"…is we did something with Spain that we are adopting increasingly through our markets, which is we wanted to get -- we wanted to simplify the business inside from an IT perspective, cost perspective, etc. To do that, you have migrate your base on to forward book pricing and forward book tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/16/vodafone-group-plc-vod-q2-2021-earnings-call-trans/"},{"c":"VOD 2020 Q2","e":"vod","d":"2020-11-16","l":"tariffs","r":"management","s":"Nick Read","x":"That's important because it means that we don't have this long legacy of lots of historical pricing tariffs, etc., makes the tariffs people are on today's pricing so we are less vulnerable to today's pricing and promos.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/16/vodafone-group-plc-vod-q2-2021-earnings-call-trans/"},{"c":"VOD 2020 Q2","e":"vod","d":"2020-11-16","l":"pricing_power","r":"analyst","s":"Akhil Dattani","x":"If I'm understanding correctly, traditionally a lot of your price increases kick in in Q2, but actually this time around with the lockdown they didn't.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/16/vodafone-group-plc-vod-q2-2021-earnings-call-trans/"},{"c":"VOD 2020 Q2","e":"vod","d":"2020-11-16","l":"pricing_power","r":"analyst","s":"Akhil Dattani","x":"And I'm looking forward and seeing that you are starting to put through a number of price increases into Q3 and Q4.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/16/vodafone-group-plc-vod-q2-2021-earnings-call-trans/"},{"c":"VOD 2020 Q2","e":"vod","d":"2020-11-16","l":"cost_cuts","r":"management","s":"Margherita Della Valle","x":"All the KPIs around our cost reduction programs have been either progressing at the same pace as before in the first half or have been accelerated.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/16/vodafone-group-plc-vod-q2-2021-earnings-call-trans/"},{"c":"VOD 2020 Q2","e":"vod","d":"2020-11-16","l":"cost_cuts","r":"management","s":"Margherita Della Valle","x":"And on the back of that linked to also an integrated procurement process, we think that if anything the opportunity is there post COVID to further accelerate our cost reduction programs.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/16/vodafone-group-plc-vod-q2-2021-earnings-call-trans/"},{"c":"VOD 2020 Q3","e":"vod","d":"2021-02-03","l":"tariffs","r":"analyst","s":"John Karidis","x":"If I may, I wanted to ask a question about unlimited tariffs simply because in the States, every quarter, Verizon and AT&T highlight the various net present value benefits were getting more of their our customers onto unlimited tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/03/vodafone-group-plc-vod-q3-2021-earnings-call-trans/"},{"c":"VOD 2020 Q3","e":"vod","d":"2021-02-03","l":"tariffs","r":"analyst","s":"John Karidis","x":"And then secondly, what I'm trying to figure out is, if whether the intensity of competition for customers on unlimited tariffs varies meaningfully versus the intensity of competition for customers on meter tariffs?","url":"https://www.fool.com/earnings/call-transcripts/2021/02/03/vodafone-group-plc-vod-q3-2021-earnings-call-trans/"},{"c":"VOD 2020 Q3","e":"vod","d":"2021-02-03","l":"pricing_power","r":"management","s":"Nick Read","x":"In Spain, as service revenues continue to stabilize further, so quarter-over-quarter improvement and we managed a price increase in the month of November in what was a highly promotional and intensive quarter and I think we landed that very well.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/03/vodafone-group-plc-vod-q3-2021-earnings-call-trans/"},{"c":"VOD 2020 Q3","e":"vod","d":"2021-02-03","l":"pricing_power","r":"management","s":"Nick Read","x":"So I just -- I think it's a climate -- when people start to appreciate the quality of networks and that gives a little bit more I wouldn't say it strong pricing power, but it just gives a little bit more latitude to do targeted more for more pricing.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/03/vodafone-group-plc-vod-q3-2021-earnings-call-trans/"},{"c":"VOD 2020 Q3","e":"vod","d":"2021-02-03","l":"guidance","r":"management","s":"Nick Read","x":"Good overall performance therefore underscores our confidence in our full year outlook and we reiterated our guidance of over EUR5 billion of free cash flow.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/03/vodafone-group-plc-vod-q3-2021-earnings-call-trans/"},{"c":"VOD 2020 Q4","e":"vod","d":"2021-05-18","l":"cost_cuts","r":"analyst","s":"David Wright","x":"Is Spain there or do you need to -- does it need some kind of additional restructuring you think to make the grade?","url":"https://www.fool.com/earnings/call-transcripts/2021/05/18/vodafone-groupplc-vod-q4-2021-earnings-call-transc/"},{"c":"VOD 2021 Q1","e":"vod","d":"2021-07-23","l":"tariffs","r":"analyst","s":"Adam Fox-Rumley","x":"Or do you think it's kind of unlimited tariffs where bill worry and bill shock is being removed, that's really driving upside at the moment?","url":"https://www.fool.com/earnings/call-transcripts/2021/07/23/vodafone-group-plc-vod-q1-2022-earnings-call-trans/"},{"c":"VOD 2021 Q2","e":"vod","d":"2021-11-16","l":"pricing_power","r":"management","s":"Margherita Della Valle","x":"In terms of what we see for the coming quarters, I'd say probably a couple of more technical headwinds to keep in mind, in particular as we move into Q3, we are now lapping a price increase we did last year in November in Spain.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/16/vodafone-group-plc-vod-h1-2022-earnings-call-trans/"},{"c":"VOD 2021 Q2","e":"vod","d":"2021-11-16","l":"pricing_power","r":"management","s":"Sam McHugh","x":"And given you've all implemented CPI plus price increases to a degree, you've all reintroduced roaming charges in the face of latter month of each other.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/16/vodafone-group-plc-vod-h1-2022-earnings-call-trans/"},{"c":"VOD 2021 Q2","e":"vod","d":"2021-11-16","l":"cost_cuts","r":"analyst","s":"Adam Fox-Rumley","x":"I had a question on Spanish restructuring and some of the wider implications, also what you were saying about the -- sorry.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/16/vodafone-group-plc-vod-h1-2022-earnings-call-trans/"},{"c":"VOD 2021 Q2","e":"vod","d":"2021-11-16","l":"cost_cuts","r":"analyst","s":"Adam Fox-Rumley","x":"Spanish restructuring that you referred to I think is mostly within the commercial channels and it was interesting to also hear Margherita's comments in the prepared presentation around the structural changes in which the stores are being used post COVID.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/16/vodafone-group-plc-vod-h1-2022-earnings-call-trans/"},{"c":"VOD 2027 Q2","e":"vod","d":"2026-11-10","l":"cost_cuts","r":"management","s":"Margherita Della Valle","x":"We are also taking action to further step up our productivity in Germany with the next phase of our headcount reduction program.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/10/vodafone-vod-q2-2027-earnings-call-transcript/"},{"c":"VOD 2027 Q2","e":"vod","d":"2026-11-10","l":"cost_cuts","r":"management","s":"Margherita Della Valle","x":"This means that we will have reduced headcount in Germany by 40% since we began our transformation.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/10/vodafone-vod-q2-2027-earnings-call-transcript/"}],"trends":{"theater":[[38,1,8699,0,0,0,6740,1490],[39,1,12417,0,0,0,12255,0],[40,1,8265,0,0,0,6515,1313],[41,1,13961,0,0,0,13346,303],[42,1,11054,0,0,0,9144,1499],[43,1,8067,0,0,0,5589,2088],[44,1,6995,0,0,0,5629,899],[45,1,9343,0,0,0,7146,1754],[46,1,7632,0,0,0,5868,1356],[47,1,7529,0,0,0,5764,1319],[67,1,6366,0,0,0,4873,1232]],"cinema":[[38,1,8699,0,0,0,6740,1490],[39,1,12417,0,0,0,12255,0],[40,1,8265,0,0,0,6515,1313],[41,1,13961,0,0,0,13346,303],[42,1,11054,0,0,0,9144,1499],[43,1,8067,0,0,0,5589,2088],[44,1,6995,0,0,0,5629,899],[45,1,9343,0,0,0,7146,1754],[46,1,7632,0,0,0,5868,1356],[47,1,7529,0,0,0,5764,1319],[67,1,6366,0,0,0,4873,1232]],"imax":[[38,1,8699,0,0,0,6740,1490],[39,1,12417,0,0,0,12255,0],[40,1,8265,0,0,0,6515,1313],[41,1,13961,0,0,0,13346,303],[42,1,11054,0,0,0,9144,1499],[43,1,8067,0,0,0,5589,2088],[44,1,6995,0,0,0,5629,899],[45,1,9343,0,0,0,7146,1754],[46,1,7632,0,0,0,5868,1356],[47,1,7529,0,0,0,5764,1319],[67,1,6366,0,0,0,4873,1232]],"streaming":[[38,1,8699,1,1,0,6740,1490],[39,1,12417,0,0,0,12255,0],[40,1,8265,0,0,0,6515,1313],[41,1,13961,0,0,0,13346,303],[42,1,11054,0,0,0,9144,1499],[43,1,8067,0,0,0,5589,2088],[44,1,6995,0,0,0,5629,899],[45,1,9343,0,0,0,7146