":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0593,"r5":0.1053,"r20":0.0079,"r1_spy":0.0613,"r5_spy":0.1063,"r20_spy":0.0203}},{"id":"BWA 2026 Q3","t":"BWA","d":"2026-10-29","time":"bmo","w":8890,"n":77,"url":"https://www.fool.com/earnings/call-transcripts/2026/10/29/borgwarner-bwa-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[1,1,0,1.15],"tariffs":[1,1,0,1.15],"pricing_power":[0,0,0,0.0],"cost_cuts":[1,1,0,1.15],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.047,"r5":-0.0989,"r1_spy":-0.0432,"r5_spy":-0.0918}}],"quotes":[{"c":"BWA 2018 Q3","e":"bwa","d":"2018-10-25","l":"tariffs","r":"management","s":"Ronald Hundzinski","x":"R&D timing related to new launches distorted our margin performance in the quarter as well, and raw material and tariff-related costs and inflation impacted us.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/26/borgwarner-inc-bwa-q3-2018-earnings-conference-cal.aspx"},{"c":"BWA 2018 Q3","e":"bwa","d":"2018-10-25","l":"tariffs","r":"management","s":"Ronald Hundzinski","x":"You're correct, $10 million to $20 million of headwind in tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/26/borgwarner-inc-bwa-q3-2018-earnings-conference-cal.aspx"},{"c":"BWA 2018 Q3","e":"bwa","d":"2018-10-25","l":"cost_cuts","r":"management","s":"Ronald Hundzinski","x":"This was driven by limited European cost reduction due to the temporary volume decline and timing of R&D spending for awarded programs.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/26/borgwarner-inc-bwa-q3-2018-earnings-conference-cal.aspx"},{"c":"BWA 2018 Q3","e":"bwa","d":"2018-10-25","l":"cost_cuts","r":"management","s":"Ronald Hundzinski","x":"So, the rapid decline in the volumes, we didn't take any cost out, because we saw them as temporary in Europe.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/26/borgwarner-inc-bwa-q3-2018-earnings-conference-cal.aspx"},{"c":"BWA 2018 Q4","e":"bwa","d":"2019-02-14","l":"tariffs","r":"management","s":"Tom McGill","x":"However, this is below our long-term mid-teens target due to the rapid decline in industry volumes and tariff-related cost inflation.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/14/borgwarner-inc-bwa-q4-2018-earnings-conference-cal.aspx"},{"c":"BWA 2018 Q4","e":"bwa","d":"2019-02-14","l":"tariffs","r":"management","s":"Tom McGill","x":"This margin performance is due to the relatively low organic growth combined with costs related to tariffs, supplier bankruptcy costs in Europe, and changes to launch timing throughout 2019.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/14/borgwarner-inc-bwa-q4-2018-earnings-conference-cal.aspx"},{"c":"BWA 2018 Q4","e":"bwa","d":"2019-02-14","l":"cost_cuts","r":"management","s":"Deepa Raghavan","x":"Okay, my second question would be, can you discuss some of the restructuring that you mentioned and if there are any other actions you're undertaking to offset some of the negative volume impacts?","url":"https://www.fool.com/earnings/call-transcripts/2019/02/14/borgwarner-inc-bwa-q4-2018-earnings-conference-cal.aspx"},{"c":"BWA 2019 Q1","e":"bwa","d":"2019-04-25","l":"tariffs","r":"management","s":"Frederic B. Lissalde","x":"In addition to the costs related to tariffs and supply bankruptcies, we're also supporting elevated R&D spending in Q2.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/26/borgwarner-inc-bwa-q1-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q1","e":"bwa","d":"2019-04-25","l":"tariffs","r":"management","s":"Thomas J. McGill","x":"This $11 million shortfall compared to a 20% decremental margin can be explained by tariff-related costs, supplier bankruptcy costs in Europe and timing of costs related to a new business launch later in 2019.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/26/borgwarner-inc-bwa-q1-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q1","e":"bwa","d":"2019-04-25","l":"cost_cuts","r":"management","s":"Patrick Nolan","x":"He will then follow this with a high-level overview of our Q1 results, our 2019 outlook and the cost restructuring plan that we announced this morning.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/26/borgwarner-inc-bwa-q1-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q1","e":"bwa","d":"2019-04-25","l":"cost_cuts","r":"management","s":"Frederic B. Lissalde","x":"The cost restructuring plan that we announced in our press release this morning is consistent with this long-term commitment.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/26/borgwarner-inc-bwa-q1-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q1","e":"bwa","d":"2019-04-25","l":"guidance","r":"management","s":"Frederic B. Lissalde","x":"Whilst we are encouraged by the stronger Q1 performance, we're maintaining our full year guidance.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/26/borgwarner-inc-bwa-q1-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q1","e":"bwa","d":"2019-04-25","l":"guidance","r":"management","s":"Thomas J. McGill","x":"And finally, we are maintaining our guidance for the year, but feel increasingly confident in our earnings and free cash flow outlook for the full year.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/26/borgwarner-inc-bwa-q1-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q2","e":"bwa","d":"2019-07-25","l":"tariffs","r":"management","s":"Kevin A. Nowlan","x":"The $22 million shortfall compared to our long-term 20% decremental margins can be explained primarily by our supply chain cost reductions falling short of our targets due in part to the year-over-year impact of tariffs and some of the insolvency issues in Europe.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/25/borgwarner-inc-bwa-q2-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q2","e":"bwa","d":"2019-07-25","l":"tariffs","r":"management","s":"Kevin A. Nowlan","x":"This is in part due to costs arising from the year-over-year impact of tariffs and costs related to supplier bankruptcies.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/25/borgwarner-inc-bwa-q2-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q2","e":"bwa","d":"2019-07-25","l":"cost_cuts","r":"management","s":"Fredrric B. Lissalde","x":"This will include more steps to manage our near-term costs and more aggressive restructuring measures than the ones we have previously announced.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/25/borgwarner-inc-bwa-q2-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q2","e":"bwa","d":"2019-07-25","l":"cost_cuts","r":"management","s":"Fredrric B. Lissalde","x":"So in the prior call, we've announced some restructuring that were essentially SG&A-focused.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/25/borgwarner-inc-bwa-q2-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q3","e":"bwa","d":"2019-10-31","l":"cost_cuts","r":"management","s":"Frederic B. Lissalde","x":"Our near-term cost actions are beginning to drive our incremental margins, and we are identifying additional cost-saving opportunities to sustain our strong margin profile.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/31/borgwarner-inc-bwa-q3-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q3","e":"bwa","d":"2019-10-31","l":"cost_cuts","r":"management","s":"Frederic B. Lissalde","x":"Earnings were better than our guidance, driven by better top-line performance and our cost-saving measures.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/31/borgwarner-inc-bwa-q3-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q4","e":"bwa","d":"2020-02-13","l":"cost_cuts","r":"management","s":"Frederic B. Lissalde","x":"Our near-term cost actions are supporting our incremental margin and we have identified additional cost saving opportunities that we believe will sustain our strong margin profile.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/13/borgwarner-inc-bwa-q4-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2019 Q4","e":"bwa","d":"2020-02-13","l":"cost_cuts","r":"management","s":"Frederic B. Lissalde","x":"Let's now turn to Slide 6, which highlights the additional cost restructuring steps that we have announced today.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/13/borgwarner-inc-bwa-q4-2019-earnings-call-transcrip.aspx"},{"c":"BWA 2020 Q1","e":"bwa","d":"2020-05-06","l":"cost_cuts","r":"management","s":"Frederic B. Lissalde","x":"Employees at many of our facilities have been put on temporary layoffs due to lower production, or in many locations, the complete production shutdown.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/borgwarner-inc-bwa-q1-2020-earnings-call-transcrip.aspx"},{"c":"BWA 2020 Q1","e":"bwa","d":"2020-05-06","l":"cost_cuts","r":"management","s":"Kevin Nowlan","x":"I think we were pleased with that 26% as well, and that's really a function of the a lot of the cost restructuring actions that we were executing on throughout last year that we announced back in April, and it allowed us to manage the decrementals now, and we're seeing the benefit of that.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/borgwarner-inc-bwa-q1-2020-earnings-call-transcrip.aspx"},{"c":"BWA 2020 Q2","e":"bwa","d":"2020-08-05","l":"cost_cuts","r":"management","s":"Aileen Smith","x":"Or does it also reflect more progress than expected on some of your cost savings or cash conservation initiatives?","url":"https://www.fool.com/earnings/call-transcripts/2020/08/05/borgwarner-inc-bwa-q2-2020-earnings-call-transcrip.aspx"},{"c":"BWA 2020 Q2","e":"bwa","d":"2020-08-05","l":"cost_cuts","r":"management","s":"Kevin Nowlan","x":"I mean decrementals absolutely include the benefit associated with the restructuring actions.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/05/borgwarner-inc-bwa-q2-2020-earnings-call-transcrip.aspx"},{"c":"BWA 2020 Q3","e":"bwa","d":"2020-10-29","l":"cost_cuts","r":"management","s":"Frederic Lissalde","x":"Our incremental margin performance was very strong as revenue trends exceeded our expectations, and we benefited from our restructuring savings and temporary wage reductions.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/borgwarner-inc-bwa-q3-2020-earnings-call-transcrip/"},{"c":"BWA 2020 Q3","e":"bwa","d":"2020-10-29","l":"cost_cuts","r":"management","s":"Kevin Nowlan","x":"This earnings performance in the quarter was driven by our ability to successfully convert on the revenue recovery and the benefit of our restructuring actions in some of the temporary wage reductions we implemented earlier in the year.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/borgwarner-inc-bwa-q3-2020-earnings-call-transcrip/"},{"c":"BWA 2020 Q4","e":"bwa","d":"2021-02-11","l":"cost_cuts","r":"management","s":"Kevin Nowlan","x":"That said, I think the restructuring actions that the company had been taking pre-closing and that we're continuing on a post-closing basis, we'll continue to support that margin profile.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/borgwarner-inc-bwa-q4-2021-earnings-call-transcrip/"},{"c":"BWA 2020 Q4","e":"bwa","d":"2021-02-11","l":"cost_cuts","r":"management","s":"Kevin Nowlan","x":"…$140 million revenue decline and that comes with some outsized margin, because it's a strong margin performing piece of the portfolio and that's where the restructuring actions that we're continuing to execute that legacy project pioneer are helping to mitigate the impact of those headwinds.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/borgwarner-inc-bwa-q4-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q1","e":"bwa","d":"2021-05-05","l":"pricing_power","r":"management","s":"Frederic B. Lissalde","x":"And the color I wanted to give you is that on the biggest raw material purchases, we have about 60% pass through with our customers.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/05/borgwarner-inc-bwa-q1-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q1","e":"bwa","d":"2021-05-05","l":"pricing_power","r":"analyst","s":"David Kelley","x":"And then also I was curious to hear if you -- if so, if you see an opportunity to pass those through?","url":"https://www.fool.com/earnings/call-transcripts/2021/05/05/borgwarner-inc-bwa-q1-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q1","e":"bwa","d":"2021-05-05","l":"cost_cuts","r":"management","s":"Kevin A. Nowlan","x":"Second, our margin and cash flow performance in the quarter were strong, driven by the top line results as well as our cost-saving measures.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/05/borgwarner-inc-bwa-q1-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q1","e":"bwa","d":"2021-05-05","l":"cost_cuts","r":"management","s":"Kevin A. Nowlan","x":"This solid performance was driven by conversion on higher volumes, restructuring savings and Delphi Technology synergies in excess of purchase price amortization.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/05/borgwarner-inc-bwa-q1-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q2","e":"bwa","d":"2021-08-06","l":"cost_cuts","r":"management","s":"Kevin A. Nowlan","x":"That translates to a strong incremental margin of over 28%, driven by conversion on higher volumes, restructuring savings and Delphi-related synergies in excess of purchase price amortization.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/06/borgwarner-inc-bwa-q2-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q2","e":"bwa","d":"2021-08-06","l":"cost_cuts","r":"management","s":"Kevin A. Nowlan","x":"The primary driver is faster execution of headcount reductions related to our planned SG&A cost synergies.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/06/borgwarner-inc-bwa-q2-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q2","e":"bwa","d":"2021-08-06","l":"guidance","r":"management","s":"Frederic B. Lissalde","x":"As Kevin will discuss, we are increasing our full year guidance as we believe higher outgrowth and synergies are offsetting commodity and other headwinds.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/06/borgwarner-inc-bwa-q2-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q3","e":"bwa","d":"2021-11-03","l":"pricing_power","r":"management","s":"Kevin Nowlan","x":"Our typical pass-throughs, when you look at the blend of all the pass-through mechanisms we have contractually as it relates to steel, aluminum, nickel, copper, the things that we're most exposed to the contractual pass-throughs are about 50% on a fully blended basis.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/03/borgwarner-inc-bwa-q3-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q3","e":"bwa","d":"2021-11-03","l":"pricing_power","r":"management","s":"Kevin Nowlan","x":"The second thing I would just note is when you get into more sustained inflationary environments of such a high degree like we're seeing there, it's not uncommon to see suppliers having conversations across the industry with customers about what to do beyond the contractual pass-through mechanism.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/03/borgwarner-inc-bwa-q3-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q3","e":"bwa","d":"2021-11-03","l":"cost_cuts","r":"management","s":"Kevin Nowlan","x":"We expect inventory to improve in the coming quarters once we see less volatility in production orders, which will give us the ability to rightsize our supply chain demands accordingly.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/03/borgwarner-inc-bwa-q3-2021-earnings-call-transcrip/"},{"c":"BWA 2021 Q3","e":"bwa","d":"2021-11-03","l":"cost_cuts","r":"management","s":"Kevin Nowlan","x":"From a cost perspective, we expect incremental Delphi-related cost synergies in the $40 million to $45 million range, and we also expect incremental restructuring savings of $40 million to $50 million.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/03/borgwarner-inc-bwa-q3-2021-earnings-call-transcrip/"},{"c":"BWA 2025 Q3","e":"bwa","d":"2025-10-30","l":"tariffs","r":"management","s":"Joseph F. Fadool","x":"Our adjusted operating margin performance was strong in the third quarter, coming in at 10.7%, which increased 60 basis points year over year despite a 60 basis point net tariff headwind.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/30/borgwarner-bwa-q3-2025-earnings-call-transcript/"},{"c":"BWA 2025 Q3","e":"bwa","d":"2025-10-30","l":"tariffs","r":"management","s":"Craig D. Aaron","x":"This performance represents a 60 basis point improvement year over year despite a $17 million net tariff headwind in the quarter.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/30/borgwarner-bwa-q3-2025-earnings-call-transcript/"},{"c":"BWA 2025 Q3","e":"bwa","d":"2025-10-30","l":"pricing_power","r":"management","s":"Craig D. Aaron","x":"Within this guidance, we continue to expect a tailwind from tariff-related recoveries of up to 1% of sales as this is a pass-through recovery of our costs to our customers.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/30/borgwarner-bwa-q3-2025-earnings-call-transcript/"},{"c":"BWA 2025 Q3","e":"bwa","d":"2025-10-30","l":"cost_cuts","r":"management","s":"Craig D. Aaron","x":"We're going to use all the levers within our control to do that, meaning focus on cost controls, again, chain savings, restructuring, productivity, lower cost of poor quality.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/30/borgwarner-bwa-q3-2025-earnings-call-transcript/"},{"c":"BWA 2025 Q3","e":"bwa","d":"2025-10-30","l":"cost_cuts","r":"analyst","s":"Joseph Robert Spak","x":"So I mean, do you think you're with the actions you've taken today properly rightsize that now?","url":"https://www.fool.com/earnings/call-transcripts/2025/10/30/borgwarner-bwa-q3-2025-earnings-call-transcript/"},{"c":"BWA 2025 Q4","e":"bwa","d":"2026-02-11","l":"tariffs","r":"management","s":"Joseph Fadool","x":"We expanded our adjusted operating margin by 60 basis points despite a 20 basis point net tariff headwind.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/11/borgwarner-bwa-q4-2025-earnings-call-transcript/"},{"c":"BWA 2025 Q4","e":"bwa","d":"2026-02-11","l":"tariffs","r":"management","s":"Craig Aaron","x":"This performance benefited from more than 100 points in customer recoveries, primarily for a North American new product program that has seen significant volume shortfalls, as well as $11 million of positive net tariff recoveries.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/11/borgwarner-bwa-q4-2025-earnings-call-transcript/"},{"c":"BWA 2025 Q4","e":"bwa","d":"2026-02-11","l":"cost_cuts","r":"management","s":"James Picariello","x":"I assume there's an additional restructuring effort in place or underway to address the declines and yes, curious how you're thinking about the loss rate relative to what we saw in 2025.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/11/borgwarner-bwa-q4-2025-earnings-call-transcript/"},{"c":"BWA 2026 Q1","e":"bwa","d":"2026-05-06","l":"cost_cuts","r":"management","s":"Craig Aaron","x":"This strong year-over-year performance benefited from ongoing cost reduction actions that our teams continue to take across our business.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/06/borgwarner-bwa-q1-2026-earnings-transcript/"},{"c":"BWA 2026 Q1","e":"bwa","d":"2026-05-06","l":"cost_cuts","r":"analyst","s":"Colin Langan","x":"So there's no incremental -- th