,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[2,2,0,2.75],"pricing_power":[22,21,1,30.24],"cost_cuts":[4,2,2,5.5],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}]},"move":{"r1":0.0758,"r5":0.1553,"r1_spy":0.0796,"r5_spy":0.1624}}],"quotes":[{"c":"CSL 2018 Q2","e":"csl","d":"2018-07-24","l":"pricing_power","r":"management","s":"Chris Koch","x":"We were largely able to offset these pressures with higher sales volumes by driving price increases, implementing freight surcharges and generating savings from the Carlisle Operating System.","url":"https://www.fool.com/earnings/call-transcripts/2018/07/25/carlisle-companies-csl-q2-2018-earnings-conference.aspx"},{"c":"CSL 2018 Q2","e":"csl","d":"2018-07-24","l":"pricing_power","r":"management","s":"Chris Koch","x":"We expect this positive pricing trend that began in 2017 to accelerate into the second half of 2018.","url":"https://www.fool.com/earnings/call-transcripts/2018/07/25/carlisle-companies-csl-q2-2018-earnings-conference.aspx"},{"c":"CSL 2018 Q2","e":"csl","d":"2018-07-24","l":"cost_cuts","r":"management","s":"Chris Koch","x":"…we have gained traction on our key initiatives, including achieving above-market organic growth, driving cost savings and operational efficiencies through COS, focusing on portfolio realignment through M&A and deploying capital in the form of share repurchases, dividends and capital investments.","url":"https://www.fool.com/earnings/call-transcripts/2018/07/25/carlisle-companies-csl-q2-2018-earnings-conference.aspx"},{"c":"CSL 2018 Q2","e":"csl","d":"2018-07-24","l":"cost_cuts","r":"management","s":"Chris Koch","x":"Our COS efforts continue to improve on a year-over-year basis as we generated 1.5% of sales and cost savings within the quarter, well within our long-term target of 1% to 2%.","url":"https://www.fool.com/earnings/call-transcripts/2018/07/25/carlisle-companies-csl-q2-2018-earnings-conference.aspx"},{"c":"CSL 2018 Q3","e":"csl","d":"2018-10-23","l":"pricing_power","r":"management","s":"Christian Koch","x":"We were largely able to offset these pressures with higher sales volume, proactive and strategic price increases, continued implementation of freight surcharges and generating savings from the Carlisle operating system.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/23/carlisle-cos-inc-csl-q3-2018-earnings-conference-c.aspx"},{"c":"CSL 2018 Q3","e":"csl","d":"2018-10-23","l":"pricing_power","r":"management","s":"Christian Koch","x":"Our pricing result proved fruitful in our core products, as we achieved over $11 million in price realization in the quarter.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/23/carlisle-cos-inc-csl-q3-2018-earnings-conference-c.aspx"},{"c":"CSL 2018 Q3","e":"csl","d":"2018-10-23","l":"cost_cuts","r":"management","s":"Christian Koch","x":"We remain committed to driving efficiency throughout Carlisle as demonstrated by the acceleration of savings generated by COS in 2018, specifically 1.4% of sales and cost savings within the quarter, well within our long-term target of 1% to 2%.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/23/carlisle-cos-inc-csl-q3-2018-earnings-conference-c.aspx"},{"c":"CSL 2018 Q3","e":"csl","d":"2018-10-23","l":"cost_cuts","r":"management","s":"Robert Roche","x":"CIT's operating income improved 13.1% to $29.3 million due primarily to higher volumes, lower restructuring costs and COS savings.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/23/carlisle-cos-inc-csl-q3-2018-earnings-conference-c.aspx"},{"c":"CSL 2018 Q4","e":"csl","d":"2019-02-07","l":"pricing_power","r":"management","s":"Robert M. Roche","x":"Positive pricing and volume leverage combined for 2.3 percentage points of the growth and COS drove a positive 130 basis point margin improvement.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/07/carlisle-cos-inc-csl-q4-2018-earnings-conference-c.aspx"},{"c":"CSL 2018 Q4","e":"csl","d":"2019-02-07","l":"pricing_power","r":"management","s":"Robert M. Roche","x":"Echoing Chris's earlier thoughts, CCM executed extremely well in accomplishing $16 million of price realization in the quarter.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/07/carlisle-cos-inc-csl-q4-2018-earnings-conference-c.aspx"},{"c":"CSL 2018 Q4","e":"csl","d":"2019-02-07","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"In the fourth quarter operating income rose 22.7%, almost three times our revenue growth, a further indication that the restructuring efforts, pricing discipline and increased focused on productivity that we instituted over the last two years are paying off.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/07/carlisle-cos-inc-csl-q4-2018-earnings-conference-c.aspx"},{"c":"CSL 2018 Q4","e":"csl","d":"2019-02-07","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"For the fourth quarter, we achieved cost savings of 1.3% of sales through CLS and 1.5% for the full year, well within our goal of 1% to 2% savings annually.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/07/carlisle-cos-inc-csl-q4-2018-earnings-conference-c.aspx"},{"c":"CSL 2019 Q1","e":"csl","d":"2019-04-23","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"We remain disciplined to maintain pricing resolved, driving positive price realization across all four segments.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/23/carlisle-cos-inc-csl-q1-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q1","e":"csl","d":"2019-04-23","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"As I mentioned earlier, this was driven primarily by 6% organic growth, including 2% price realization.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/23/carlisle-cos-inc-csl-q1-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q1","e":"csl","d":"2019-04-23","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"Operating income rose over 20% for the second consecutive quarter, more than double our revenue growth, a further indication that our past restructuring efforts, pricing discipline, and savings and efficiencies derived from the Carlisle Operating System are paying dividends.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/23/carlisle-cos-inc-csl-q1-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q1","e":"csl","d":"2019-04-23","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"Our operating income in the first quarter grew 21% to $114.7 million, driving record first quarter diluted EPS of $1.33, which includes $0.08 of restructuring, facility rationalization and acquisition-related costs.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/23/carlisle-cos-inc-csl-q1-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q2","e":"csl","d":"2019-07-23","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"This was driven by 2.3% organic growth, including 1.5% price realization and 4.7% from acquisitions with foreign exchange translation a headwind during the quarter.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/23/carlisle-cos-inc-csl-q2-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q2","e":"csl","d":"2019-07-23","l":"pricing_power","r":"management","s":"Robert M. Roche","x":"Positive pricing and volume leverage combined for 140 basis points of the year-over-year improvement.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/23/carlisle-cos-inc-csl-q2-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q2","e":"csl","d":"2019-07-23","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"While we have reached the end of our initial restructuring activities, we continue to drive efficiencies and are now focused on growth, both by increasing our R&D efforts and on acquisitions that broaden our product suite across several end markets, namely liquid and powder finishing, and…","url":"https://www.fool.com/earnings/call-transcripts/2019/07/23/carlisle-cos-inc-csl-q2-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q2","e":"csl","d":"2019-07-23","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"Combined with price cost dynamics and efficiencies gained from prior year restructuring efforts, we leverage these positives into solid incremental margins.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/23/carlisle-cos-inc-csl-q2-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q3","e":"csl","d":"2019-10-22","l":"pricing_power","r":"management","s":"Chris Koch","x":"Accordingly, we announced a price increase on all CCM products commencing early January 2020, and it's important to note, it's not tied to raw material fluctuations, but rather to address the cost of providing industry-leading value to our customers, and the general inflation in operating costs.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/22/carlisle-cos-inc-csl-q3-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q3","e":"csl","d":"2019-10-22","l":"pricing_power","r":"management","s":"Bob Roche","x":"Positive pricing and volume leverage combined for 90 basis points of the year-over-year improvement.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/22/carlisle-cos-inc-csl-q3-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q3","e":"csl","d":"2019-10-22","l":"cost_cuts","r":"management","s":"Chris Koch","x":"We were also very pleased with the significant margin improvement that CIT delivered in the quarter, in no small way made possible by previous year's restructuring efforts.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/22/carlisle-cos-inc-csl-q3-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q3","e":"csl","d":"2019-10-22","l":"cost_cuts","r":"management","s":"Chris Koch","x":"CIT had strong operating leverage in the quarter, increasing margins 270 basis points year-over-year to 14.9%, which includes $2.5 million of investment in restructuring costs.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/22/carlisle-cos-inc-csl-q3-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q4","e":"csl","d":"2020-02-06","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"We instituted a price increase on all CCM products in mid-January, addressing the cost of providing industry-leading value to our customers and general inflation and operating costs.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/07/carlisle-cos-inc-csl-q4-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q4","e":"csl","d":"2020-02-06","l":"pricing_power","r":"management","s":"Robert M. Roche","x":"These were partially offset by favorable mix, price realization and savings from COS.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/07/carlisle-cos-inc-csl-q4-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q4","e":"csl","d":"2020-02-06","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"Despite these declines, CBF continue to capture the benefits from its significant restructuring efforts around the closure of the Tulsa, Oklahoma manufacturing facility and its integration into Medina, Ohio and in their ongoing COS programs.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/07/carlisle-cos-inc-csl-q4-2019-earnings-call-transcr.aspx"},{"c":"CSL 2019 Q4","e":"csl","d":"2020-02-06","l":"cost_cuts","r":"management","s":"Robert M. Roche","x":"Freight, labor and raw material costs netted to a 60 basis point improvement, and net restructuring and rationalization costs were an additional 60 basis point tailwind.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/07/carlisle-cos-inc-csl-q4-2019-earnings-call-transcr.aspx"},{"c":"CSL 2020 Q1","e":"csl","d":"2020-04-21","l":"cost_cuts","r":"management","s":"Christian Koch","x":"Due to our strong balance sheet, in the first quarter, we were able to avoid layoffs and disruptions in our operations outside of health and safety or government-mandated shutdowns.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/21/carlisle-cos-inc-csl-q1-2020-earnings-call-transcr.aspx"},{"c":"CSL 2020 Q1","e":"csl","d":"2020-04-21","l":"cost_cuts","r":"management","s":"Christian Koch","x":"Accordingly, we are actively seeking to accelerate and complete restructuring actions, many of which were contemplated in Vision 2025.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/21/carlisle-cos-inc-csl-q1-2020-earnings-call-transcr.aspx"},{"c":"CSL 2020 Q2","e":"csl","d":"2020-07-21","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"We took pride in keeping layoffs and reduced hours to a minimum, which helped provide the uninterrupted service to our customers that they have come to rely on and allowed us to continue our progress on key initiatives related to Vision 2025.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/22/carlisle-cos-inc-csl-q2-2020-earnings-call-transcr.aspx"},{"c":"CSL 2020 Q2","e":"csl","d":"2020-07-21","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"In response, our CIT team initiated an acceleration of restructuring actions that will right size our manufacturing footprint in line with expected demand over the next few years.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/22/carlisle-cos-inc-csl-q2-2020-earnings-call-transcr.aspx"},{"c":"CSL 2020 Q3","e":"csl","d":"2020-10-20","l":"pricing_power","r":"management","s":"Robert M. Roche","x":"These were offset partially by savings from COS, lower SG&A and some price increases.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/20/carlisle-companies-inc-csl-q3-2020-earnings-call-t/"},{"c":"CSL 2020 Q3","e":"csl","d":"2020-10-20","l":"pricing_power","r":"management","s":"Robert M. Roche","x":"This was driven by price realization, efficiencies from COS and lower SG&A. Turning now to Slide 11 for CBS, CBS third quarter organic revenue declined 10.8%, FX had a positive 1.7% impact, operating income was $0.9 million or 1.3% operating margin, driven primarily by volume declines and…","url":"https://www.fool.com/earnings/call-transcripts/2020/10/20/carlisle-companies-inc-csl-q3-2020-earnings-call-t/"},{"c":"CSL 2020 Q3","e":"csl","d":"2020-10-20","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"We have taken tough but necessary restructuring actions at CIT including the announced closures of Mobile, Alabama and Kent, Washington facilities.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/20/carlisle-companies-inc-csl-q3-2020-earnings-call-t/"},{"c":"CSL 2020 Q3","e":"csl","d":"2020-10-20","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"We also took the difficult actions of reducing headcount by approximately 550 employees in our Nogales, Mexico factory and by over 100 employees in our Dongguan, China aerospace factory.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/20/carlisle-companies-inc-csl-q3-2020-earnings-call-t/"},{"c":"CSL 2020 Q4","e":"csl","d":"2021-02-04","l":"pricing_power","r":"management","s":"Robert M. Roche","x":"These declines were partially offset by savings from CLS, lower SG&A and price increases.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/05/carlisle-companies-inc-csl-q4-2020-earnings-call-t/"},{"c":"CSL 2020 Q4","e":"csl","d":"2021-02-04","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"From my perspective, it was very satisfying to see that the price increases that occurred were quickly embraced by a lot of parties and we also see widespread support in other construction-related products for price increases, so my belief is that we will see traction on price as you said becomes…","url":"https://www.fool.com/earnings/call-transcripts/2021/02/05/carlisle-companies-inc-csl-q4-2020-earnings-call-t/"},{"c":"CSL 2020 Q4","e":"csl","d":"2021-02-04","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"In the face of significant declines, the teams did a commendable job managing through the crisis, taking actions to reduce costs and position their businesses for the future, including leveraging COS, investing in new product development and rightsizing footprints.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/05/carlisle-companies-inc-csl-q4-2020-earnings-call-t/"},{"c":"CSL 2020 Q4","e":"csl","d":"2021-02-04","l":"cost_cuts","r":"management","s":"Robert M. Roche","x":"CIT's operating margin declined significantly year-over-year to a negative 8.6% driven by commercial aerospace volume declines and accelerated restructuring actions.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/05/carlisle-companies-inc-csl-q4-2020-earnings-call-t/"},{"c":"CSL 2021 Q1","e":"csl","d":"2021-04-22","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"Coming into the year we were expecting an inflationary environment, coupled with strong demand and thus had prioritized selling price increases across most product categories at CCM to ensure we can continue to invest in and provide world-class customer service to our customers.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/22/carlisle-companies-inc-csl-q1-2021-earnings-call-t/"},{"c":"CSL 2021 Q1","e":"csl","d":"2021-04-22","l":"pricing_power","r":"analyst","s":"Garik Shmois","x":"Is this -- you reiterated that is this predicated on getting or needing additional price increases or do you think what you secured so far this year should get you there just given the visibility that you have on the cost side?","url":"https://www.fool.com/earnings/call-transcripts/2021/04/22/carlisle-companies-inc-csl-q1-2021-earnings-call-t/"},{"c":"CSL 2021 Q1","e":"csl","d":"2021-04-22","l":"cost_cuts","r":"management","s":"Robert M. Roche","x":"While the actions taken by CIT in 2020 to rightsize our footprint and reuse the overall workforce were difficult, we are positioned to deliver sequentially improving performance throughout 2021.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/22/carlisle-companies-inc-csl-q1-2021-earnings-call-t/"},{"c":"CSL 2021 Q1","e":"csl","d":"2021-04-22","l":"cost_cuts","r":"management","s":"Robert M. Roche","x":"Finally, we expect restructuring in 2021 to be approximately $20 million.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/22/carlisle-companies-inc-csl-q1-2021-earnings-call-t/"},{"c":"CSL 2021 Q2","e":"csl","d":"2021-07-22","l":"pricing_power","r":"management","s":"Chris Koch","x":"CFT delivered improved revenue and profitability performance in the second quarter, driven by its reenergized commitment to new product introductions, improved operational efficiencies, price realization from earning the value that comes with innovation and an improved customer experience.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/22/carlisle-companies-incorporated-csl-q2-2021-earnin/"},{"c":"CSL 2021 Q2","e":"csl","d":"2021-07-22","l":"pricing_power","r":"analyst","s":"Saree Boroditsky","x":"I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/22/carlisle-companies-incorporated-csl-q2-2021-earnin/"},{"c":"CSL 2021 Q2","e":"csl","d":"2021-07-22","l":"cost_cuts","r":"management","s":"Robert M. Roche","x":"Finally, restructuring is expected in 2021 to be approximately $20 million.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/22/carlisle-companies-incorporated-csl-q2-2021-earnin/"},{"c":"CSL 2021 Q2","e":"csl","d":"2021-07-22","l":"guidance","r":"analyst","s":"Saree Boroditsky","x":"And then you raised the outlook for CFT.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/22/carlisle-companies-incorporated-csl-q2-2021-earnin/"},{"c":"CSL 2021 Q2","e":"csl","d":"2021-07-22","l":"guidance","r":"analyst","s":"Kevin Hocevar","x":"And in terms of the increased guidance, just one quick question there.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/22/carlisle-companies-incorporated-csl-q2-2021-earnin/"},{"c":"CSL 2021 Q3","e":"csl","d":"2021-10-21","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"On CFT, given its reenergized commitment to new products, improved operational efficiencies, price realization from earning the value of innovation and an improved customer experience, CFT generated revenue growth of 9% year-over-year and adjusted EBIT growth of 16% year-over-year in the third…","url":"https://www.fool.com/earnings/call-transcripts/2021/10/21/carlisle-companies-incorporated-csl-q3-2021-earnin/"},{"c":"CSL 2021 Q3","e":"csl","d":"2021-10-21","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"We raised prices because we anticipated as the vaccines took hold and as reopenings occurred, that demand would pick up.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/21/carlisle-companies-incorporated-csl-q3-2021-earnin/"},{"c":"CSL 2021 Q3","e":"csl","d":"2021-10-21","l":"cost_cuts","r":"management","s":"D. Christian Koch","x":"Over the last several quarters, CIT has taken significant restructuring actions such as closing our facility in Kent, Washington to drive improved profitability.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/21/carlisle-companies-incorporated-csl-q3-2021-earnin/"},{"c":"CSL 2021 Q3","e":"csl","d":"2021-10-21","l":"cost_cuts","r":"management","s":"Robert M. Roche","x":"Given the positive indicators and actions undertaken in 2020 and 2021 to rightsize the business, we are optimistic that CIT is positioned to leverage a return to growth over the coming quarters and years.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/21/carlisle-companies-incorporated-csl-q3-2021-earnin/"},{"c":"CSL 2025 Q4","e":"csl","d":"2026-02-03","l":"ai_spend","r":"management","s":"Chris Koch","x":"…regulation, and pressure from rising utility rates, especially now with the outsized impact of AI and data centers consuming unprecedented levels of electricity, structurally high labor costs, and a decreasing labor pool that increases contractors' desire for easy-to-install, labor-saving…","url":"https://www.fool.com/earnings/call-transcripts/2026/02/03/carlisle-csl-q4-2025-earnings-call-transcript/"},{"c":"CSL 2025 Q4","e":"csl","d":"2026-02-03","l":"tariffs","r":"management","s":"Kevin Zdimal","x":"With the recent harsh weather throughout most of the country, combined with a tariff pull forward in 2025 that we discussed on the Q2 earnings call, we expect first quarter 2026 revenue will be down low single digits versus last year.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/03/carlisle-csl-q4-2025-earnings-call-transcript/"},{"c":"CSL 2025 Q4","e":"csl","d":"2026-02-03","l":"pricing_power","r":"management","s":"David MacGregor","x":"Price increase or how much forward visibility do you have right now in CCM and are you thinking about that pricing in?","url":"https://www.fool.com/earnings/call-transcripts/2026/02/03/carlisle-csl-q4-2025-earnings-call-transcript/"},{"c":"CSL 2025 Q4","e":"csl","d":"2026-02-03","l":"pricing_power","r":"management","s":"Chris Koch","x":"Obviously, that's kind of the traditional price increases that would happen maybe in that mid-year time frame.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/03/carlisle-csl-q4-2025-earnings-call-transcript/"},{"c":"CSL 2025 Q4","e":"csl","d":"2026-02-03","l":"cost_cuts","r":"management","s":"Kevin Zdimal","x":"We expect consolidated adjusted EBITDA margins to expand by approximately 50 basis points supported by our focus on operational excellence, cost-saving initiatives in both segments, and volume leverage.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/03/carlisle-csl-q4-2025-earnings-call-transcript/"},{"c":"CSL 2026 Q1","e":"csl","d":"2026-04-23","l":"tariffs","r":"management","s":"D. Christian Koch","x":"Second, last year’s first quarter benefited from approximately $15 million of tariff-related order pull-forward from Canadian customers, which did not repeat this year.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/carlisle-csl-q1-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q1","e":"csl","d":"2026-04-23","l":"tariffs","r":"management","s":"Kevin P. Zdimal","x":"…mentioned earlier, the two primary drivers of that decline were the adverse impact of this winter’s harsh weather limiting the number of days that roofing contractors were able to spend on the roof, and the absence of approximately $15 million of tariff-related pull-forward that benefited 2025.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/carlisle-csl-q1-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q1","e":"csl","d":"2026-04-23","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"We acted quickly in mid-March, announcing price increases across both CCM and CWT effective mid-April, and implementing real-time freight surcharges to drive more immediate recovery.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/carlisle-csl-q1-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q1","e":"csl","d":"2026-04-23","l":"pricing_power","r":"management","s":"D. Christian Koch","x":"In addition, we announced a second round of price increases at CCM today to offset the additional cost pressures that disruptions in the petrochemical supply chain are driving.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/carlisle-csl-q1-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q1","e":"csl","d":"2026-04-23","l":"guidance","r":"management","s":"Kevin P. Zdimal","x":"However, based on our progress to date, we are reaffirming our 2026 outlook.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/carlisle-csl-q1-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q1","e":"csl","d":"2026-04-23","l":"guidance","r":"analyst","s":"Bryan Francis Blair","x":"In the revised, reaffirmed guide, what are you now baking in for volume versus price per CCM and CWT for the year?","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/carlisle-csl-q1-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q2","e":"csl","d":"2026-07-29","l":"pricing_power","r":"management","s":"Kevin Zdimal","x":"Since the start of the conflict, we have announced 3 broad based price increases and implemented freight surcharges to offset higher raw material and freight costs.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/07/carlisle-csl-q2-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q2","e":"csl","d":"2026-07-29","l":"pricing_power","r":"management","s":"Kevin Zdimal","x":"As we have seen in prior inflationary cycles, price realization typically lags rising costs.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/07/carlisle-csl-q2-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q3","e":"csl","d":"2026-10-28","l":"tariffs","r":"management","s":"D. Koch","x":"And then we move into the tariff situation and election and tariffs impacted raw material supplies and it impacted demand.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/29/carlisle-csl-q3-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q3","e":"csl","d":"2026-10-28","l":"pricing_power","r":"management","s":"D. Koch","x":"We addressed the cost increases that began in quarter 1 with multiple price increases and freight surcharges.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/29/carlisle-csl-q3-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q3","e":"csl","d":"2026-10-28","l":"pricing_power","r":"management","s":"D. Koch","x":"Historically, price realization has lagged cost increases by approximately 3 to 6 months, primarily because we honor existing quotes and firm orders already in our system.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/29/carlisle-csl-q3-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q3","e":"csl","d":"2026-10-28","l":"cost_cuts","r":"management","s":"Kevin Zdimal","x":"Structural cost savings and higher volume drove that improvement, more than offsetting raw material and freight inflation that outpaced price realization.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/29/carlisle-csl-q3-2026-earnings-call-transcript/"},{"c":"CSL 2026 Q3","e":"csl","d":"2026-10-28","l":"cost_cuts","r":"management","s":"D. Koch","x":"While others may be looking to have cost cutting or maybe not adding as much as we mentioned, we continue to invest through the cycle.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/29/carlisle-csl-q3-2026-earnings-call-transcript/"}],"trends":{"theater":[[34,1,7222,0,0,0,5420,1362],[35,1,7116,0,0,0,5185,1398],[36,1,5292,0,0,0,4155,772],[37,1,6491,0,0,0,4691,1299],[38,1,6169,0,0,0,4823,968],[39,1,6394,0,0,0,4938,1068],[40,1,7472,0,0,0,6104,1010],[41,1,9113,0,0,0,7246,1475],[42,1,8715,0,0,0,6933,1310],[43,1,8265,0,0,0,6666,1082],[44,1,9567,0,0,0,7774,1210],[45,1,8232,0,0,0,6651,1165],[46,1,8433,0,0,0,6928,1132],[47,1,8330,0,0,0,7125,818],[64,1,6069,0,0,0,5839,0],[65,1,5417,0,0,0,4286,687],[66,1,7147,0,0,0,5191,1513],[67,1,7382,0,0,0,5843,1216]],"cinema":[[34,1,7222,0,0,0,5420,1362],[35,1,7116,0,0,0,5185,1398],[36,1,5292,0,0,0,4155,772],[37,1,6491,0,0,0,4691,1299],[38,1,6169,0,0,0,4823,968],[39,1,6394,0,0,0,4938,1068],[40,1,7472,0,0,0,6104,1010],[41,1,9113,0,0,0,7246,1475],[42,1,8715,0,0,0,6933,1310],[43,1,8265,0,0,0,6666,1082],[44,1,9567,0,0,0,7774,1210],[45,1,8232,0,0,0,6651,1165],[46,1,8433,0,0,0,6928,1132],[47,1,8330,0,0,0,7125,818],[64,1,6069,0,0,0,5839,0],[65,1,5417,0,0,0,4286,687],[66,1,7147,0,0,0,5191,1513],[67,1,7382,0,0,0,5843,1216]],"imax":[[34,1,7222,0,0,0,5420,1362],[35,1,7116,0,0,0,5185,1398],[36,1,5292,0,0,0,4155,772],[37,1,6491,0,0,0,4691,1299],[38,1,6169,0,0,0,4823,968],[39,1,6394,0,0,0,4938,1068],[40,1,7472,0,0,0,6104,1010],[41,1,9113,0,0,0,7246,1475],[42,1,8715,0,0,0,6933,1310],[43,1,8265,0,0,0,6666,1082],[44,1,9567,0,0,0,7774,121