ricing_power":[3,2,1,4.71],"cost_cuts":[1,1,0,1.57],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0033,"r5":0.036,"r20":-0.0203,"r1_spy":-0.0086,"r5_spy":0.0352,"r20_spy":0.0273,"r1_sector":-0.0201,"r5_sector":0.0142,"r20_sector":0.0993,"etf":"XLK"}}],"quotes":[{"c":"TDY 2020 Q1","e":"tdy","d":"2020-04-22","l":"cost_cuts","r":"management","s":"Al Pichelli","x":"GAAP segment operating margin decreased due to lower aerospace sales, but also 525 basis points of charges for severance facility consolidations and certain contract cost adjustments.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2020 Q1","e":"tdy","d":"2020-04-22","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"So let me start from the latter part of your question, which is do I expect more restructuring?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2020 Q2","e":"tdy","d":"2020-07-22","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"Ongoing simplification of our processes and margin improvement actions, including progressive cost cutting in the first half of 2020 delivered superior results.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2020 Q2","e":"tdy","d":"2020-07-22","l":"cost_cuts","r":"management","s":"Al Pichelli","x":"Overall, Instrumentation segment operating profit and margin were flat with last year despite $2.8 million in higher severance and facility consolidation costs.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2020 Q3","e":"tdy","d":"2020-10-21","l":"streaming","r":"management","s":"Robert Mehrabian","x":"The area that has not come back is the offshore exploration where we provide streamer cables and sensors.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2020 Q3","e":"tdy","d":"2020-10-21","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"Having said that and going forward I think that would moderate somewhat because we took a lot of cost out this year and we're going to enjoy the fruits of that next year but I would be disappointed if we can't continuously improve our margins somewhere between 80 to 100 basis points in the next…","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2020 Q3","e":"tdy","d":"2020-10-21","l":"cost_cuts","r":"analyst","s":"Blake Gendron","x":"You've quantified some of the cost out in the past things that you're doing internally with the target goal of 20% GAAP EBIT margins or better.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2020 Q4","e":"tdy","d":"2021-01-27","l":"cost_cuts","r":"management","s":"Al Pichelli","x":"The GAAP segment operating margin decreased due to lower sales as well as $5.8 million in severance facility consolidation and other contract charges.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2020 Q4","e":"tdy","d":"2021-01-27","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"It's just primarily cost takeout and improvement in everything else that we're doing.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2021 Q2","e":"tdy","d":"2021-07-28","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"And as a result, we now expect to achieve our annualized cost savings target of $80 million before the end of 2022 as approach to 2024 as described in our final merger proxy.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2021 Q2","e":"tdy","d":"2021-07-28","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"If we can maintain that momentum for next year, where we would enjoy probably the full year benefit of the cost reduction, I would say we may be able to increase that to as high as $2.50 from this year’s $2 and $2.20.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2021 Q3","e":"tdy","d":"2021-10-27","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"Having said that, some of our suppliers more recently have come out with 20%, 25% price increases.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2021 Q3","e":"tdy","d":"2021-10-27","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"…to accelerate the pace of planned synergies and currently expect to achieve our annualized cost saving target of $80 million before the middle of 2022 as opposed to the end of 2022 as we described in our July earnings call and compared with 2024 as noted when we announced the transaction…","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2021 Q3","e":"tdy","d":"2021-10-27","l":"cost_cuts","r":"analyst","s":"Elizabeth Grenfell","x":"When we think about the FLIR integration and the acceleration and the timeline to achieving the initial cost savings, where do you think we could potentially see additional upside to, I think before the top side had been to $100 million.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2021 Q4","e":"tdy","d":"2022-01-27","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"Let's start with price increase for us.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2021 Q4","e":"tdy","d":"2022-01-27","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"On the flip side, we had some price increases from our suppliers.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2021 Q4","e":"tdy","d":"2022-01-27","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"We took cost out, as we always do.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2021 Q4","e":"tdy","d":"2022-01-27","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"We took the cost out, and some of the comps, therefore, were easy as we come into the new year.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q1","e":"tdy","d":"2022-04-27","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"We're pretty much offsetting that with price increases.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q1","e":"tdy","d":"2022-04-27","l":"pricing_power","r":"analyst","s":"Noah Poponak","x":"Are you raising price at a rate equal to or slightly greater than the cost inflation?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q1","e":"tdy","d":"2022-04-27","l":"guidance","r":"management","s":"Robert Mehrabian","x":"So, I would say, we’ve increased our outlook from January a little bit from, let’s say, 4% to 4.5%.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q2","e":"tdy","d":"2022-07-28","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"Our price increases for the year, we anticipate it to be about 3% of sales.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q2","e":"tdy","d":"2022-07-28","l":"guidance","r":"analyst","s":"Greg Konrad","x":"But yes, just I mean, I guess it's uncharacteristic for Teledyne to cut guidance.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q3","e":"tdy","d":"2022-10-26","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"On the other hand, we have also against that, we have inflation, Greg, and price increases in the products that we buy.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q3","e":"tdy","d":"2022-10-26","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"The price increases in the products that we buy have been about 3.4%.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q3","e":"tdy","d":"2022-10-26","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"And obviously, we were also concerned whether we could manage our margins that take cost out to improve our margins.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q3","e":"tdy","d":"2022-10-26","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"But as we took some cost out and increased prices, and we had good cash flow, by the way, it’s given us a lot more confidence.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2022 Q3","e":"tdy","d":"2022-10-26","l":"guidance","r":"management","s":"Robert Mehrabian","x":"So we raised our outlook and de-risked Q4 at the same time.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q1","e":"tdy","d":"2023-04-26","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"On the overall for the company, we think the margins now would increase 40 basis points for the year and if we can have better price increases going forward, we should improve on that.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q1","e":"tdy","d":"2023-04-26","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"Again, we hope to do better than that and the way to do better than that is if we can stick some more price increases in our portfolio, because inflation is moderating.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q1","e":"tdy","d":"2023-04-26","l":"guidance","r":"management","s":"Robert Mehrabian","x":"Consequently, by maintaining the full year guidance, we have also modestly derisked the quarterly sequential revenue and earnings slopes.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q2","e":"tdy","d":"2023-07-26","l":"pricing_power","r":"analyst","s":"Guy Hardwick","x":"I think last quarter, you had pointed out negative mix, lag of price increases, I think, in the Medical business.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q2","e":"tdy","d":"2023-07-26","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"And I think FLIR margins will increase as we -- especially as we take the cost out that I just mentioned.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q3","e":"tdy","d":"2023-10-25","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"But generally, we are successful in raising prices across the board, we have been this year versus let's say last year.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q3","e":"tdy","d":"2023-10-25","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"The reductions in force, a majority of them have happened and the rest will happen in the Q4 time frame.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q3","e":"tdy","d":"2023-10-25","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"But having said that, coming back to the margins of -- FLIR margins have really improved this quarter, both because of the cost reduction, also because of the mix of businesses that we have and Digital Imaging as a whole, which includes DALSA and e2v.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q3","e":"tdy","d":"2023-10-25","l":"guidance","r":"management","s":"Sue Main","x":"And on a non-GAAP basis, we are raising our outlook to $19.20 to $19.30.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q4","e":"tdy","d":"2024-01-24","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"First point, backwards, in '23, we had some nice price increases.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q4","e":"tdy","d":"2024-01-24","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"But nevertheless, no, I don't think we're expecting to suffer there because as we've done before, when some of our markets soften up, we take cost out.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2023 Q4","e":"tdy","d":"2024-01-24","l":"cost_cuts","r":"analyst","s":"Kristine Liwag","x":"And ultimately, could we expect to see higher margins there if you have additional cost takeout you could do this year?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2024 Q1","e":"tdy","d":"2024-04-24","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"We took about $52 million worth of cost out last year, and we're taking additional $10 million to $15 million cost of this year early on.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2024 Q2","e":"tdy","d":"2024-07-24","l":"streaming","r":"management","s":"Robert Mehrabian","x":"We have -- as you know, we have instruments that are deployed in streamers to look down at acoustic signals that bounce from the ocean floor and determine whether there's oil and gas there.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2024 Q2","e":"tdy","d":"2024-07-24","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"Having said that, we took cost out in that business.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2024 Q2","e":"tdy","d":"2024-07-24","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"And fortunately for us, we took the cost out very early and the margins of instruments have remained pretty well.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2024 Q3","e":"tdy","d":"2024-10-23","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"On the FLIR side, Edwin and his people were able to take cost out in our camera, especially in our camera and some health care businesses to compensate for lower revenue.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2024 Q3","e":"tdy","d":"2024-10-23","l":"cost_cuts","r":"management","s":"Robert Mehrabian","x":"FLIR, very strong, Digital Imaging, the rest of Digital Imaging, taking the cost out.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2024 Q4","e":"tdy","d":"2025-01-22","l":"tariffs","r":"management","s":"Robert Mehrabian","x":"Let's talk about tariffs first.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2024 Q4","e":"tdy","d":"2025-01-22","l":"tariffs","r":"management","s":"Robert Mehrabian","x":"The way the tariffs are laid out, at least initially, the Canada, Mexico or China, we think the impact of those would be less than what we experienced in 2022, maybe half as much.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2025 Q1","e":"tdy","d":"2025-04-24","l":"tariffs","r":"management","s":"Robert Mehrabian","x":"Finally, just 4% of external sales are from Teledyne international locations to U.S.-based customers where new tariffs may apply for our customers.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2025 Q1","e":"tdy","d":"2025-04-24","l":"tariffs","r":"management","s":"Robert Mehrabian","x":"While we are not immune to the current 10%-plus of tariff rates or certainly the pre-pause liberation day proposed tariff rates, we are certainly planning actions to protect margins as the landscape evolves.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TDY 2025 Q1","e":"tdy","d":"2025-04-24","l":"pricing_power","r":"management","s":"Robert Mehrabian","x":"Finally, we have to take price a