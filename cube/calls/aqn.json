c":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[8,7,1,13.94],"pricing_power":[0,0,0,0.0],"cost_cuts":[1,1,0,1.74],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0017,"r5":0.0122,"r20":-0.0261,"r1_spy":-0.0079,"r5_spy":0.0,"r20_spy":-0.0321}},{"id":"AQN 2026 Q3","t":"AQN","d":"2026-11-06","time":"bmo","w":4670,"n":34,"url":"https://www.fool.com/earnings/call-transcripts/2026/11/06/algonquin-power-aqn-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[9,8,1,19.62],"pricing_power":[0,0,0,0.0],"cost_cuts":[2,2,0,4.36],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0213,"r5":-0.0195,"r1_spy":-0.0244,"r5_spy":-0.0524}}],"quotes":[{"c":"AQN 2019 Q3","e":"aqn","d":"2019-11-08","l":"pricing_power","r":"management","s":"Ian Robertson","x":"And so to the extent that costs were being -- trying to be passed through to us it just made sense to negotiate that arrangement.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/08/algonquin-power-utilities-corp-aqn-q3-2019-earning.aspx"},{"c":"AQN 2019 Q3","e":"aqn","d":"2019-11-08","l":"cost_cuts","r":"management","s":"David Bronicheski","x":"We've invested in capital and this has now allowed us to enjoy some operational cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/08/algonquin-power-utilities-corp-aqn-q3-2019-earning.aspx"},{"c":"AQN 2019 Q3","e":"aqn","d":"2019-11-08","l":"cost_cuts","r":"management","s":"Ian Robertson","x":"And so that depending on where that operating cost saving is occasioned it could go away at the next rate case.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/08/algonquin-power-utilities-corp-aqn-q3-2019-earning.aspx"},{"c":"AQN 2019 Q4","e":"aqn","d":"2020-02-28","l":"cost_cuts","r":"management","s":"Ian Robertson","x":"Well, you know we look at cost savings across the utility platform as kind of one of those dials that allows us to earn our regulatory return and it will -- it will vary somewhat depending on the various rate case cycles that we -- that we happen to be in.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/28/algonquin-power-utilities-corp-aqn-q4-2019-earning.aspx"},{"c":"AQN 2020 Q1","e":"aqn","d":"2020-05-09","l":"cost_cuts","r":"management","s":"Arun Banskota","x":"Thirdly, we also began implementing certain cost reduction strategies in order to mitigate some of the weather impacts experienced during Q1.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/09/algonquin-power-utilities-corp-aqn-q1-2020-earning.aspx"},{"c":"AQN 2020 Q1","e":"aqn","d":"2020-05-09","l":"cost_cuts","r":"management","s":"David Bronicheski","x":"Diving into our Regulated Services Group, the business unit delivered $170.2 million in operating profit in Q1, 2020, compared to $161.2 million in the prior year, as lower consumption due to warmer weather, was partially offset by cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/09/algonquin-power-utilities-corp-aqn-q1-2020-earning.aspx"},{"c":"AQN 2020 Q2","e":"aqn","d":"2020-08-14","l":"cost_cuts","r":"management","s":"Arthur Kacprzak","x":"The implementation of new rates as well as operating cost savings realized during the quarter.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/14/algonquin-power-utilities-corp-aqn-q2-2020-earning/"},{"c":"AQN 2020 Q2","e":"aqn","d":"2020-08-14","l":"cost_cuts","r":"management","s":"Arthur Kacprzak","x":"I'm pleased to report that in Q2, the company was able to achieve approximately $5 million in cost savings and expect to show similar savings in Q3 and Q4 to achieve further expense reductions of approximately $10 million in the second half of the year.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/14/algonquin-power-utilities-corp-aqn-q2-2020-earning/"},{"c":"AQN 2020 Q3","e":"aqn","d":"2020-11-13","l":"cost_cuts","r":"management","s":"Arthur Kacprzak","x":"The increase is primarily due to the implementation of new rates as well as operating cost savings realized during the quarter and has been partially offset by decreased customer demand from the impacts of COVID-19.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/13/algonquin-power-utilities-corp-aqn-q3-2020-earning/"},{"c":"AQN 2020 Q3","e":"aqn","d":"2020-11-13","l":"cost_cuts","r":"management","s":"Arthur Kacprzak","x":"Our results were positively impacted by cost savings implemented during the quarter and tax credits earned from our renewable generation projects, but were partially offset by the delay in the closing of BELCO and the impacts of COVID-19.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/13/algonquin-power-utilities-corp-aqn-q3-2020-earning/"},{"c":"AQN 2020 Q4","e":"aqn","d":"2021-03-05","l":"pricing_power","r":"management","s":"Arthur Kacprzak","x":"But primarily all of those costs are expected to be passed through to our customers, although the timing of the pass-through is obviously subject to discussions with our regulators.","url":"https://www.fool.com/earnings/call-transcripts/2021/03/05/algonquin-power-utilities-corp-aqn-q4-2020-earning/"},{"c":"AQN 2020 Q4","e":"aqn","d":"2021-03-05","l":"cost_cuts","r":"management","s":"Arun Banskota","x":"Despite these, management was able to pull a number of levers, including cost savings to continue our growth trajectory.","url":"https://www.fool.com/earnings/call-transcripts/2021/03/05/algonquin-power-utilities-corp-aqn-q4-2020-earning/"},{"c":"AQN 2020 Q4","e":"aqn","d":"2021-03-05","l":"cost_cuts","r":"management","s":"Arthur Kacprzak","x":"Our results were positively impacted by cost savings implemented during the quarter, a solid performance from our generation facilities and a contribution of the ESSAL and the BELCO acquisitions.","url":"https://www.fool.com/earnings/call-transcripts/2021/03/05/algonquin-power-utilities-corp-aqn-q4-2020-earning/"},{"c":"AQN 2021 Q1","e":"aqn","d":"2021-05-07","l":"tariffs","r":"management","s":"Arun Banskota","x":"They will allow us to implement time of use tariffs that will further help us to more economically balanced supply and demand providing further benefits for our customers.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/07/algonquin-power-utilities-corp-aqn-q1-2021-earning/"},{"c":"AQN 2021 Q1","e":"aqn","d":"2021-05-07","l":"pricing_power","r":"management","s":"Arthur Kacprzak","x":"So on the tax rate, as I mentioned, to the previous question, it's basically a pass through on the regulated side, maybe it's a slight like negative on the renewable side.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/07/algonquin-power-utilities-corp-aqn-q1-2021-earning/"},{"c":"AQN 2021 Q2","e":"aqn","d":"2021-08-13","l":"pricing_power","r":"management","s":"Arun Banskota","x":"And again, what we had seen is some of the increase on the supply chain has been offset by price increases on the optic side of the ledger.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/13/algonquin-power-utilities-corp-aqn-q2-2021-earning/"},{"c":"AQN 2021 Q2","e":"aqn","d":"2021-08-13","l":"cost_cuts","r":"management","s":"Arun Banskota","x":"And this new investment, if approved, will help us continue to decarbonize and provide cost savings over the long-term to our customers.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/13/algonquin-power-utilities-corp-aqn-q2-2021-earning/"},{"c":"AQN 2021 Q2","e":"aqn","d":"2021-08-13","l":"cost_cuts","r":"management","s":"Arun Banskota","x":"As you know, Abengoa was our 50% partner on Ages [Phonetic] and given all of the challenges that they were having with restructuring, we felt it was timely for us to find a new partner.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/13/algonquin-power-utilities-corp-aqn-q2-2021-earning/"},{"c":"AQN 2021 Q2","e":"aqn","d":"2021-08-13","l":"guidance","r":"management","s":"Arthur Kacprzak","x":"So in terms of outlook for the rest of the year, like I mentioned in my prepared commentary, we are reiterating our guidance between the 71 and 76.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/13/algonquin-power-utilities-corp-aqn-q2-2021-earning/"},{"c":"AQN 2021 Q3","e":"aqn","d":"2021-11-12","l":"pricing_power","r":"management","s":"Arun Banskota","x":"But what I was saying is that on the flipside, by and large, we have seen higher off-take prices as well.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/12/algonquin-power-utilities-corp-aqn-q3-2021-earning/"},{"c":"AQN 2021 Q3","e":"aqn","d":"2021-11-12","l":"cost_cuts","r":"management","s":"Arthur Kacprzak","x":"Some of these impacts were partially offset by higher realized renewable energy credit pricing on our US wind facilities as well as operating cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/12/algonquin-power-utilities-corp-aqn-q3-2021-earning/"},{"c":"AQN 2021 Q4","e":"aqn","d":"2022-03-04","l":"pricing_power","r":"management","s":"Arun Banskota","x":"On the regulated side of the business, I mean look, I mean, inflation is largely a pass-through.","url":"https://www.fool.com/earnings/call-transcripts/2022/03/04/algonquin-power-utilities-corp-aqn-q4-2021-earning/"},{"c":"AQN 2022 Q1","e":"aqn","d":"2022-05-13","l":"tariffs","r":"management","s":"Arun Banskota","x":"Staying on the topic of solar as it relates to the U.S. government's solar tariff investigation for the renewable sector, we believe there are two categories where the investigations impact on our industry might affect our pipeline.","url":"https://www.fool.com/earnings/call-transcripts/2022/05/14/algonquin-power-utilities-corp-aqn-q1-2022-earning/"},{"c":"AQN 2022 Q1","e":"aqn","d":"2022-05-13","l":"tariffs","r":"management","s":"Arun Banskota","x":"One recent example is that Liberty has secured approval and is now awaiting the final tariff for a pilot program with the regulator in Missouri, which is making the first utility in the state to obtain approval to earn a regulated return on behind-the-meter electric vehicle charging equipment.","url":"https://www.fool.com/earnings/call-transcripts/2022/05/14/algonquin-power-utilities-corp-aqn-q1-2022-earning/"},{"c":"AQN 2022 Q1","e":"aqn","d":"2022-05-13","l":"pricing_power","r":"management","s":"Arun Banskota","x":"We believe the potential consequences of the investigation could be cost pass-through to PPA pricing in the industry.","url":"https://www.fool.com/earnings/call-transcripts/2022/05/14/algonquin-power-utilities-corp-aqn-q1-2022-earning/"},{"c":"AQN 2022 Q1","e":"aqn","d":"2022-05-13","l":"pricing_power","r":"management","s":"Arthur Kacprzak","x":"…at Empire Electric, although moderately negatively impacted by weather this quarter as compared to long-term averages, recorded higher operating profit as compared to the prior year due to higher non pass-through fuel costs incurred in the prior year resulting from the impacts of Storm Uri.","url":"https://www.fool.com/earnings/call-transcripts/2022/05/14/algonquin-power-utilities-corp-aqn-q1-2022-earning/"},{"c":"AQN 2022 Q2","e":"aqn","d":"2022-08-12","l":"tariffs","r":"management","s":"Arun Banskota","x":"On the solar side with respect to the U.S. executive order regarding a two-year tariff exemption for solar panels, which is announced in June.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/12/algonquin-power-utilities-corp-aqn-q2-2022-earning/"},{"c":"AQN 2022 Q2","e":"aqn","d":"2022-08-12","l":"tariffs","r":"management","s":"Arun Banskota","x":"First, there are current projects with solar panel deliveries before the 24 months tariff free period expires.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/12/algonquin-power-utilities-corp-aqn-q2-2022-earning/"},{"c":"AQN 2022 Q2","e":"aqn","d":"2022-08-12","l":"pricing_power","r":"management","s":"Arun Banskota","x":"We believe a potential consequence of the investigation could be caused passed through to PPA pricing in the industry.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/12/algonquin-power-utilities-corp-aqn-q2-2022-earning/"},{"c":"AQN 2022 Q3","e":"aqn","d":"2022-11-11","l":"pricing_power","r":"management","s":"Arun Banskota","x":"These costs are largely a pass-through.","url":"https://www.fool.com/earnings/call-transcripts/2022/11/11/algonquin-power-utilities-corp-aqn-q3-2022-earning/"},{"c":"AQN 2023 Q2","e":"aqn","d":"2023-08-10","l":"cost_cuts","r":"analyst","s":"Sean Steuart","x":"Is there any benefit to potentially streamlining the regulated portfolio, one around a tighter group of modalities or a tighter regional platform as well?","url":"https://www.fool.com/earnings/call-transcripts/2023/08/10/algonquin-power-utilities-aqn-q2-2023-earnings-cal/"},{"c":"AQN 2023 Q3","e":"aqn","d":"2023-11-10","l":"cost_cuts","r":"management","s":"Chris Huskilson","x":"Second, there is a substantial opportunity to simplify, streamline, and reinvest for greater customer service and value.","url":"https://www.fool.com/earnings/call-transcripts/2023/11/10/algonquin-power-utilities-aqn-q3-2023-earnings-cal/"},{"c":"AQN 2023 Q3","e":"aqn","d":"2023-11-10","l":"cost_cuts","r":"analyst","s":"Rupert Merer","x":"And then secondly, Chris, you mentioned that you see an opportunity to streamline operations in the regulated utility.","url":"https://www.fool.com/earnings/call-transcripts/2023/11/10/algonquin-power-utilities-aqn-q3-2023-earnings-cal/"},{"c":"AQN 2023 Q4","e":"aqn","d":"2024-03-08","l":"tariffs","r":"management","s":"Darren Myers","x":"Subsequent to year-end, we successfully raised $850 million of Liberty Utilities senior unsecured notes and an additional $306 million of securitized utility tariff bonds at Empire.","url":"https://www.fool.com/earnings/call-transcripts/2024/03/08/algonquin-power-utilities-aqn-q4-2023-earnings-cal/"},{"c":"AQN 2024 Q1","e":"aqn","d":"2024-05-10","l":"tariffs","r":"management","s":"Darren Myers","x":"We closed financings of $2.3 billion with the issuance of unsecured senior notes and securitized utility tariff bonds, as well as the successful remarketing of our senior notes related to our green equity units.","url":"https://www.fool.com/earnings/call-transcripts/2024/05/10/algonquin-power-utilities-aqn-q1-2024-earnings-cal/"},{"c":"AQN 2024 Q2","e":"aqn","d":"2024-08-09","l":"cost_cuts","r":"management","s":"Chris Huskilson","x":"Also, as part of our objective to be more self-sufficient, the board has decided to rightsize the dividend so we're not chasing a high payout ratio and excess -- excessive equity raises.","url":"https://www.fool.com/earnings/call-transcripts/2024/08/09/algonquin-power-utilities-aqn-q2-2024-earnings-cal/"},{"c":"AQN 2024 Q2","e":"aqn","d":"2024-08-09","l":"cost_cuts","r":"management","s":"Darren Myers","x":"I mean, really, for us, it's around getting that strong balance sheet, you know, rightsizing the dividend.","url":"https://www.fool.com/earnings/call-transcripts/2024/08/09/algonquin-power-utilities-aqn-q2-2024-earnings-cal/"},{"c":"AQN 2024 Q3","e":"aqn","d":"2024-11-07","l":"pricing_power","r":"management","s":"Darren Myers","x":"Our revenue growth was partially offset by lower pass-through commodity costs.","url":"https://www.fool.com/earnings/call-transcripts/2024/11/07/algonquin-power-utilities-aqn-q3-2024-earnings-cal/"},{"c":"AQN 2024 Q3","e":"aqn","d":"2024-11-07","l":"cost_cuts","r":"management","s":"Chris Huskilson","x":"We began to streamline our capital structure early for this year.","url":"https://www.fool.com/earnings/call-transcripts/2024/11/07/algonquin-power-utilities-aqn-q3-2024-earnings-cal/"},{"c":"AQN 2024 Q4","e":"aqn","d":"2025-03-07","l":"tariffs","r":"management","s":"Chris Huskilson","x":"In short, the late revision to our tariff calculations has prompted us to restart the case, meaning the case is now expected to be resolved in the first half of 2026 rather than the late portion of 2025, as previously expected.","url":"https://www.fool.com/earnings/call-transcripts/2025/03/07/algonquin-power-utilities-aqn-q4-2024-earnings-cal/"},{"c":"AQN 2024 Q4","e":"aqn","d":"2025-03-07","l":"cost_cuts","r":"management","s":"Chris Huskilson","x":"Now, the critical focus points for the company remain continuing to improve our utilities; optimizing and leveraging our IT platform, which we completed last year; streamlining how we operate; and driving operational efficiency and customer service.","url":"https://www.fool.com/earnings/call-transcripts/2025/03/07/algonquin-power-utilities-aqn-q4-2024-earnings-cal/"},{"c":"AQN 2024 Q4","e":"aqn","d":"2025-03-07","l":"cost_cuts","r":"management","s":"Chris Huskilson","x":"The parties in this case agreed to full consolidation of all four water systems, which is consistent with our plan to streamline our business.","url":"https://www.fool.com/earnings/call-transcripts/2025/03/07/algonquin-power-utilities-aqn-q4-2024-earnings-cal/"},{"c":"AQN 2025 Q3","e":"aqn","d":"2025-11-07","l":"cost_cuts","r":"management","s":"Brian Chin","x":"You'll notice that we have taken cost-cutting measures as part of our ongoing strategy of improving value to our customers and stakeholders.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/10/algonquin-power-aqn-q3-2025-earnings-transcript/"},{"c":"AQN 2025 Q3","e":"aqn","d":"2025-11-07","l":"cost_cuts","r":"management","s":"Brian Chin","x":"What I'd say is we're in the early innings of our restructuring efforts still.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/10/algonquin-power-aqn-q3-2025-earnings-transcript/"},{"c":"AQN 2026 Q2","e":"aqn","d":"2026-08-07","l":"tariffs","r":"management","s":"Roderick West","x":"We continue to await an order on our Arizona Litchfield Park Water & Sewer rate case 