 2 rate cuts our guidance would be more like 7% to 8%.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/associated-bank-asb-q1-2026-earnings-transcript/"},{"c":"ASB 2026 Q3","e":"asb","d":"2026-10-22","l":"tariffs","r":"management","s":"Patrick Ahern","x":"We will also remain diligent in monitoring credit stressors in the macro economy to ensure current underwriting reflects the impact of ongoing inflation pressures, shifting labor markets, tariffs, and other economic concerns.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/22/associated-banc-asb-q3-2026-earnings-call-transcript/"}],"trends":{"theater":[[35,1,5597,0,0,0,3731,1182],[36,1,6177,0,0,0,696,4910],[37,1,4476,0,0,0,3202,752],[38,1,5305,0,0,0,4150,639],[39,1,4554,0,0,0,3238,776],[40,1,5236,0,0,0,3885,779],[41,1,7553,1,1,0,5970,1017],[42,1,7485,0,0,0,1033,5841],[43,1,5116,0,0,0,3735,838],[44,1,7221,0,0,0,5415,1195],[45,1,6366,0,0,0,5696,0],[46,1,6734,0,0,0,5001,1083],[47,1,7150,1,1,0,6038,530],[62,1,6081,0,0,0,5404,455],[63,1,6484,0,0,0,6332,0],[64,1,7839,0,0,0,2215,5365],[65,1,7974,0,0,0,6785,933],[67,1,8721,0,0,0,2374,5771]],"cinema":[[35,1,5597,0,0,0,3731,1182],[36,1,6177,0,0,0,696,4910],[37,1,4476,0,0,0,3202,752],[38,1,5305,0,0,0,4150,639],[39,1,4554,0,0,0,3238,776],[40,1,5236,0,0,0,3885,779],[41,1,7553,0,0,0,5970,1017],[42,1,7485,0,0,0,1033,5841],[43,1,5116,0,0,0,3735,838],[44,1,7221,0,0,0,5415,1195],[45,1,6366,0,0,0,5696,0],[46,1,6734,0,0,0,5001,1083],[47,1,7150,0,0,0,6038,530],[62,1,6081,0,0,0,5404,455],[63,1,6484,0,0,0,6332,0],[64,1,7839,0,0,0,2215,5365],[65,1,7974,0,0,0,6785,933],[67,1,8721,0,0,0,2374,5771]],"imax":[[35,1,5597,0,0,0,3731,1182],[36,1,6177,0,0,0,696,4910],[37,1,4476,0,0,0,3202,752],[38,1,5305,0,0,0,4150,639],[39,1,4554,0,0,0,3238,776],[40,1,5236,0,0,0,3885,779],[41,1,7553,0,0,0,5970,1017],[42,1,7485,0,0,0,1033,5841],[43,1,5116,0,0,0,3735,838],[44,1,7221,0,0,0,5415,1195],[45,1,6366,0,0,0,5696,0],[46,1,6734,0,0,0,5001,1083],[47,1,7150,0,0,0,6038,530],[62,