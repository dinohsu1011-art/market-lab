affirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0237,"r5":-0.1051,"r20":-0.2237,"r1_spy":-0.0198,"r5_spy":-0.1056,"r20_spy":-0.2659}},{"id":"POOL 2026 Q3","t":"POOL","d":"2026-10-22","time":"bmo","w":10983,"n":89,"url":"https://www.fool.com/earnings/call-transcripts/2026/10/22/pool-pool-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[14,8,6,12.97],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.1436,"r5":0.1342,"r1_spy":0.1555,"r5_spy":0.1353}}],"quotes":[{"c":"POOL 2018 Q3","e":"pool","d":"2018-10-18","l":"tariffs","r":"management","s":"Manuel Perez de la Mesa","x":"And like everything else, we would -- if that is in fact happening in the drop dead day happens, we will buy into that price increase or the tariff in that particular case as we should, based on the velocity and based on the price increase or tariff increase and everything else.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/18/pool-corp-pool-q3-2018-earnings-conference-call-tr.aspx"},{"c":"POOL 2018 Q3","e":"pool","d":"2018-10-18","l":"tariffs","r":"analyst","s":"Stephen Volkmann","x":"And then the final one, nobody's brought it up, so maybe it doesn't matter, but our tariffs, if we go to 25% on the Section 301 tariffs, do we have anything to worry about here?","url":"https://www.fool.com/earnings/call-transcripts/2018/10/18/pool-corp-pool-q3-2018-earnings-conference-call-tr.aspx"},{"c":"POOL 2018 Q3","e":"pool","d":"2018-10-18","l":"pricing_power","r":"management","s":"Manuel Perez de la Mesa","x":"As mentioned in previous calls, we were expecting greater and earlier than normal manufacturer price increases in 2018, given materials and operating cost pressures.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/18/pool-corp-pool-q3-2018-earnings-conference-call-tr.aspx"},{"c":"POOL 2018 Q3","e":"pool","d":"2018-10-18","l":"pricing_power","r":"management","s":"Mark Joslin","x":"On the balance sheet and cash flow statements, I have one meaningful item to highlight, which is the impact of pre-price increase purchases that we began making in Q2 as discussed on our second quarter call and that continued into Q3.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/18/pool-corp-pool-q3-2018-earnings-conference-call-tr.aspx"},{"c":"POOL 2018 Q4","e":"pool","d":"2019-02-14","l":"pricing_power","r":"management","s":"Peter Arvan","x":"As mentioned in the third quarter call earlier and greater-than-normal blue vendor price increases drove much of the increase in the fourth quarter and will carry into the first quarter of 2019.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/14/pool-corp-pool-q4-2018-earnings-conference-call-tr.aspx"},{"c":"POOL 2018 Q4","e":"pool","d":"2019-02-14","l":"pricing_power","r":"management","s":"Peter Arvan","x":"We also saw mid-season price increases from major equipment suppliers making the competitive market even more challenging but, again, our seasoned team did well.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/14/pool-corp-pool-q4-2018-earnings-conference-call-tr.aspx"},{"c":"POOL 2019 Q1","e":"pool","d":"2019-04-18","l":"pricing_power","r":"analyst","s":"Ryan Merkel","x":"I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/18/pool-corp-pool-q1-2019-earnings-call-transcript.aspx"},{"c":"POOL 2019 Q1","e":"pool","d":"2019-04-18","l":"guidance","r":"management","s":"Peter D. Arvan","x":"Lastly, as a result of the ASU benefit we saw in the quarter, we are increasing our annual guidance by $0.04.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/18/pool-corp-pool-q1-2019-earnings-call-transcript.aspx"},{"c":"POOL 2019 Q1","e":"pool","d":"2019-04-18","l":"guidance","r":"management","s":"Mark W. Joslin","x":"As a result, we increased our guidance range for 2019 to include the unexpected $0.04 benefit.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/18/pool-corp-pool-q1-2019-earnings-call-transcript.aspx"},{"c":"POOL 2019 Q2","e":"pool","d":"2019-07-18","l":"tariffs","r":"analyst","s":"Steve Volkmann","x":"We've, obviously, had a little bit more of a tariff ramp up in certain things.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/18/pool-corp-pool-q2-2019-earnings-call-transcript.aspx"},{"c":"POOL 2019 Q2","e":"pool","d":"2019-07-18","l":"pricing_power","r":"management","s":"Peter D. Arvan","x":"As mentioned in the previous call, we expected gross profit margins to increase slightly as we sold down the remaining pre-price inventory -- pre-price increase inventory purchased late last year.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/18/pool-corp-pool-q2-2019-earnings-call-transcript.aspx"},{"c":"POOL 2019 Q2","e":"pool","d":"2019-07-18","l":"pricing_power","r":"management","s":"Mark W. Joslin","x":"As I've said, we had expected a meaningful Q1 margin gain due to the carryover pre-price increase inventories from 2018 and then our margin gain should moderate substantially in Q2 and Q3 and become a headwind in Q4, based on our strong Q4, 2018 results.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/18/pool-corp-pool-q2-2019-earnings-call-transcript.aspx"},{"c":"POOL 2019 Q3","e":"pool","d":"2019-10-17","l":"pricing_power","r":"management","s":"Mark W. Joslin","x":"As most of you are aware, we've been carrying higher inventory levels than normal since our pre-price increase purchases last year, but are now down to appropriate levels to support our normal business needs just as we begin to gear up for seasonal early buy purchases from our vendors.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/17/pool-corp-pool-q3-2019-earnings-call-transcript.aspx"},{"c":"POOL 2019 Q3","e":"pool","d":"2019-10-17","l":"guidance","r":"management","s":"Peter D. Arvan","x":"With 2.5 months left in the year, we are narrowing and raising our guidance for 2019 from $6.09 to $6.34 to the new range of $6.20 to $6.40 per share.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/17/pool-corp-pool-q3-2019-earnings-call-transcript.aspx"},{"c":"POOL 2019 Q4","e":"pool","d":"2020-02-13","l":"pricing_power","r":"management","s":"Peter D. Arvan","x":"Although the numbers are still preliminary, this year, assuming a normal year and without having the benefit of price increases on equipment, I think our margin profile on that returns back to normal.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/13/pool-corp-pool-q4-2019-earnings-call-transcript.aspx"},{"c":"POOL 2020 Q1","e":"pool","d":"2020-04-23","l":"pricing_power","r":"management","s":"Peter D. Arvan","x":"Second quarter we have a headwind, as I think, I mentioned coming into the year, we had 30 basis points of gross margin improvement in the second quarter of 2019, largely driven by some continuing pre-inventory purchases, pre-price increase purchases in 2018 that we were still selling in 2019.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/23/pool-corp-pool-q1-2020-earnings-call-transcript.aspx"},{"c":"POOL 2020 Q1","e":"pool","d":"2020-04-23","l":"pricing_power","r":"management","s":"Mark W. Joslin","x":"We did not see as you would expect a lot of price increases during the recession.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/23/pool-corp-pool-q1-2020-earnings-call-transcript.aspx"},{"c":"POOL 2020 Q1","e":"pool","d":"2020-04-23","l":"cost_cuts","r":"management","s":"Mark W. Joslin","x":"In total, we see a potential cost reduction in the range of $10 million in this area in 2019 -- in 2020, compared to 2019.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/23/pool-corp-pool-q1-2020-earnings-call-transcript.aspx"},{"c":"POOL 2020 Q1","e":"pool","d":"2020-04-23","l":"cost_cuts","r":"management","s":"Mark W. Joslin","x":"In addition to this, one of the first steps we took was to put a hiring freeze in place.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/23/pool-corp-pool-q1-2020-earnings-call-transcript.aspx"},{"c":"POOL 2020 Q3","e":"pool","d":"2020-10-22","l":"pricing_power","r":"analyst","s":"Ryan Merkel","x":"I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/22/pool-corp-pool-q3-2020-earnings-call-transcript/"},{"c":"POOL 2020 Q3","e":"pool","d":"2020-10-22","l":"pricing_power","r":"analyst","s":"Stephen Volkmann","x":"And then, Mark, I think you said you're going to have a little bit higher price increase than normal.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/22/pool-corp-pool-q3-2020-earnings-call-transcript/"},{"c":"POOL 2020 Q4","e":"pool","d":"2021-02-11","l":"pricing_power","r":"management","s":"Jeffrey Stevenson","x":"I'm just wondering if you got any price realization in the back half of the year.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/pool-corp-pool-q4-2020-earnings-call-transcript/"},{"c":"POOL 2020 Q4","e":"pool","d":"2021-02-11","l":"pricing_power","r":"management","s":"Peter D. Arvan","x":"So there was some price realization in the back half of the year, but not much, because by the time the supplies were drawn down, there wasn't much in terms of demand left for the season.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/pool-corp-pool-q4-2020-earnings-call-transcript/"},{"c":"POOL 2021 Q1","e":"pool","d":"2021-04-22","l":"pricing_power","r":"management","s":"Peter D. Arvan","x":"As it relates to nondiscretionary products such as chemicals, inflation is simply passed through again with no real effect on demand.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/22/pool-corp-pool-q1-2021-earnings-call-transcript/"},{"c":"POOL 2021 Q1","e":"pool","d":"2021-04-22","l":"pricing_power","r":"management","s":"Mark W. Joslin","x":"Second, we've seen an acceleration in inflationary price increases announced by our vendors over the last couple of months, roughly doubling the inflationary impact we expect to see for the year from our earlier guidance of 2% to 3% on average across our product portfolio to 4% to 5% now.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/22/pool-corp-pool-q1-2021-earnings-call-transcript/"},{"c":"POOL 2021 Q1","e":"pool","d":"2021-04-22","l":"guidance","r":"management","s":"Peter D. Arvan","x":"As a result, we are raising our guidance for the year to $11.85 to $12.60 earnings per share from the previous guidance of $9.12 to $9.62.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/22/pool-corp-pool-q1-2021-earnings-call-transcript/"},{"c":"POOL 2021 Q1","e":"pool","d":"2021-04-22","l":"guidance","r":"management","s":"Mark W. Joslin","x":"So some of the price increases that we've seen, as we said, we raised our guidance just in the last two months.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/22/pool-corp-pool-q1-2021-earnings-call-transcript/"},{"c":"POOL 2021 Q2","e":"pool","d":"2021-07-22","l":"pricing_power","r":"management","s":"Peter Arvan","x":"This has had no meaningful impact on demand and has passed through the channel as is typically the case.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/22/pool-corporation-pool-q2-2021-earnings-call-transc/"},{"c":"POOL 2021 Q2","e":"pool","d":"2021-07-22","l":"pricing_power","r":"management","s":"Melanie Hart","x":"First, we saw benefits from our supply chain initiatives, which included a focus on accelerating purchases ahead of vendor price increases to limit stock-outs where possible in today's tight supply conditions.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/22/pool-corporation-pool-q2-2021-earnings-call-transc/"},{"c":"POOL 2021 Q3","e":"pool","d":"2021-10-21","l":"pricing_power","r":"analyst","s":"Ryan James Merkel","x":"I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/21/pool-corporation-pool-q3-2021-earnings-call-transc/"},{"c":"POOL 2021 Q3","e":"pool","d":"2021-10-21","l":"cost_cuts","r":"management","s":"Peter D. Arvan","x":"I think Melanie mentioned that our incentive compensation, which a year ago we were telling you, well, could be the source of some cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/21/pool-corporation-pool-q3-2021-earnings-call-transc/"},{"c":"POOL 2024 Q3","e":"pool","d":"2024-10-24","l":"pricing_power","r":"analyst","s":"Peter Arvan","x":"As we have mentioned, aftermarket equipment installations are roughly four to five times that of new construction and combined with price increases that have been realized in the market, these products are holding up well even with lower discretionary spending.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/13/pool-pool-q3-2024-earnings-call-transcript/"},{"c":"POOL 2024 Q3","e":"pool","d":"2024-10-24","l":"pricing_power","r":"analyst","s":"Ryan Merkel","x":"I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/13/pool-pool-q3-2024-earnings-call-transcript/"},{"c":"POOL 2025 Q2","e":"pool","d":"2025-07-24","l":"tariffs","r":"management","s":"Peter Arvan","x":"Tariff-driven price increases had a modest impact on the quarter due to timing and was somewhat offset by deflation in our commodity categories.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/24/pool-corp-pool-q2-2025-earnings-call-transcript/"},{"c":"POOL 2025 Q2","e":"pool","d":"2025-07-24","l":"tariffs","r":"management","s":"Melanie Hart","x":"Both the traditional pool season price increases implemented earlier in the year and the subsequent late April, early May price increase enacted by certain vendors to react to higher expected tariffs have passed through and have been accepted into the marketplace.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/24/pool-corp-pool-q2-2025-earnings-call-transcript/"},{"c":"POOL 2025 Q2","e":"pool","d":"2025-07-24","l":"pricing_power","r":"management","s":"Peter Arvan","x":"Equipment sales, which include cleaners, increased 1% during the quarter, reflecting modest price realization and stable replacement volumes mitigating the year-over-year decrease in new construction units.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/24/pool-corp-pool-q2-2025-earnings-call-transcript/"},{"c":"POOL 2025 Q2","e":"pool","d":"2025-07-24","l":"pricing_power","r":"management","s":"Peter Arvan","x":"For context, the most recent price increase went into effect late in the quarter.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/24/pool-corp-pool-q2-2025-earnings-call-transcript/"},{"c":"POOL 2025 Q3","e":"pool","d":"2025-10-23","l":"tariffs","r":"management","s":"Peter Arvan","x":"Looking at the macroeconomic environment, uncertainty around tariffs and elevated borrowing rates continue to weigh on consumer sentiment and limit discretionary demand, particularly for pool projects that require financing.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/23/pool-pool-q3-2025-earnings-call-transcript/"},{"c":"POOL 2025 Q3","e":"pool","d":"2025-10-23","l":"tariffs","r":"analyst","s":"Jeff Hammond","x":"Seems like they're putting kind of normal plus two to three points with tariff.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/23/pool-pool-q3-2025-earnings-call-transcript/"},{"c":"POOL 2025 Q3","e":"pool","d":"2025-10-23","l":"pricing_power","r":"management","s":"Peter Arvan","x":"Mid-season price increases created a slight lift on top line but were diluted some by chemical deflation.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/23/pool-pool-q3-2025-earnings-call-transcript/"},{"c":"POOL 2025 Q3","e":"pool","d":"2025-10-23","l":"pricing_power","r":"management","s":"Melanie Hart","x":"During the quarter, we realized a 3% benefit from pricing, reflecting the full quarter impact of price realization on the mid-season vendor price increases implemented in April and May.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/23/pool-pool-q3-2025-earnings-call-transcript/"},{"c":"POOL 2026 Q1","e":"pool","d":"2026-04-23","l":"tariffs","r":"management","s":"Melanie M. Hart","x":"In the first quarter, we had that incremental 1% that was really the tariff price increases that we saw last year.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/pool-pool-q1-2026-earnings-call-transcript/"},{"c":"POOL 2026 Q1","e":"pool","d":"2026-04-23","l":"tariffs","r":"analyst","s":"Scott Schneeberger","x":"Melanie, you discussed that we are going to be lapping the tariff pricing that started in April.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/pool-pool-q1-2026-earnings-call-transcript/"},{"c":"POOL 2026 Q1","e":"pool","d":"2026-04-23","l":"pricing_power","r":"management","s":"Melanie M. Hart","x":"This reflects an estimated 1% to 2% full-year price realization from current-year increases supplemented by an approximately 1% incremental benefit from mid-season pricing actions that were implemented in April of the prior year.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/pool-pool-q1-2026-earnings-call-transcript/"},{"c":"POOL 2026 Q1","e":"pool","d":"2026-04-23","l":"pricing_power","r":"management","s":"Melanie M. Hart","x":"Our current inventory includes stocking for new locations and acquisitions added to the network, new product introductions resulting in a broader product range, and cost inflation relative to the same period last year, with some opportunistic purchases made ahead of current season price increases.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/pool-pool-q1-2026-earnings-call-transcript/"},{"c":"POOL 2026 Q3","e":"pool","d":"2026-10-22","