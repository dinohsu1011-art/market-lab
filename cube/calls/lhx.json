1_sector":-0.03,"r5_sector":-0.1006,"r20_sector":-0.0434,"etf":"XLI"}},{"id":"LHX 2026 Q3","t":"LHX","d":"2026-10-29","time":"bmo","w":8980,"n":63,"url":"","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[1,1,0,1.13],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[1,0,1,1.13],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}]},"move":{"r1":0.0684,"r5":-0.0033,"r1_spy":0.0722,"r5_spy":0.0038,"r1_sector":0.0586,"r5_sector":-0.0091,"etf":"XLI"}}],"quotes":[{"c":"LHX 2018 Q4","e":"lhx","d":"2019-01-29","l":"cost_cuts","r":"management","s":"Rahul Ghai","x":"…next to it and we have seen some of that kind of coming to this year but as we continue down the path of cost reduction, the business is 75%, 80% cost that is fixed price, so as we continue to take cost out of that in that business they should be margin upside there as well in the outer years.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2018 Q4","e":"lhx","d":"2019-01-29","l":"guidance","r":"management","s":"Bill Brown","x":"And today we're raising guidance for the year on revenue, margin, earnings per share, and free cash flow.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2018 Q4","e":"lhx","d":"2019-01-29","l":"guidance","r":"management","s":"Bill Brown","x":"…a continuation of a very, very strong ramp in the DoD business, last year, if you remember, we increased our guidance through the year, we started off in the high teens 20%, we ended in the mid-30s, we're seeing a similar trajectory this year but a shift from readiness to modernization, the…","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2019 Q1","e":"lhx","d":"2019-05-01","l":"guidance","r":"management","s":"William Brown","x":"…strong year-to-date performance, improving business outlook and growing backlog, we're once again increasing guidance across all metrics with company revenue now expected to be up about 9% versus previous guidance of up 8% to 8.5%, earnings per share of $8.15 and free cash flow of approximately…","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2019 Q1","e":"lhx","d":"2019-05-01","l":"guidance","r":"management","s":"William Brown","x":"We've raised our guidance now 3x this year.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2019 Q2","e":"lhx","d":"2019-07-31","l":"cost_cuts","r":"management","s":"Jay Malave","x":"As I mentioned there will be some continued costs related to the integration, restructuring type level of costs and those type of items, but beyond that I don’t expect there to be other significant items that will repeat going forward.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2020 Q1","e":"lhx","d":"2020-05-05","l":"pricing_power","r":"management","s":"William Brown","x":"The DoD has moved quickly to adjust the terms of progress payments to drive cash into the industrial base which we have passed through to our small suppliers and started a dialogue with industry on how to size and cover COVID-19 related costs.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2020 Q1","e":"lhx","d":"2020-05-05","l":"cost_cuts","r":"management","s":"Jay Malave","x":"For this year our cash flow is bolstered by accelerated synergies, federal stimulus and cost takeout, which will offset the reduced revenues discussed earlier.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2020 Q1","e":"lhx","d":"2020-05-05","l":"guidance","r":"management","s":"William Brown","x":"Despite the solid start to the year, we're trimming our outlook for revenue and earnings per share due principally to our commercial aerospace exposure and our recently completed divestiture plus some anticipated softness in international and Public Safety and potential risks from supply chain…","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2020 Q1","e":"lhx","d":"2020-05-05","l":"guidance","r":"management","s":"William Brown","x":"We just see all those items contributing to more of a timing issues, so we reduced the outlook there if that helps.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2020 Q2","e":"lhx","d":"2020-07-31","l":"cost_cuts","r":"management","s":"Bill Brown","x":"As we get beyond the calendar 2022 time period and integration starts to wind down in terms of that focus process the drive to achieving cost savings will continue.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2020 Q2","e":"lhx","d":"2020-07-31","l":"guidance","r":"management","s":"Jay Malave","x":"We've increased our outlook to 17.5% plus with the plus indicating potential upside of 10 to 20 basis points versus the prior guidance of 17.5%.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2020 Q2","e":"lhx","d":"2020-07-31","l":"guidance","r":"management","s":"Jay Malave","x":"We've maintained our guidance for all line items but for margins at IMS, where we see likely upside.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2020 Q3","e":"lhx","d":"2020-10-30","l":"cost_cuts","r":"management","s":"Bill Brown","x":"We continue to drive cost out drive operational excellence, improve quality and meet our program objectives.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2020 Q3","e":"lhx","d":"2020-10-30","l":"guidance","r":"management","s":"Bill Brown","x":"Their efforts have led to another strong quarter and put us in a position to raise our 2020 guidance.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2021 Q1","e":"lhx","d":"2021-04-30","l":"cost_cuts","r":"analyst","s":"Kristine Liwag","x":"And also on cost cutting, how do you know you're not cutting too much that it ends up hampering performance in the future?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2021 Q2","e":"lhx","d":"2021-08-03","l":"cost_cuts","r":"management","s":"Jay Malave","x":"The good thing about that is the CMS track record being able to take cost out, drive the margins better over time.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2021 Q2","e":"lhx","d":"2021-08-03","l":"guidance","r":"management","s":"Jay Malave","x":"Turning to margins, we have raised our outlook to approximately 18.5%, a 25 basis point increase to the top end of the previous range due to our strong performance to-date and confidence in our ability to execute on cost synergies, e3 and program deliverables.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2021 Q2","e":"lhx","d":"2021-08-03","l":"guidance","r":"management","s":"Jay Malave","x":"On EPS, we're raising our full year guide to a range of $12.80 to $13, with the midpoint now toward the upper end of our previous range and reflecting 11% growth from 2020, delivering on our double digit commitment in spite of dilution from divestitures.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2021 Q3","e":"lhx","d":"2021-10-29","l":"cost_cuts","r":"management","s":"Chris Kubasik","x":"Through streamlining and simplifying our manufacturing processes, be it from a redesign of a factory's layout or integrating automation tools, we can shorten cycle times, increase labor efficiency and continue to drive out costs.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2021 Q3","e":"lhx","d":"2021-10-29","l":"guidance","r":"management","s":"Jay Malave","x":"Turning to margins, we've raised our outlook to 18.75% from 18.5% due to performance to-date, E3 progress, and favorable mix from award timing.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2021 Q4","e":"lhx","d":"2022-01-31","l":"cost_cuts","r":"analyst","s":"Richard Safran","x":"I was curious as to how much runway you think you have left with respect to A3 cost savings?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2022 Q1","e":"lhx","d":"2022-04-29","l":"guidance","r":"management","s":"Chris Kubasik","x":"And for the full year, we're reiterating our guide across the board as we continue to advance our strategy in a dynamic environment, whether it's from the pandemic or the global threats in Eastern Europe and elsewhere.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2022 Q2","e":"lhx","d":"2022-07-29","l":"pricing_power","r":"analyst","s":"Michael Ciarmoli","x":"Maybe you can walk us through how long it takes to flow through price increases on raw materials or higher billing rates?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2022 Q2","e":"lhx","d":"2022-07-29","l":"pricing_power","r":"analyst","s":"Michael Ciarmoli","x":"And how we should maybe think about the margin evolution as you can pass through some of those prices?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2022 Q2","e":"lhx","d":"2022-07-29","l":"guidance","r":"management","s":"Christopher Kubasik","x":"In addition, while we're reiterating our guide, we're now pointing to the low end of the range across the board.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2022 Q3","e":"lhx","d":"2022-10-28","l":"pricing_power","r":"management","s":"Michelle Turner","x":"And so teams are doing a good job in terms of as we're reacting to the higher input costs, ensuring that we're getting priced where the market will accept those price increases.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2022 Q3","e":"lhx","d":"2022-10-28","l":"guidance","r":"management","s":"Michelle Turner","x":"But just to give a little bit more color in terms of margins, how it's playing out in 2022 and how we're thinking about 2023, to Chris' opening comments, we did reduce our guide to 15.5 from an overall segment perspective, really driven by two things.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2022 Q4","e":"lhx","d":"2023-01-27","l":"cost_cuts","r":"analyst","s":"Doug Harned","x":"Second, are there some areas of cost reduction there beyond just corporate costs?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2022 Q4","e":"lhx","d":"2023-01-27","l":"cost_cuts","r":"analyst","s":"Michael Ciarmoli","x":"Maybe just to go back to Aerojet and thinking about these cost synergies, I know they had previously executed on a $240 million cost takeout program.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2023 Q1","e":"lhx","d":"2023-04-28","l":"cost_cuts","r":"management","s":"Chris Kubasik","x":"…and space, air, land, sea and cyber domains, significant revenue synergies, significant cost synergies over 650 million of cost savings that we shared with our shareholders and the DOD and resulted in a stronger company, in this case, providing more competition within the defense industrial base.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2023 Q1","e":"lhx","d":"2023-04-28","l":"guidance","r":"management","s":"Chris Kubasik","x":"…results are differentiated winning strategy and the overall business environment led us to reaffirm our 2023 guidance with the recognition that record orders and strong revenue growth to date could support a bias towards the higher end of our revenue guidance range should these trends…","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2023 Q3","e":"lhx","d":"2023-10-27","l":"cost_cuts","r":"management","s":"Chris Kubasik","x":"I'll say from an integration perspective, all was going well, we're clearly on track to get the 40 million to 50 million of cost savings that we talked about previously.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2023 Q3","e":"lhx","d":"2023-10-27","l":"cost_cuts","r":"management","s":"Michelle Turner","x":"And so they focused on streamlining our overall workflows, and we've actually reduced double digits the number of communications that we're distributing as a result.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2023 Q4","e":"lhx","d":"2024-01-26","l":"cost_cuts","r":"management","s":"Christopher Kubasik","x":"As highlighted at our Investor Day, we are executing on our LHX NeXt initiative aimed at delivering $1 billion in gross cost savings over the next three years.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2023 Q4","e":"lhx","d":"2024-01-26","l":"cost_cuts","r":"management","s":"Kenneth Bedingfield","x":"Consolidated segment operating margin is anticipated to be approximately 15% from efficiencies gained with increased volume, operational improvements and LHX NeXt cost savings.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q1","e":"lhx","d":"2024-04-26","l":"cost_cuts","r":"management","s":"Kenneth Bedingfield","x":"And then from a cash perspective, we're primarily just adjusting out the cash severance costs related to the program.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q2","e":"lhx","d":"2024-07-26","l":"cost_cuts","r":"management","s":"Kenneth L. Bedingfield","x":"Operating margins continued to be strong, expanding to 15.6%, up 80 basis points, reflecting improved operational and program performance across all segments with LHX NeXt cost savings contributing.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q2","e":"lhx","d":"2024-07-26","l":"cost_cuts","r":"management","s":"Kenneth L. Bedingfield","x":"This was partially offset by LHX NeXt cost savings and the favorable net one-time impact of legal settlements.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q2","e":"lhx","d":"2024-07-26","l":"guidance","r":"management","s":"Christopher E. Kubasik","x":"Our first half performance provides confidence for the remainder of the year, leading us to increase our guidance, which Ken will discuss in more detail.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q2","e":"lhx","d":"2024-07-26","l":"guidance","r":"management","s":"Kenneth L. Bedingfield","x":"Given our strong first half performance, we are increasing guidance for revenue, margin rate, and EPS, which we've outlined in our earnings release and presentation.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q3","e":"lhx","d":"2024-10-25","l":"cost_cuts","r":"management","s":"Kenneth Bedingfield","x":"We're on track to exceed our 2024 run rate cost savings target of $400 million, and now expect to achieve at least $600 million by the end of the year.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q3","e":"lhx","d":"2024-10-25","l":"cost_cuts","r":"management","s":"Kenneth Bedingfield","x":"We are also confident in our ability to reach our $1 billion cost savings target a year early, and our pipeline provides opportunity for additional cost savings, to exceed the $1 billion target.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q3","e":"lhx","d":"2024-10-25","l":"guidance","r":"management","s":"Kenneth Bedingfield","x":"Given our strong performance so far this year, we are increasing guidance again.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q4","e":"lhx","d":"2025-01-30","l":"cost_cuts","r":"management","s":"Christopher Kubasik","x":"She will report directly to me as we continue to drive cost savings while accelerating enterprise-wide transformation.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2024 Q4","e":"lhx","d":"2025-01-30","l":"cost_cuts","r":"management","s":"Kenneth Bedingfield","x":"Segment operating margin was 15.4%, reflecting continued cost savings and strong execution.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2025 Q1","e":"lhx","d":"2025-04-24","l":"tariffs","r":"management","s":"Kenneth L. Bedingfield","x":"Although we are closely monitoring the changing trade landscape, have put various mitigation strategies in place, we do not anticipate tariffs to have a meaningful impact on our financial results.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2025 Q1","e":"lhx","d":"2025-04-24","l":"cost_cuts","r":"management","s":"Kenneth L. Bedingfield","x":"Operating margin increased 50 bps to 25.5% reflecting favorable high-margin international mix for resilient communications as well as LHX NEXT cost savings across the segment.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2025 Q1","e":"lhx","d":"2025-04-24","l":"cost_cuts","r":"management","s":"Kenneth L. Bedingfield","x":"Operating margin increased due to strong program performance, increased volume of higher-margin airborne electro-optical sensors, and LHX NEXT cost savings.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2025 Q1","e":"lhx","d":"2025-04-24","l":"guidance","r":"management","s":"Kenneth L. Bedingfield","x":"We are maintaining our guidance for space and airborne systems, with revenue expected in the range of $6.9 to $7.1 billion reflecting government fiscal year 2025 budget constraints in the space sector that we expect to abate by 2026.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"LHX 2025 Q2","e":"lhx","d":"2025-07-24","l":"pricing_power","r":"management","s":"Christopher E. Kubasik","x":"We'll pass it on to the team.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/24/l3harris-lhx-q2-2025-earnings-call-transcript/"},{"c":"LHX 2025 Q2","e":"lhx","d":"2025-07-24","l":"cost_cuts","r":"management","s":"Kenneth L. Bedingfield","x":"Operating margin remained solid at 24.4%, reflecting higher domestic volumes and LHX mix-driven cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/24/l3harris-lhx-q2-2025-earnings-call-transcript/"},{"c":"LHX 2025 Q2","e":"lhx","d":"2025-07-24","l":"cost_cuts","r":"management","s":"Kenneth L. Bedingfield","x":"Operating margin was 12.3%, down 30 basis points due to an unfavorable mix, partially offset by LHX Next cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/24/l3harris-lhx-q2-2025-earnings-call-transcript/"},{"c":"LHX 2025 Q2","e":"lhx","d":"2025-07-24","l":"guidance","r":"management","s":"Kenneth L. Bedingfield","x":"Our increased guidance reflects our strong first-half performance and improved outlook for the rest of the year.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/24/l3harris-lhx-q2-2025-earnings-call-transcript/"},{"c":"LHX 2025 Q2","e":"lhx","d":"2025-07-24","l":"guidance","r":"management","s":"Kenneth L. Bedingfield","x":"And we are reaffirming guidance for CS and AR.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/24/l3harris-lhx-q2-2025-earnings-call-transcript/"},{"c":"LHX 2025 Q4","e":"lhx","d":"2026-01-29","l":"cost_cuts","r":"management","s":"Christopher E. Kubasik","x":"That was a top-down approach, as you know, for two years to take out significant over, you know, billions of dollars of cost to streamline the business.","url":"https://www.fool.com/earnings/call-transcripts/2026/01/29/l3harris-lhx-q4-2025-earnings-call-transcript/"},{"c":"LHX 2025 Q4","e":"lhx","d":"2026-01-29","l":"cost_cuts","r":"management","s":"Christopher E. Kubasik","x":"So the concepts and the philosophy of continuous improvement efficiency, cost savings will continue.","url":"https://www.fool.com/earnings/call-transcripts/2026/01/29/l3harris-lhx-q4-2025-earnings-call-transcript/"},{"c":"LHX 2026 Q1","e":"lhx","d":"2026-04-30","l":"ai_spend","r":"management","s":"Christopher E. Kubasik","x":"Revenue per employee has increased by almost 25% over the past couple of years, driven by productivity improvements and aided by investments in technology, including AI.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/30/l3harris-lhx-q1-2026-earnings-transcript/"},{"c":"LHX 2026 Q1","e":"lhx","d":"2026-04-30","l":"cost_cuts","r":"management","s":"Christopher E. Kubasik","x":"Our focus on transformation and being agile meant reducing unnecessary cost and streamlining our operations.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/30/l3harris-lhx-q1-2026-earnings-transcript/"}],"trends":{"theater":[[36,1,9575,0,0,0,7488,1629],[37,1,10480,0,0,0,8542,1559],[38,1,12167,0,0,0,9276,2354],[41,1,9683,0,0,0,7735,1524],[42,1,9271,0,0,0,7363,1463],[43,1,9565,0,0,0,7499,1533],[44,1,9084,0,0,0,7147,1388],[45,1,9212,0,0,0,6891,1650],[46,1,9792,0,0,0,8046,1223],[47,1,9717,0,0,0,8456,841],[48,1,9009,0,0,0,7662,1017],[49,1,7104,0,0,0,5593,1150],[50,1,6054,0,0,0,4589,1120],[51,1,7488,0,0,0,5998,1069],[52,1,7072,0,0,0,5545,1111],[53,1,6557,0,0,0,5130,1033],[54,1,5770,0,0,0,4501,961],[55,1,6978,0,0,0,5883,774],[56,1,8025,0,0,0,6506,1083],[57,1,2827,0,0,0,1502,1005],[58,1,8470,0,0,0,6435,1538],[59,1,8924,0,0,0,7297,1218],[60,1,8830,0,0,0,7509,923],[61,1,8533,0,0,0,6899,1117],[62,1,8620,0,0,0,7059,1005],[64,1,7962,0,0,0,6293,1229],[65,1,7751,0,0,0,6436,774],[67,1,8980,0,0,0,6931,1406]],"cinema":[[36,1,9575,0,0,0,7488,1629],[37,1,10480,0,0,0,8542