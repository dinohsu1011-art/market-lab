x":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[1,1,0,1.9],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[1,1,0,1.9],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}]},"move":{"r1":-0.0714,"r5":-0.023,"r1_spy":-0.0537,"r5_spy":0.0243}}],"quotes":[{"c":"PIPR 2020 Q1","e":"pipr","d":"2020-05-01","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"Sandler was the most active financial advisor in recapitalizing banks and restructuring their balance sheets.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/01/piper-sandler-companies-pipr-q1-2020-earnings-call.aspx"},{"c":"PIPR 2020 Q1","e":"pipr","d":"2020-05-01","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"…to decline, reflecting the overall market environment, we are starting to see some activity in restructuring and balance sheet advisory, and we anticipate a continued ramp in corporate equity and debt new issues. However, we don't expect this ramp in activity will fully offset the impact to…","url":"https://www.fool.com/earnings/call-transcripts/2020/05/01/piper-sandler-companies-pipr-q1-2020-earnings-call.aspx"},{"c":"PIPR 2020 Q2","e":"pipr","d":"2020-07-31","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"Relative to products, we're underrepresented in certain parts of restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/31/piper-sandler-companies-pipr-q2-2020-earnings-call.aspx"},{"c":"PIPR 2020 Q2","e":"pipr","d":"2020-07-31","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"A lot of recapitalizations, a lot of restructuring, a lot of rescue financings.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/31/piper-sandler-companies-pipr-q2-2020-earnings-call.aspx"},{"c":"PIPR 2020 Q4","e":"pipr","d":"2021-02-04","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"We acquired TRS Advisors on December 31st, a restructuring advisory firm, to broaden our investment banking product capabilities.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/04/piper-sandler-companies-pipr-q4-2020-earnings-call/"},{"c":"PIPR 2020 Q4","e":"pipr","d":"2021-02-04","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"In addition, on December 31st, we closed on the acquisition of TRS Advisors, an independent restructuring firm.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/04/piper-sandler-companies-pipr-q4-2020-earnings-call/"},{"c":"PIPR 2021 Q1","e":"pipr","d":"2021-04-30","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"Over the last six months, we have strengthened our presence by adding MDs in healthcare, technology, financial services and diversified industrials, as well as our growing restructuring capabilities.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/piper-sandler-companies-pipr-q1-2021-earnings-call/"},{"c":"PIPR 2021 Q1","e":"pipr","d":"2021-04-30","l":"cost_cuts","r":"management","s":"Tim Carter","x":"…our investment banking product capabilities by completing the acquisition of TRS Advisors, a restructuring advisory firm; paid an aggregate of $47 million to our shareholders through our quarterly and annual special dividends and repurchased approximately 249,000 shares, or $24 million of…","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/piper-sandler-companies-pipr-q1-2021-earnings-call/"},{"c":"PIPR 2021 Q2","e":"pipr","d":"2021-07-30","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"And our restructuring business was further enhanced with the acquisition of TRS Advisors.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/31/piper-sandler-companies-pipr-q2-2021-earnings-call/"},{"c":"PIPR 2021 Q2","e":"pipr","d":"2021-07-30","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"During the quarter M&A and restructuring activity generated 53% of total corporate investment banking revenues, equity financings contributed 24% and debt financing and capital advisory engagements produce 23% of revenue.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/31/piper-sandler-companies-pipr-q2-2021-earnings-call/"},{"c":"PIPR 2021 Q3","e":"pipr","d":"2021-10-29","l":"cost_cuts","r":"management","s":"Chad R. Abraham","x":"During the third quarter, we completed 68 M&A and restructuring transactions and 31 capital advisory deals.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/29/piper-sandler-companies-pipr-q3-2021-earnings-call/"},{"c":"PIPR 2021 Q3","e":"pipr","d":"2021-10-29","l":"cost_cuts","r":"management","s":"Chad R. Abraham","x":"In addition, we have increased our restructuring capabilities, we have continued to enhance our debt capital markets capabilities and we have expanded our financial sponsors coverage team during this time period.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/29/piper-sandler-companies-pipr-q3-2021-earnings-call/"},{"c":"PIPR 2025 Q3","e":"pipr","d":"2025-10-31","l":"tariffs","r":"management","s":"Chad R. Abraham","x":"Certain parts of services, certain parts of commercial and residential services, obviously, places where tariffs don't matter.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/02/piper-sandler-pipr-q3-2025-earnings-transcript/"},{"c":"PIPR 2025 Q3","e":"pipr","d":"2025-10-31","l":"cost_cuts","r":"management","s":"Chad R. Abraham","x":"In recent years, we have made substantial investments in the advisory capabilities, which include debt capital markets advisory, private capital advisory, and restructuring to expand client offerings and increase market share, especially with private equity.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/02/piper-sandler-pipr-q3-2025-earnings-transcript/"},{"c":"PIPR 2025 Q3","e":"pipr","d":"2025-10-31","l":"cost_cuts","r":"management","s":"Debbra Lynn Schoneman","x":"For the record, Devin, we'd love a significant M&A fee, and we want to do the restructuring on everything.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/02/piper-sandler-pipr-q3-2025-earnings-transcript/"},{"c":"PIPR 2025 Q4","e":"pipr","d":"2026-02-06","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"The most meaningful components of our non-M&A advisory revenues are debt capital markets advisory, private capital advisory, and restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/06/piper-sandler-pipr-q4-2025-earnings-transcript/"},{"c":"PIPR 2025 Q4","e":"pipr","d":"2026-02-06","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"I would say right now relative to the product side, we've added quite a bit in terms of the last five years, restructuring, private capital advisory, obviously longer than that ten plus years ago, we added debt capital advisory.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/06/piper-sandler-pipr-q4-2025-earnings-transcript/"},{"c":"PIPR 2026 Q1","e":"pipr","d":"2026-05-01","l":"cost_cuts","r":"management","s":"Debbra Schoneman","x":"We were able to mitigate this reduction by completing balance sheet restructuring trades in conjunction with the closing of bank M&A transactions.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/01/piper-sandler-pipr-q1-2026-earnings-transcript/"},{"c":"PIPR 2026 Q1","e":"pipr","d":"2026-05-01","l":"cost_cuts","r":"management","s":"Chad Abraham","x":"We had a good Q1 in non-M&A. Obviously, we've got the major pieces of that DCM advisory, restructuring and then private capital advisory.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/01/piper-sandler-pipr-q1-2026-earnings-transcript/"},{"c":"PIPR 2026 Q3","e":"pipr","d":"2026-10-30","l":"ai_spend","r":"management","s":"Chad Abraham","x":"Increased demand for energy to power the growth in AI data centers helped drive record quarterly revenues for our diversified energy group.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/31/piper-sandler-pipr-q3-2026-earnings-call-transcript/"},{"c":"PIPR 2026 Q3","e":"pipr","d":"2026-10-30","l":"cost_cuts","r":"management","s":"Debbra Schoneman","x":"Again, we saw an increase in what I'll call either restructuring related to M&A or balance sheet optimization.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/31/piper-sandler-pipr-q3-2026-earnings-call-transcript/"}],"trends":{"theater":[[41,1,6731,0,0,0,5338,1024],[42,1,5919,0,0,0,4409,1127],[43,1,7191,0,0,0,5547,1239],[44,1,6742,0,0,0,5267,1036],[45,1,5475,0,0,0,4053,1010],[46,1,5496,0,0,0,4228,854],[47,1,6865,0,0,0,5811,567],[63,1,4733,0,0,0,3755,749],[64,1,5882,0,0,0,4638,966],[65,1,4049,0,0,0,3222,671],[67,1,5366,0,0,0,3901,1224]],"cinema":[[41,1,6731,0,0,0,5338,1024],[42,1,5919,0,0,0,4409,1127],[43,1,7191,0,0,0,5547,1239],[44,1,6742,0,0,0,5267,1036],[45,1,5475,0,0,0,4053,1010],[46,1,5496,0,0,0,4228,854],[47,1,6865,0,0,0,5811,567],[63,1,4733,0,0,0,3755,749],[64,1,5882,0,0,0,4638,966],[65,1,4049,0,0,0,3222,671],[67,1,5366,0,0,0,3901,1224]],"imax":[[41,1,6731,0,0,0,5338,1024],[42,1,5919,0,0,0,4409,1127],[43,1,7191,0,0,0,5547,1239],[44,1,6742,0,0,0,5267,1036],[45,1,5475,0,0,0,4053,1010],[46,1,5496,0,0,0,4228,854],[47,1,6865,0,0,0,5811,567],[63,1,4733,0,0,0,3755,749],[64,1,5882,0,0,0,4638,966],[65,1,4049,0,0,0,3222,671],[67,1,5366,0,0,0,3901,1224]],"streaming":[[41,1,6731,0,0,0,5338,1024],[42,1,5919,0,0,0,4409,1127],[43,1,7191,0,0,0,5547,1239],[44,1,6742,0,0,0,5267,1036],[45,1,5475,0,0,0,4053,1010],[46,1,5496,0,0,0,4228,854],[47,1,6865,0,0,0,5811,567],[63,1,4733,0,0,0,3755,749],[64,1,5882,0,0,0,4638,966],[65,1,4049,0,0,0,3222,671],[67,1,5366,0,0,0,3901,1224]],"dtc":[[41,1,6731,0,0,0,5338,1024],[42,1,5919,0,0,0,4409,1127],[43,1,7191,0,0,0,5547,1239],[44,1,6742,0,0,0,5267,1036],[45,1,5475,0,0,0,4053,1010],[46,1,5496,0,0,0,4228,854],[47,1,6865,0,0,0,5811,567],[63,1,4733,0,0,0,3755,749],[64,1,5882,0,0,0,4638,966],[65,1,4049,0,0,0,3222,671],[67,1,5366,0,0,0,3901,1224]],"ai_spend":[[41,1,6731,0,0,0,5338,1024],[42,1,5919,0,0,0,4