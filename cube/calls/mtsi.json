0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[1,1,0,1.05],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}]},"move":{"r1":-0.1835,"r5":0.0718,"r1_spy":-0.1394,"r5_spy":0.0809}}],"quotes":[{"c":"MTSI 2019 Q1","e":"mtsi","d":"2019-02-05","l":"tariffs","r":"management","s":"John Croteau","x":"In the data center optical modular supply chain, which has traditionally had a heavy manufacturing presence in China, uncertainty around tariffs and trade restrictions has disrupted order patterns.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/05/macom-technology-solutions-holdings-mtsi-q1-2019-e.aspx"},{"c":"MTSI 2019 Q1","e":"mtsi","d":"2019-02-05","l":"tariffs","r":"management","s":"John Croteau","x":"To conclude, with today's macroeconomic backdrop of sluggish industrial and data center demand, tariffs, trade tensions, we're fortunate to be levered in multiple large and diverse growth opportunities underpinned by planned infrastructure buildouts that should help to drive catalyst for demand…","url":"https://www.fool.com/earnings/call-transcripts/2019/02/05/macom-technology-solutions-holdings-mtsi-q1-2019-e.aspx"},{"c":"MTSI 2019 Q3","e":"mtsi","d":"2019-08-01","l":"cost_cuts","r":"management","s":"Steve Daly","x":"On June 18, we announced a restructuring initiative, which included a 20% workforce reduction in the closing of seven design centers.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/02/macom-technology-solutions-holdings-mtsi-q3-2019-e.aspx"},{"c":"MTSI 2019 Q3","e":"mtsi","d":"2019-08-01","l":"cost_cuts","r":"management","s":"Steve Daly","x":"I want to highlight that while the restructuring plan is substantial in scope, we do not believe these actions will have a negative impact on our ability to achieve our growth objectives.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/02/macom-technology-solutions-holdings-mtsi-q3-2019-e.aspx"},{"c":"MTSI 2019 Q4","e":"mtsi","d":"2019-11-12","l":"cost_cuts","r":"management","s":"Steve Daly","x":"The company achieved non-GAAP profitability, primarily a result of the major restructuring we announced in June.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/13/macom-technology-solutions-holdings-mtsi-q4-2019-e.aspx"},{"c":"MTSI 2019 Q4","e":"mtsi","d":"2019-11-12","l":"cost_cuts","r":"management","s":"Steve Daly","x":"The new structure eliminates a layer of management, and we believe that it will streamline decision-making and improve accountability.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/13/macom-technology-solutions-holdings-mtsi-q4-2019-e.aspx"},{"c":"MTSI 2020 Q1","e":"mtsi","d":"2020-01-28","l":"cost_cuts","r":"management","s":"Steve Daly","x":"Simply put, we are increasing the efficiency of our R&D spending by streamlining the product launch process.","url":"https://www.fool.com/earnings/call-transcripts/2020/01/28/macom-technology-solutions-holdings-mtsi-q1-2020-e.aspx"},{"c":"MTSI 2020 Q1","e":"mtsi","d":"2020-01-28","l":"cost_cuts","r":"management","s":"Jack Kober","x":"We incurred $1.2 million of restructuring charges in the first fiscal quarter associated with the restructuring plan we announced back in June 2019.","url":"https://www.fool.com/earnings/call-transcripts/2020/01/28/macom-technology-solutions-holdings-mtsi-q1-2020-e.aspx"},{"c":"MTSI 2025 Q4","e":"mtsi","d":"2025-11-06","l":"ai_spend","r":"analyst","s":"Srini Pajjuri","x":"And then as a follow-up, I wanted to ask an AI question that is actually not about the data center market.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/06/macom-mtsi-q4-2025-earnings-call-transcript/"},{"c":"MTSI 2025 Q4","e":"mtsi","d":"2025-11-06","l":"cost_cuts","r":"management","s":"Stephen Daly","x":"We have noticed that each of those companies is closing down their fabs and I imagine over the course of time, there'll be some restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/06/macom-mtsi-q4-2025-earnings-call-transcript/"},{"c":"MTSI 2026 Q1","e":"mtsi","d":"2026-02-05","l":"ai_spend","r":"management","s":"Stephen Daly","x":"Not only in the traditional AI construct but also closer to the compute, we see opportunities to eliminate retimers in various compute connections.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/05/macom-mtsi-q1-2026-earnings-call-transcript/"},{"c":"MTSI 2026 Q2","e":"mtsi","d":"2026-05-07","l":"pricing_power","r":"analyst","s":"Sean O'Loughlin","x":"And so I don't want to over-index to these comments, but we've had some comments from public substrate suppliers about price increases and just maybe generally across your manufacturing footprint, is that something that you're either having to absorb and there's a timing mismatch?","url":"https://www.fool.com/earnings/call-transcripts/2026/05/07/macom-mtsi-q2-2026-earnings-transcript/"},{"c":"MTSI 2026 Q2","e":"mtsi","d":"2026-05-07","l":"pricing_power","r":"analyst","s":"Sean O'Loughlin","x":"Or is the pricing environment for a lot of these products such that you're able to sort of pass those through?","url":"https://www.fool.com/earnings/call-transcripts/2026/05/07/macom-mtsi-q2-2026-earnings-transcript/"},{"c":"MTSI 2026 Q3","e":"mtsi","d":"2026-08-06","l":"pricing_power","r":"analyst","s":"William Stein","x":"I'm hoping you could talk a little bit about input cost inflation, whether you're seeing this influence your need to spend on cost of goods and whether that's met with easy pass-through to customers or whether it's a bigger fight or any color around that, please?","url":"https://www.fool.com/earnings/call-transcripts/2026/08/13/macom-mtsi-q3-2026-earnings-call-transcript/"},{"c":"MTSI 2026 Q4","e":"mtsi","d":"2026-11-05","l":"ai_spend","r":"management","s":"Stephen Daly","x":"Our 3.2T chipset solution was designed to help our customers accelerate development of their next-generation optical interconnects for AI infrastructure across thin-film lithium niobate, silicon photonics and EML-based architectures.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/05/macom-mtsi-q4-2026-earnings-call-transcript/"}],"trends":{"theater":[[36,1,7292,0,0,0,6242,655],[37,1,9214,0,0,0,7980,863],[38,1,7670,0,0,0,6367,943],[39,1,6880,0,0,0,5375,1159],[40,1,6033,0,0,0,4997,750],[41,1,8892,0,0,0,7179,1298],[63,1,8832,0,0,0,4871,1215],[64,1,10374,0,0,0,8052,1859],[65,1,9702,0,0,0,7859,1531],[66,1,10335,0,0,0,8703,1271],[67,1,9660,0,0,0,7411,1863]],"cinema":[[36,1,7292,0,0,0,6242,655],[37,1,9214,0,0,0,7980,863],[38,1,7670,0,0,0,6367,943],[39,1,6880,0,0,0,5375,1159],[40,1,6033,0,0,0,4997,750],[41,1,8892,0,0,0,7179,1298],[63,1,8832,0,0,0,4871,1215],[64,1,10374,0,0,0,8052,1859],[65,1,9702,0,0,0,7859,1531],[66,1,10335,0,0,0,8703,1271],[67,1,9660,0,0,0,7411,1863]],"imax":[[36,1,7292,0,0,0,6242,655],[37,1,9214,0,0,0,7980,863],[38,1,7670,0,0,0,6367,943],[39,1,6880,0,0,0,5375,1159],[40,1,6033,0,0,0,4997,750],[41,1,8892,0,0,0,7179,1298],[63,1,8832,0,0,0,4871,1215],[64,1,10374,0,0,0,8052,1859],[65,1,9702,0,0,0,7859,1531],[66,1,10335,0,0,0,8703,1271],[67,1,9660,0,0,0,7411,1863]],"streaming":[[36,1,7292,0,0,0,6242,655],[37,1,9214,0,0,0,7980,863],[38,1,7670,0,0,0,6367,943],[39,1,6880,0,0,0,5375,1159],[40,1,6033,0,0,0,4997,750],[41,1,8892,0,0,0,7179,1298],[63,1,8832,0,0,0,4871,1215],[64,1,10374,0,0,0,8052,1859],[65,1,9702,0,0,0,7859,1531],[66,1,10335,0,0,0,8703,1271],[67,1,9660,0,0,0,7411,1863]],"dtc":[[36,1,7292,0,0,0,6242,655],[37,1,9214,0,0,0,7980,863],[38,1,7670,0,0,0,6367,943],[39,1,6880,0,0,0,5375,1159],[40,1,6033,0,0,0,4997,750],[41,1,8892,0,0,0,7179,1298],[63,1,8832,0,0,0,4871,1215],[64,1,10374,0,0,0,8052,1859],[65,1,9702,0,0,0,7859,1531],[66,1,10335,0,0,0,8703,1271],[67,1,9660,0,0,0,7411,1863]],"ai_spend":[[36,1,7292,0,0,0,6242,655],[37,1,9214,0,0,0,7980,863],[38,1,7670,0,0,0,6367,943],[39,1,6880,0,0,0,5375,1159],[40,1,6033,0,0,0,4997,750],[41,1,8892,0,0,0,7179,1298],[63,1,8832,1,0,1,48