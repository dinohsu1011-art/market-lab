:[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[3,3,0,2.68],"tariffs":[0,0,0,0.0],"pricing_power":[2,2,0,1.78],"cost_cuts":[0,0,0,0.0],"guidance":[1,1,0,0.89,{"raise":1,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.042,"r5":-0.0512,"r1_spy":-0.0302,"r5_spy":-0.0502}}],"quotes":[{"c":"WH 2018 Q3","e":"wh","d":"2018-10-30","l":"cost_cuts","r":"management","s":"Geoff Ballotti","x":"We're on track for our IT integration of La Quinta into our cloud-based property and central reservation systems, and we have identified increased distribution and cost savings opportunities associated with this migration.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/30/wyndham-hotels-resorts-inc-wh-q3-2018-earnings-con.aspx"},{"c":"WH 2018 Q3","e":"wh","d":"2018-10-30","l":"cost_cuts","r":"management","s":"David Wyshner","x":"As a reminder, virtually all the synergies we projected are cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/30/wyndham-hotels-resorts-inc-wh-q3-2018-earnings-con.aspx"},{"c":"WH 2018 Q4","e":"wh","d":"2019-02-13","l":"cost_cuts","r":"management","s":"David Wyshner","x":"As a reminder, virtually all of the synergies we projected are cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/13/wyndham-hotels-resorts-inc-wh-q4-2018-earnings-con.aspx"},{"c":"WH 2019 Q1","e":"wh","d":"2019-04-30","l":"pricing_power","r":"analyst","s":"Jared Shojaian","x":"So it sounds like some of those costs or the marketing that you talk about might be pass-through costs?","url":"https://www.fool.com/earnings/call-transcripts/2019/04/30/wyndham-hotels-resorts-inc-wh-q1-2019-earnings-cal.aspx"},{"c":"WH 2019 Q1","e":"wh","d":"2019-04-30","l":"pricing_power","r":"analyst","s":"Jared Shojaian","x":"And I'm just trying to understand exactly how that flows through like if they're pass-through costs, do you get to keep that?","url":"https://www.fool.com/earnings/call-transcripts/2019/04/30/wyndham-hotels-resorts-inc-wh-q1-2019-earnings-cal.aspx"},{"c":"WH 2019 Q1","e":"wh","d":"2019-04-30","l":"cost_cuts","r":"management","s":"Geoff Ballotti","x":"And as the manager of CorePoint hotels, we were also able to deliver cost savings of $3 million to their portfolio in 2018.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/30/wyndham-hotels-resorts-inc-wh-q1-2019-earnings-cal.aspx"},{"c":"WH 2019 Q1","e":"wh","d":"2019-04-30","l":"cost_cuts","r":"management","s":"Geoff Ballotti","x":"As we move forward postintegration, we expect to generate incremental savings throughout 2019 in the form of more efficient labor management, lower insurance premiums and lower employee benefit costs, among other cost-savings opportunities.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/30/wyndham-hotels-resorts-inc-wh-q1-2019-earnings-cal.aspx"},{"c":"WH 2019 Q2","e":"wh","d":"2019-07-25","l":"cost_cuts","r":"management","s":"Geoff Ballotti","x":"Our teams are now focused on enhancements to our mobile app that will further enhance and streamline bookings, engage our guests during their stay and provide Wyndham reward members with a more personalized, seamless experience.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/25/wyndham-hotels-resorts-inc-wh-q2-2019-earnings-cal.aspx"},{"c":"WH 2019 Q3","e":"wh","d":"2019-10-29","l":"pricing_power","r":"management","s":"David Wyshner","x":"There would be some pass-through revenues that go away, but there's no profitable revenue associated with that.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/29/wyndham-hotels-resorts-inc-wh-q3-2019-earnings-cal.aspx"},{"c":"WH 2019 Q3","e":"wh","d":"2019-10-29","l":"cost_cuts","r":"management","s":"David Wyshner","x":"We have tweaked our earnings outlook slightly to reflect our lower RevPAR outlook, cost savings and other items.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/29/wyndham-hotels-resorts-inc-wh-q3-2019-earnings-cal.aspx"},{"c":"WH 2019 Q3","e":"wh","d":"2019-10-29","l":"cost_cuts","r":"management","s":"David Wyshner","x":"And we'll continue to look for cost savings opportunities to mitigate any softness that's there.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/29/wyndham-hotels-resorts-inc-wh-q3-2019-earnings-cal.aspx"},{"c":"WH 2019 Q4","e":"wh","d":"2020-02-13","l":"pricing_power","r":"management","s":"Michele Allen","x":"This decrease reflects lower pass-through cost reimbursement revenues in our hotel management business, which have no impact on adjusted EBITDA.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/13/wyndham-hotels-resorts-inc-wh-q4-2019-earnings-cal.aspx"},{"c":"WH 2019 Q4","e":"wh","d":"2020-02-13","l":"pricing_power","r":"management","s":"Geoff Ballotti","x":"They are at all-time highs, and it's frustrating to see that sort of lack of just initiative to raise price given how high the occupancies are and you're spot on economy.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/13/wyndham-hotels-resorts-inc-wh-q4-2019-earnings-cal.aspx"},{"c":"WH 2019 Q4","e":"wh","d":"2020-02-13","l":"cost_cuts","r":"analyst","s":"Jared Shojaian","x":"So just in the earnings release, you called out the, I think $8 million, for restructuring the organization, efficiency and rationalizing the operations.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/13/wyndham-hotels-resorts-inc-wh-q4-2019-earnings-cal.aspx"},{"c":"WH 2020 Q1","e":"wh","d":"2020-05-05","l":"cost_cuts","r":"management","s":"Michele Allen","x":"Our adjusted EBITDA, declined $4 million or 4% to $107 million in the first quarter reflecting the revenue decline partially offset by $19 million of cost savings primarily related to our COVID-19 medication plan.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/05/wyndham-hotels-resorts-inc-wh-q1-2020-earnings-cal.aspx"},{"c":"WH 2020 Q1","e":"wh","d":"2020-05-05","l":"cost_cuts","r":"management","s":"Michele Allen","x":"While variable and marketing expenses will eventually return, we believe at least $100 million of these cost savings will be permanent and reset our ongoing cost base which is about a 500 basis point improvement to our 2019 full-year margin.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/05/wyndham-hotels-resorts-inc-wh-q1-2020-earnings-cal.aspx"},{"c":"WH 2020 Q4","e":"wh","d":"2021-02-11","l":"pricing_power","r":"management","s":"Geoff Ballotti","x":"…program when combined with our sales, marketing and state-of-the-art distribution platform can normally deliver 70% of an owner's room nights here in the U.S. at the lowest cost of distribution, combined with the significant cash savings, our pricing power can deliver to their bottom lines.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/wyndham-hotels-resorts-inc-wh-q4-2020-earnings-cal/"},{"c":"WH 2020 Q4","e":"wh","d":"2021-02-11","l":"cost_cuts","r":"management","s":"Geoff Ballotti","x":"And brands generate significant distribution and operating cost savings through lower procurement, technology and labor costs.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/wyndham-hotels-resorts-inc-wh-q4-2020-earnings-cal/"},{"c":"WH 2020 Q4","e":"wh","d":"2021-02-11","l":"cost_cuts","r":"management","s":"Michele Allen","x":"When we implemented our COVID plan, it was $255 million of cost savings for the full year 2020.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/wyndham-hotels-resorts-inc-wh-q4-2020-earnings-cal/"},{"c":"WH 2021 Q1","e":"wh","d":"2021-04-29","l":"cost_cuts","r":"management","s":"Michele Allen","x":"Our adjusted EBITDA margin increased to 42%, reflecting not only the COVID-19 cost savings but also less excess marketing fund spend in the quarter this year.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/29/wyndham-hotels-resorts-inc-wh-q1-2021-earnings-cal/"},{"c":"WH 2021 Q2","e":"wh","d":"2021-07-30","l":"pricing_power","r":"management","s":"Michele Allen","x":"No, Joe, I think you have it the -- in the third quarter, we certainly have our greatest pricing power.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/31/wyndham-hotels-resorts-inc-wh-q2-2021-earnings-cal/"},{"c":"WH 2021 Q2","e":"wh","d":"2021-07-30","l":"cost_cuts","r":"management","s":"Geoff Ballotti","x":"With improving leisure demand combined with a continued market share outperformance of our brands and the structural cost savings from our 2020 organizational restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/31/wyndham-hotels-resorts-inc-wh-q2-2021-earnings-cal/"},{"c":"WH 2021 Q3","e":"wh","d":"2021-10-28","l":"cost_cuts","r":"management","s":"Geoffrey A. Ballotti","x":"…2% to 4% to 3% to 5% is just how happy our teams are that we completed throughout 2020, that sizable restructuring we talked about on the last two calls, I mean, were moving over 20,000 unprofitable and noncompliant franchise rooms that are no longer going to be an issue for us moving forward.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/28/wyndham-hotels-resorts-inc-wh-q3-2021-earnings-cal/"},{"c":"WH 2021 Q3","e":"wh","d":"2021-10-28","l":"guidance","r":"management","s":"Michele Allen","x":"In light of the continued outperformance of our business model and stronger-than-anticipated third quarter, we are raising our 2021 outlook as follows.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/28/wyndham-hotels-resorts-inc-wh-q3-2021-earnings-cal/"},{"c":"WH 2025 Q4","e":"wh","d":"2026-02-19","l":"ai_spend","r":"management","s":"Kurt Albert","x":"We'd like to thank and recognize our teams around the world who did a fantastic job this quarter helping to drive cost containment measures combined with operational savings aided by the realization of AI investments that drove efficiencies.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/19/wyndham-hotels-wh-q4-2025-earnings-call-transcript/"},{"c":"WH 2025 Q4","e":"wh","d":"2026-02-19","l":"pricing_power","r":"management","s":"Geoffrey A. Ballotti","x":"Our Latin America region also delivered impressive RevPAR growth of 6% an 11 sequential improvement from the third quarter reflecting strong leisure demand and pricing power from our more upscale brands across The Caribbean.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/19/wyndham-hotels-wh-q4-2025-earnings-call-transcript/"},{"c":"WH 2025 Q4","e":"wh","d":"2026-02-19","l":"pricing_power","r":"management","s":"Kurt Albert","x":"…$25,000,000 year over year primarily reflecting a 15% increase in ancillary revenues and higher pass through revenues associated with our global franchisee conference in 2025 partially offset by lower royalties and franchisees and lower non conference related marketing reservation and loyalty…","url":"https://www.fool.com/earnings/call-transcripts/2026/02/19/wyndham-hotels-wh-q4-2025-earnings-call-transcript/"},{"c":"WH 2025 Q4","e":"wh","d":"2026-02-19","l":"cost_cuts","r":"management","s":"Kurt Albert","x":"Excluding the previously noted return of approximately 15,000,000 of one time variable cost savings, and the impact of the deferral of approximately $12,000,000 of royalties related to Revo our adjusted EBITDA would otherwise be expected to grow between 5% to 7%.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/19/wyndham-hotels-wh-q4-2025-earnings-call-transcript/"},{"c":"WH 2026 Q1","e":"wh","d":"2026-04-30","l":"ai_spend","r":"management","s":"Geoffrey Ballotti","x":"In closing, the over $450 million investment we've made in technology, which is enabling our AI innovation and which is detailed in our investor presentation posted last night to our Investor Relations website, serves as a powerful engine for franchisee profitability regardless of the economic…","url":"https://www.fool.com/earnings/call-transcripts/2026/05/01/wyndham-wh-q1-2026-earnings-call-transcript/"},{"c":"WH 2026 Q1","e":"wh","d":"2026-04-30","l":"pricing_power","r":"management","s":"Geoffrey Ballotti","x":"In Canada, RevPAR increased 8% on increased pricing power and improved demand.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/01/wyndham-wh-q1-2026-earnings-call-transcript/"},{"c":"WH 2026 Q1","e":"wh","d":"2026-04-30","l":"cost_cuts","r":"management","s":"Geoffrey Ballotti","x":"…agents answering calls and chats on behalf of our owners, helping to drive nearly 300 basis points of incremental direct contribution for these hotels through agenetic voice channels while also driving meaningful cost savings for these owners by taking labor out of their hotels and front offices.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/01/wyndham-wh-q1-2026-earnings-call-transcript/"},{"c":"WH 2026 Q3","e":"wh","d":"2026-10-22","l":"ai_spend","r":"management","s":"Geoffrey A. Ballotti","x":"Higher midweek demand is driving much of this strength especially at hotels and markets near major transportation, manufacturing, AI, data center, and industrial projects.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/22/wyndham-hotels-wh-q3-2026-earnings-call-transcript/"},{"c":"WH 2026 Q3","e":"wh","d":"2026-10-22","l":"ai_spend","r":"management","s":"Geoffrey A. Ballotti","x":"…that consolidated dozens of property management systems onto 2 have optimized and accelerated our AI readiness via a 100% cloud-based, fully optimized infrastructure across best in class partners like Oracle, AWS, like Salesforce, Adobe, like Canary Technologies, This investment has allowed us…","url":"https://www.fool.com/earnings/call-transcripts/2026/10/22/wyndham-hotels-wh-q3-2026-earnings-call-transcript/"},{"c":"WH 2026 Q3","e":"wh","d":"2026-10-22","l":"pricing_power","r":"management","s":"Geoffrey A. Ballotti","x":"Importantly, our franchisees also experienced continued pricing power 