max":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[2,2,0,2.42],"tariffs":[3,2,1,3.63],"pricing_power":[1,1,0,1.21],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0308,"r5":0.0459,"r20":-0.0071,"r1_spy":-0.019,"r5_spy":0.0469,"r20_spy":0.0484,"r1_sector":-0.0263,"r5_sector":0.0477,"r20_sector":-0.0389,"etf":"XLY"}}],"quotes":[{"c":"TSLA 2020 Q1","e":"tsla","d":"2020-04-29","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"So there's good progress happening, both on the ASP side and the cost reduction side, for our products and production.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2020 Q2","e":"tsla","d":"2020-07-22","l":"pricing_power","r":"management","s":"Zachary Kirkhorn","x":"Given the global macroeconomic context, we made the decision in Q2 to pass-through savings to customers around the world on some of our products.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2020 Q2","e":"tsla","d":"2020-07-22","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"The direct cost savings -- or the direct cost impact of the temporary shutdown was largely offset by these cost savings actions.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2020 Q3","e":"tsla","d":"2020-10-21","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"We are also seeing benefits from the ongoing upward trend of locally built and delivered cars, which has increased from under 50% at the beginning of last year to over 70% most recently, which is a core component of our cost reduction strategy.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2021 Q1","e":"tsla","d":"2021-04-27","l":"ai_spend","r":"management","s":"Elon Musk","x":"It does seem as though over time, I mean, just an observation, I think, I will basically step back that neural net-based computing or AI-based computing is more and more of the compute stack.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2021 Q2","e":"tsla","d":"2021-07-26","l":"cost_cuts","r":"management","s":"Elon Musk","x":"We're also aiming to do a structural pack with 4680 cells, which is a mass reduction and a cost reduction.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2021 Q2","e":"tsla","d":"2021-07-26","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"This was primarily driven by better cost optimization across our factories, good execution against our cost reduction plans, as well as increases in production and delivery volumes.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2021 Q3","e":"tsla","d":"2021-10-20","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"And we spend extreme amount of effort in manufacturing to take $5 upon cost-out here, or $10 out somewhere else.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2021 Q4","e":"tsla","d":"2022-01-26","l":"pricing_power","r":"management","s":"Zachary Kirkhorn","x":"And then, we've also done various price increases in certain markets on certain models, which has helped there.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2021 Q4","e":"tsla","d":"2022-01-26","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"If we look across the full year '21 and compare that to 2020, our automotive gross margin, excluding credits, rose by over 600 basis points, enabled by work on cost reduction, utilization of our Shanghai factory for exports and accelerating demand.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q1","e":"tsla","d":"2022-04-20","l":"pricing_power","r":"management","s":"Martin Viecha","x":"Separately, how do you think about price increases versus prioritizing higher mix vehicles going forward?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q1","e":"tsla","d":"2022-04-20","l":"pricing_power","r":"management","s":"Elon Musk","x":"Actually, on the price increase front, I should mention that it may seem like maybe we’re being unreasonable about increasing the prices of our vehicles, given that we had record profitability this quarter, but the wait list for our vehicles is quite long.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q2","e":"tsla","d":"2022-07-20","l":"pricing_power","r":"management","s":"Elon Musk","x":"So, this is why you kind of just raise prices to some arbitrarily high level because you pass the affordability boundary and then the demand falls off a cliff.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q2","e":"tsla","d":"2022-07-20","l":"pricing_power","r":"management","s":"Elon Musk","x":"So, I do feel like we have raised our prices or we raise the price quite a few times.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q2","e":"tsla","d":"2022-07-20","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"Additionally, we converted a majority of our Bitcoin holdings to Fiat for a realized gain, offset by impairment charges on the remainder of our holdings, netting a $106 million cost to the P&L included within restructuring and other.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q2","e":"tsla","d":"2022-07-20","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"We also incurred restructuring charges related to targeted staffing reductions.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q3","e":"tsla","d":"2022-10-19","l":"cost_cuts","r":"management","s":"Colin Rusch","x":"…curious about areas where you could invest in an incremental way, whether it’s on the R&D side or on the sales side to accelerate growth or cost reduction, or should we be thinking about this level of spend on a go-forward basis and some significant operating leverage as you scale up from here?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q3","e":"tsla","d":"2022-10-19","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"But I just want to set expectations that there’s not some windfall of cost reduction in this space coming in Q4, maybe some as we go into next year.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q4","e":"tsla","d":"2023-01-25","l":"ai_spend","r":"management","s":"Elon Musk","x":"And we think probably -- we said this already actually at AI Day, so it's not new information, but we do see potential for an order of magnitude improvement relative to GPU, what GPUs can do for Dojo, which is obviously very specialized for AI training.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q4","e":"tsla","d":"2023-01-25","l":"pricing_power","r":"management","s":"Elon Musk","x":"Demand far exceeds production, and we actually are making some small price increases as a result.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q4","e":"tsla","d":"2023-01-25","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"Second, on cost reduction, we're holding steady on our plans to rapidly increase volume, while improving overhead efficiency, which is the most effective method to retain strength in our operating margins.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2022 Q4","e":"tsla","d":"2023-01-25","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"We're doing a lot of work on cost reduction outside of that.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q1","e":"tsla","d":"2023-04-19","l":"pricing_power","r":"management","s":"Elon Musk","x":"So that's -- so it's just almost directly equivalent to a price increase, is there any kind of interest rate increase.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q1","e":"tsla","d":"2023-04-19","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"Progress on vehicle cost reduction continued in Q1 with meaningful improvements on logistics and the beginnings of some commodity cost reductions starting to be realized.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q1","e":"tsla","d":"2023-04-19","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"And so, over the course of this year, as volume increases, more localization occurs, we do see a good path to cost reduction in the Berlin factory as well.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q2","e":"tsla","d":"2023-07-19","l":"ai_spend","r":"management","s":"Zachary Kirkhorn","x":"This includes increasing spending on AI related technologies such as full self-driving, Optimus and Dojo, as well as new products such as Cybertruck, our next generation platform and the Semi, as evidenced by the continued growth in our R&D spend.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q2","e":"tsla","d":"2023-07-19","l":"cost_cuts","r":"management","s":"Unidentified Company Representative","x":"…it is important to remember that most of what we focused on a Battery Day was the Tesla-engineered 4680 production system and the improvements we strove to achieve on equipment, factory density, capital cost and utility cost reduction, all of which we are realizing in our Texas scale up to date.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q2","e":"tsla","d":"2023-07-19","l":"cost_cuts","r":"management","s":"Zachary Kirkhorn","x":"That means continuing to be hyper focused on near-term cost reduction.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q3","e":"tsla","d":"2023-10-18","l":"ai_spend","r":"management","s":"Elon Musk","x":"We’ll continue to invest significantly in AI development, as this is really the mass game changer.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q3","e":"tsla","d":"2023-10-18","l":"ai_spend","r":"management","s":"Vaibhav Taneja","x":"On the operating expenses front, R&D expenses continued to rise due to Cybertruck prototype builds and pilot production testing combined with spend on AI technologies like full self-driving, Optimus and Dojo.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q3","e":"tsla","d":"2023-10-18","l":"cost_cuts","r":"management","s":"Martin Viecha","x":"The second question is, can you provide a progress update on the 4680 cell, particularly progress towards performance improvements and cost savings outlined on Battery Day?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q3","e":"tsla","d":"2023-10-18","l":"cost_cuts","r":"management","s":"Vaibhav Taneja","x":"We get -- we expect that we’ll get some benefits from our cost reduction efforts, which are all underway.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q4","e":"tsla","d":"2024-01-24","l":"tariffs","r":"management","s":"Vaibhav Taneja","x":"That said, predicting auto gross margins is extremely challenging since there are many moving parts to this equation, some of which are out of our control like the change in tariffs or local incentives to name a few.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q4","e":"tsla","d":"2024-01-24","l":"tariffs","r":"management","s":"Elon Musk","x":"So I think they will have significant success outside of China depending on what kind of tariffs or trade barriers are established.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q4","e":"tsla","d":"2024-01-24","l":"cost_cuts","r":"management","s":"Vaibhav Taneja","x":"For 2024, our focus is to continue growing our output, continuing our cost reduction efforts, and increasing investments in our future growth initiatives.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2023 Q4","e":"tsla","d":"2024-01-24","l":"cost_cuts","r":"management","s":"Vaibhav Taneja","x":"A few pennies saved at the subcomponent level, whether through engineering redesign or from many other things which I mentioned leads to cost reduction.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q1","e":"tsla","d":"2024-04-23","l":"ai_spend","r":"management","s":"Elon Musk","x":"We also continue to expand our AI training capacity in Q1, more than doubling our training compute sequentially.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q1","e":"tsla","d":"2024-04-23","l":"ai_spend","r":"management","s":"Elon Musk","x":"Regarding AI compute, over the past few months, we've been actively working on expanding Tesla's core AI infrastructure.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q1","e":"tsla","d":"2024-04-23","l":"pricing_power","r":"management","s":"Alex Potter","x":"Maybe one final question and I'll pass it on.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q1","e":"tsla","d":"2024-04-23","l":"cost_cuts","r":"management","s":"Vaibhav Taneja","x":"Additionally, while we did experience higher cost due to the ramp of Model 3 in Fremont and disruptions in Berlin, these costs were largely offset by cost reduction initiatives.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q1","e":"tsla","d":"2024-04-23","l":"cost_cuts","r":"management","s":"Alex Potter","x":"I'd be interested also in potentially more qualitative discussion of what the implications are for these headcount reductions.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q2","e":"tsla","d":"2024-07-24","l":"ai_spend","r":"management","s":"Elon Musk","x":"And we are investing in many future projects, including AI training and inference and great deal of infrastructure to support future products.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q2","e":"tsla","d":"2024-07-24","l":"ai_spend","r":"management","s":"Vaibhav Taneja","x":"Sequentially, our operating expenses excluding surcharges reduced despite an increase in spend for AI-related activities and higher legal and other costs.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q2","e":"tsla","d":"2024-07-24","l":"tariffs","r":"management","s":"Vaibhav Taneja","x":"Additionally, as we get into the second half of the year, it is important to note that we are still ramping Cybertruck and Model 3 and are also getting impacted by varying amounts of tariffs on both raw materials and finished goods.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q2","e":"tsla","d":"2024-07-24","l":"tariffs","r":"management","s":"Elon Musk","x":"Trump has said that he will put heavy tariffs on vehicles produced in Mexico.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q2","e":"tsla","d":"2024-07-24","l":"cost_cuts","r":"management","s":"Vaibhav Taneja","x":"The impact of our recent reorg is reflected in restructuring other - on the income statement.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q2","e":"tsla","d":"2024-07-24","l":"cost_cuts","r":"management","s":"Vaibhav Taneja","x":"This was despite restructuring payments being made in the quarter and we ended the quarter with over $30 billion of cash and investments.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q3","e":"tsla","d":"2024-10-23","l":"theater","r":"management","s":"Elon Musk","x":"So you can watch it -- watch a great movie with, it's like being in a Personal movie theater?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q3","e":"tsla","d":"2024-10-23","l":"ai_spend","r":"management","s":"Vaibhav Taneja","x":"One thing which I'd like to elaborate is that we're being very judicious on our AI compute spend too and saying how best we can utilize the existing infrastructure before making further investments.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q3","e":"tsla","d":"2024-10-23","l":"ai_spend","r":"management","s":"Vaibhav Taneja","x":"This was a sequential increase largely because of investments in AI compute.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q3","e":"tsla","d":"2024-10-23","l":"cost_cuts","r":"management","s":"Vaibhav Taneja","x":"This is partially due to the restructuring we undertook in Q2.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q3","e":"tsla","d":"2024-10-23","l":"cost_cuts","r":"management","s":"Vaibhav Taneja","x":"Cost savings from these initiatives were partially offset by increase in costs related to our AI efforts.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q4","e":"tsla","d":"2025-01-29","l":"ai_spend","r":"management","s":"Vaibhav Taneja","x":"The biggest driver of the increase was R&D as we continue to invest in AI-related initiatives.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q4","e":"tsla","d":"2025-01-29","l":"ai_spend","r":"management","s":"Vaibhav Taneja","x":"Accumulative AI-related CapEx, including infrastructure, so far has been approximately $5 billion.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q4","e":"tsla","d":"2025-01-29","l":"tariffs","r":"management","s":"Vaibhav Taneja","x":"There's a lot of uncertainty around tariffs.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q4","e":"tsla","d":"2025-01-29","l":"tariffs","r":"management","s":"Vaibhav Taneja","x":"Therefore, the imposition of tariffs, which is very likely, and any [Indiscernible] will have an impact on our business and profitability.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2024 Q4","e":"tsla","d":"2025-01-29","l":"cost_cuts","r":"management","s":"Vaibhav Taneja","x":"Our journey on cost reduction continues, and we were able to get our overall cost per car down below $35,000, primarily by material costs.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2025 Q1","e":"tsla","d":"2025-04-22","l":"tariffs","r":"management","s":"Vaibhav Taneja","x":"I know tariffs is the hottest topic which people talk about and it has various impacts to our business.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"TSLA 2025 Q1","e":"tsla","d":"2025-04-22","l":"tariffs","r":"management","s":"Vaibhav Taneja","x":"…said, this definitely gives us a bigger edge as compared to our other OEMs in terms of managing the tariffs, but we're not immune because when the Section 232 auto tests become effective in May, which includes Canada and Mexico, and Canada and Mexico has been part of our regionalization study.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"}],"trends":{"theater":[[41,1,8505,0,0,0,6552,1578],[42,1,8707,0,0,0,7199,1164],[43,1,9135,0,0