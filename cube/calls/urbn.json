0],"tariffs":[18,18,0,21.06],"pricing_power":[7,6,1,8.19],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.1354,"r5":0.1593,"r20":0.1446,"r1_spy":0.1285,"r5_spy":0.1461,"r20_spy":0.1219}},{"id":"URBN 2027 Q1","t":"URBN","d":"2026-05-20","time":"17:00","w":7238,"n":22,"url":"https://www.fool.com/earnings/call-transcripts/2026/05/20/urbn-q1-2027-earnings-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[1,1,0,1.39],"dtc":[1,1,0,1.39],"ai_spend":[2,2,0,2.79],"tariffs":[22,22,0,30.64],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0292,"r5":0.0444,"r20":0.0663,"r1_spy":0.0272,"r5_spy":0.0264,"r20_spy":0.0589}}],"quotes":[{"c":"URBN 2018 Q3","e":"urbn","d":"2017-11-20","l":"streaming","r":"management","s":"Frank Conforti","x":"Within our URBN retail segment comp, the direct-to-consumer channel continued to outperform our store channel driven by increases in sessions and conversion rates, which more than offset a small decrease in average order value.","url":"https://www.fool.com/earnings/call-transcripts/2017/11/21/urban-outfitters-inc-urbn-q3-2018-earnings-confere.aspx"},{"c":"URBN 2018 Q3","e":"urbn","d":"2017-11-20","l":"streaming","r":"management","s":"Frank Conforti","x":"The Free People wholesale segment sales increase of 9% for the quarter was driven by domestic and international growth in department stores, specialty stores, and direct-to-consumer.","url":"https://www.fool.com/earnings/call-transcripts/2017/11/21/urban-outfitters-inc-urbn-q3-2018-earnings-confere.aspx"},{"c":"URBN 2018 Q3","e":"urbn","d":"2017-11-20","l":"dtc","r":"management","s":"Frank Conforti","x":"The decline in gross profit rate was primarily driven by deleverage in delivery and logistics expense due to increased penetration of the direct-to-consumer channel, higher international penetration, and increased furniture penetration.","url":"https://www.fool.com/earnings/call-transcripts/2017/11/21/urban-outfitters-inc-urbn-q3-2018-earnings-confere.aspx"},{"c":"URBN 2018 Q3","e":"urbn","d":"2017-11-20","l":"dtc","r":"management","s":"Frank Conforti","x":"We believe that gross margin rate for the fourth decline on a year-over-year basis primarily due to deleverage in delivery and logistics expense, primarily due to the increased penetration of the direct-to-consumer channel.","url":"https://www.fool.com/earnings/call-transcripts/2017/11/21/urban-outfitters-inc-urbn-q3-2018-earnings-confere.aspx"},{"c":"URBN 2019 Q2","e":"urbn","d":"2018-08-21","l":"streaming","r":"management","s":"Trish Donnelly","x":"As we penetrate new territories, our direct-to-consumer business sees outsized growth.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/21/urban-outfitters-inc-urbn-q2-2019-earnings-confere.aspx"},{"c":"URBN 2019 Q2","e":"urbn","d":"2018-08-21","l":"dtc","r":"management","s":"Andrew Carnie","x":"We're going to follow a similar path, focusing on major cities through stores, DTC, and with the addition of wholesale.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/21/urban-outfitters-inc-urbn-q2-2019-earnings-confere.aspx"},{"c":"URBN 2019 Q2","e":"urbn","d":"2018-08-21","l":"tariffs","r":"management","s":"Frank J. Conforti","x":"Given the news and questions we have received regarding China tariffs, I wanted to briefly discuss our current exposure.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/21/urban-outfitters-inc-urbn-q2-2019-earnings-confere.aspx"},{"c":"URBN 2019 Q3","e":"urbn","d":"2018-11-19","l":"tariffs","r":"management","s":"Richard Hayne","x":"As far as inventory is concerned, we saw little back up in October when people tried to get stuff in before the tariffs took effect.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/19/urban-outfitters-inc-urbn-q3-2018-earnings-confere.aspx"},{"c":"URBN 2019 Q3","e":"urbn","d":"2018-11-19","l":"tariffs","r":"analyst","s":"Adrienne Yih","x":"Are you seeing any earlier inventory coming in, any port delays, have people try to get in before kind of this looming tariff issue?","url":"https://www.fool.com/earnings/call-transcripts/2018/11/19/urban-outfitters-inc-urbn-q3-2018-earnings-confere.aspx"},{"c":"URBN 2019 Q4","e":"urbn","d":"2019-03-05","l":"tariffs","r":"management","s":"Frank J. Conforti","x":"I think some retailers probably got caught with a bit too much inventory that they brought in, because of the -- of all of the political tariffs, et cetera, going on and I think they have a little bit extra.","url":"https://www.fool.com/earnings/call-transcripts/2019/03/05/urban-outfitters-inc-urbn-q4-2019-earnings-confere.aspx"},{"c":"URBN 2020 Q1","e":"urbn","d":"2019-05-21","l":"tariffs","r":"management","s":"Frank J. Conforti","x":"As it relates to the China tariff, I think there was kind of two parts to that question.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/21/urban-outfitters-inc-urbn-q1-2019-earnings-call-tr.aspx"},{"c":"URBN 2020 Q1","e":"urbn","d":"2019-05-21","l":"tariffs","r":"management","s":"Frank J. Conforti","x":"As it relates to how much the dollar value impact would be related to the 25% increase in tariff.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/21/urban-outfitters-inc-urbn-q1-2019-earnings-call-tr.aspx"},{"c":"URBN 2020 Q2","e":"urbn","d":"2019-08-20","l":"tariffs","r":"management","s":"Frank J. Conforti","x":"Lastly, and Dick mentioned a little bit of this just recently on the last answer, we have experienced a fair amount of uncertainty around inventory deliveries over the past quarter, which has a lot to do with the trade war that continues.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/20/urban-outfitters-inc-urbn-q2-2020-earnings-call-tr.aspx"},{"c":"URBN 2020 Q2","e":"urbn","d":"2019-08-20","l":"tariffs","r":"management","s":"Richard A. Hayne","x":"As far as the trade wars are concerned, if the 10% tariffs go into effect as they are threatened too, I think we could see anywhere from $2.5 million to $3.0 million charge in the back half of the year.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/20/urban-outfitters-inc-urbn-q2-2020-earnings-call-tr.aspx"},{"c":"URBN 2020 Q2","e":"urbn","d":"2019-08-20","l":"pricing_power","r":"management","s":"Richard A. Hayne","x":"And then we also have some pricing power.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/20/urban-outfitters-inc-urbn-q2-2020-earnings-call-tr.aspx"},{"c":"URBN 2020 Q2","e":"urbn","d":"2019-08-20","l":"pricing_power","r":"analyst","s":"Matthew Robert Boss","x":"And I'm curious, your thoughts around the pricing power that you believe -- that you have at the brands and any impacts that potential price increases could have on sale?","url":"https://www.fool.com/earnings/call-transcripts/2019/08/20/urban-outfitters-inc-urbn-q2-2020-earnings-call-tr.aspx"},{"c":"URBN 2020 Q3","e":"urbn","d":"2019-11-19","l":"streaming","r":"management","s":"Richard Hayne","x":"And all of the brands are anticipate expanding both their retail footprint, that is to open more stores in Europe and expand their direct-to-consumer business in Europe.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/19/urban-outfitters-inc-urbn-q3-2020-earnings-call-tr.aspx"},{"c":"URBN 2020 Q3","e":"urbn","d":"2019-11-19","l":"tariffs","r":"management","s":"Frank Conforti","x":"We did bring in certain receipts early to protect deliveries against the important holiday period, while tariff war and Brexit uncertainty persisted.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/19/urban-outfitters-inc-urbn-q3-2020-earnings-call-tr.aspx"},{"c":"URBN 2020 Q3","e":"urbn","d":"2019-11-19","l":"tariffs","r":"analyst","s":"Adrienne Yih","x":"And then on tariffs, Frank, can you just give us an update, last number we had was 25%, going down though.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/19/urban-outfitters-inc-urbn-q3-2020-earnings-call-tr.aspx"},{"c":"URBN 2021 Q1","e":"urbn","d":"2020-05-19","l":"streaming","r":"management","s":"Richard A. Hayne","x":"I think that we're seeing much more of the full price happen at the direct-to-consumer level, and when you ask yourself, well why is someone going to go to a store particularly unless you are a young, and it's a social thing, the reason might be price.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/19/urban-outfitters-inc-urbn-q1-2021-earnings-call-tr.aspx"},{"c":"URBN 2021 Q1","e":"urbn","d":"2020-05-19","l":"cost_cuts","r":"management","s":"Frank J. Conforti","x":"We reduced our SG&A expense plans through a hiring freeze, Board and executive pay reductions, suspension of raises and bonuses, employee furloughs, as well as reductions in non-payroll expenses in areas such as creative and marketing.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/19/urban-outfitters-inc-urbn-q1-2021-earnings-call-tr.aspx"},{"c":"URBN 2021 Q3","e":"urbn","d":"2020-11-23","l":"streaming","r":"management","s":"Trish Donnelly","x":"Our retail stores optimized their pick, pack, and ship capabilities and were able to fill close to 1 million direct-to-consumer units out of store inventories globally.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/23/urban-outfitters-inc-urbn-q3-2021-earnings-call-tr/"},{"c":"URBN 2021 Q3","e":"urbn","d":"2020-11-23","l":"dtc","r":"management","s":"Trish Donnelly","x":"The operational competencies we've developed this past quarter in the retail channel around DTC order fulfillment will certainly prove beneficial this holiday season.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/23/urban-outfitters-inc-urbn-q3-2021-earnings-call-tr/"},{"c":"URBN 2021 Q3","e":"urbn","d":"2020-11-23","l":"dtc","r":"analyst","s":"Marni Shapiro","x":"Can you talk a little bit, you've had a pretty dramatic shift to DTC and Free People was already there.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/23/urban-outfitters-inc-urbn-q3-2021-earnings-call-tr/"},{"c":"URBN 2021 Q4","e":"urbn","d":"2021-03-02","l":"cost_cuts","r":"analyst","s":"Marni Shapiro","x":"How are you thinking about the right size for your stores these days?","url":"https://www.fool.com/earnings/call-transcripts/2021/03/02/urban-outfitters-inc-urbn-q4-2020-earnings-call-tr/"},{"c":"URBN 2022 Q1","e":"urbn","d":"2021-05-25","l":"dtc","r":"analyst","s":"Marni Shapiro","x":"If you saw new people coming into the brands in the US as well as they were coming through digital and I didn't hear on the call or may be missed, did you talk about what penetration DTC was to sales this quarter in the United States just relative to where we've been?","url":"https://www.fool.com/earnings/call-transcripts/2021/05/25/urban-outfitters-inc-urbn-q1-2022-earnings-call-tr/"},{"c":"URBN 2022 Q1","e":"urbn","d":"2021-05-25","l":"pricing_power","r":"management","s":"Frank J. Conforti","x":"We believe favorable markdowns could offset lower initial mark-ups that are being pressured by commodity and freight price increases, as well as deleverage in delivery and logistics expense driven primarily by the increased penetration of the digital channel.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/25/urban-outfitters-inc-urbn-q1-2022-earnings-call-tr/"},{"c":"URBN 2022 Q1","e":"urbn","d":"2021-05-25","l":"cost_cuts","r":"analyst","s":"Ike Boruchow","x":"Understanding the guide for Q2, do you expect the business I guess Free People specifically to continue to right size that business meaning to be down versus LLY in the back half of the year?","url":"https://www.fool.com/earnings/call-transcripts/2021/05/25/urban-outfitters-inc-urbn-q1-2022-earnings-call-tr/"},{"c":"URBN 2022 Q2","e":"urbn","d":"2021-08-24","l":"pricing_power","r":"management","s":"Frank J. Conforti","x":"Lower initial mark-ups are likely to be due to increased freight and commodity price increases.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/24/urban-outfitters-inc-urbn-q2-2022-earnings-call-tr/"},{"c":"URBN 2022 Q2","e":"urbn","d":"2021-08-24","l":"pricing_power","r":"management","s":"Richard A. Hayne","x":"In general, we have raised prices on probably almost half of our items, but we're doing strategically and selectively.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/24/urban-outfitters-inc-urbn-q2-2022-earnings-call-tr/"},{"c":"URBN 2022 Q2","e":"urbn","d":"2021-08-24","l":"cost_cuts","r":"management","s":"Lauren Frasch","x":"We know you've been doing a lot of great work to rightsize the Free People wholesale business.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/24/urban-outfitters-inc-urbn-q2-2022-earnings-call-tr/"},{"c":"URBN 2022 Q2","e":"urbn","d":"2021-08-24","l":"cost_cuts","r":"management","s":"Sheila Harrington","x":"We're excited about rightsizing the brand in wholesale because it will mean that we get the opportunity to strengthen our brand.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/24/urban-outfitters-inc-urbn-q2-2022-earnings-call-tr/"},{"c":"URBN 2022 Q3","e":"urbn","d":"2021-11-22","l":"streaming","r":"management","s":"Sheila Harrington","x":"It gives us a chance to expand our lifestyle offering, really test out opportunities and I think there is something to be built on as we continue to go after our direct to consumer business.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/22/urban-outfitters-inc-urbn-q3-2022-earnings-call-tr/"},{"c":"URBN 2022 Q3","e":"urbn","d":"2021-11-22","l":"pricing_power","r":"management","s":"Melanie Marein-Efron","x":"Lower initial mark-ups are likely to be due to increased freight and commodity price increases.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/22/urban-outfitters-inc-urbn-q3-2022-earnings-call-tr/"},{"c":"URBN 2022 Q3","e":"urbn","d":"2021-11-22","l":"pricing_power","r":"management","s":"Frank J. Conforti","x":"I think, price is one of our strategies as Dick talked about sort of gently raising prices.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/22/urban-outfitters-inc-urbn-q3-2022-earnings-call-tr/"},{"c":"URBN 2026 Q2","e":"urbn","d":"2025-08-27","l":"dtc","r":"management","s":"Sheila Harrington","x":"Our positive Urban Outfitters North America business reflects sequential improvement across both channels, with stores delivering positive results and DTC driving strong regular price comps.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/27/urban-outfitters-urbn-q2-2026-earnings-transcript/"},{"c":"URBN 2026 Q2","e":"urbn","d":"2025-08-27","l":"tariffs","r":"management","s":"Dick Hayne","x":"The agenda for today's call includes comments from Frank Conforti, our Co-President and COO, who will elaborate on Q2 performance by brand and business segment and address the tariff situation.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/27/urban-outfitters-urbn-q2-2026-earnings-transcript/"},{"c":"URBN 2026 Q2","e":"urbn","d":"2025-08-27","l":"tariffs","r":"management","s":"Frank Conforti","x":"Now moving on to tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/27/urban-outfitters-urbn-q2-2026-earnings-transcript/"},{"c":"URBN 2026 Q2","e":"urbn","d":"2025-08-27","l":"pricing_power","r":"management","s":"Frank Conforti","x":"And lastly is gonna be gently raising prices.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/27/urban-outfitters-urbn-q2-2026-earnings-transcript/"},{"c":"URBN 2026 Q2","e":"urbn","d":"2025-08-27","l":"pricing_power","r":"management","s":"Tricia Smith","x":"I think, hi, Lorraine, that our pricing strategy, as Frank mentioned, is really to look at some gentle price increases where we feel like there's the value that contributes to that.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/27/urban-outfitters-urbn-q2-2026-earnings-transcript/"},{"c":"URBN 2026 Q3","e":"urbn","d":"2025-11-25","l":"tariffs","r":"management","s":"Frank Conforti","x":"These gains more than offset lower initial product margins at all our brands due to increased tariffs versus the prior year.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/25/urban-outfitters-urbn-earnings-call-transcript/"},{"c":"URBN 2026 Q3","e":"urbn","d":"2025-11-25","l":"tariffs","r":"management","s":"Frank Conforti","x":"Now moving on to tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/25/urban-outfitters-urbn-earnings-call-transcript/"},{"c":"URBN 2026 Q3","e":"urbn","d":"2025-11-25","l":"pricing_power","r":"management","s":"Tricia Smith","x":"We are being highly strategic and thoughtful about taking price, and these are definitely not across-the-board price increases.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/25/urban-outfitters-urbn-earnings-call-transcript/"},{"c":"URBN 2026 Q3","e":"urbn","d":"2025-11-25","l":"pricing_power","r":"management","s":"Tricia Smith","x":"We've taken small price increases where we felt the price-value equation was appropriate and have seen really little to no price resistance where we did so.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/25/urban-outfitters-urbn-earnings-call-transcript/"},{"c":"URBN 2027 Q1","e":"urbn","d":"2026-05-20","l":"streaming","r":"management","s":"Francis J. Conforti","x":"We will lead our international growth through a strategic mix of wholesale partnerships, and direct to consumer channels, allowing us to scale brand awareness rapidly while remaining a deep authentic connection with our global community.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/20/urbn-q1-2027-earnings-transcript/"},{"c":"URBN 2027 Q1","e":"urbn","d":"2026-05-20","l":"ai_spend","r":"management","s":"Francis J. Conforti"