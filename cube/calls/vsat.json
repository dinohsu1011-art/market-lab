0],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}]},"move":{"r1":0.077,"r5":0.1997,"r1_spy":0.0738,"r5_spy":0.1668}}],"quotes":[{"c":"VSAT 2019 Q2","e":"vsat","d":"2018-11-01","l":"streaming","r":"management","s":"Mark Dankberg","x":"In the contrast, the lower verticals are direct to consumer.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/01/viasat-inc-vsat-q2-2019-earnings-conference-call-t.aspx"},{"c":"VSAT 2019 Q3","e":"vsat","d":"2019-02-07","l":"streaming","r":"management","s":"Mark Dankberg","x":"Last week, American Airlines and Apple announced a program that allows Apple Music subscribers free access to Apple's music streaming service and also provides free access to prospective subscribers to sign up while in flight.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/08/viasat-inc-vsat-q3-2019-earnings-conference-call-t.aspx"},{"c":"VSAT 2019 Q3","e":"vsat","d":"2019-02-07","l":"streaming","r":"management","s":"Mark Dankberg","x":"We've also been experimenting with American and their media partners on live streaming events like the Willie Nelson concert on Austin City Limits that's shown on this side.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/08/viasat-inc-vsat-q3-2019-earnings-conference-call-t.aspx"},{"c":"VSAT 2020 Q1","e":"vsat","d":"2019-08-08","l":"streaming","r":"management","s":"Mark Dankberg","x":"Continuing adoption of multimedia within messaging and social networks, as well as on the web and through rapidly growing cloud-based streaming music and video services continues to put a spotlight on bandwidth resources.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/09/viasat-inc-vsat-q1-2020-earnings-call-transcript.aspx"},{"c":"VSAT 2020 Q1","e":"vsat","d":"2019-08-08","l":"streaming","r":"management","s":"Mark Dankberg","x":"And then also, in the streaming services.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/09/viasat-inc-vsat-q1-2020-earnings-call-transcript.aspx"},{"c":"VSAT 2020 Q2","e":"vsat","d":"2019-11-07","l":"streaming","r":"management","s":"Mark Dankberg","x":"If passengers are not connected they won't have access to streaming entertainment or e-commerce or be able to participate in a myriad of advertiser- and sponsor-related activities.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/11/viasat-inc-vsat-q2-2020-earnings-call-transcript.aspx"},{"c":"VSAT 2020 Q2","e":"vsat","d":"2019-11-07","l":"streaming","r":"management","s":"Mark Dankberg","x":"…able to connect every passenger on each flight with a reliable high-speed connection suitable for streaming even at the busiest hub airports.This expansive view of the economic impact of scalable high-performance IFC resonates with us as we've seen our airline partners leverage our connectivity…","url":"https://www.fool.com/earnings/call-transcripts/2019/11/11/viasat-inc-vsat-q2-2020-earnings-call-transcript.aspx"},{"c":"VSAT 2020 Q3","e":"vsat","d":"2020-02-06","l":"streaming","r":"management","s":"Mark Dankberg","x":"Obviously, for anyone to target a market of that size the competition is really terrestrial and the appeal would be delivering better quality -- better quality video streaming.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/07/viasat-inc-vsat-q3-2020-earnings-call-transcript.aspx"},{"c":"VSAT 2020 Q3","e":"vsat","d":"2020-02-06","l":"streaming","r":"management","s":"Mark Dankberg","x":"We believe we can compete well for streaming video among the underserved.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/07/viasat-inc-vsat-q3-2020-earnings-call-transcript.aspx"},{"c":"VSAT 2020 Q4","e":"vsat","d":"2020-05-26","l":"cost_cuts","r":"management","s":"Mark Dankberg","x":"We have taken cost-reduction measures earlier this quarter to address the downturn in commercial in-flight connectivity.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/26/viasat-inc-vsat-q4-2020-earnings-call-transcript.aspx"},{"c":"VSAT 2020 Q4","e":"vsat","d":"2020-05-26","l":"cost_cuts","r":"management","s":"Richard Baldridge","x":"So we in general -- we had a layoff of reduction in force of a little over 300 employees.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/26/viasat-inc-vsat-q4-2020-earnings-call-transcript.aspx"},{"c":"VSAT 2021 Q2","e":"vsat","d":"2020-11-05","l":"streaming","r":"management","s":"Mark Dankberg","x":"And also, we've been pretty clear that we think that lots of bandwidth for streaming video is going to be a really important factor in a lot of buying decisions.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/06/viasat-vsat-q2-2021-earnings-call-transcript/"},{"c":"VSAT 2021 Q2","e":"vsat","d":"2020-11-05","l":"streaming","r":"management","s":"Mark Dankberg","x":"I think the thing that we've seen that's really the most decisive is being able to get a lot of bandwidth, especially for video streaming and that if you can do that well, that that's more important.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/06/viasat-vsat-q2-2021-earnings-call-transcript/"},{"c":"VSAT 2021 Q4","e":"vsat","d":"2021-05-25","l":"cost_cuts","r":"analyst","s":"Chris Quilty","x":"And I think, you know, also at the start of COVID, you had a layoff of a couple of hundred people on the IFC side.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/26/viasat-vsat-q4-2021-earnings-call-transcript/"},{"c":"VSAT 2022 Q1","e":"vsat","d":"2021-08-05","l":"ai_spend","r":"management","s":"Rick Baldridge","x":"And also think of things that need to be -- need the cloud compute to be able to have AI elements back to how you control elements.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/06/viasat-vsat-q1-2022-earnings-call-transcript/"},{"c":"VSAT 2022 Q4","e":"vsat","d":"2022-05-25","l":"streaming","r":"management","s":"Mark Dankberg","x":"And you'll see -- we're doing -- right now, I would say one of our most promising plans is really around higher quality and more video streaming.","url":"https://www.fool.com/earnings/call-transcripts/2022/05/26/viasat-vsat-q4-2022-earnings-call-transcript/"},{"c":"VSAT 2023 Q1","e":"vsat","d":"2022-08-08","l":"streaming","r":"management","s":"Mark Dankberg","x":"Right now, we think is, especially with just the booming growth in streaming and a more and more video entertainment hours switching from broadcast to streaming.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/09/viasat-vsat-q1-2023-earnings-call-transcript/"},{"c":"VSAT 2023 Q1","e":"vsat","d":"2022-08-08","l":"streaming","r":"management","s":"Mark Dankberg","x":"We think that streaming is really driving substantial growth and demand.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/09/viasat-vsat-q1-2023-earnings-call-transcript/"},{"c":"VSAT 2026 Q4","e":"vsat","d":"2026-05-28","l":"cost_cuts","r":"management","s":"Mark D. Dankberg","x":"So 1 of the opportunities to further improve cost efficiency and cost savings would be to invite other partners who may be regional operator.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/28/viasat-vsat-q4-2026-earnings-transcript/"},{"c":"VSAT 2026 Q4","e":"vsat","d":"2026-05-28","l":"cost_cuts","r":"management","s":"Mark D. Dankberg","x":"So if they share ours, it just reinforces the cost savings that we can achieve otherwise And the other opportunity is to coordinate spectrum in a way that allows more spectrum to be brought into use.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/28/viasat-vsat-q4-2026-earnings-transcript/"}],"trends":{"theater":[[35,1,10228,0,0,0,9460,547],[36,1,10334,0,0,0,9068,899],[37,1,9510,0,0,0,8041,1127],[38,1,8021,0,0,0,7007,767],[39,1,8596,0,0,0,7732,612],[40,1,8223,0,0,0,7440,562],[41,1,7090,0,0,0,5106,1571],[42,1,8714,0,0,0,6789,1556],[43,1,4982,0,0,0,3961,722],[44,1,11360,0,0,0,8274,2582],[45,1,5250,0,0,0,3651,12