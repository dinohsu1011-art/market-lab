ts":[0,0,0,0.0],"guidance":[1,1,0,2.16,{"raise":0,"reaffirm":1,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.087,"r5":0.0908,"r20":0.1493,"r1_spy":0.0908,"r5_spy":0.0903,"r20_spy":0.1071}},{"id":"SIGI 2026 Q3","t":"SIGI","d":"2026-10-23","time":"bmo","w":5470,"n":47,"url":"https://www.fool.com/earnings/call-transcripts/2026/10/23/selective-insurance-sigi-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0531,"r5":0.0826,"r1_spy":0.0583,"r5_spy":0.0756}}],"quotes":[{"c":"SIGI 2018 Q4","e":"sigi","d":"2019-02-01","l":"pricing_power","r":"management","s":"Gregory E. Murphy","x":"First, our standard commercial lines renewal underwriters achieved overall renewal pure price increases of 3.5% for the year, in line with our expected claim inflation levels.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/01/selective-insurance-group-inc-sigi-q4-2018-earning.aspx"},{"c":"SIGI 2018 Q4","e":"sigi","d":"2019-02-01","l":"pricing_power","r":"management","s":"Gregory E. Murphy","x":"Third, we've been taking active steps over the past two-year period to address profitability in our E&S segment, that implementing meaningful targeted price increases, exiting challenged business segments and improving the claim processes.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/01/selective-insurance-group-inc-sigi-q4-2018-earning.aspx"},{"c":"SIGI 2018 Q4","e":"sigi","d":"2019-02-01","l":"cost_cuts","r":"management","s":"Mark A. Wilcox","x":"We remain focused on seeking areas of efficiency and cost savings, while continuing to invest in our employees and in key initiatives around geographic expansion, enhancing our underwriting tools technology and the customer experience.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/01/selective-insurance-group-inc-sigi-q4-2018-earning.aspx"},{"c":"SIGI 2018 Q4","e":"sigi","d":"2019-02-01","l":"cost_cuts","r":"management","s":"John J. Marchioni","x":"Most of the benefit of these changes has been offset by continued increase in loss frequencies and severance.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/01/selective-insurance-group-inc-sigi-q4-2018-earning.aspx"},{"c":"SIGI 2019 Q1","e":"sigi","d":"2019-05-02","l":"pricing_power","r":"management","s":"Gregory Murphy","x":"Our above industry growth rate reflects in part renewal pure price increases and new business premium written that included the added premium from our five greenfield expansion states.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/02/selective-insurance-group-inc-sigi-q1-2019-earning.aspx"},{"c":"SIGI 2019 Q1","e":"sigi","d":"2019-05-02","l":"pricing_power","r":"management","s":"Gregory Murphy","x":"…has no mercy with expected loss trends up in the 3% to 4% range, the only math that improves industry-wide combined ratios is earned rate in the 5% to 6% range, over time generating renewal pure price increases over expected loss trend is the only way to maintain and improve profitability.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/02/selective-insurance-group-inc-sigi-q1-2019-earning.aspx"},{"c":"SIGI 2019 Q1","e":"sigi","d":"2019-05-02","l":"cost_cuts","r":"management","s":"Mark Wilcox","x":"Overall, we continue to seek out areas of efficiency in cost savings, while balancing these savings with investments in our operations for the company's long-term success, including investments in talent and in key initiatives such as geographic expansion, our underwriting tools, value-added…","url":"https://www.fool.com/earnings/call-transcripts/2019/05/02/selective-insurance-group-inc-sigi-q1-2019-earning.aspx"},{"c":"SIGI 2019 Q2","e":"sigi","d":"2019-08-01","l":"pricing_power","r":"management","s":"Gregory E. Murphy","x":"For the quarter, all aspects of our underwriting operations performed remarkably with, one, overall net premium written growth of 7%; two, solid renewal pure price increases of 3.4%; three, strong retention; and four, new business that was up 7% to $146 million.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/01/selective-insurance-group-inc-sigi-q2-2019-earning.aspx"},{"c":"SIGI 2019 Q2","e":"sigi","d":"2019-08-01","l":"pricing_power","r":"management","s":"Gregory E. Murphy","x":"We feel confident in our ability to maintain attractive ROEs given the implied profitability embedded in our business, coupled with our renewal pure price increases versus the expected loss trends.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/01/selective-insurance-group-inc-sigi-q2-2019-earning.aspx"},{"c":"SIGI 2019 Q2","e":"sigi","d":"2019-08-01","l":"cost_cuts","r":"management","s":"Mark A. Wilcox","x":"Overall, we continue to seek areas of efficiency in cost savings, while balancing these savings with investments in our operations for the company's long-term success, including investments in our people, technology and key initiatives such as geo expansion and significantly expanded our customer…","url":"https://www.fool.com/earnings/call-transcripts/2019/08/01/selective-insurance-group-inc-sigi-q2-2019-earning.aspx"},{"c":"SIGI 2019 Q3","e":"sigi","d":"2019-10-31","l":"pricing_power","r":"management","s":"Gregory E Murphy","x":"In addition we remain focused on generating renewable pure price increases that for the quarter were 3.7% in line with our expected claim trend as well as driving ongoing underwriting and claim improvements.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/01/selective-insurance-group-inc-sigi-q3-2019-earning.aspx"},{"c":"SIGI 2019 Q3","e":"sigi","d":"2019-10-31","l":"pricing_power","r":"management","s":"Gregory E Murphy","x":"Overall net premiums written were up 6% led by one solid overall renewal pure price increases of 3.6% strong retention and three new businesses that was up 5% for the first nine months.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/01/selective-insurance-group-inc-sigi-q3-2019-earning.aspx"},{"c":"SIGI 2019 Q3","e":"sigi","d":"2019-10-31","l":"cost_cuts","r":"management","s":"Gregory E Murphy","x":"…third quarter results were impacted by: One higher than expected levels of non-cat property losses of $5 million after tax or $0.09 per diluted share and $3 million of employee severance-related costs which were split between underwriting and corporate expenses that accounted for $0.05 per share.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/01/selective-insurance-group-inc-sigi-q3-2019-earning.aspx"},{"c":"SIGI 2019 Q3","e":"sigi","d":"2019-10-31","l":"cost_cuts","r":"management","s":"Mark A Wilcox","x":"…partners and employees driven by our strong year-to-date results as well as the employee severance related costs that Greg mentioned which negatively impacted our expense ratio by 30 basis points in the quarter. A 33.6% expense ratio for the first nine months was 60 basis points above…","url":"https://www.fool.com/earnings/call-transcripts/2019/11/01/selective-insurance-group-inc-sigi-q3-2019-earning.aspx"},{"c":"SIGI 2019 Q3","e":"sigi","d":"2019-10-31","l":"guidance","r":"management","s":"Mark A Wilcox","x":"…income after-tax a $180 million despite the much lower interest rate environment where we are today versus where we started the year where we're able to maintain the guidance and in fact to increase it by $5 million earlier in the year given the strong performance in the alternative portfolio.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/01/selective-insurance-group-inc-sigi-q3-2019-earning.aspx"},{"c":"SIGI 2019 Q4","e":"sigi","d":"2020-01-31","l":"pricing_power","r":"management","s":"Gregory E. Murphy","x":"Our sophisticated modeling and underwriting tools allow us to administer price increases at an extremely granular level, while balancing retention and growth rates.","url":"https://www.fool.com/earnings/call-transcripts/2020/01/31/selective-insurance-group-inc-sigi-q4-2019-earning.aspx"},{"c":"SIGI 2019 Q4","e":"sigi","d":"2020-01-31","l":"pricing_power","r":"management","s":"Gregory E. Murphy","x":"We've been steadfast in our commitment to maintaining underwriting discipline, having consistently implemented commercial lines renewal pure price increases that have matched or exceeded loss trends.","url":"https://www.fool.com/earnings/call-transcripts/2020/01/31/selective-insurance-group-inc-sigi-q4-2019-earning.aspx"},{"c":"SIGI 2019 Q4","e":"sigi","d":"2020-01-31","l":"cost_cuts","r":"management","s":"Mark A. Wilcox","x":"For the year, corporate expenses totaled $31 million compared to $25 million in 2018 and included $3 million of one-time items, principally related to severance.","url":"https://www.fool.com/earnings/call-transcripts/2020/01/31/selective-insurance-group-inc-sigi-q4-2019-earning.aspx"},{"c":"SIGI 2020 Q1","e":"sigi","d":"2020-05-06","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"For April, which reflects the first full month of economic strain, commercial lines renewal pure price increases averaged 4% and overall premium growth remained strong at 7%.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/selective-insurance-group-inc-sigi-q1-2020-earning.aspx"},{"c":"SIGI 2020 Q1","e":"sigi","d":"2020-05-06","l":"pricing_power","r":"management","s":"Mark A. Wilcox","x":"Renewal pure price increases averaged 3.7%.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/selective-insurance-group-inc-sigi-q1-2020-earning.aspx"},{"c":"SIGI 2020 Q2","e":"sigi","d":"2020-07-30","l":"pricing_power","r":"management","s":"Mark Wilcox","x":"Strong renewal retention, overall renewal pure price increases averaging 3.9% and steady new business volumes helped drive the solid growth.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/31/selective-insurance-group-inc-sigi-q2-2020-earning.aspx"},{"c":"SIGI 2020 Q2","e":"sigi","d":"2020-07-30","l":"pricing_power","r":"management","s":"Mark Wilcox","x":"New business was flat relative to a year ago, while retention was very strong at 86% for the quarter, and renewal pure price increases was stable at 3.9%.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/31/selective-insurance-group-inc-sigi-q2-2020-earning.aspx"},{"c":"SIGI 2020 Q3","e":"sigi","d":"2020-10-29","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"Our premium growth, driven by solid price increases, excellent retention rates and strong new business volumes is a testament to our unique market position and deep distribution partner relationships.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/selective-insurance-group-inc-sigi-q3-2020-earning/"},{"c":"SIGI 2020 Q3","e":"sigi","d":"2020-10-29","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"It is our granular and sophisticated approach to pricing that has allowed us to generate pure renewal price increases, in line with or above expected claim trend for the past 10 years without sacrificing policy retention or growth.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/selective-insurance-group-inc-sigi-q3-2020-earning/"},{"c":"SIGI 2020 Q3","e":"sigi","d":"2020-10-29","l":"cost_cuts","r":"management","s":"John J. Marchioni","x":"We've also begun the initial rollout of a new agency interface for small business, designed to dramatically streamline the quoting and issuance process for this key business segment.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/selective-insurance-group-inc-sigi-q3-2020-earning/"},{"c":"SIGI 2020 Q3","e":"sigi","d":"2020-10-29","l":"cost_cuts","r":"management","s":"John J. Marchioni","x":"…I think we saw the need to invest in a complete redesign of that interface, taking advantage of a lot of the technology and the intelligence -- artificial intelligence, that's available to us to streamline the amount of information required to generate, to allow more business to flow through.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/selective-insurance-group-inc-sigi-q3-2020-earning/"},{"c":"SIGI 2020 Q4","e":"sigi","d":"2021-01-29","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"Our solid premium growth was driven by overall renewal pure price increases averaging 4.8%, strong standard lines retention rates and an increase in new business.","url":"https://www.fool.com/earnings/call-transcripts/2021/01/29/selective-insurance-group-inc-sigi-q4-2020-earning/"},{"c":"SIGI 2020 Q4","e":"sigi","d":"2021-01-29","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"For smaller accounts with policy premiums of less than $10,000, renewal pure price increased 4.2% in the quarter, while larger accounts in excess of $100,000 of premium generated renewal pure price increases of 6.2%.","url":"https://www.fool.com/earnings/call-transcripts/2021/01/29/selective-insurance-group-inc-sigi-q4-2020-earning/"},{"c":"SIGI 2020 Q4","e":"sigi","d":"2021-01-29","l":"cost_cuts","r":"management","s":"John J. Marchioni","x":"The roll out of our new agency interface for small business remains on track and should continue to enhance our opportunities in this space by significantly streamlining the quoting and issuance process.","url":"https://www.fool.com/earnings/call-transcripts/2021/01/29/selective-insurance-group-inc-sigi-q4-2020-earning/"},{"c":"SIGI 2021 Q1","e":"sigi","d":"2021-04-30","l":"pricing_power","r":"management","s":"John J Marchioni","x":"Our solid premium growth of 11%, when adjusted for the prior year COVID-19-related audit premium accrual, was driven by overall renewal pure price increases averaging 5.4% and strong retention rates.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/selective-insurance-group-inc-sigi-q1-2021-earning/"},{"c":"SIGI 2021 Q1","e":"sigi","d":"2021-04-30","l":"pricing_power","r":"management","s":"John J Marchioni","x":"We've established a decade-long track record of obtaining renewal pure price increases that are in line with or above expected loss trend.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/selective-insurance-group-inc-sigi-q1-2021-earning/"},{"c":"SIGI 2021 Q2","e":"sigi","d":"2021-07-29","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"For the quarter, our solid net premiums written growth of 12% after adjusting for the prior year COVID '19 related personal and commercial auto credits was driven by overall renewal pure price increases averaging 5.1%, strong new business growth and stable retention rates.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/29/selective-insurance-group-inc-sigi-q2-2021-earning/"},{"c":"SIGI 2021 Q2","e":"sigi","d":"2021-07-29","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"While economic researches and strong market pricing are positive tailwinds that have helped our growth, our continued disciplined underwriting and focus on obtaining renewal pure price increases at or above expected loss trends have been equally important.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/29/selective-insurance-group-inc-sigi-q2-2021-earning/"},{"c":"SIGI 2021 Q2","e":"sigi","d":"2021-07-29","l":"cost_cuts","r":"management","s":"John J. Marchioni","x":"We significantly streamline the quoting and issuance process for eligible accounts and are experiencing a strong increase in small business submissions since the rollout.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/29/selective-insurance-group-inc-sigi-q2-2021-earning/"},{"c":"SIGI 2021 Q3","e":"sigi","d":"2021-10-28","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"For the quarter, our strong net premiums written growth of 13% was driven by renewal pure price increases averaging 5.3% for commercial lines and 5.6% for E&S. Exposure growth of approximately 3% on our renewable for commercial lines, solid commercial lines retention of 86%, and new business…","url":"https://www.fool.com/earnings/call-transcripts/2021/10/28/selective-insurance-group-inc-sigi-q3-2021-earning/"},{"c":"SIGI 2021 Q3","e":"sigi","d":"2021-10-28","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"For ten consecutive years, our renewal pure price increases have met or exceeded expected loss trend.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/28/selective-insurance-group-inc-sigi-q3-2021-earning/"},{"c":"SIGI 2024 Q4","e":"sigi","d":"2025-01-30","l":"pricing_power","r":"management","s":"John Marchioni","x":"The Personal Lines underlying combined ratio improved 9.6 points in 2024, as we implemented significant price increases, took meaningful underwriting actions to address underperforming business and continued transitioning to the mass affluent market.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/22/selective-sigi-q4-2024-earnings-transcript/"},{"c":"SIGI 2025 Q2","e":"sigi","d":"2025-07-24","l":"tariffs","r":"management","s":"John Joseph Marchioni","x":"We also have the overlay of potential tariff impacts that many are talking about and I think at least building into their forward view of potential loss trend increases -- and I think we still have the level of catastrophe volatility across the industry.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/22/selective-sigi-q2-2025-earnings-transcript/"},{"c":"SIGI 2025 Q2","e":"sigi","d":"2025-07-24","l":"pricing_power","r":"management","s":"John Joseph Marchioni","x":"Related to pricing, we continue to seek and achieve overall renewal pure price increases above expected loss trend.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/22/selective-sigi-q2-2025-earnings-transcript/"},{"c":"SIGI 2025 Q2","e":"sigi","d":"2025-07-24","l":"pricing_power","r":"management","s":"John Joseph Marchioni","x":"Property renewal pure price increases slowed in the quarter compared to our recent run rate, reflecting broader market conditions and improved profitability.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/22/selective-sigi-q2-2025-earnings-transcript/"},{"c":"SIGI 2025 Q3","e":"sigi","d":"2025-10-23","l":"pricing_power","r":"management","s":"John J. Marchioni","x":"Excess and surplus lines grew 14% in the quarter, driven by average renewal pure price increases of 8.3%.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/22/selective-sigi-q3-2025-earnings-transcript/"},{"c":"SIGI 2025 Q4","e":"sigi","d":"2026-01-30","l":"pricing_power","r":"management","s":"Patrick Brennan","x":"Standard Commercial Lines premium growth in the quarter was 5%, driven by renewal pure price increase of 7.5% or 8.5% excluding workers' compensation.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/21/selective-sigi-q4-2025-earnings-transcript/"},{"c":"SIGI 2025 Q4","e":"sigi","d":"2026-01-30","l":"pricing_power","r":"management","s":"Patrick Brennan","x":"While there was some deceleration in commercial auto pricing for physical damage, liability price increases continue to exceed 10%.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/21/selective-sigi-q4-2025-earnings-transcript/"},{"c":"SIGI 2026 Q1","e":"sigi","d":"2026-04-23","l":"pricing_power","r":"management","s":"Patrick Brennan","x":"Standard Commercial Lines net premiums written declined 1% as lower policy counts offset 7.1% renewal pure price increases and stronger new business pricing.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/23/selective-sigi-q1-2026-earnings-transcript/"},{"c":"SIGI 2026 Q1","e":"sigi","d":"2026-04-23","l":"pricing_power","r":"management","s":"Patrick Brennan","x":"Auto liability price increa