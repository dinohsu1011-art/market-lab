,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0491,"r5":0.0518,"r1_spy":0.0326,"r5_spy":0.0577,"r1_sector":0.0492,"r5_sector":0.0949,"etf":"XLK"}}],"quotes":[{"c":"UBER 2020 Q1","e":"uber","d":"2020-05-07","l":"cost_cuts","r":"management","s":"Dara Khosrowshahi","x":"Yesterday, consistent with lower trip volumes and our hiring freeze, we announced a reduction in our customer support and recruiting teams by more than 3,700 employees.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q1","e":"uber","d":"2020-05-07","l":"cost_cuts","r":"management","s":"Nelson Chai","x":"By focusing on efficiency and cost savings across the Rides P&L. In Eats, we continue to make progress demonstrated by our quarter-over-quarter segment EBITDA margin improvement of 46% as a percentage of ANR.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q2","e":"uber","d":"2020-08-07","l":"cost_cuts","r":"management","s":"Nelson Chai","x":"…operating expenses, which include pro forma adjustments such as stock-based compensation and restructuring charges, operations and support increased year-over-year to 19% from 16% of adjusted net revenue, however, was down $89 million on an absolute dollar basis, reflecting mitigating…","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q2","e":"uber","d":"2020-08-07","l":"cost_cuts","r":"management","s":"Nelson Chai","x":"In Q2 2020, corporate G&A and platform R&D of $490 million, which represents the G&A and R&D not allocated to one of our segments, decreased 21% due primarily to the layoffs we announced in May as well as lower accrued taxes associated with the decline in mobility.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q3","e":"uber","d":"2020-11-05","l":"theater","r":"management","s":"Dara Khosrowshahi","x":"…is coming, not only for an influx of new users, but also from higher engagement from existing users, with Delivery MAPC growth over 70% and trip growth over 110%, excluding markets that we exited, theatre, restaurant, delivery, driver retention, all increased year-on-year and quarter-on-quarter.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q3","e":"uber","d":"2020-11-05","l":"cost_cuts","r":"management","s":"Nelson Chai","x":"Turning now to non-GAAP operating expenses, which include pro forma adjustments such as stock-based compensation and restructuring charges.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q3","e":"uber","d":"2020-11-05","l":"cost_cuts","r":"management","s":"Nelson Chai","x":"Operations and support decreased to 12% from 13% of ANR and was down $119 million on an absolute dollar basis, reflecting the headcount reduction actions taken in the second quarter.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q4","e":"uber","d":"2021-02-10","l":"pricing_power","r":"management","s":"Nelson Chai","x":"And the price increases are manageable when compared to the 100-plus increases associated with traditional employment that we would have seen us exit most markets in California.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q4","e":"uber","d":"2021-02-10","l":"pricing_power","r":"management","s":"Nelson Chai","x":"And while the price increases have accounted for the majority of the cost to the customer, but we have seen slightly bigger impact in Mobility.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q4","e":"uber","d":"2021-02-10","l":"cost_cuts","r":"management","s":"Nelson Chai","x":"Turning now to non-GAAP operating expenses, which exclude pro forma adjustments such as stock-based compensation and restructuring charges.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2020 Q4","e":"uber","d":"2021-02-10","l":"cost_cuts","r":"management","s":"Nelson Chai","x":"Operations and support was down $123 million year-on-year, reflecting continued leverage from headcount reduction actions taken in the second quarter.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2021 Q1","e":"uber","d":"2021-05-05","l":"pricing_power","r":"management","s":"Dara Khosrowshahi","x":"Clearly, our model has pricing power.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2021 Q1","e":"uber","d":"2021-05-05","l":"pricing_power","r":"management","s":"Dara Khosrowshahi","x":"And what we have seen consistently with our businesses is that we got pricing power, generally, and this is a service.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2021 Q2","e":"uber","d":"2021-08-04","l":"pricing_power","r":"management","s":"Dara Khosrowshahi","x":"It's still up year-on-year, but the pace of the price increases looks like it's easing as we get into a more normalized supply situation, which we think is a great as a real positive for the marketplace.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2021 Q2","e":"uber","d":"2021-08-04","l":"cost_cuts","r":"analyst","s":"Youssef Squali","x":"Can you maybe revisit long-term margins of the business across both Rides and Eats that you've shared with us pre-COVID arguably obviously you're in a much, much better financial situation with all the cost savings et cetera.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2021 Q3","e":"uber","d":"2021-11-04","l":"pricing_power","r":"management","s":"Dara Khosrowshahi","x":"And I think it shows the pricing power of our service.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2021 Q3","e":"uber","d":"2021-11-04","l":"pricing_power","r":"management","s":"Dara Khosrowshahi","x":"…from other forms of transportation, one point I'll make is that, we have come back from the pandemic faster than almost any other mode of transportation, despite higher pricing, which goes to the earlier comment that I made about the utility of our product and the pricing power that we've had.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2022 Q1","e":"uber","d":"2022-05-04","l":"pricing_power","r":"management","s":"Dara Khosrowshahi","x":"…multi-product business allows us to take learnings from one side of a business, apply it to the other, and instead of kind of starting from scratch, we've already – we're adolescence now using all open knowledge from our delivery business and passing it on to the mobility business.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2022 Q4","e":"uber","d":"2023-02-08","l":"cost_cuts","r":"analyst","s":"Eric Sheridan","x":"And then obviously, one of the more recurring themes during earnings season has been elements of continued efficiency and cost cutting within organizations.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2022 Q4","e":"uber","d":"2023-02-08","l":"guidance","r":"management","s":"Nelson Chai","x":"And again, as Dara mentioned, the year started off quite well, which is why you saw us raise guidance for the first quarter.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2023 Q1","e":"uber","d":"2023-05-02","l":"cost_cuts","r":"management","s":"Dara Khosrowshahi","x":"So like, we're innovating, we're building, while a bunch of people are restructuring, and I think that's a good position to be in.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2023 Q2","e":"uber","d":"2023-08-01","l":"pricing_power","r":"analyst","s":"Dara Khosrowshahi","x":"And then in certain other markets, where we have seen effective tort reform, et cetera, Georgia or Virginia, we're able to take prices down for consumers, which is exactly what you want, which puts a higher percentage of, let's say, the earnings in driver pockets, which is terrific.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2024 Q4","e":"uber","d":"2025-02-05","l":"pricing_power","r":"management","s":"Dara Khosrowshahi","x":"And the vast majority of that price increase has been hassle on cost insurance.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2024 Q4","e":"uber","d":"2025-02-05","l":"pricing_power","r":"management","s":"Dara Khosrowshahi","x":"And that part of the price increase is ultimately economically neutral.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2025 Q1","e":"uber","d":"2025-05-07","l":"pricing_power","r":"management","s":"Dara Khosrowshahi","x":"We are looking to modulate price increases, and you saw that in our results as well, but we’re not seeing--you know, basket size has continued to increase, so I think that was the leading indicator to the extent that there was macro uncertainty.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"UBER 2025 Q4","e":"uber","d":"2026-02-04","l":"ai_spend","r":"management","s":"Dara Khosrowshahi","x":"We are continuing to invest in a Salesforce, obviously enabled by AI, etc., so it is as efficient as can be.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/04/uber-uber-q4-2025-earnings-call-transcript/"},{"c":"UBER 2025 Q4","e":"uber","d":"2026-02-04","l":"cost_cuts","r":"management","s":"Balaji Krishnamurthy","x":"…with the amount of insurance reform and product-driven hundreds of millions of dollars of cost savings that we are seeing, we are in a position where insurance is going from a deleveraging cost item that gives us leverage and that allows us to hold prices flat or better in certain…","url":"https://www.fool.com/earnings/call-transcripts/2026/02/04/uber-uber-q4-2025-earnings-call-transcript/"},{"c":"UBER 2026 Q1","e":"uber","d":"2026-05-06","l":"ai_spend","r":"management","s":"Dara Khosrowshahi","x":"It means that our investment in AI tools and infrastructure is increasing.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/06/uber-uber-q1-2026-earnings-call-transcript/"},{"c":"UBER 2026 Q1","e":"uber","d":"2026-05-06","l":"ai_spend","r":"management","s":"Dara Khosrowshahi","x":"But if every person in this company can increase their throughput by 20%, 30%, 50%, 100% then I think metering headcount growth and leaning in on AI investment is going to be well worth it.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/06/uber-uber-q1-2026-earnings-call-transcript/"},{"c":"UBER 2026 Q1","e":"uber","d":"2026-05-06","l":"cost_cuts","r":"analyst","s":"Douglas Anmuth","x":"Dara, can you just talk about how the early benefits of insurance cost savings are playing out in L.A. and San Francisco?","url":"https://www.fool.com/earnings/call-transcripts/2026/05/06/uber-uber-q1-2026-earnings-call-transcript/"},{"c":"UBER 2026 Q2","e":"uber","d":"2026-08-05","l":"ai_spend","r":"management","s":"Dara Khosrowshahi","x":"And we see sometimes the results of like trying to go too fast and like some of these AI companies with data centers, they were kind of pushing through, you could argue too quickly with NDAs, et cetera.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/12/uber-uber-q2-2026-earnings-call-transcript/"},{"c":"UBER 2026 Q2","e":"uber","d":"2026-08-05","l":"ai_spend","r":"management","s":"Balaji Krishnamurthy","x":"The first one is the investments we're making in AI, they should result in productivity gains, and that should allow us to be moderating some of the headcount additions.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/