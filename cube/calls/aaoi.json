,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}]},"move":{"r1":0.0691,"r5":0.1271,"r1_spy":0.066,"r5_spy":0.0942,"r1_sector":0.0546,"r5_sector":0.057,"etf":"XLK"}}],"quotes":[{"c":"AAOI 2018 Q3","e":"aaoi","d":"2018-11-07","l":"tariffs","r":"management","s":"Stefan J. Murry","x":"Before turning to our outlook, I would like to make a few comments on the tariff situation with China.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/07/applied-optoelectronics-inc-aaoi-q3-2018-earnings.aspx"},{"c":"AAOI 2018 Q3","e":"aaoi","d":"2018-11-07","l":"tariffs","r":"management","s":"Stefan J. Murry","x":"While a small number of these are on the tariff list, we believe there will be minimal impact overall from tariffs on AOI's business.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/07/applied-optoelectronics-inc-aaoi-q3-2018-earnings.aspx"},{"c":"AAOI 2018 Q3","e":"aaoi","d":"2018-11-07","l":"pricing_power","r":"analyst","s":"Paul Silverstein","x":"And so if we look at your other -- well, I'll pass it on to others, and I'll come back.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/07/applied-optoelectronics-inc-aaoi-q3-2018-earnings.aspx"},{"c":"AAOI 2018 Q4","e":"aaoi","d":"2019-02-21","l":"cost_cuts","r":"management","s":"Stefan Murry","x":"We believe the new and innovative technologies that we have developed and cost reduction efforts position us well to continue to expand the reach of our products to a broad group of data center customers and diversify our customer base.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/21/applied-optoelectronics-inc-aaoi-q4-2018-earnings.aspx"},{"c":"AAOI 2019 Q2","e":"aaoi","d":"2019-08-07","l":"tariffs","r":"management","s":"Stefan Murry","x":"We have had significant interest from customers in our ability to manufacture in Taiwan, and what we can do is move some of the manufacturing operations between our Taiwan and China factories such that we can add additional capacity if needed as these tariffs come on board.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/09/applied-optoelectronics-inc-aaoi-q2-2019-earnings.aspx"},{"c":"AAOI 2019 Q2","e":"aaoi","d":"2019-08-07","l":"tariffs","r":"management","s":"Stefan Murry","x":"And that's our plan should the tariffs come in place.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/09/applied-optoelectronics-inc-aaoi-q2-2019-earnings.aspx"},{"c":"AAOI 2019 Q3","e":"aaoi","d":"2019-11-06","l":"tariffs","r":"management","s":"Dr. Stefan Murry","x":"Before turning to our outlook, I would like to provide an update on the ongoing China trade and tariff dynamics.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/06/applied-optoelectronics-inc-aaoi-q3-2019-earnings.aspx"},{"c":"AAOI 2020 Q1","e":"aaoi","d":"2020-05-08","l":"cost_cuts","r":"management","s":"Stefan J. Murry","x":"As we mentioned in our prepared remarks, the a lot of the cost reduction efforts that we intended to do during the quarter were not able to be completed during the quarter because of the shutdown in China.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/08/applied-optoelectronics-inc-aaoi-q1-2020-earnings.aspx"},{"c":"AAOI 2020 Q1","e":"aaoi","d":"2020-05-08","l":"cost_cuts","r":"management","s":"Stefan J. Murry","x":"And so we weren't able to finish a lot of the cost reduction work that we intended to do.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/08/applied-optoelectronics-inc-aaoi-q1-2020-earnings.aspx"},{"c":"AAOI 2020 Q2","e":"aaoi","d":"2020-08-07","l":"tariffs","r":"management","s":"Dr. Stefan Murry","x":"I think right now, the focus has largely been due to the tariff situation, not because they necessarily have a mandate to move out of China.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/07/applied-optoelectronics-inc-aaoi-q2-2020-earnings.aspx"},{"c":"AAOI 2020 Q2","e":"aaoi","d":"2020-08-07","l":"tariffs","r":"analyst","s":"Fahad Najam","x":"Can you share with us today how much of your production is outside of China now versus before the tariff situation?","url":"https://www.fool.com/earnings/call-transcripts/2020/08/07/applied-optoelectronics-inc-aaoi-q2-2020-earnings.aspx"},{"c":"AAOI 2020 Q2","e":"aaoi","d":"2020-08-07","l":"pricing_power","r":"analyst","s":"Paul Silverstein","x":"I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/07/applied-optoelectronics-inc-aaoi-q2-2020-earnings.aspx"},{"c":"AAOI 2020 Q2","e":"aaoi","d":"2020-08-07","l":"cost_cuts","r":"management","s":"Dr. Thompson Lin","x":"We expect that continued improvement through our cost reduction efforts and more favorable product mix will lead to improving gross margin over the next several quarters.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/07/applied-optoelectronics-inc-aaoi-q2-2020-earnings.aspx"},{"c":"AAOI 2020 Q2","e":"aaoi","d":"2020-08-07","l":"cost_cuts","r":"management","s":"Dr. Stefan Murry","x":"And that's due to a number of factors, but certainly cost reduction overall coming from higher fab utilization is a big part of that.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/07/applied-optoelectronics-inc-aaoi-q2-2020-earnings.aspx"},{"c":"AAOI 2020 Q3","e":"aaoi","d":"2020-11-05","l":"cost_cuts","r":"management","s":"Thompson Lin","x":"And that gross margin of 27.4% was abakada drench of 25 to 26.5% due to favorable predominates, coupled with benefit from our cost reduction.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/06/applied-optoelectronics-inc-aaoi-q3-2020-earnings/"},{"c":"AAOI 2020 Q3","e":"aaoi","d":"2020-11-05","l":"cost_cuts","r":"management","s":"Stefan Murry","x":"And we expect our gross margins to further benefit in q4 from continued favorable product mix and our cost reduction efforts.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/06/applied-optoelectronics-inc-aaoi-q3-2020-earnings/"},{"c":"AAOI 2020 Q4","e":"aaoi","d":"2021-02-25","l":"pricing_power","r":"analyst","s":"Paul Silverstein","x":"I'll pass it on, guys.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/25/applied-optoelectronics-inc-aaoi-q4-2020-earnings/"},{"c":"AAOI 2021 Q4","e":"aaoi","d":"2022-02-24","l":"cost_cuts","r":"management","s":"Stefan Murry","x":"While 100G margins are likely to continue to remain pressured, we expect these products to represent a smaller contribution to data center revenue as 400G begins its ramp, and we begin to see cost reduction associated with the transition to volume production.","url":"https://www.fool.com/earnings/call-transcripts/2022/02/25/applied-optoelectronics-aaoi-q4-2021-earnings-call/"},{"c":"AAOI 2021 Q4","e":"aaoi","d":"2022-02-24","l":"cost_cuts","r":"management","s":"Stefan Murry","x":"On the CATV front, we have a number of cost reduction efforts that have been implemented to reduce raw material and production costs for our highest-volume products.","url":"https://www.fool.com/earnings/call-transcripts/2022/02/25/applied-optoelectronics-aaoi-q4-2021-earnings-call/"},{"c":"AAOI 2022 Q2","e":"aaoi","d":"2022-08-04","l":"cost_cuts","r":"management","s":"Stefan Murry","x":"So that kind of offsets what would otherwise be cost savings from other areas.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/05/applied-optoelectronics-aaoi-q2-2022-earnings-call/"},{"c":"AAOI 2022 Q2","e":"aaoi","d":"2022-08-04","l":"cost_cuts","r":"management","s":"Stefan Murry","x":"…to see improvement in gross margin toward the end of the year based on some of the new products that we have kicking in more meaningfully contributing to revenue at that time and also some of the anticipated cost reduction, the combination of some of the cost reduction efforts that we have had.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/05/applied-optoelectronics-aaoi-q2-2022-earnings-call/"},{"c":"AAOI 2025 Q2","e":"aaoi","d":"2025-08-07","l":"tariffs","r":"management","s":"Stefan Murry","x":"In addition to R&D, SG&A costs also increased by $2.5 million compared to Q1, which is mostly due to increased shipping costs as we imported certain products ahead of tariff increases and supported shipping of samples and prototypes to customers, along with expenses from the OFC trade show in April.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2025 Q2","e":"aaoi","d":"2025-08-07","l":"tariffs","r":"management","s":"Stefan Murry","x":"Notably, tariffs were not a material factor to our income statement in Q2.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2025 Q2","e":"aaoi","d":"2025-08-07","l":"pricing_power","r":"analyst","s":"Michael Genovese","x":"I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2025 Q2","e":"aaoi","d":"2025-08-07","l":"cost_cuts","r":"management","s":"Thompson Lin","x":"This is major much bigger cost saving than what you're talking about.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2025 Q2","e":"aaoi","d":"2025-08-07","l":"cost_cuts","r":"management","s":"Stefan Murry","x":"There is still significant cost savings that we expect to achieve over the next few quarters in the cable TV business.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2025 Q4","e":"aaoi","d":"2026-02-26","l":"ai_spend","r":"management","s":"Thompson Lin","x":"During the quarter, we announced that we received our fourth 800G volume order from one of our major hyperscale customers to support its AI data center growth.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/26/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2025 Q4","e":"aaoi","d":"2026-02-26","l":"ai_spend","r":"management","s":"Stefan Murry","x":"Importantly, we saw, and continue to see, strong customer engagement around 800G and 1.6 terabit products, particularly as AI-driven data center investments accelerate.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/26/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2025 Q4","e":"aaoi","d":"2026-02-26","l":"tariffs","r":"management","s":"Stefan Murry","x":"During the fourth quarter, direct tariffs had a $1,200,000 impact on our income statement.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/26/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2025 Q4","e":"aaoi","d":"2026-02-26","l":"tariffs","r":"management","s":"Stefan Murry","x":"As it relates to tariffs, as I have previously mentioned, while we do utilize some imported components in our transceivers, many key components, like our laser chips, are already manufactured in the United States.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/26/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2025 Q4","e":"aaoi","d":"2026-02-26","l":"cost_cuts","r":"management","s":"Stefan Murry","x":"The year-over-year increase in our gross margin was driven primarily by our favorable product mix and our cost reduction efforts.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/26/applied-optoelectronics-aaoi-earnings-call/"},{"c":"AAOI 2026 Q1","e":"aaoi","d":"2026-05-07","l":"ai_spend","r":"management","s":"Stefan Murry","x":"We continue to see accelerating customer demand needed to support the next wave of AI infrastructure deployment, and we anticipate solid sequential revenue growth throughout this year, with a significantly larger ramp expected starting in Q3 as additional capacity comes online.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/07/aaoi-q1-2026-earnings-call-transcript/"},{"c":"AAOI 2026 Q1","e":"aaoi","d":"2026-05-07","l":"ai_spend","r":"management","s":"Stefan Murry","x":"Importantly, during the quarter, we saw and continue to see strong customer engagement around our 800G and 1.6T products, particularly as AI‑driven data center investments accelerate.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/07/aaoi-q1-2026-earnings-call-transcript/"},{"c":"AAOI 2026 Q1","e":"aaoi","d":"2026-05-07","l":"tariffs","r":"management","s":"Stefan Murry","x":"During the first quarter, direct tariffs had a $1.4 million impact on our income statement.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/07/aaoi-q1-2026-earnings-call-transcript/"},{"c":"AAOI 2026 Q1","e":"aaoi","d":"2026-05-07","l":"tariffs","r":"management","s":"Stefan Murry","x":"With the overturn of the AIPA tariff, we have applied for a refund, which we currently anticipate will be at least $5.7 million.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/07/aaoi-q1-2026-earnings-call-transcript/"},{"c":"AAOI 2026 Q3","e":"aaoi","d":"2026-11-05","l":"ai_spend","r":"management","s":"Chih-Hsiang Lin","x":"An important role in the AI infrastructure ecosystem.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/06/applied-optics-aaoi-q3-2026-earnings-call-transcript/"},{"c":"AAOI 2026 Q3","e":"aaoi","d":"2026-11-05","l":"ai_spend","r":"management","s":"Chih-Hsiang Lin","x":"We are well positioned to scale our manufacturing capability and support the next phase of AI data center deployment.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/06/applied-optics-aaoi-q3-2026-earnings-call-transcript/"}],"trends":{"theater":[[35,1,5471,0,0,0,3933,1188],[36,1,5670,0,0,0,4617,690],[37,1,5204,0,0,0,4302,594],[38,1,4718,0,0,0,3709,730],[39,1,4988,0,0,0,4151,550],[40,1,4061,0,0,0,3211,75],[41,1,5126,0,0,0,4339,485],[42,1,5797,0,0,0,4500,954],[43,1,3761,0,0,0,3392,198],[44,1,6078,0,0,0,4734,1057],[45,1,4310,0,0,0,3650,416],[46,1,6570,0,0,0,5065,1202],[47,1,2802,0,0,0,2622,0],[48,1,4007,0,0,0,3521,242],[50