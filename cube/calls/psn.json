guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}]},"move":{"r1":-0.0236,"r5":0.0374,"r1_spy":-0.0197,"r5_spy":0.0445}}],"quotes":[{"c":"PSN 2019 Q2","e":"psn","d":"2019-08-13","l":"pricing_power","r":"management","s":"Chuck Harrington","x":"We continue to run off contracts of lower margin or higher pass-through costs that tend to drive down margins.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/13/parsons-corporation-psn-q2-2019-earnings-call-tran.aspx"},{"c":"PSN 2019 Q3","e":"psn","d":"2019-11-12","l":"pricing_power","r":"analyst","s":"Gavin Parsons","x":"In regards to the pass-through work, can you quantify that for each of the two segments and when do you expect to be done with that?","url":"https://www.fool.com/earnings/call-transcripts/2019/11/19/parsons-corporation-psn-q3-2019-earnings-call-tran.aspx"},{"c":"PSN 2019 Q4","e":"psn","d":"2020-03-10","l":"pricing_power","r":"management","s":"Chuck Harrington","x":"The margin expansion was facilitated by five factors: selling more software and hardware products; acquiring higher-margin businesses; reshaping our portfolio as we continue to run off lower margin pass-through revenue; bidding on higher-margin pursuits; and effectively managing our cost structure.","url":"https://www.fool.com/earnings/call-transcripts/2020/03/11/parsons-corporation-psn-q4-2019-earnings-call-tran.aspx"},{"c":"PSN 2020 Q1","e":"psn","d":"2020-05-06","l":"pricing_power","r":"management","s":"Chuck Harrington","x":"This particular quarter, we also had a little bump in pass-through revenues, which tended to push down our margins a bit from that perspective.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/parsons-corporation-psn-q1-2020-earnings-call-tran.aspx"},{"c":"PSN 2020 Q1","e":"psn","d":"2020-05-06","l":"pricing_power","r":"management","s":"Carey Smith","x":"We had the new start contracts, combatant commander mission support, as well as, Kwajalein that had higher-than-normal pass-through costs.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/parsons-corporation-psn-q1-2020-earnings-call-tran.aspx"},{"c":"PSN 2020 Q1","e":"psn","d":"2020-05-06","l":"guidance","r":"management","s":"Chuck Harrington","x":"We reported our second consecutive quarter of double-digit organic revenue growth in our federal solutions business and we're maintaining our guidance issued earlier this year.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/parsons-corporation-psn-q1-2020-earnings-call-tran.aspx"},{"c":"PSN 2020 Q1","e":"psn","d":"2020-05-06","l":"guidance","r":"management","s":"George Ball","x":"So frankly, that's one of the reasons why we're pretty bullish and have maintained guidance, Joe.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/parsons-corporation-psn-q1-2020-earnings-call-tran.aspx"},{"c":"PSN 2025 Q2","e":"psn","d":"2025-08-06","l":"theater","r":"management","s":"Carey A. Smith","x":"We did deploy the system at 3 different locations across the theater.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/21/parsons-psn-q2-2025-earnings-transcript/"},{"c":"PSN 2025 Q3","e":"psn","d":"2025-11-05","l":"theater","r":"management","s":"Carey Smith","x":"A great example is we just deployed it over in the Ukraine and European theater and our timing results and location results were better than anticipated and additional units have now been purchased for the INDOPACOM region.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/21/parsons-psn-q3-2025-earnings-transcript/"},{"c":"PSN 2026 Q1","e":"psn","d":"2026-04-29","l":"theater","r":"management","s":"Louie Dipalma","x":"Is there a potential that your technology could be embedded into drones and other unmanned platforms to provide resiliency in the various theaters right now, whether it's the Middle East, Ukraine or the Asia Pacific.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/parsons-psn-q1-2026-earnings-call-transcript/"},{"c":"PSN 2026 Q1","e":"psn","d":"2026-04-29","l":"ai_spend","r":"management","s":"Carey Smith","x":"What we're seeing, Sangita, to your question is many of the GCC countries are using the periods of high oil prices to fund diversification into non-oil sectors and advanced technologies such as artificial intelligence and digital infrastructure so that they're less vulnerable to future price swings.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/parsons-psn-q1-2026-earnings-call-transcript/"},{"c":"PSN 2026 Q1","e":"psn","d":"2026-04-29","l":"ai_spend","r":"management","s":"Carey Smith","x":"There's artificial intelligence, $58.5 billion of investment in AI as well as showing all the command and control.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/parsons-psn-q1-2026-earnings-call-transcript/"},{"c":"PSN 2026 Q1","e":"psn","d":"2026-04-29","l":"guidance","r":"management","s":"Carey Smith","x":"We are reaffirming our 2026 guidance ranges, which Matt will review shortly.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/parsons-psn-q1-2026-earnings-call-transcript/"},{"c":"PSN 2026 Q1","e":"psn","d":"2026-04-29","l":"guidance","r":"management","s":"Matt Ofilos","x":"We are reiterating our 2026 guidance ranges provided on February 11 and based on our financial results for the first quarter of 2026 and our outlook for the remainder of the year.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/parsons-psn-q1-2026-earnings-call-transcript/"},{"c":"PSN 2026 Q2","e":"psn","d":"2026-07-29","l":"pricing_power","r":"management","s":"Matt Ofilos","x":"Second, the anticipated infrastructure ramp has been reduced by $125 million due to lower pass-through costs in North America and timing of new awards.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/07/parsons-psn-q2-2026-earnings-call-transcript/"},{"c":"PSN 2026 Q2","e":"psn","d":"2026-07-29","l":"pricing_power","r":"management","s":"Matt Ofilos","x":"While the lower pass-through has a negative effect on revenue, it benefits the Critical Infrastructure margins, which continue to deliver above 10% given strong labor growth at mid- to high single digits.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/07/parsons-psn-q2-2026-earnings-call-transcript/"},{"c":"PSN 2026 Q2","e":"psn","d":"2026-07-29","l":"guidance","r":"management","s":"Matt Ofilos","x":"Second half EBITDA in theory, would be raised, Louie, on -- so we took $118 million in charges, and we reduced guidance by $115 million.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/07/parsons-psn-q2-2026-earnings-call-transcript/"}],"trends":{"theater":[[38,1,6034,0,0,0,5058,693],[39,1,6325,0,0,0,5282,711],[40,1,8101,0,0,0,6406,1240],[41,1,10187,0,0,0,8890,879],[47,1,4979,0,0,0,4209,524],[62,1,7881,1,1,0,6108,1357],[63,1,7772,1,1,0,6172,1311],[64,1,8658,0,0,0,7002,1026],[65,1,10631,1,1,0,9323,782],[66,1,9880,0,0,0,8039,1408],[67,1,8650,1,1,0,6569,1469]],"cinema":[[38,1,6034,0,0,0,5058,693],[39,1,6325,0,0,0,5282,711],[40,1,8101,0,0,0,6406,1240],[41,1,10187,0,0,0,8890,879],[47,1,4979,0,0,0,4209,524],[62,1,7881,0,0,0,6108,1357],[63,1,7772,0,0,0,6172,1311],[64,1,8658,0,0,0,7002,1026],[65,1,10631,0,0,0,9323,782],[66,1,9880,0,0,0,8039,1408],[67,1,8650,0,0,0,6569,1469]],"imax":[[38,1,6034,0,0,0,5058,693],[39,1,6325,0,0,0,5282,711],[40,1,8101,0,0,0,6406,1240],[41,1,10187,0,0,0,8890,879],[47,1,4979,0,0,0,4209,524],[62,1,7881,0,0,0,6108,1357],[63,1,7772,0,0,0,6172,1311],[64,1,8658,0,0,0,7002,1026],[65,1,10631,0,0,0,9323,782],[66,1,9880,0,0,0,8039,1408],[67,1,8650,0,0,0,6569,1469]],"streaming":[[38,1,6034,0,0,0,5058,693],[39,1,6325,0,0,0,5282,711],[40,1,8101,0,0,0,6406,1240],[41,1,10187,0,0,0,8890,879],[47,1,4979,0,0,0,4209,524],[62,1,7881,0,0,0,6108,1357],[63,1,7772,0,0,0,6172,1311],[64,1,8658,0,0,0,7002,1026],[65,1,10631,0,0,0,9323,782],[66,1,9880,0,0,0,8039,1408],[67,1,8650,0,0,0,6569,1469]],"dtc":[[38,1,6034,0,0,0,5058,693],[39