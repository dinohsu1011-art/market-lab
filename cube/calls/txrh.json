0":0.0793,"r1_spy":0.1149,"r5_spy":0.0985,"r20_spy":0.0712,"r1_sector":0.1205,"r5_sector":0.1312,"r20_sector":0.1212,"etf":"XLY"}},{"id":"TXRH 2026 Q3","t":"TXRH","d":"2026-11-05","time":"amc","w":7707,"n":75,"url":"https://www.fool.com/earnings/call-transcripts/2026/11/06/texas-roadhouse-txrh-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[1,1,0,1.32],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0412,"r5":-0.0302,"r1_spy":-0.0444,"r5_spy":-0.0631,"r1_sector":-0.0407,"r5_sector":-0.0542,"etf":"XLY"}}],"quotes":[{"c":"TXRH 2018 Q1","e":"txrh","d":"2018-04-30","l":"pricing_power","r":"management","s":"W. Kent Taylor","x":"In late March, we implemented a menu price increase of approximately 0.8% to go along with the 0.3% menu price increase that we took in mid-December.","url":"https://www.fool.com/earnings/call-transcripts/2018/05/01/texas-roadhouse-txrh-q1-2018-earnings-conference-c.aspx"},{"c":"TXRH 2018 Q1","e":"txrh","d":"2018-04-30","l":"pricing_power","r":"management","s":"Scott Colosi","x":"I mean, this is one of those things that why we're so aggressive on our pricing, and people ask us about how much pricing power do we have and all this.","url":"https://www.fool.com/earnings/call-transcripts/2018/05/01/texas-roadhouse-txrh-q1-2018-earnings-conference-c.aspx"},{"c":"TXRH 2018 Q2","e":"txrh","d":"2018-07-30","l":"pricing_power","r":"management","s":"Kent Taylor","x":"We're looking at our New York stores as well but every year in the fall I sit down with all 60 of our market partners and we reevaluate pricing as we look to November, December as usual as it is typically the time of year we would look at price increases.","url":"https://www.fool.com/earnings/call-transcripts/2018/07/31/texas-roadhouse-txrh-q2-2018-earnings-conference-c.aspx"},{"c":"TXRH 2018 Q2","e":"txrh","d":"2018-07-30","l":"pricing_power","r":"management","s":"Scott Colosi","x":"I wouldn't be surprised if some of those folks would request somewhat higher price increases and I wouldn't be surprised if we took prices up a little bit.","url":"https://www.fool.com/earnings/call-transcripts/2018/07/31/texas-roadhouse-txrh-q2-2018-earnings-conference-c.aspx"},{"c":"TXRH 2018 Q3","e":"txrh","d":"2018-10-29","l":"tariffs","r":"management","s":"Tonya Robinson","x":"I think there is some risks out there, maybe you hear the suppliers talk about when it comes to some of the things going on in the economy, whether it's the tariffs or just other things out there, that put locking up out in the future at a premium right now.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/29/texas-roadhouse-inc-txrh-q3-2018-earnings-conferen.aspx"},{"c":"TXRH 2018 Q3","e":"txrh","d":"2018-10-29","l":"pricing_power","r":"management","s":"Kent Taylor","x":"In response to these expectations and the margin decline as we have already experienced, we will roll out a menu price increase of approximately 1.7% in mid-November.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/29/texas-roadhouse-inc-txrh-q3-2018-earnings-conferen.aspx"},{"c":"TXRH 2018 Q3","e":"txrh","d":"2018-10-29","l":"pricing_power","r":"management","s":"Scott M. Colosi","x":"The 1.7% menu pricing we are taking later this quarter, will help to offset some of this pressure, and as Kent mentioned earlier, we will continue to evaluate additional menu price increases as we see how 2019 plays out.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/29/texas-roadhouse-inc-txrh-q3-2018-earnings-conferen.aspx"},{"c":"TXRH 2018 Q4","e":"txrh","d":"2019-02-19","l":"tariffs","r":"management","s":"Tonya Robinson","x":"But some of the things we're hearing a lot -- some of the imports and exports to China, the tariffs some of the issues maybe there fueling over there with some of the swine flu and things like that that are happening could be impactful in the back half of the year.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/20/texas-roadhouse-txrh-q4-2018-earnings-conference-c.aspx"},{"c":"TXRH 2018 Q4","e":"txrh","d":"2019-02-19","l":"pricing_power","r":"management","s":"Scott Colosi","x":"In response, we are in the process of finalizing an additional menu price increase of approximately 1.5%, which will go into effect at the beginning of our second quarter.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/20/texas-roadhouse-txrh-q4-2018-earnings-conference-c.aspx"},{"c":"TXRH 2018 Q4","e":"txrh","d":"2019-02-19","l":"pricing_power","r":"analyst","s":"David Tarantino","x":"And on the price increase that you decided to take.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/20/texas-roadhouse-txrh-q4-2018-earnings-conference-c.aspx"},{"c":"TXRH 2019 Q1","e":"txrh","d":"2019-04-29","l":"pricing_power","r":"management","s":"Scott M. Colosi","x":"So -- and for example, if you take our sirloins, some markets may have taken a little bit more pricing on the sirloins back in November, but others didn't and that may have flipped in this last price increase where some took some -- some who had not taken a pricing on sirloins did this time.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/30/texas-roadhouse-inc-txrh-q1-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q1","e":"txrh","d":"2019-04-29","l":"pricing_power","r":"analyst","s":"Jeffrey Bernstein","x":"First just on the -- I guess, the most recent price increase, it would seemingly be the case that you're already aware of these updated assumptions for, I guess, now 7% to 8% increase in labor.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/30/texas-roadhouse-inc-txrh-q1-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q2","e":"txrh","d":"2019-07-29","l":"tariffs","r":"management","s":"Tonya Robinson","x":"We're hearing a little bit probably the same thing you all are hearing that some of this tariff activity and things like that may negatively impact beef prices going forward, don't know if that will happen or what cuts that will happen.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/29/texas-roadhouse-inc-txrh-q2-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q2","e":"txrh","d":"2019-07-29","l":"pricing_power","r":"analyst","s":"Jeffrey Bernstein","x":"And then my follow-up to an earlier question just in terms of the, I guess, the late first quarter or early second quarter price increase that you already took.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/29/texas-roadhouse-inc-txrh-q2-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q3","e":"txrh","d":"2019-10-28","l":"tariffs","r":"management","s":"Wayne Kent Taylor","x":"Maybe you could give us some outlook on what the tariffs will be at that time that might help us?","url":"https://www.fool.com/earnings/call-transcripts/2019/10/28/texas-roadhouse-inc-txrh-q3-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q3","e":"txrh","d":"2019-10-28","l":"tariffs","r":"management","s":"Tonya Robinson","x":"So some of what we're hearing is just maybe -- it wasn't -- it's not as bad as maybe what the expectation was, how it's coming off of the discussion that's been going on all year on tariffs and the swine fever and how that would impact beef.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/28/texas-roadhouse-inc-txrh-q3-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q3","e":"txrh","d":"2019-10-28","l":"pricing_power","r":"management","s":"Wayne Kent Taylor","x":"As a result, we plan to roll out a menu of price increase of approximately, 1.9% in late November to replace the menu pricing that will be rolling off.Whether this pricing action will be enough to offset inflation and maintain restaurant margins in 2020, will depend on a number of factors…","url":"https://www.fool.com/earnings/call-transcripts/2019/10/28/texas-roadhouse-inc-txrh-q3-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q3","e":"txrh","d":"2019-10-28","l":"pricing_power","r":"analyst","s":"David E. Tarantino","x":"And then, the follow-up I had was related to 2020 and I know, Kent, you just -- you mentioned that you're taking a 1.9% price increase and I think that's replacing 1.7%.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/28/texas-roadhouse-inc-txrh-q3-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q3","e":"txrh","d":"2019-10-28","l":"cost_cuts","r":"analyst","s":"Peter Saleh","x":"Is that the removal of the square footage in the cost savings?","url":"https://www.fool.com/earnings/call-transcripts/2019/10/28/texas-roadhouse-inc-txrh-q3-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q4","e":"txrh","d":"2020-02-20","l":"pricing_power","r":"management","s":"W. Kent Taylor","x":"We are in the process of assessing a second quarter price increase as approximately 1.5% rolls off at the end of March.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/20/texas-roadhouse-inc-txrh-q4-2019-earnings-call-tra.aspx"},{"c":"TXRH 2019 Q4","e":"txrh","d":"2020-02-20","l":"pricing_power","r":"management","s":"Tonya Robinson","x":"I mean, we're always going to be conservative on taking price.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/20/texas-roadhouse-inc-txrh-q4-2019-earnings-call-tra.aspx"},{"c":"TXRH 2020 Q1","e":"txrh","d":"2020-05-04","l":"pricing_power","r":"analyst","s":"David Palmer","x":"And I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/04/texas-roadhouse-inc-txrh-q1-2020-earnings-call-tra.aspx"},{"c":"TXRH 2020 Q1","e":"txrh","d":"2020-05-04","l":"cost_cuts","r":"management","s":"W. Kent Taylor","x":"Additionally, all of our restaurant managers continue to be paid salaries and bonuses and we have not laid off or furloughed any full-time Support Center employees.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/04/texas-roadhouse-inc-txrh-q1-2020-earnings-call-tra.aspx"},{"c":"TXRH 2020 Q1","e":"txrh","d":"2020-05-04","l":"cost_cuts","r":"management","s":"Tonya Robinson","x":"You've got payroll in there, as we mentioned, we haven't had any layoffs at the Support Center.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/04/texas-roadhouse-inc-txrh-q1-2020-earnings-call-tra.aspx"},{"c":"TXRH 2020 Q3","e":"txrh","d":"2020-10-28","l":"pricing_power","r":"management","s":"W. Kent Taylor","x":"To assist with margin improvement, we are rolling out a menu price increase of approximately 1% effective this week, with a positive mix trends that we are seeing from both our dine-in and to-go guests, we feel comfortable moving forward with this increase, which was originally scheduled for…","url":"https://www.fool.com/earnings/call-transcripts/2020/10/29/texas-roadhouse-inc-txrh-q3-2020-earnings-call-tra/"},{"c":"TXRH 2020 Q3","e":"txrh","d":"2020-10-28","l":"pricing_power","r":"analyst","s":"Jeff Farmer","x":"So you just mentioned taking some price increases, but in terms of thinking about the consumer pushback on those menu price increases?","url":"https://www.fool.com/earnings/call-transcripts/2020/10/29/texas-roadhouse-inc-txrh-q3-2020-earnings-call-tra/"},{"c":"TXRH 2020 Q4","e":"txrh","d":"2021-02-18","l":"pricing_power","r":"management","s":"Tonya Robinson","x":"Other than that we're not assuming a second price increase or anything like that later on in the year.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/18/texas-roadhouse-inc-txrh-q4-2020-earnings-call-tra/"},{"c":"TXRH 2020 Q4","e":"txrh","d":"2021-02-18","l":"pricing_power","r":"analyst","s":"John Glass","x":"Is this is an opportunity to sort of take a larger than average price increase?","url":"https://www.fool.com/earnings/call-transcripts/2021/02/18/texas-roadhouse-inc-txrh-q4-2020-earnings-call-tra/"},{"c":"TXRH 2021 Q1","e":"txrh","d":"2021-04-29","l":"pricing_power","r":"management","s":"Jerry Morgan","x":"To help offset some of these pressures, we implemented a 1.75% menu price increase, which went into effect yesterday.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/texas-roadhouse-inc-txrh-q1-2021-earnings-call-tra/"},{"c":"TXRH 2021 Q1","e":"txrh","d":"2021-04-29","l":"pricing_power","r":"analyst","s":"Jeffrey Bernstein","x":"One just on the inflation side besides the efficiencies that we've talked about that you've perhaps learned through the pandemic, just wondering whether you think the 1.75% price increase I think you said you took yesterday is enough to last it through year-end.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/texas-roadhouse-inc-txrh-q1-2021-earnings-call-tra/"},{"c":"TXRH 2021 Q2","e":"txrh","d":"2021-07-29","l":"pricing_power","r":"management","s":"Gerald L. Morgan","x":"We will have our normal internal conversations with operators regarding menu pricing several weeks from now with the target of implementing any price increase in late October.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/30/texas-roadhouse-inc-txrh-q2-2021-earnings-call-tra/"},{"c":"TXRH 2021 Q2","e":"txrh","d":"2021-07-29","l":"cost_cuts","r":"analyst","s":"Jeff Bernstein","x":"What do you think there may be incremental cost savings?","url":"https://www.fool.com/earnings/call-transcripts/2021/07/30/texas-roadhouse-inc-txrh-q2-2021-earnings-call-tra/"},{"c":"TXRH 2021 Q3","e":"txrh","d":"2021-10-28","l":"pricing_power","r":"management","s":"Gerald L. Morgan","x":"With the feedback from our operators, we implemented a menu price increase of approximately 4.2% last week.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/29/texas-roadhouse-inc-txrh-q3-2021-earnings-call-tra/"},{"c":"TXRH 2021 Q3","e":"txrh","d":"2021-10-28","l":"pricing_power","r":"management","s":"Tonya R. Robinson","x":"And given that we didn't take a price -- two price increases in 2020, we had to skip one, that gave us more comfort too that we could come in just a bit higher maybe than we normally would with that pricing this time.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/29/texas-roadhouse-inc-txrh-q3-2021-earnings-call-tra/"},{"c":"TXRH 2025 Q2","e":"txrh","d":"2025-08-07","l":"tariffs","r":"management","s":"Keith Humpic","x":"This guidance includes approximately 30 basis points of full-year 2025 inflation related to tariffs, which remains consistent with our initial estimates from last quarter.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/texas-roadhouse-txrh-q2-2025-earnings-transcript/"},{"c":"TXRH 2025 Q2","e":"txrh","d":"2025-08-07","l":"tariffs","r":"management","s":"Keith Humpic","x":"On the on the construction side, we really aren't seeing any impact yet from tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/texas-roadhouse-txrh-q2-2025-earnings-transcript/"},{"c":"TXRH 2025 Q2","e":"txrh","d":"2025-08-07","l":"pricing_power","r":"management","s":"Jerry Morgan","x":"Based on those conversations, we will take a menu price increase of approximately 1.7% at the beginning of the fourth quarter.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/texas-roadhouse-txrh-q2-2025-earnings-transcript/"},{"c":"TXRH 2025 Q2","e":"txrh","d":"2025-08-07","l":"guidance","r":"management","s":"Keith Humpic","x":"Looking ahead, we have increased our guidance for full-year inflation to approximately 5%, primarily due to higher than previously forecasted beef inflation, particularly in the third quarter.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/texas-roadhouse-txrh-q2-2025-earnings-transcript/"},{"c":"TXRH 2025 Q2","e":"txrh","d":"2025-08-07","l":"guidance","r":"management","s":"Keith Humpic","x":"With greater visibility into inflationary trends for the year, we have lowered our guidance for full-year wage and other labor inflation to approximately 4%.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/07/texas-roadhouse-txrh-q2-2025-earnings-transcript/"},{"c":"TXRH 2025 Q3","e":"txrh","d":"2025-11-06","l":"tariffs","r":"management","s":"Michael Bailen","x":"We have heard that utility costs are going up and tariffs would be something that maybe flow through there, but not expecting anything dramatic on that line as we know it right now.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/27/texas-roadhouse-txrh-q3-2025-earnings-transcript/"},{"c":"TXRH 2025 Q3","e":"txrh","d":"2025-11-06","l":"pricing_power","r":"management","s":"Gerald Morgan","x":"In addition, we haven't seen any noticeable change in guest behavior since our 1.7% menu price increase at the beginning of the fourth quarter.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/27/texas-roadhouse-txrh-q3-2025-earnings-transcript/"},{"c":"TXRH 2025 Q3","e":"txrh","d":"2025-11-06","l":"pricing_power","r":"analyst","s":"Andrew Strelzik","x":"And number two, on the pricing side, your price increases that you've been taking for the last couple of rounds here have been stepping up a little bit, not a ton, but a little bit.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/27/texas-roadhouse-txrh-q3-2025-earnings-transcript/"},{"c":"TXRH 2026 Q1","e":"txrh","d":"2026-05-07","l":"pricing_power","r":"management","s":"Mike Lenihan","x":"Included within this positive sales trend is the benefit of the 1.9% menu price increase that went into effect at the beginning of the second quarter.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/07/texas-roadhouse-txrh-q1-2026-earnings-transcript/"},{"c":"TXRH 2026 Q3","e":"txrh","d":"2026-11-05","l":"pricing_power","r":"management","s":"Mike Lenihan","x":"While consumers remain selective and value conscious, we have not seen signs of a meaningful shift in our guests' ordering behavior since implementing our 1% menu price increase at the beginning of the fourth quarter.","url":