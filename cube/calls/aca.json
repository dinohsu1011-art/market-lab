0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[4,4,0,7.77],"pricing_power":[2,2,0,3.88],"cost_cuts":[1,1,0,1.94],"guidance":[5,5,0,9.71,{"raise":5,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0135,"r5":0.0124,"r20":0.0022,"r1_spy":-0.0163,"r5_spy":-0.0056,"r20_spy":-0.0504}}],"quotes":[{"c":"ACA 2018 Q4","e":"aca","d":"2019-02-28","l":"cost_cuts","r":"management","s":"Antonio Carrillo","x":"Going back to the first stage priorities on Slide No. 7, in the Energy Equipment segment, we have taken actions that are expected to improve margins, applying lean manufacturing processes to our utility structure business and restructuring our Mexican operations.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/28/acacia-mining-aca-q4-2018-earnings-conference-call.aspx"},{"c":"ACA 2019 Q2","e":"aca","d":"2019-08-02","l":"guidance","r":"management","s":"Antonio Carrillo","x":"We are pleased to report our strong second quarter and first half results, which exceeded our initial financial forecasts and have positioned us to raise our guidance for full year 2019.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/15/arcosa-inc-aca-q2-2019-earnings-call-transcript.aspx"},{"c":"ACA 2019 Q2","e":"aca","d":"2019-08-02","l":"guidance","r":"management","s":"Scott C. Beasley","x":"Starting on page 6, I'll walk through the second quarter results for each segment, and then give additional color on our increased guidance.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/15/arcosa-inc-aca-q2-2019-earnings-call-transcript.aspx"},{"c":"ACA 2019 Q3","e":"aca","d":"2019-10-31","l":"tariffs","r":"management","s":"Antonio Carrillo","x":"Of course agricultural tariffs continue to create headwinds.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/31/arcosa-inc-aca-q3-2019-earnings-call-transcript.aspx"},{"c":"ACA 2019 Q3","e":"aca","d":"2019-10-31","l":"tariffs","r":"management","s":"Antonio Carrillo","x":"I think there's still some uncertainty around the -- all the China tariffs and the export for grains.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/31/arcosa-inc-aca-q3-2019-earnings-call-transcript.aspx"},{"c":"ACA 2019 Q3","e":"aca","d":"2019-10-31","l":"cost_cuts","r":"management","s":"Antonio Carrillo","x":"That said we have already taken actions to rightsize the business in the face of a more normalized demand.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/31/arcosa-inc-aca-q3-2019-earnings-call-transcript.aspx"},{"c":"ACA 2019 Q4","e":"aca","d":"2020-02-27","l":"cost_cuts","r":"management","s":"Scott Beasley","x":"But it has -- if you follow a drilling activity, it certainly has been hit in the last year and we've had to make a lot of changes to right-size that footprint to correspond to lower demand level.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/27/arcosa-inc-aca-q4-2019-earnings-call-transcript.aspx"},{"c":"ACA 2020 Q1","e":"aca","d":"2020-04-29","l":"pricing_power","r":"management","s":"Scott Beasley","x":"Higher volumes in both wind towers and utility structures drove our increased revenue, which was even more impressive given that lower pass-through steel prices were a pricing headwind for utility structures in the quarter.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/29/arcosa-inc-aca-q1-2020-earnings-call-transcript.aspx"},{"c":"ACA 2020 Q1","e":"aca","d":"2020-04-29","l":"cost_cuts","r":"management","s":"Antonio Carrillo","x":"However, we continue to take actions to right-size our costs.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/29/arcosa-inc-aca-q1-2020-earnings-call-transcript.aspx"},{"c":"ACA 2020 Q1","e":"aca","d":"2020-04-29","l":"cost_cuts","r":"management","s":"Scott Beasley","x":"In energy and barge, those are more variable cost structure, so we should be able to hold margins relatively consistent by right-sizing the footprint.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/29/arcosa-inc-aca-q1-2020-earnings-call-transcript.aspx"},{"c":"ACA 2020 Q1","e":"aca","d":"2020-04-29","l":"guidance","r":"management","s":"Antonio Carrillo","x":"The reality is that I don't think anyone really knows how deep and how slow this is going to be and that was the reason we withdrew our guidance because we don't know, the reality is that we don't know.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/29/arcosa-inc-aca-q1-2020-earnings-call-transcript.aspx"},{"c":"ACA 2020 Q2","e":"aca","d":"2020-07-31","l":"pricing_power","r":"management","s":"Scott Beasley","x":"We've had price increases in line with the industry averages across our footprint.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/31/arcosa-inc-aca-q2-2020-earnings-call-transcript.aspx"},{"c":"ACA 2020 Q2","e":"aca","d":"2020-07-31","l":"cost_cuts","r":"management","s":"Scott Beasley","x":"As we discussed on the last call, we've taken significant actions at our components facilities to right size for lower demand, and we have been EBITDA positive throughout the down cycle.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/31/arcosa-inc-aca-q2-2020-earnings-call-transcript.aspx"},{"c":"ACA 2020 Q3","e":"aca","d":"2020-10-29","l":"pricing_power","r":"analyst","s":"Bascome Majors","x":"One more and then I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/arcosa-inc-aca-q3-2020-earnings-call-transcript/"},{"c":"ACA 2020 Q4","e":"aca","d":"2021-02-26","l":"tariffs","r":"management","s":"Antonio Carrillo","x":"There were significant number of towers coming into the US market taking advantage of some still tariffs and trying -- and basically dumping towers into the US market.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/26/arcosa-inc-aca-q4-2020-earnings-call-transcript/"},{"c":"ACA 2021 Q1","e":"aca","d":"2021-04-30","l":"pricing_power","r":"management","s":"Scott Beasley","x":"We continue to see nice price increases across our footprint, although a mix shift to a few lower ASP plants resulted in a lower overall ASP.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/arcosa-inc-aca-q1-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q1","e":"aca","d":"2021-04-30","l":"pricing_power","r":"management","s":"Scott Beasley","x":"We have been able to pass through higher steel prices and have also benefited from strong residential and commercial demand for propane tanks, driven by COVID-related de-urbanization.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/arcosa-inc-aca-q1-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q2","e":"aca","d":"2021-08-05","l":"tariffs","r":"management","s":"Antonio Carrillo","x":"On the utility structures, our customers are able to pass that additional steel cost through their tariffs to the customers.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/05/arcosa-inc-aca-q2-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q2","e":"aca","d":"2021-08-05","l":"tariffs","r":"management","s":"Antonio Carrillo","x":"There needs to be some adjustment to the tariffs in the river system for them to be able to invest.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/05/arcosa-inc-aca-q2-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q2","e":"aca","d":"2021-08-05","l":"pricing_power","r":"management","s":"Antonio Carrillo","x":"We're managing our continued steel price inflation through proactive price increases across our operations.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/05/arcosa-inc-aca-q2-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q2","e":"aca","d":"2021-08-05","l":"pricing_power","r":"management","s":"Gail M. Peck","x":"Lastly, the inclusion of StonePoint was also dilutive to margins as we now include their revenues on a gross basis, inclusive of pass-through freight in line with our legacy businesses.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/05/arcosa-inc-aca-q2-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q2","e":"aca","d":"2021-08-05","l":"guidance","r":"management","s":"Gail M. Peck","x":"On the guidance topic, as you pointed out, we did maintain our guidance range of $270 million to $290 million of EBITDA, essentially looking at it in total.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/05/arcosa-inc-aca-q2-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q2","e":"aca","d":"2021-08-05","l":"guidance","r":"analyst","s":"Justin Laurence Bergner","x":"Or has cost pressure become more of a headwind in your maintained guide?","url":"https://www.fool.com/earnings/call-transcripts/2021/08/05/arcosa-inc-aca-q2-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q3","e":"aca","d":"2021-11-04","l":"pricing_power","r":"management","s":"Gail M. Peck","x":"The positive news is we have been proactively raising prices to mitigate the impact on our overall margins.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/04/arcosa-inc-aca-q3-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q3","e":"aca","d":"2021-11-04","l":"pricing_power","r":"management","s":"Gail M. Peck","x":"As a primarily build to stock business, we continue to closely monitor steel prices and have been successful thus far passing through increases, as the demand environment remains conducive.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/04/arcosa-inc-aca-q3-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q3","e":"aca","d":"2021-11-04","l":"cost_cuts","r":"management","s":"Antonio Carrillo","x":"As we continue to integrate the acquired companies and streamline our operations, we recently sold the assets of an asphalt operation, which came with StonePoint and was determined not to be strategic for Arcosa.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/04/arcosa-inc-aca-q3-2021-earnings-call-transcript/"},{"c":"ACA 2021 Q3","e":"aca","d":"2021-11-04","l":"cost_cuts","r":"management","s":"Gail M. Peck","x":"And that does reflect some one-time costs, as we wind down our Clinton, Illinois facility and as we right-size our capacity as we head into 2022.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/04/arcosa-inc-aca-q3-2021-earnings-call-transcript/"},{"c":"ACA 2025 Q4","e":"aca","d":"2026-02-27","l":"pricing_power","r":"management","s":"Gail Peck","x":"Excluding freight, which is a pass-through in our Construction Materials business, revenues increased 4%.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/27/arcosa-aca-q4-2025-earnings-call-transcript/"},{"c":"ACA 2025 Q4","e":"aca","d":"2026-02-27","l":"pricing_power","r":"management","s":"Gail Peck","x":"Steel pass-through was roughly flat year over year.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/27/arcosa-aca-q4-2025-earnings-call-transcript/"},{"c":"ACA 2025 Q4","e":"aca","d":"2026-02-27","l":"cost_cuts","r":"management","s":"Gail Peck","x":"For wind towers, adjusted EBITDA was roughly flat as we focused on rightsizing the business for lower production levels in 2026, resulting in a slight decline in margin year over year for the business.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/27/arcosa-aca-q4-2025-earnings-call-transcript/"},{"c":"ACA 2025 Q4","e":"aca","d":"2026-02-27","l":"cost_cuts","r":"management","s":"Antonio Carrillo","x":"Rightsizing the business to two facilities really reduces our exposure.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/27/arcosa-aca-q4-2025-earnings-call-transcript/"},{"c":"ACA 2026 Q1","e":"aca","d":"2026-05-01","l":"tariffs","r":"management","s":"Antonio Carrillo","x":"We're successfully addressing the recently implemented steel tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/01/arcosa-aca-q1-2026-earnings-call-transcript/"},{"c":"ACA 2026 Q1","e":"aca","d":"2026-05-01","l":"tariffs",