e":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0078,"r5":-0.0696,"r20":-0.1028,"r1_spy":-0.0156,"r5_spy":-0.084,"r20_spy":-0.1512}},{"id":"KNSL 2026 Q3","t":"KNSL","d":"2026-10-23","time":"bmo","w":7757,"n":84,"url":"https://www.fool.com/earnings/call-transcripts/2026/10/23/kinsale-capital-knsl-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[1,1,0,1.33]},"move":{"r1":-0.0669,"r5":-0.0709,"r20":0.012,"r1_spy":-0.0617,"r5_spy":-0.078,"r20_spy":0.075}}],"quotes":[{"c":"KNSL 2018 Q4","e":"knsl","d":"2019-02-22","l":"cost_cuts","r":"management","s":"Bryan Paul Petrucelli","x":"If you look at Lloyd's collectively, I think it was 23% market share in 2017, the 2018 statistics haven't been published yet, but AIG has always been the second largest writer of recent years and they're both going through a lot of restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/22/kinsale-capital-group-inc-knsl-q4-2018-earnings-co.aspx"},{"c":"KNSL 2019 Q2","e":"knsl","d":"2019-08-02","l":"pricing_power","r":"management","s":"Michael Patrick Kehoe","x":"…what we are talking about is some of the headlines you see in the trade press, where companies are reacting to poor financial results by revising underwriting strategies, in some cases, reducing capacity, in some cases, stepping back from certain lines of business, in some cases, raising prices.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/05/kinsale-capital-group-inc-knsl-q2-2019-earnings-ca.aspx"},{"c":"KNSL 2020 Q1","e":"knsl","d":"2020-05-01","l":"theater","r":"management","s":"Michael P. Kehoe","x":"Kinsale's property book focuses on industrial-type exposures in general: processing facilities, recyclers, warehouses, vacant properties,etc. We generally avoid occupancies like restaurants, gyms, theaters, etc, that may be more exposed to government shutdown orders.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/01/kinsale-capital-group-inc-knsl-q1-2020-earnings-ca.aspx"},{"c":"KNSL 2020 Q1","e":"knsl","d":"2020-05-01","l":"theater","r":"management","s":"Michael P. Kehoe","x":"Restaurants, theaters, gyms, things like that.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/01/kinsale-capital-group-inc-knsl-q1-2020-earnings-ca.aspx"},{"c":"KNSL 2020 Q1","e":"knsl","d":"2020-05-01","l":"pricing_power","r":"management","s":"Michael P. Kehoe","x":"After a long period of intense industry competition, many companies, standard and nonstandard, are restructuring their books of business, running off underperforming lines, reducing capacity, raising prices and canceling programs.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/01/kinsale-capital-group-inc-knsl-q1-2020-earnings-ca.aspx"},{"c":"KNSL 2020 Q2","e":"knsl","d":"2020-07-31","l":"pricing_power","r":"management","s":"Michael P. Kehoe","x":"After many years of intense competition, some competitors are experiencing adverse results and are withdrawing capacity, canceling some programs, raising prices, etc. We expect this dislocation to continue, thereby allowing Kinsale to grow at an elevated rate perhaps through 2021.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/31/kinsale-capital-group-inc-knsl-q2-2020-earnings-ca.aspx"},{"c":"KNSL 2020 Q3","e":"knsl","d":"2020-10-30","l":"cost_cuts","r":"management","s":"Michael P. Kehoe","x":"Some competitors are reacting to substandard results by restructuring books of business, canceling programs and withdrawing capacity.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/kinsale-capital-group-inc-knsl-q3-2020-earnings-ca/"},{"c":"KNSL 2020 Q3","e":"knsl","d":"2020-10-30","l":"cost_cuts","r":"management","s":"Michael P. Kehoe","x":"Separate and apart from that, you've got other competitors restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/kinsale-capital-group-inc-knsl-q3-2020-earnings-ca/"},{"c":"KNSL 2021 Q1","e":"knsl","d":"2021-04-30","l":"pricing_power","r":"management","s":"Michael P. Kehoe","x":"I think the fact that we have been aggressively raising prices well ahead of loss cost trend, going back to January of 2019 puts us in a great position to handle things like inflation.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/kinsale-capital-group-inc-knsl-q1-2021-earnings-ca/"},{"c":"KNSL 2021 Q2","e":"knsl","d":"2021-07-30","l":"pricing_power","r":"analyst","s":"Pablo Singzon","x":"So my first question, it seems like the improvement in accident year loss fix call it about one point from the first half last year to first half of this year, is low in light of a gap we're getting between price increases.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/30/kinsale-capital-group-inc-knsl-q2-2021-earnings-ca/"},{"c":"KNSL 2025 Q4","e":"knsl","d":"2026-02-13","l":"pricing_power","r":"management","s":"Michael Kehoe","x":"And as Stuart mentioned, right, our commercial auto is experiencing strong price increases.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/13/kinsale-knsl-q4-2025-earnings-call-transcript/"},{"c":"KNSL 2025 Q4","e":"knsl","d":"2026-02-13","l":"cost_cuts","r":"management","s":"Michael Kehoe","x":"And so it's a cost savings opportunity.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/13/kinsale-knsl-q4-2025-earnings-call-transcript/"},{"c":"KNSL 2026 Q3","e":"knsl","d":"2026-10-23","l":"ai_disruption","r":"management","s":"Salmaan K. Allibhai FCAS MAAA","x":"Kinsale is well positioned for a more competitive part of the insurance cycle and for the disruption that AI will bring to our industry.","url":"https://www.fool.com/earnings/call-transcripts/