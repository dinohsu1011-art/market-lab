er":[0,0,0,0.0],"cost_cuts":[4,3,1,6.31],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.1093,"r5":0.1006,"r20":-0.0005,"r1_spy":0.1032,"r5_spy":0.0885,"r20_spy":-0.0065}},{"id":"ICUI 2026 Q3","t":"ICUI","d":"2026-11-05","time":"amc","w":6910,"n":60,"url":"https://www.fool.com/earnings/call-transcripts/2026/11/06/icu-medical-icui-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[17,15,2,25.09],"pricing_power":[0,0,0,0.0],"cost_cuts":[7,5,2,10.33],"guidance":[1,0,1,1.48,{"raise":1,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0266,"r5":0.0576,"r1_spy":0.0235,"r5_spy":0.0247}}],"quotes":[{"c":"ICUI 2018 Q2","e":"icui","d":"2018-08-09","l":"tariffs","r":"management","s":"Vivek Jain","x":"And on the tariff, there's no tariff-specific stuff.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/09/icu-medical-inc-icui-q2-2018-earnings-conference-c.aspx"},{"c":"ICUI 2018 Q2","e":"icui","d":"2018-08-09","l":"tariffs","r":"analyst","s":"Larry Solow","x":"And have you guys seen any impact, maybe not direct, but indirect from cost of goods, inflationary issues from tariffs, cost of goods, or just non-tariff-related, any inflationary issues on your labor?","url":"https://www.fool.com/earnings/call-transcripts/2018/08/09/icu-medical-inc-icui-q2-2018-earnings-conference-c.aspx"},{"c":"ICUI 2018 Q2","e":"icui","d":"2018-08-09","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"Lastly, we do finally expect these restructuring integration charges, meaning real cash to slow down after Q3, and we want to get back to the bare minimum of non-GAAP adjustments, basically in line with what ICU did pre-deal.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/09/icu-medical-inc-icui-q2-2018-earnings-conference-c.aspx"},{"c":"ICUI 2018 Q2","e":"icui","d":"2018-08-09","l":"cost_cuts","r":"management","s":"Scott Lamb","x":"Restructuring, integration, and strategic transaction expenses were $19 million for the three months ended June 30th and were mostly related to our integration of the Hospira business.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/09/icu-medical-inc-icui-q2-2018-earnings-conference-c.aspx"},{"c":"ICUI 2018 Q3","e":"icui","d":"2018-11-08","l":"cost_cuts","r":"management","s":"Scott Lamb","x":"Restructuring, integration and strategic transaction expenses were $24 million for the 3 months ended September 30, and were mostly related to our integration of the Hospira business.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/08/icu-medical-inc-icui-q3-2018-earnings-conference-c.aspx"},{"c":"ICUI 2018 Q3","e":"icui","d":"2018-11-08","l":"cost_cuts","r":"management","s":"Scott Lamb","x":"Next, we expect to see net cost savings next year of $20 million to $30 million related to coming off the Pfizer TSAs and running the business on our own.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/08/icu-medical-inc-icui-q3-2018-earnings-conference-c.aspx"},{"c":"ICUI 2018 Q3","e":"icui","d":"2018-11-08","l":"guidance","r":"management","s":"Scott Lamb","x":"As Vivek already mentioned, based on what we are seeing for the remainder of this year, we are raising our 2018 guidance for adjusted EBITDA from a range of $270 million to $280 million to a range of $280 million to $290 million.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/08/icu-medical-inc-icui-q3-2018-earnings-conference-c.aspx"},{"c":"ICUI 2018 Q4","e":"icui","d":"2019-02-28","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"We based our 2019 view on an EBITDA run rate around the Q3 or Q4 2018 levels and adding to that the various TSA and operational cost savings and the earnings growth from at least some consumables growth.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/28/icu-medical-inc-icui-q4-2018-earnings-conference-c.aspx"},{"c":"ICUI 2018 Q4","e":"icui","d":"2019-02-28","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"Right now, we see Q1 2019 as sort of average plus cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/28/icu-medical-inc-icui-q4-2018-earnings-conference-c.aspx"},{"c":"ICUI 2019 Q1","e":"icui","d":"2019-05-09","l":"cost_cuts","r":"management","s":"Scott Lamb","x":"Restructuring, integration, and strategic transaction expenses were $24 million in the first quarter versus $22 million last year.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/09/icu-medical-inc-icui-q1-2019-earnings-call-transcr.aspx"},{"c":"ICUI 2019 Q2","e":"icui","d":"2019-08-07","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"We've largely concluded our integration efforts and delivered our TSA and other cost savings, but this can no longer offset and more competitive commercial environment primarily in our IV Solutions segment.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/08/icu-medical-inc-icui-q2-2019-earnings-call-transcr.aspx"},{"c":"ICUI 2019 Q2","e":"icui","d":"2019-08-07","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"The income statement was straightforward with a sequential decrease in revenues that led to a sequential decrease in earnings as most of the TSA cost savings have been in the P&L since the beginning of the year.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/08/icu-medical-inc-icui-q2-2019-earnings-call-transcr.aspx"},{"c":"ICUI 2019 Q3","e":"icui","d":"2019-11-11","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"We showed cost improvements on the P&L from TSA savings and operating efficiencies and our actual cash restructuring expenses have begun to come down.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/11/icu-medical-inc-icui-q3-2019-earnings-call-transcr.aspx"},{"c":"ICUI 2019 Q3","e":"icui","d":"2019-11-11","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"Restructuring and integration charges were down to $8 million and we added cash to our balance sheet before the Pursuit acquisition.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/11/icu-medical-inc-icui-q3-2019-earnings-call-transcr.aspx"},{"c":"ICUI 2019 Q4","e":"icui","d":"2020-02-27","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"Restructuring and integration charges were down to $11 million.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/27/icu-medical-inc-icui-q4-2019-earnings-call-transcr.aspx"},{"c":"ICUI 2019 Q4","e":"icui","d":"2020-02-27","l":"cost_cuts","r":"management","s":"Scott E. Lamb","x":"Restructuring, strategic transaction and integration expenses were down $30 million to $11 million in the fourth quarter versus $41 million last year.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/27/icu-medical-inc-icui-q4-2019-earnings-call-transcr.aspx"},{"c":"ICUI 2020 Q1","e":"icui","d":"2020-05-07","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"The vast majority of restructuring and integration charges were due to the Austin factory IT system cutover, as previously discussed.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/08/icu-medical-inc-icui-q1-2020-earnings-call-transcr.aspx"},{"c":"ICUI 2020 Q1","e":"icui","d":"2020-05-07","l":"cost_cuts","r":"management","s":"Brian Bonnell","x":"Restructuring, integration and strategic transaction expenses were $12 million in the first quarter versus $24 million last year.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/08/icu-medical-inc-icui-q1-2020-earnings-call-transcr.aspx"},{"c":"ICUI 2020 Q2","e":"icui","d":"2020-08-10","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"…and we were pleased with our level of profitability, given the reduction in volumes in our higher-margin products overlaid with the geographic mix and we were able to add a good amount of cash to our balance sheet, even after making the final payments to Pfizer as restructuring costs came down.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/10/icu-medical-inc-icui-q2-2020-earnings-call-transcr.aspx"},{"c":"ICUI 2020 Q2","e":"icui","d":"2020-08-10","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"Restructuring and integration charges were half the level of Q1.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/10/icu-medical-inc-icui-q2-2020-earnings-call-transcr.aspx"},{"c":"ICUI 2020 Q3","e":"icui","d":"2020-11-05","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"We added a good amount of cash to our balance sheet as restructuring and integration costs have dramatically reduced, and we paid back our revolver.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/06/icu-medical-inc-icui-q3-2020-earnings-call-transcr/"},{"c":"ICUI 2020 Q3","e":"icui","d":"2020-11-05","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"While we have generated margin from excess hardware sales and cost savings from discretionary expenses, the hit in absolute volumes to consumables has been a large negative.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/06/icu-medical-inc-icui-q3-2020-earnings-call-transcr/"},{"c":"ICUI 2020 Q4","e":"icui","d":"2021-02-25","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"We had our best quarter of free cash flow generation in the last 2.5 years and added $60 million to our balance sheet as operational improvements have materialized and restructuring and integration costs have dramatically reduced.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/26/icu-medical-inc-icui-q4-2020-earnings-call-transcr/"},{"c":"ICUI 2020 Q4","e":"icui","d":"2021-02-25","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"As a reminder of the net effect of the pandemic was neutral to down and earnings for the company in 2020, while we generated margin from excess hardware sales and cost savings discretionary expenses the hit an absolute volumes to consumables was a large negative.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/26/icu-medical-inc-icui-q4-2020-earnings-call-transcr/"},{"c":"ICUI 2021 Q1","e":"icui","d":"2021-05-06","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"We had our best Q1 of free cash flow generation ever and added $31 million to our balance sheet as operational improvements have materialized, and restructuring and integration costs have dramatically reduced.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/06/icu-medical-inc-icui-q1-2021-earnings-call-transcr/"},{"c":"ICUI 2021 Q1","e":"icui","d":"2021-05-06","l":"cost_cuts","r":"management","s":"Brian Michael Bonnell","x":"Restructuring, integration and strategic transaction expenses were down to $3 million in the first quarter versus $12 million last year.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/06/icu-medical-inc-icui-q1-2021-earnings-call-transcr/"},{"c":"ICUI 2021 Q2","e":"icui","d":"2021-08-04","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"We had a strong quarter of free cash flow generation and added $38 million to our balance sheet as operational improvements have materialized and restructuring and integration costs have dramatically reduced.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/04/icu-medical-inc-icui-q2-2021-earnings-call-transcr/"},{"c":"ICUI 2021 Q2","e":"icui","d":"2021-08-04","l":"cost_cuts","r":"management","s":"Brian Bonnell","x":"Restructuring, integration and strategic transaction expenses were $4 million in the second quarter versus $6 million last year.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/04/icu-medical-inc-icui-q2-2021-earnings-call-transcr/"},{"c":"ICUI 2021 Q3","e":"icui","d":"2021-11-03","l":"cost_cuts","r":"management","s":"Vivek Jain","x":"We had an extremely strong quarter of free cash flow generation of $62 million and