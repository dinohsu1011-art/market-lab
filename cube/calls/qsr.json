e":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0203,"r5":0.0518,"r1_spy":-0.0164,"r5_spy":0.0589}}],"quotes":[{"c":"QSR 2018 Q3","e":"qsr","d":"2018-10-24","l":"theater","r":"management","s":"Daniel Schwartz","x":"We're going to double drive-throughs, outdoor digital menu boards, kiosks internally and more open in the kitchen, giving the kind of full-kitchen-theater experience and some other exciting features.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/25/restaurant-brands-international-qsr-q3-2018-earnin.aspx"},{"c":"QSR 2018 Q3","e":"qsr","d":"2018-10-24","l":"cost_cuts","r":"management","s":"Daniel Schwartz","x":"Outdoor digital menu boards drive increased check, allow for integration with other technologies like mobile apps and provide franchisees cost savings on printed media and menu signage.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/25/restaurant-brands-international-qsr-q3-2018-earnin.aspx"},{"c":"QSR 2019 Q1","e":"qsr","d":"2019-04-29","l":"pricing_power","r":"management","s":"Matthew Dunnigan","x":"These payments and receipts are structured as pass-through in our lease contracts and on a net basis, there is no impact of this change to our financial results.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/29/restaurant-brands-international-inc-qsr-q1-2019-ea.aspx"},{"c":"QSR 2020 Q2","e":"qsr","d":"2020-08-07","l":"cost_cuts","r":"management","s":"Matthew Dunnigan","x":"Our Tim Hortons results were also affected by the one-time charge I mentioned, which is flowing through our cost of sales and is related to the restructuring of one of our suppliers during Q2.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/07/restaurant-brands-international-inc-qsr-q2-2020-ea.aspx"},{"c":"QSR 2020 Q4","e":"qsr","d":"2021-02-11","l":"pricing_power","r":"management","s":"Jose Cil","x":"Pricing through our app and white label, we think we have some pricing power there, certainly, and we've tested various different opportunities to look at pricing as a driver of transactions through our mobile app versus through third-party aggregators.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/restaurant-brands-international-inc-qsr-q4-2020-ea/"},{"c":"QSR 2020 Q4","e":"qsr","d":"2021-02-11","l":"pricing_power","r":"analyst","s":"Nicole Miller","x":"So we now are starting to see brands at scale flex pricing power in the marketplace.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/restaurant-brands-international-inc-qsr-q4-2020-ea/"},{"c":"QSR 2021 Q1","e":"qsr","d":"2021-04-30","l":"pricing_power","r":"analyst","s":"David Palmer","x":"Do you agree that you should be higher in sales per unit in '22 if Canada is reopened? and I'll pass it on, thanks.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/30/restaurant-brands-international-inc-qsr-q1-2021-ea/"},{"c":"QSR 2021 Q3","e":"qsr","d":"2021-10-25","l":"cost_cuts","r":"management","s":"Jose Cil","x":"Our biggest areas of addressable opportunity are clear and we're already at work on our plans to streamline our operations and drive superior guest service levels.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/25/restaurant-brands-international-inc-qsr-q3-2021-ea/"},{"c":"QSR 2021 Q3","e":"qsr","d":"2021-10-25","l":"cost_cuts","r":"management","s":"Jose Cil","x":"So we're sharing those practices and we're also leveraging technology and streamlining operations wherever possible to make this transition in this challenging moment would be more kind of be friendlier to operations to allow for staffing levels to get to the places we need them to get to drive…","url":"https://www.fool.com/earnings/call-transcripts/2021/10/25/restaurant-brands-international-inc-qsr-q3-2021-ea/"},{"c":"QSR 2025 Q4","e":"qsr","d":"2026-02-12","l":"tariffs","r":"management","s":"Josh Kobza","x":"In Canada, Tim Hortons delivered solid top line sales performance, which helped offset headwinds from tariffs and increased operating commodity costs, including coffee.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/12/rbi-qsr-q4-2025-earnings-call-transcript/"},{"c":"QSR 2025 Q4","e":"qsr","d":"2026-02-12","l":"tariffs","r":"management","s":"Josh Kobza","x":"As previously discussed, we believe these pressures are cyclical, as the increase is largely tied to US herd rebuilding coupled with tariff impacts and upstream labor shortages.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/12/rbi-qsr-q4-2025-earnings-call-transcript/"},{"c":"QSR 2026 Q2","e":"qsr","d":"2026-08-06","l":"pricing_power","r":"analyst","s":"Joshua Kobza","x":"I think the kind of menu price increases have been running probably low single digits, but I think we've been pretty restrained on those.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/13/restaurant-brands-qsr-q2-2026-earnings-call-transcript/"},{"c":"QSR 2026 Q3","e":"qsr","d":"2026-10-29","l":"tariffs","r":"management","s":"Sami Siddiqui","x":"Organic AOI growth this quarter included approximately $11 million of tariff refunds in our Tim Hortons U.S. CPG business related to tariffs incurred last year.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/29/restaurant-brands-qsr-q3-2026-earnings-call-transcript/"},{"c":"QSR 2026 Q3","e":"qsr","d":"2026-10-29","l":"cost_cuts","r":"management","s":"Joshua Kobza","x":"Second, as part of our efforts to streamline operations and refocus on our core menu, we made a deliberate decision to scale back our wings offering.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/29/restaurant-brands-qsr-q3-2026-earnings-call-transcript/"}],"trends":{"theater":[[35,1,9530,1,1,0,7399,1687],[36,1,8831,0,0,0,7329,1114],[37,1,10141,0,0,0,8034,1514],[38,1,9522,0,0,0,7903,1125],[39,1,10075,0,0,0,8836,812],[40,1,12983,0,0,0,11675,853],[41,1,9046,0,0,0,7978,768],[42,1,10714,0,0,0,9502,915],[43,1,10728,0,0,0,9601,834],[44