":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[6,2,4,12.99],"pricing_power":[1,0,1,2.17],"cost_cuts":[0,0,0,0.0],"guidance":[2,0,2,4.33,{"raise":2,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0962,"r5":0.0649,"r20":0.095,"r1_spy":0.0882,"r5_spy":0.0352,"r20_spy":0.0371}},{"id":"MATX 2026 Q3","t":"MATX","d":"2026-11-04","time":"amc","w":5402,"n":31,"url":"https://www.fool.com/earnings/call-transcripts/2026/11/05/matson-matx-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[2,0,2,3.76],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[1,0,1,1.88]},"move":{"r1":0.0115,"r5":0.0028,"r1_spy":0.0556,"r5_spy":0.0119}}],"quotes":[{"c":"MATX 2018 Q3","e":"matx","d":"2018-11-05","l":"tariffs","r":"management","s":"Matthew Cox","x":"Since our last earnings call, the US has implemented additional tariff measure of 10%, on an incremental $200 billion in imported goods, on the heels of the 25% on the initial $50 billion in imported goods.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/05/matson-inc-matx-q3-2018-earnings-conference-call-t.aspx"},{"c":"MATX 2018 Q3","e":"matx","d":"2018-11-05","l":"tariffs","r":"management","s":"Matthew Cox","x":"Although nearly 20% of the goods that Matson transports are subject to these tariffs as of today, we've not seen any meaningful negative impact from these tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/05/matson-inc-matx-q3-2018-earnings-conference-call-t.aspx"},{"c":"MATX 2018 Q3","e":"matx","d":"2018-11-05","l":"pricing_power","r":"management","s":"Matthew Cox","x":"…fuel, what is less clear is the industry on the international sides track record of being able to pass through costs and in most -- in my mind, Jack its primarily a function of whether or not the international Ocean carriers can manage the supply and demand adequately to allow for those factors…","url":"https://www.fool.com/earnings/call-transcripts/2018/11/05/matson-inc-matx-q3-2018-earnings-conference-call-t.aspx"},{"c":"MATX 2018 Q3","e":"matx","d":"2018-11-05","l":"cost_cuts","r":"analyst","s":"Ben Nolan","x":"Okay, and then lastly for me, just on the -- circling back around to the timing, and the delivery over the last, the Matsonia being a few quarters late, obviously that probably has a little bit of an impact on the operating cost savings that you foresee getting out of that.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/05/matson-inc-matx-q3-2018-earnings-conference-call-t.aspx"},{"c":"MATX 2018 Q4","e":"matx","d":"2019-02-21","l":"tariffs","r":"management","s":"Matthew J. Cox","x":"Our China service saw higher average freight rates and higher volume compared to the fourth quarter of 2017, as a result of the stronger seasonal demand driven by the US China tariff situation.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/21/matson-inc-matx-q4-2018-earnings-conference-call-t.aspx"},{"c":"MATX 2018 Q4","e":"matx","d":"2019-02-21","l":"tariffs","r":"management","s":"Matthew J. Cox","x":"Both volume and rate in the quarter were positively impacted by stronger seasonal demand in a period that is traditionally not as strong, which we attribute primarily to a pull-forward demand effect due to the US-China tariff situation.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/21/matson-inc-matx-q4-2018-earnings-conference-call-t.aspx"},{"c":"MATX 2018 Q4","e":"matx","d":"2019-02-21","l":"pricing_power","r":"management","s":"Matthew J. Cox","x":"So international ocean carriers are focused on trying to get mechanisms in place that would allow for them to pass through the higher cost of the IMO fuel post 1/1.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/21/matson-inc-matx-q4-2018-earnings-conference-call-t.aspx"},{"c":"MATX 2018 Q4","e":"matx","d":"2019-02-21","l":"pricing_power","r":"analyst","s":"Michael Webber","x":"We certainly agree on the, I guess, the degree of skepticism around the international airlines (ph) ability to pass through an exogenous shock to their cost curve.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/21/matson-inc-matx-q4-2018-earnings-conference-call-t.aspx"},{"c":"MATX 2019 Q1","e":"matx","d":"2019-05-08","l":"pricing_power","r":"analyst","s":"Michael Webber","x":"But as it pertains to actually passing through I guess your fuel surcharge mechanism, one, are you guys going to look to secure your forward HSFO fuel supplies on a long-term basis?","url":"https://www.fool.com/earnings/call-transcripts/2019/05/08/matson-matx-q1-2019-earnings-call-transcript.aspx"},{"c":"MATX 2019 Q1","e":"matx","d":"2019-05-08","l":"pricing_power","r":"analyst","s":"Michael Webber","x":"So I guess the question is, I guess within the pass through mechanism, passing through all of your fuel costs, I guess is that done on, like, a real-time basis?","url":"https://www.fool.com/earnings/call-transcripts/2019/05/08/matson-matx-q1-2019-earnings-call-transcript.aspx"},{"c":"MATX 2019 Q1","e":"matx","d":"2019-05-08","l":"guidance","r":"management","s":"Matt Cox","x":"We are maintaining our outlook for Ocean Transportation operating income and we're raising our outlook for Logistics.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/08/matson-matx-q1-2019-earnings-call-transcript.aspx"},{"c":"MATX 2019 Q2","e":"matx","d":"2019-08-07","l":"tariffs","r":"management","s":"Matt Cox","x":"We believe volatility in Transpacific trade lane capacity and demand will continue into the second half of the year as capacity adjusts to tariff-related demand changes and the realities of the coming IMO 2020.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/08/matson-matx-q2-2019-earnings-call-transcript.aspx"},{"c":"MATX 2019 Q2","e":"matx","d":"2019-08-07","l":"tariffs","r":"management","s":"Matt Cox","x":"…in talking to our customers, is that customers -- if you were a customer that sourced only out of China, I think there's a lot of risk mitigation planning on developing sourcing from other countries to the extent that the U.S.-China situation worsens or if tariffs go up above even current levels.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/08/matson-matx-q2-2019-earnings-call-transcript.aspx"},{"c":"MATX 2019 Q2","e":"matx","d":"2019-08-07","l":"guidance","r":"management","s":"Matt Cox","x":"We are lowering our outlook for ocean transportation operating income and we are raising our outlook for logistics.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/08/matson-matx-q2-2019-earnings-call-transcript.aspx"},{"c":"MATX 2019 Q2","e":"matx","d":"2019-08-07","l":"guidance","r":"management","s":"Joel Wine","x":"As a result of the continued weakness in the Hawaii market and the higher operating costs of SSAT in the second quarter that are largely behind us, we are lowering our outlook for the full year.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/08/matson-matx-q2-2019-earnings-call-transcript.aspx"},{"c":"MATX 2019 Q3","e":"matx","d":"2019-11-07","l":"tariffs","r":"management","s":"Matt Cox","x":"But what we're seeing is, when we looked at 2018, and we said, because of all these tariffs and deadlines and we just saw this unbelievable contribution from our China tradelane, and what you're hearing us say now is that we now believe that both volume and rate have approached and will be the…","url":"https://www.fool.com/earnings/call-transcripts/2019/11/08/matson-matx-q3-2019-earnings-call-transcript.aspx"},{"c":"MATX 2019 Q4","e":"matx","d":"2020-02-25","l":"tariffs","r":"management","s":"Matt Cox","x":"Our China service outperformed the year-ago period which included the exceptionally strong seasonal demand, driven by the US-China tariff situation.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/26/matson-matx-q4-2019-earnings-call-transcript.aspx"},{"c":"MATX 2019 Q4","e":"matx","d":"2020-02-25","l":"tariffs","r":"management","s":"Matt Cox","x":"The decline in year-over-year volume is a function of stronger seasonal demand in the fourth quarter of 2018 as an effect of the US-China tariff situation, as well as the negative impact from a number of blank sailings in the transpacific trade lane in December of 2019.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/26/matson-matx-q4-2019-earnings-call-transcript.aspx"},{"c":"MATX 2020 Q1","e":"matx","d":"2020-05-05","l":"cost_cuts","r":"management","s":"Matt Cox","x":"In early April, we initiated an operating and capital cost reduction plan to address the profitability challenges we expect to encounter as the economy weakens while the recovery remains uncertain.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/matson-matx-q1-2020-earnings-call-transcript.aspx"},{"c":"MATX 2020 Q1","e":"matx","d":"2020-05-05","l":"cost_cuts","r":"management","s":"Matt Cox","x":"We have instituted a hiring freeze across the organization, and we announced today a salary reduction plan.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/matson-matx-q1-2020-earnings-call-transcript.aspx"},{"c":"MATX 2020 Q1","e":"matx","d":"2020-05-05","l":"guidance","r":"management","s":"Matt Cox","x":"On April 6, we withdrew our full-year outlook in light of the increasing economic uncertainties regarded the COVID-19 pandemic in the absence of outlook for the tradelanes, SSAT, and logistics.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/06/matson-matx-q1-2020-earnings-call-transcript.aspx"},{"c":"MATX 2020 Q4","e":"matx","d":"2021-02-23","l":"pricing_power","r":"management","s":"Joel M. Wine","x":"…growth with CLX+ as well as significant cost increases on containers, chassis and other equipment where we have seen price increases on many types of equipment of 50% to 150%, we now estimate our annual maintenance capex to be higher in the range of approximately $60 million to $70 million.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/23/matson-inc-matx-q4-2020-earnings-call-transcript/"},{"c":"MATX 2025 Q1","e":"matx","d":"2025-05-05","l":"tariffs","r":"management","s":"Matt Cox","x":"Looking ahead, we are lowering our 2025 outlook due to the significant uncertainty regarding tariffs and global trade, regulatory measures, the trajectory of the U.S. economy and other geopolitical factors.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/04/matson-matx-q1-2025-earnings-transcript/"},{"c":"MATX 2025 Q1","e":"matx","d":"2025-05-05","l":"tariffs","r":"management","s":"Matt Cox","x":"Currently, there is significant uncertainty regarding tariffs and global trade, regulatory measures, the trajectory of the U.S. economy and other geopolitical factors.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/04/matson-matx-q1-2025-earnings-transcript/"},{"c":"MATX 2025 Q1","e":"matx","d":"2025-05-05","l":"pricing_power","r":"management","s":"Matt Cox","x":"…activities underway between our retail customers and the importers or manufacturers of this product, as I mentioned earlier, about resetting pricing, what can move at what price, how does the burden get shared between those 3 actors and ultimately gets passed through to the end consumer.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/04/matson-matx-q1-2025-earnings-transcript/"},{"c":"MATX 2025 Q2","e":"matx","d":"2025-07-31","l":"tariffs","r":"management","s":"Matt Cox","x":"Starting on slide three, our second quarter financial performance exceeded our expectations amid the challenges of market uncertainty and volatility arising from tariffs and global trade.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/04/matson-matx-q2-2025-earnings-call-transcript/"},{"c":"MATX 2025 Q2","e":"matx","d":"2025-07-31","l":"tariffs","r":"management","s":"Matt Cox","x":"Looking ahead, we expect uncertainty regarding tariffs and global trade regulatory measures, the trajectory of the US economy, and other geopolitical factors to continue.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/04/matson-matx-q2-2025-earnings-call-transcript/"},{"c":"MATX 2025 Q2","e":"matx","d":"2025-07-31","l":"cost_cuts","r":"analyst","s":"Daniel Imbro","x":"I do not get the full expense detail on the 10-Q, but did you take any cost reduction actions during the quarter that should continue through the back half and into next year, just trying to figure out what is happening on the expense side?","url":"https://www.fool.com/earnings/call-transcripts/2025/08/04/matson-matx-q2-2025-earnings-call-transcript/"},{"c":"MATX 2025 Q2","e":"matx","d":"2025-07-31","l":"guidance","r":"management","s":"Matt Cox","x":"However, given our financial performance in the second quarter, and assuming these factors do not materially change from current conditions, we are raising our outlook for the full year 2025.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/04/matson-matx-q2-2025-earnings-call-transcript/"},{"c":"MATX 2026 Q1","e":"matx","d":"2026-05-04","l":"tariffs","r":"management","s":"Joel M. Wine","x":"…uptick is really the China trade and the demand drivers in some of our core segments that Matt talked about earlier—e-commerce, e-goods, garments—returning to a more normal traditional demand in the second quarter compared to last year’s second quarter, which had a lot of tariff impacts on it.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/04/matson-matx-q1-2026-earnings-call-transcript/"},{"c":"MATX 2026 Q1","e":"matx","d":"2026-05-04","l":"tariffs","r":"management","s":"Joel M. Wine","x":"The risks would be a dislocation—tariffs reenacted or other shocks to the system.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/04/matson-matx-q1-2026-earnings-call-transcript/"},{"c":"MATX 2026 Q1","e":"matx","d":"2026-05-04","l":"pricing_power","r":"analyst","s":"Jacob Gregory Lacks","x":"As you get into the third quarter, could you even over-recover given the investments you have made in scrubbers and LNG, or is this really a true pass-through?","url":"https://www.fool.com/earnings/call-transcripts/2026/05/04/matson-matx-q1-2026-earnings-call-transcript/"},{"c":"MATX 2026 Q1","e":"matx","d":"2026-05-04","l":"guidance","r":"analyst","s":"Matthew J. Cox","x":"Lastly, we are raising our full-year outlook for consolidated operating income and now expect to modestly exceed the level achieved in 2025.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/04/matson-matx-q1-2026-earnings-call-transcript/"},{"c":"MATX 2026 Q1","e":"matx","d":"2026-05-04","l":"guidance","r":"analyst","s":"Matthew J. Cox","x":"The primary driver behind raising outlook for consolidated operating income is the strengthening of freight demand in our China service post-Lunar New Year that we expect now to continue through peak season.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/04/matson-matx-q1-2026-earnings-call-transcript/"},{"c":"MATX 2026 Q3","e":"matx","d":"2026-11-04","l":"ai_spend","r":"analyst","s":"Matthew Cox","x":"I think the majority of the AI and data center demand still uses air freight.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/05/matson-matx-q3-2026-earnings-call-transcript/"},{"c":"MATX 2026 Q3","e":"matx","d":"2026-11-04","l":"ai_spend","r":"analyst","s":"Matthew Cox","x":"So -- but to answer your question, we do see AI data center commodities or materials that are flowing through our network.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/05/matson-matx-q3-2026-earnings-call-transcript/"},{"c":"MATX 2026 Q3","e":"matx","d":"2026-11-04","l":"ai_disruption","r":"analyst","s":"Matthew Cox","x":