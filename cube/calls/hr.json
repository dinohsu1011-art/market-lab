t":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0242,"r5":-0.0618,"r20":-0.1115,"r1_spy":-0.0314,"r5_spy":-0.098,"r20_spy":-0.1511}},{"id":"HR 2026 Q3","t":"HR","d":"2026-10-30","time":"bmo","w":8597,"n":88,"url":"https://www.fool.com/earnings/call-transcripts/2026/10/30/healthcare-realty-hr-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[7,0,7,8.32],"cost_cuts":[0,0,0,0.0],"guidance":[2,0,2,2.38,{"raise":2,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0199,"r5":0.0518,"r1_spy":0.0376,"r5_spy":0.0991}}],"quotes":[{"c":"HR 2018 Q3","e":"hr","d":"2018-11-02","l":"cost_cuts","r":"management","s":"Bethany Mancini","x":"This policy should further motivate hospitals to streamline care in off-campus settings and centralize higher acuity services on-campus, reinforcing the relative value and stability of on-campus outpatient care.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/02/healthcare-realty-trust-hr-q3-2018-earnings-confer.aspx"},{"c":"HR 2019 Q2","e":"hr","d":"2019-07-31","l":"theater","r":"management","s":"Bethany A. Mancini","x":"The political environment has certainly brought some theater to the healthcare sector since the beginning of the year, although actual health policy is expected to remain stable for the next 18 months leading up to the next election.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/31/healthcare-realty-trust-hr-q2-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q2","e":"hr","d":"2019-07-31","l":"theater","r":"management","s":"Todd J. Meredith","x":"All this, as Bethany said, is a lot of campaign theater right now.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/31/healthcare-realty-trust-hr-q2-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q2","e":"hr","d":"2019-07-31","l":"pricing_power","r":"management","s":"Todd J. Meredith","x":"I would definitely say it's more the latter, the pricing power.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/31/healthcare-realty-trust-hr-q2-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q2","e":"hr","d":"2019-07-31","l":"pricing_power","r":"management","s":"Todd J. Meredith","x":"But I would say generally speaking, it's an ability to just continue the momentum that you have, because of the pricing power with the competitive alternatives they are on is plentiful.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/31/healthcare-realty-trust-hr-q2-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q2","e":"hr","d":"2019-07-31","l":"cost_cuts","r":"management","s":"Bethany A. Mancini","x":"Health systems are looking to gain the correct balance of efficiency in acuity, cost savings, and revenue growth.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/31/healthcare-realty-trust-hr-q2-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q2","e":"hr","d":"2019-07-31","l":"guidance","r":"management","s":"Todd J. Meredith","x":"We see continued momentum, and we've increased our guidance for the year.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/31/healthcare-realty-trust-hr-q2-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q2","e":"hr","d":"2019-07-31","l":"guidance","r":"analyst","s":"Jordan Sadler","x":"He's been able to raise guidance on acquisitions and now it seems like you're optimistic around the high-end of the range even which is good.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/31/healthcare-realty-trust-hr-q2-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q3","e":"hr","d":"2019-11-05","l":"pricing_power","r":"management","s":"Kris Douglas","x":"In the third quarter, future contractual increases for the leases executed in the quarter were once again strong at 3.06%, while cash leasing spreads average 3.3% highlighting our pricing power, especially with the out-sized volume of renewals and 90% tenant retention this quarter.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/05/healthcare-realty-trust-hr-q3-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q3","e":"hr","d":"2019-11-05","l":"pricing_power","r":"management","s":"Kris Douglas","x":"And we think that, that's reasonable and sustainable based on our history, but then also if you look at it from the pricing power really goes to what your replacement cost is.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/05/healthcare-realty-trust-hr-q3-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q3","e":"hr","d":"2019-11-05","l":"cost_cuts","r":"management","s":"Todd J. Meredith","x":"…at today, Rich is really accumulation of all of the work we've been doing to really clean up the portfolio over the last several years, really try to focus on MOB, you've seen a lot of inpatient rehab sales over the last few years and really trying to streamline and get focused on the best MOB.","url":"https://www.fool.com/earnings/call-transcripts/2019/11/05/healthcare-realty-trust-hr-q3-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q4","e":"hr","d":"2020-02-13","l":"pricing_power","r":"management","s":"Bethany A. Mancini","x":"Moving past the political realm, hospital fundamentals appear strong with positive reimbursement rates and commercial price increases in 2020 and signs of stable admissions and revenue growth.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/13/healthcare-realty-trust-hr-q4-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q4","e":"hr","d":"2020-02-13","l":"cost_cuts","r":"management","s":"Todd Meredith","x":"And so, it may cause some restructuring in some uncertainty around that certainly from the health insurance side going from private to government.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/13/healthcare-realty-trust-hr-q4-2019-earnings-call-t.aspx"},{"c":"HR 2019 Q4","e":"hr","d":"2020-02-13","l":"guidance","r":"management","s":"Tau","x":"I'm just wondering what are the primary driver of that lower guidance?","url":"https://www.fool.com/earnings/call-transcripts/2020/02/13/healthcare-realty-trust-hr-q4-2019-earnings-call-t.aspx"},{"c":"HR 2020 Q1","e":"hr","d":"2020-05-08","l":"cost_cuts","r":"management","s":"Bethany Mancini","x":"We anticipate the cost savings and better revenue generated for lower acuity care to serve an additive role within the physician's office as providers meet greater healthcare demand from an aging population.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/08/healthcare-realty-trust-hr-q1-2020-earnings-call-t.aspx"},{"c":"HR 2020 Q2","e":"hr","d":"2020-08-06","l":"cost_cuts","r":"management","s":"Bethany A. Mancini","x":"CMS remains active on the regulatory front in pursuing several Medicare cost-saving initiatives.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/07/healthcare-realty-trust-hr-q2-2020-earnings-call-t.aspx"},{"c":"HR 2020 Q3","e":"hr","d":"2020-11-05","l":"guidance","r":"management","s":"Rob Hull","x":"We are raising guidance well above our top end from last quarter.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/06/healthcare-realty-trust-hr-q3-2020-earnings-call-t/"},{"c":"HR 2020 Q4","e":"hr","d":"2021-02-11","l":"cost_cuts","r":"management","s":"Kris Douglas","x":"And you've heard us talk about, it's finding -- a lot of times, it's finding the right tenant for the right size space.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/healthcare-realty-trust-hr-q4-2020-earnings-call-t/"},{"c":"HR 2020 Q4","e":"hr","d":"2021-02-11","l":"cost_cuts","r":"analyst","s":"Connor Siversky","x":"Just some of these changing dynamics within the healthcare industry either maybe further shifts in procedures to the outpatient environment, providers finding some cost savings there as well.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/11/healthcare-realty-trust-hr-q4-2020-earnings-call-t/"},{"c":"HR 2021 Q1","e":"hr","d":"2021-05-07","l":"pricing_power","r":"analyst","s":"Vikram Malhotra","x":"…as you think about underwriting here, are there certain areas you're focused on, or markets you're focused on, where you may feel you have a little bit more pricing power from an underwriting standpoint, just trying to figure out the underwriting in light of where costs are constructions going?","url":"https://www.fool.com/earnings/call-transcripts/2021/05/07/healthcare-realty-trust-hr-q1-2021-earnings-call-t/"},{"c":"HR 2021 Q1","e":"hr","d":"2021-05-07","l":"guidance","r":"management","s":"Rob Hull","x":"But the strength of our year today at acquisitions, we are raising our guidance range by 50 million at the midpoint with an upper end of 550 million.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/07/healthcare-realty-trust-hr-q1-2021-earnings-call-t/"},{"c":"HR 2021 Q2","e":"hr","d":"2021-08-05","l":"pricing_power","r":"management","s":"Kris Douglas","x":"This reflects our pricing power derived from our quality portfolio and attractive markets.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/05/healthcare-realty-trust-reit-inc-hr-q2-2021-earnin/"},{"c":"HR 2021 Q2","e":"hr","d":"2021-08-05","l":"guidance","r":"analyst","s":"Nick Yulico","x":"I was hoping to hear just a little bit more in terms of the transaction market and the decision to increase guidance on the acquisition side.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/05/healthcare-realty-trust-reit-inc-hr-q2-2021-earnin/"},{"c":"HR 2021 Q3","e":"hr","d":"2021-11-04","l":"pricing_power","r":"management","s":"Kris Douglas","x":"You end up with a small tenant close to campus if not as may not have as much pricing power as well.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/04/healthcare-realty-trust-reit-inc-hr-q3-2021-earnin/"},{"c":"HR 2021 Q3","e":"hr","d":"2021-11-04","l":"guidance","r":"management","s":"Todd Meredith","x":"We've increased our guidance again due to the strength of our pipeline and see the ability to sustain annual investment volumes of more than 10% of enterprise value in the years ahead.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/04/healthcare-realty-trust-reit-inc-hr-q3-2021-earnin/"},{"c":"HR 2021 Q3","e":"hr","d":"2021-11-04","l":"guidance","r":"analyst","s":"Connor Siversky","x":"So, with the reiterated guidance range, I think it was $28 million to $34 million.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/04/healthcare-realty-trust-reit-inc-hr-q3-2021-earnin/"},{"c":"HR 2025 Q2","e":"hr","d":"2025-08-01","l":"cost_cuts","r":"management","s":"Pete Scott","x":"Second action item: a significant organizational restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/05/healthcare-realty-hr-q2-2025-earnings-transcript/"},{"c":"HR 2025 Q2","e":"hr","d":"2025-08-01","l":"cost_cuts","r":"management","s":"Pete Scott","x":"We have implemented a new operating model that will drive meaningful cost savings and promote incremental accountability at the property level between our operations and leasing personnel.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/05/healthcare-realty-hr-q2-2025-earnings-transcript/"},{"c":"HR 2025 Q2","e":"hr","d":"2025-08-01","l":"guidance","r":"management","s":"Pete Scott","x":"We completed a very successful renewal of our revolver, extended the tenor of our term loans, and raised guidance.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/05/healthcare-realty-hr-q2-2025-earnings-transcript/"},{"c":"HR 2025 Q2","e":"hr","d":"2025-08-01","l":"guidance","r":"management","s":"Austin Helfrich","x":"In my remarks this morning, I will cover our second quarter results, progress on asset sales, balance sheet improvements, and increased 2025 guidance.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/05/healthcare-realty-hr-q2-2025-earnings-transcript/"},{"c":"HR 2025 Q3","e":"hr","d":"2025-10-31","l":"cost_cuts","r":"management","s":"Peter A. Scott","x":"But if you think about the organizational restructuring charges, but you also factor in that we had $2 million to $3 million less of G&A this quarter, right?","url":"https://www.fool.com/earnings/call-transcripts/2025/11/02/healthcare-realty-hr-earnings-call-transcript/"},{"c":"HR 2025 Q3","e":"hr","d":"2025-10-31","l":"cost_cuts","r":"analyst","s":"John Joseph Pawlowski","x":"Just two questions for me on the restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2025/11/02/healthcare-realty-hr-earnings-call-transcript/"},{"c":"HR 2025 Q4","e":"hr","d":"2026-02-13","l":"cost_cuts","r":"management","s":"Peter A. Scott","x":"And our outlook has improved to Stable from both Moody’s and S&P. We also took the long overdue step to rightsize our dividend, something HR 1.0 struggled with for over a decade.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/13/healthcare-realty-hr-earnings-call-transcript/"},{"c":"HR 2025 Q4","e":"hr","d":"2026-02-13","l":"cost_cuts","r":"management","s":"Peter A. Scott","x":"But, obviously, look, we are making a concerted effort to invest capital back into our portfolio, and that was one of the reasons why we decided to rightsize our dividend a couple of quarters ago to take that additional retained earnings and reinvest it back into redevelopment.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/13/healthcare-realty-hr-earnings-call-transcript/"},{"c":"HR 2026 Q1","e":"hr","d":"2026-05-01","l":"guidance","r":"management","s":"Peter Scott","x":"I mean I think about it as an opportunity to raise guidance a few more times as the year progresses.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/01/healthcare-realty-hr-q1-2026-earnings-transcript/"},{"c":"HR 2026 Q1","e":"hr","d":"2026-05-01","l":"guidance","r":"management","s":"Peter Scott","x":"Obviously, we put up some good results and we're able to raise guidance in the first quarter.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/01/healthcare-realty-hr-q1-2026-earnings-transcript/"},{"c":"HR 2026 Q2","e":"hr","d":"2026-07-31","l":"guidance","r":"management","s":"Daniel Gabbay","x":"I mean, numerically, right, we have increased our guidance range.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/07/healthcare-realty-trust-hr-q2-2026-earnings-call-transcript/"},{"c":"HR 2026 Q2","e":"hr","d":"2026-07-31","l":"guidance","r":"analyst","s":"Peter A. Scott","x":"And we have raised guidance every single quarter along the way.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/07/healthcare-realty-trust-hr-q2-2026-earnings-call-transcript/"},{"c":"HR 2026 Q3","e":"hr","d":"2026-10-30","l":"pricing_power","r":"analyst","s":"Pete Scott","x":"Second, pricing power.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/30/healthcare-realty-hr-q3-2026-earnings-call-transcript/"},{"c":"HR 2026 Q3","e":"hr","d":"2026-10-30","l":"pricing_power","r":"analyst","s":"Pete Scott","x":"So, big picture, we feel really good about the backdrop, and we are obviously going to push in every single area where we feel like we have pricing power.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/30/healthcare-realty-hr-q3-2026-earnings-call-transcript/"},{"c":"HR 2026 Q3","e":"hr","d":"2026-10-30","l":"guidance","r":"analyst","s":"Pete Scott","x":"Cash leasing spreads were 8.6%, and we are raising guidance for the third time this year.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/30/healthcare-realty-hr-q3-2026-earnings-call-transcript/"},{"c":"HR 2026 Q3","e":"hr","d":"2026-10-30","l":"guidance","r":"analyst","s":"Pete Scott","x":"We have raised guidance 3x, including by two pennies each of the last couple of quarters.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/30/healthcare-realty-hr-q3-2026-earnings-call-transcript/"}],"trends":{"theater":[[35,1,9055,0,0,0,6756,1805],[36,1,8