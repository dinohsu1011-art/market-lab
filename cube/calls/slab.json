3,10.77],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0773,"r5":0.0828,"r20":-0.0346,"r1_spy":0.0513,"r5_spy":0.0389,"r20_spy":-0.0895}}],"quotes":[{"c":"SLAB 2018 Q2","e":"slab","d":"2018-07-25","l":"streaming","r":"management","s":"Tyson Tuttle","x":"So those are used for like more streaming video and very high speed connections.","url":"https://www.fool.com/earnings/call-transcripts/2018/07/25/silicon-laboratories-slab-q2-2018-earnings-confere.aspx"},{"c":"SLAB 2018 Q2","e":"slab","d":"2018-07-25","l":"tariffs","r":"management","s":"John Hollister","x":"Before I turn the call over to Tyson, I would like to comment on recent activity involving tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2018/07/25/silicon-laboratories-slab-q2-2018-earnings-confere.aspx"},{"c":"SLAB 2018 Q2","e":"slab","d":"2018-07-25","l":"tariffs","r":"management","s":"John Hollister","x":"We do not believe that the U.S. government's tariffs enacted on imports from China, thus far, will have a significant direct effect on our financials.","url":"https://www.fool.com/earnings/call-transcripts/2018/07/25/silicon-laboratories-slab-q2-2018-earnings-confere.aspx"},{"c":"SLAB 2018 Q3","e":"slab","d":"2018-10-24","l":"tariffs","r":"management","s":"John Hollister","x":"So on the tariff side, there's really not a significant material direct impact of the tariffs on us, as far as our ability to ship product to customers, there's a little bit of an impact on some consumables that we intake in the Company and our operations, but it's not material.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/24/silicon-laboratories-inc-slab-q3-2018-earnings-con.aspx"},{"c":"SLAB 2018 Q3","e":"slab","d":"2018-10-24","l":"tariffs","r":"management","s":"John Hollister","x":"We have heard some feedback from partners in China, in particular that they are beginning to see some effect of the tariffs overall on their ability to be out in the market.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/24/silicon-laboratories-inc-slab-q3-2018-earnings-con.aspx"},{"c":"SLAB 2018 Q4","e":"slab","d":"2019-01-30","l":"tariffs","r":"management","s":"Tyson Tuttle","x":"China, in particular, is facing a difficult environment, with a slowdown in overall GDP performance and factory activity, combined with customers moving production to other geographies due to concerns over tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2019/01/30/silicon-laboratories-slab-q4-2018-earnings-confere.aspx"},{"c":"SLAB 2018 Q4","e":"slab","d":"2019-01-30","l":"tariffs","r":"management","s":"John Hollister","x":"We're going into Chinese New Year, we've got a Trade War, we've got debt concerns and other things.","url":"https://www.fool.com/earnings/call-transcripts/2019/01/30/silicon-laboratories-slab-q4-2018-earnings-confere.aspx"},{"c":"SLAB 2018 Q4","e":"slab","d":"2019-01-30","l":"cost_cuts","r":"analyst","s":"Gary Mobley","x":"So the question is how long are you willing to go before becoming more proactive in rightsizing the OPEX to delivery some stabilization there, if not improvement?","url":"https://www.fool.com/earnings/call-transcripts/2019/01/30/silicon-laboratories-slab-q4-2018-earnings-confere.aspx"},{"c":"SLAB 2019 Q3","e":"slab","d":"2019-10-23","l":"tariffs","r":"management","s":"Tyson Tuttle","x":"We've been driving some good wins and new products out into the market but still, we see a little bit of slowdown in terms of the deployment of this technology given some of the trade war dynamics.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/23/silicon-laboratories-inc-slab-q3-2019-earnings-cal.aspx"},{"c":"SLAB 2019 Q4","e":"slab","d":"2020-01-29","l":"cinema","r":"management","s":"Tyson Tuttle","x":"This groundbreaking 3-day conference, a first for the industry, will feature keynotes from Amazon, Comcast and Google executives, technical training, interactive sessions, workshops, round tables and exhibitor demonstrations.","url":"https://www.fool.com/earnings/call-transcripts/2020/01/29/silicon-laboratories-inc-slab-q4-2019-earnings-cal.aspx"},{"c":"SLAB 2019 Q4","e":"slab","d":"2020-01-29","l":"tariffs","r":"analyst","s":"Raji Gill","x":"You are kind of indicating that some of -- the situation in the China trade war is improving, so that could help the broad-based MCU business.","url":"https://www.fool.com/earnings/call-transcripts/2020/01/29/silicon-laboratories-inc-slab-q4-2019-earnings-cal.aspx"},{"c":"SLAB 2019 Q4","e":"slab","d":"2020-01-29","l":"cost_cuts","r":"management","s":"John Hollister","x":"GAAP operating expenses were $120 million for Q4, which were higher than we expected at the beginning of the quarter due to restructuring actions taken, including the closure of several design centers and offering a voluntary early retirement plan for long-standing employees.","url":"https://www.fool.com/earnings/call-transcripts/2020/01/29/silicon-laboratories-inc-slab-q4-2019-earnings-cal.aspx"},{"c":"SLAB 2019 Q4","e":"slab","d":"2020-01-29","l":"cost_cuts","r":"management","s":"John Hollister","x":"GAAP earnings per share ended Q4 at $0.22, which was below our guidance due to the restructuring actions taken.","url":"https://www.fool.com/earnings/call-transcripts/2020/01/29/silicon-laboratories-inc-slab-q4-2019-earnings-cal.aspx"},{"c":"SLAB 2020 Q2","e":"slab","d":"2020-07-29","l":"cost_cuts","r":"management","s":"John Hollister","x":"As part of our SLAB for auto initiative, Karuna will play a lead role in accelerating Silicon Labs efforts to simplify, streamline and scale our business with the IT systems that touch every part of our company.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/29/silicon-laboratories-inc-slab-q2-2020-earnings-cal.aspx"},{"c":"SLAB 2020 Q4","e":"slab","d":"2021-02-03","l":"tariffs","r":"analyst","s":"Rajvindra Gill","x":"Wondering what are your thoughts on there if there has been kind of rebound in that area post the trade war, post the kind of COVID?","url":"https://www.fool.com/earnings/call-transcripts/2021/02/03/silicon-laboratories-inc-slab-q4-2020-earnings-cal/"},{"c":"SLAB 2020 Q4","e":"slab","d":"2021-02-03","l":"pricing_power","r":"management","s":"John Hollister","x":"And to mitigate the effect we have begun to implement price increases to our customers.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/03/silicon-laboratories-inc-slab-q4-2020-earnings-cal/"},{"c":"SLAB 2020 Q4","e":"slab","d":"2021-02-03","l":"pricing_power","r":"management","s":"John Hollister","x":"And we are taking steps to -- fairly broad-based in a manner to pass that on to the customer base.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/03/silicon-laboratories-inc-slab-q4-2020-earnings-cal/"},{"c":"SLAB 2021 Q1","e":"slab","d":"2021-04-28","l":"pricing_power","r":"management","s":"John Hollister","x":"We are implementing additional price increases but expect will be slightly below model on gross margin for the balance of this year.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/28/silicon-laboratories-inc-slab-q1-2021-earnings-cal/"},{"c":"SLAB 2021 Q1","e":"slab","d":"2021-04-28","l":"pricing_power","r":"analyst","s":"Gary Mobley","x":"And as it relates to passing on the price increases where might you be getting some pushback from customers?","url":"https://www.fool.com/earnings/call-transcripts/2021/04/28/silicon-laboratories-inc-slab-q1-2021-earnings-cal/"},{"c":"SLAB 2021 Q2","e":"slab","d":"2021-07-28","l":"pricing_power","r":"management","s":"John Hollister","x":"During the June quarter, we implemented price increases in response to higher costs and expedite charges because of the current supply chain situation.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/28/silicon-laboratories-inc-slab-q2-2021-earnings-cal/"},{"c":"SLAB 2021 Q2","e":"slab","d":"2021-07-28","l":"pricing_power","r":"management","s":"John Hollister","x":"And have implemented a number of price increase programs with our customers.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/28/silicon-laboratories-inc-slab-q2-2021-earnings-cal/"},{"c":"SLAB 2021 Q3","e":"slab","d":"2021-10-27","l":"pricing_power","r":"management","s":"John Hollister","x":"Earlier this year, we implemented price increases to recoup cost increases from our suppliers and we are seeing positive effects.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/27/silicon-laboratories-inc-slab-q3-2021-earnings-cal/"},{"c":"SLAB 2021 Q3","e":"slab","d":"2021-10-27","l":"pricing_power","r":"management","s":"John Hollister","x":"Given the variable timing associated with costs and price increases, we are experiencing greater volatility in gross margins and expect that to continue in the near to midterm.","url":"https://www.fool.com/earnings/call-transcripts/2021/10/27/silicon-laboratories-inc-slab-q3-2021-earnings-cal/"},{"c":"SLAB 2021 Q4","e":"slab","d":"2022-02-02","l":"pricing_power","r":"management","s":"John Hollister","x":"Towards the end of the fourth quarter, we implemented a series of price increases across all product lines and customers to recover both existing and expected manufacturing cost increases.","url":"https://www.fool.com/earnings/call-transcripts/2022/02/02/silicon-laboratories-slab-q4-2021-earnings-call-tr/"},{"c":"SLAB 2021 Q4","e":"slab","d":"2022-02-02","l":"pricing_power","r":"management","s":"John Hollister","x":"For the fourth quarter, non-GAAP gross margin ended above our expectations at 61.4% on strong product mix, combined with the aforementioned price increases as well as expedite charges.","url":"https://www.fool.com/earnings/call-transcripts/2022/02/02/silicon-laboratories-slab-q4-2021-earnings-call-tr/"},{"c":"SLAB 2022 Q1","e":"slab","d":"2022-04-27","l":"pricing_power","r":"management","s":"John Hollister","x":"While also seeing our manufacturing costs rise with price increases from our suppliers.","url":"https://www.fool.com/earnings/call-transcripts/2022/04/27/silicon-laboratories-slab-q1-2022-earnings-call-tr/"},{"c":"SLAB 2022 Q1","e":"slab","d":"2022-04-27","l":"pricing_power","r":"management","s":"John Hollister","x":"No immediate plan on price increases can never rule it out.","url":"https://www.fool.com/earnings/call-transcripts/2022/04/27/silicon-laboratories-slab-q1-2022-earnings-call-tr/"},{"c":"SLAB 2022 Q2","e":"slab","d":"2022-07-27","l":"pricing_power","r":"management","s":"John Hollister","x":"Q2 gross margin was 62.4%, which was a decline from first quarter as anticipated due to the significant price increase effects in Q1.","url":"https://www.fool.com/earnings/call-transcripts/2022/07/27/silicon-laboratories-slab-q2-2022-earnings-call-tr/"},{"c":"SLAB 2022 Q2","e":"slab","d":"2022-07-27","l":"pricing_power","r":"management","s":"John Hollister","x":"As far as the pricing power and how long that will sustain, let me turn it to Matt to comment longer term.","url":"https://www.fool.com/earnings/call-transcripts/2022/07/27/silicon-laboratories-slab-q2-2022-earnings-call-tr/"}],"trends":{"theater":[[34,1,7553,0,0,0,6046,1127],[35,1,6086,0,0,0,4879,864],[36,1,6651,0,0,0,5125,1159],[37,1,7413,0,0,0,5752,1197],[38,1,8088,0,0,0,6292,1403],[39,1,8112,0,0,0,6552,1173],[40,1,7097,0,0,0,5822,970],[41,1,9385,0,0,0,8039,941],[42,1,8164,0,0,0,6679,1114],[43,1,7409,0,0,0,5909,1152],[44,1,7264,0,0,0,5706,1191],[45,1,7257,0,0,0,5346,1520],[46,1,5830,0,0,0,4352,1170],[47,1,5971,0,0,0,4553,1149],[48,1,6036,0,0,0,4552,1158],[49,1,5410,0,0,0,3939,1174],[50,1,4760,0,0,0,3511,996]],"cinema":[[34,1,7553,0,0,0,6046,1127],[35,1,6086,0,0,0,4879,864],[36,1,6651,0,0,0,5125,1159],[37,1,7413,0,0,0,5752,1197],[38,1,8088,0,0,0,6292,1403],[39,1,8112,0,0,0,6552,1173],[40,1,7097,1,1,0,5822,970],[41,1,9385,0,0,0,8039,941],[42,1,8164,0,0,0,6679,1114],[43,1,7409,0,0,0,5909,1152],[44,1,7264,0,0,0,5706,1191],[45,1,7257,0,0,0,5346,1520]