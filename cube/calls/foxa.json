0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0692,"r5":0.0786,"r1_spy":0.0662,"r5_spy":0.0778,"r1_sector":0.0574,"r5_sector":0.0077,"etf":"XLC"}}],"quotes":[{"c":"FOXA 2020 Q1","e":"foxa","d":"2019-11-06","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Interestingly, we now see well about 10% of our streaming audience consuming the 4K stream.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q1","e":"foxa","d":"2019-11-06","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"The streaming services with Disney, Netflix and Apple are recently being spending good money.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q2","e":"foxa","d":"2020-02-05","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"And our national networks categories that are leading this intensity include financial, insurance, the streamers, technology, and foreign auto.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q2","e":"foxa","d":"2020-02-05","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Nevertheless, we have begun allocating capital to expand our revenue base while reserving our subscriber fee relationships into direct-to-consumer initiatives which will grow in importance over time.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q2","e":"foxa","d":"2020-02-05","l":"dtc","r":"management","s":"Lachlan Murdoch","x":"And if we - you asked do we have what we need to succeed in those sectors whether it's on the broadcast or in a direct-to-consumer experience.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q2","e":"foxa","d":"2020-02-05","l":"dtc","r":"management","s":"Lachlan Murdoch","x":"And I should also just call out Fox Nation which is obviously a really excellent sort of direct-to-consumer product out of Fox News.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q3","e":"foxa","d":"2020-05-06","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"…the announcement and subsequent closing of our acquisition of Tubi, which immediately expands our direct to consumer capabilities and provides our advertisers with even more opportunities to reach audiences at great scale. Coupled with combined power of Fox's existing networks, Tubi provides a…","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q3","e":"foxa","d":"2020-05-06","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Coupled with combined power of Fox's existing networks, Tubi provides a substantial base from which we will drive long-term growth in the direct to consumer market.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q3","e":"foxa","d":"2020-05-06","l":"dtc","r":"management","s":"Lachlan Murdoch","x":"And we've talked before about our direct-to-consumer strategy.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q3","e":"foxa","d":"2020-05-06","l":"dtc","r":"management","s":"Lachlan Murdoch","x":"So -- and we've talked before about Fox Bet and Credible as a part of our direct-to-consumer strategy.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q4","e":"foxa","d":"2020-08-04","l":"theater","r":"management","s":"Lachlan Murdoch","x":"This innovation was created by mixing our first down line technology and real-time theatrical visual effects.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q4","e":"foxa","d":"2020-08-04","l":"theater","r":"management","s":"Lachlan Murdoch","x":"Obviously, the categories that are affected, retail, theatrical entertainment, fast food restaurants.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q4","e":"foxa","d":"2020-08-04","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Tubi complements Fox portfolio and underscores our long-term strategic initiative to broaden and enhance direct-to-consumer digital reach and engagement, while providing advertising partners with more opportunities to engage audiences at scale.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2020 Q4","e":"foxa","d":"2020-08-04","l":"cost_cuts","r":"management","s":"Steven Tomsic","x":"…net income attributable to stockholders of $122 million or $0.20 per share was lower than the $0.73 per share in the prior year quarter, most notably due to the higher impairment and restructuring charges, including the negotiated settlement to exit our rights agreement with the USGA.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q1","e":"foxa","d":"2020-11-03","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Another important digital expansion for the company, our ad-supported streaming platform Tubi is thriving.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q1","e":"foxa","d":"2020-11-03","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"When Tubi began streaming The Masked Singer, the show quickly became Tubi's number one television series overall.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q1","e":"foxa","d":"2020-11-03","l":"dtc","r":"analyst","s":"Alexia Quadrani","x":"I'm curious when we may get maybe some more information or a bigger update on your long-term DTC strategy, and then just a quick follow-up, any color you can share on the NFL negotiations and how important maybe Thursday Night versus Sunday Afternoon is to you?","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q2","e":"foxa","d":"2021-02-09","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"The news cycle also continued to connect engaged audiences to the various FOX News Media platforms: linear, digital, radio, and streaming for news, analysis and opinion.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q2","e":"foxa","d":"2021-02-09","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"With Tubi as part of our portfolio, Fox broadens from being the leader in broadcast network television into a leader in linear and streaming ecosystems.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q2","e":"foxa","d":"2021-02-09","l":"dtc","r":"management","s":"Lachlan Murdoch","x":"And that’s why we’ve really chosen to embrace AVOD as our direct-to-consumer strategy, and we think we can do this for really two reasons.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q2","e":"foxa","d":"2021-02-09","l":"pricing_power","r":"management","s":"Lachlan Murdoch","x":"Beyond advertising and because of the substantial pricing power of our brands, our affiliate revenues grew by 6% despite a reserve taken for potential distribution credits.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q2","e":"foxa","d":"2021-02-09","l":"pricing_power","r":"management","s":"Lachlan Murdoch","x":"One is obviously the pricing power of our affiliate revenue remains relatively untapped.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q3","e":"foxa","d":"2021-05-05","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"FOX Nation, the direct-to-consumer offering from FOX News Media also had an impressive quarter, with the highest number of customer acquisition since launch and this momentum, which has carried over into the current quarter.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q3","e":"foxa","d":"2021-05-05","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"The key drivers of this growth are the streaming of live events and the premier of exclusive flagship content, including the streaming of CPAC in February and the launch of Tucker Carlson content, including a new video of podcast series entitled, Tucker Carlson Today and long form documentaries…","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q4","e":"foxa","d":"2021-08-04","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"On the last call, I told you that Fox Nation, the direct-to-consumer offering from FOX News Media had recorded its strongest quarter for customer acquisitions since launch.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q4","e":"foxa","d":"2021-08-04","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"But I cannot emphasize enough the importance of total view time, or TBT, as the critical metric for ad supported streaming.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2021 Q4","e":"foxa","d":"2021-08-04","l":"cost_cuts","r":"management","s":"Steve Tomsic","x":"This increase reflects the absence of impairment and restructuring charges booked in the prior year quarter, net of the impact of mark-to-market adjustments associated with the company's investments recognized in other net.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2022 Q1","e":"foxa","d":"2021-11-03","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Audiences are migrating to live news, sports, and streaming underscoring the operational and financial pillars that have defined our short history as Fox Corporation.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2022 Q1","e":"foxa","d":"2021-11-03","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"At Fox Nation, the complementary streaming service to Fox News, our total subscriber count was up nearly 25% compared to last quarter, and up over 130% compared to the same quarter last year.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2022 Q2","e":"foxa","d":"2022-02-09","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"While some companies are focused on multibillion dollar content investments in search of streaming subscription growth, to be continued its unrelenting focus on advertising video on demand with a strategic and measured investment approach.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2022 Q2","e":"foxa","d":"2022-02-09","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"And in the 3 years since we formed Fox Corporation, we have used this collective platform to develop a rapidly growing Eva streaming business and create optionality within the sports betting ecosystem.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2022 Q3","e":"foxa","d":"2022-05-10","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"I think our clients can see both the shift to AVOD and the streaming advertising.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2022 Q3","e":"foxa","d":"2022-05-10","l":"streaming","r":"analyst","s":"Doug Mitchelson","x":"And FOX has been in kind of the interesting investment in that not making a strong pivot to streaming to some of your peers, but yet Tubi is an interesting investment opportunity that's impacting margins this year.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2022 Q3","e":"foxa","d":"2022-05-10","l":"pricing_power","r":"management","s":"Lachlan Murdoch","x":"It's actually usually beating, many nights of the week sort of beating broadcast networks and we expect our pricing power to continue to strengthen with performance like that.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q1","e":"foxa","d":"2022-11-01","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Additionally, despite the economic headwinds, we are seeing continued strength across our linear news and sports portfolios, led by the pharmaceutical, restaurant and streaming categories.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q1","e":"foxa","d":"2022-11-01","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"…position as I think a lot of the cable, general entertainment channels, which are – you know are more at risk to people going to SVOD services and streaming to get that type of content, whereas you know there's only one place you can get FOX News and there's only one place you can get FOX Sports.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q2","e":"foxa","d":"2023-02-08","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Further, FOX Entertainment recently announced a multiyear extension with Hulu of our longstanding content licensing agreement, which bolsters Fox's streaming audience and provides Hulu with a key point of differentiation in a crowded streaming world.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q2","e":"foxa","d":"2023-02-08","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Tubi, the number one AVOD player, leads our streaming strategy and with minimal investment when compared to our peers.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q2","e":"foxa","d":"2023-02-08","l":"pricing_power","r":"management","s":"Lachlan Murdoch","x":"For example, our affiliate and advertising revenue growth is driven by our pricing power, reinforced by regularly delivering large scale audiences and uniquely providing exclusive content to our pay TV distributors.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q2","e":"foxa","d":"2023-02-08","l":"pricing_power","r":"management","s":"Lachlan Murdoch","x":"What we've seen in the renewals this past year is the importance really of our Fox brands with our affiliate partners and the pricing power that we have with them.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q3","e":"foxa","d":"2023-05-09","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"In terms of the, you know, so the cable universe and what we plan to do with news and sport, you know, going forward in terms of any sort of a direct-to-consumer or alternative kind of distribution strategy.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q4","e":"foxa","d":"2023-08-08","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"And on the streaming front, Tubi made its debut in Nielsen's The Gauge, growing total consumption in fiscal 2023 by 79%, making it the number one AVOD player with consumption levels equal to a top five cable network.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q4","e":"foxa","d":"2023-08-08","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"So as regards, FOX Sports and our sports portfolio and any sort of direct-to-consumer proposition I think the -- our business is fundamentally very similar to ESPN's.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q4","e":"foxa","d":"2023-08-08","l":"dtc","r":"management","s":"Lachlan Murdoch","x":"It's not a -- we don't envision a moment, when you leave a pay-TV universe and quickly transition to a direct-to-consumer universe, we think you'll enter a phase where both are important.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2023 Q4","e":"foxa","d":"2023-08-08","l":"cost_cuts","r":"management","s":"Steve Tomsic","x":"As the EBITDA movements just described along with the restructuring and other below-the-line costs were more than offset by the mark-to-market increases of our investment in Flutter.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2024 Q2","e":"foxa","d":"2024-02-07","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Tubi's library of over 240,000 movies and TV episodes coupled with ubiquitous distribution drove engagement, helping Tubi reach 78 million monthly active users, log almost 2.5 billion streaming hours in the quarter and set a new monthly record of 855 million total viewing hours in December alone.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2024 Q2","e":"foxa","d":"2024-02-07","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Tubi has consolidated its position in the streaming landscape, ranking as the most watched free TV and movie streaming service in the United States, according to Nielsen, and surpassing Peacock, Max, Paramount Plus, and Pluto TV in view time for seven consecutive months.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2024 Q2","e":"foxa","d":"2024-02-07","l":"pricing_power","r":"management","s":"Steve Tomsic","x":"The TV segment reported strong 10% growth in affiliate fee revenues as price increases across all Fox affiliated stations more than offset the impact from industry subscriber declines.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2024 Q3","e":"foxa","d":"2024-05-08","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"…next week, our focus on live content and must-watch events, such as the coming presidential election cycle and next year's Super Bowl combined with Tobi's position as the most watched free TV and movie streaming service will favor our enviable position with advertisers across the FOX portfolio.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2024 Q3","e":"foxa","d":"2024-05-08","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Our expansive content library and our differentiated user base have solidified Tubi's position as the most watched free TV and movie streaming service in the U.S. with 1.6% of total TV viewing, ahead of Peacock, MAX, The Roku Channel, Paramount+ and Pluto TV and only marginally behind Disney+.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2024 Q3","e":"foxa","d":"2024-05-08","l":"pricing_power","r":"management","s":"Steve Tomsic","x":"TV affiliate fee revenues grew 9% over the prior year as price increases across our owned and operated as well as 30 FOX-affiliated stations more than offset the impact from subscriber declines.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2025 Q1","e":"foxa","d":"2024-11-04","l":"streaming","r":"analyst","s":"Benjamin Swinburne","x":"I don't know if you would agree, it feels like the sort of connected TV streaming market is really participating this cycle in a way, at least that I haven't noticed in the past.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2025 Q2","e":"foxa","d":"2025-02-04","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Our only disappointment in sports is that we will not be moving forward with Venu, our sports streaming joint venture with Warner Bros.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2025 Q2","e":"foxa","d":"2025-02-04","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"And that is what we continue to be focused on, maximum distribution of our content, whether that be traditional, digital streaming, or our own D2C offering in the near future.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2025 Q2","e":"foxa","d":"2025-02-04","l":"dtc","r":"management","s":"Lachlan Murdoch","x":"And what we will continue through -- and it actually ties into the direct-to-consumer strategy because to put our content in front of every consumer that wants it on any platform and every platform.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2025 Q3","e":"foxa","d":"2025-05-12","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"Tubi has established itself as a leading player in the streaming world, offering premium on demand entertainment and original content that is 100% free for consumers.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2025 Q3","e":"foxa","d":"2025-05-12","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"We're also excited about our direct-to-consumer plans.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2025 Q3","e":"foxa","d":"2025-05-12","l":"dtc","r":"analyst","s":"Benjamin Swinburne","x":"I wanted to ask about your strategy around direct-to-consumer and sort of the broader affiliate revenue growth at the company.","url":"https://huggingface.co/datasets/kurry/sp500_earnings_transcripts"},{"c":"FOXA 2026 Q2","e":"foxa","d":"2026-02-04","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"It is the product of both a highly differentiated strategy and high-quality execution that reflect the power of our leadership brands across news, sports, streaming, and entertainment.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/04/fox-foxa-q2-2026-earnings-call-transcript/"},{"c":"FOXA 2026 Q2","e":"foxa","d":"2026-02-04","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"These patterns reinforce our view that Fox One is not only the premier destination for live sports but also the leading platform for timely, relevant live news streaming.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/04/fox-foxa-q2-2026-earnings-call-transcript/"},{"c":"FOXA 2026 Q3","e":"foxa","d":"2026-05-11","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"These attracted robust audiences consuming live on the network and were amplified with meaningful levels of delayed digital streaming.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/11/fox-foxa-q3-2026-earnings-call-transcript/"},{"c":"FOXA 2026 Q3","e":"foxa","d":"2026-05-11","l":"streaming","r":"analyst","s":"Michael Morris","x":"And then more broadly on the topic, there was an article recently in the Journal saying that Rupert Murdoch expressed concern to the administration about games moving -- NFL games moving to streaming services.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/11/fox-foxa-q3-2026-earnings-call-transcript/"},{"c":"FOXA 2026 Q4","e":"foxa","d":"2026-08-06","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"We successfully launched our direct-to-consumer streaming service, FOX One, broadcast the FIFA Men's World Cup to record audiences in the U.S., continued to keep America informed through a dynamic and fast-moving news cycle, enhanced Tubi's position as a leading streaming service and announced…","url":"https://www.fool.com/earnings/call-transcripts/2026/08/06/fox-foxa-q4-2026-earnings-call-transcript/"},{"c":"FOXA 2026 Q4","e":"foxa","d":"2026-08-06","l":"streaming","r":"management","s":"Lachlan Murdoch","x":"For example, when we acquired Tubi in its early stages, we have turned it into a leading streaming platform with 10x the revenue from when we started.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/06/fox-foxa-q4-2026-earnings-call-transcript/"},{"c":"FOXA 2026 Q4","e":"foxa","d":"2026-08-06","l":"pricing_power","r":"analyst","s":"John Hodulik","x":"I think there's a lot of expectations that you would see price increase either up for this season or for next season.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/06/fox-foxa-q4-2026-earnings-call-transcript/"},{"c":"FOXA 2027 Q1","e":"foxa","d":"2026-11-02","l":"streaming","r":"management","s":"Lachlan Keith Murdoch","x":"Combining Roku's leading streaming platform with our premium sports news, and entertainment content, we will build our position in the fastest growing segments of the media landscape and will deliver both sustained growth for the company and value for our shareholders.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/02/fox-foxa-q1-2027-earnings-call-transcript/"},{"c":"FOXA 2027 Q1","e":"foxa","d":"2026-11-02","l":"streaming","r":"analyst","s":"Michael Morris","x":"For Fox, I am wondering why these bundles have not been impactful and what you might need to see to strike a deeper distribution agreement with a large streaming platform.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/02/fox-foxa-q1-2027-earnings-call-transcript/"}],"trends":{"theater":[[38,1,2363,0,0,0,1622,526],[39,1,5325,0,0,0,4325,710],[40,1,6216,0,0,0,5094,876],[41,1,8519,0,0,0,7227,1006],[42,1,6728,2,2,0,5864,679],[43,1,6285,0,0,0,5021,980],[44,1,6899,0,0,0,5725,889],[45,1,6602,0,0,0,5245,1073],[46,1,7247,0,0,0,6325,696],[47,1,6662,0,0,0,5439,900],[48,1,5578,0,0,0,4662,673],[49,1,5497,0,0,0,4367,865],[50,1,5890,0,0,0,4873,769],[51,1,5392,0,0,0,3899,1201],[52,1,6019,0,0,0,4927,787],[53,1,5025,0,0,0,4045,756],[54,1,5803,0,0,0,4897,658],[56,1,4784,0,0,0,3731,809],[57,1,5166,0,0,0,4277,666],[59,1,5177,0,0,0,3987,923],[60,1,4772,0,0,0,3900,645],[61,1,5802,0,0,0,4663,870],[64,1,5719,0,0,0,4695,584],[65,1,4459,0,0,0,3749,502],[66,1,4977,0,0,0,4173,526],[67,1,3987,0,0,0,2774,764]],"cinema":[[38,1,2363,0,0,0,1622,526],[39,1,5325,0,0,0,4325,710],[40,1,6216,0,0,0,5094,876],[41,1,8519,0,0,0,7227,1006],[42,1,6728,0,0,0,5864,679],[43,1,6285,0,0,0,5021,980],[44,1,6899,0,0,0,5725,889],[45,1,6602,0,0,0,5245,1073],[46,1,7247,0,0,0,6325,696],[47,1,6662,0,0,0,5439,900],[48,1,5578,0,0,0,4662,673],[49,1,5497,0,0,0,