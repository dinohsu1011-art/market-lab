,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0388,"r5":-0.0129,"r20":-0.1103,"r1_spy":-0.0356,"r5_spy":-0.0124,"r20_spy":-0.1011}},{"id":"AAON 2026 Q3","t":"AAON","d":"2026-11-09","time":null,"w":7458,"n":51,"url":"https://www.fool.com/earnings/call-transcripts/2026/11/10/aaon-aaon-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[2,2,0,2.72,{"raise":2,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.1931,"r5":0.2438,"r1_spy":0.1968,"r5_spy":0.2608}}],"quotes":[{"c":"AAON 2018 Q3","e":"aaon","d":"2018-11-01","l":"tariffs","r":"management","s":"Scott Asbjornson","x":"The company continues to experience increases in raw material costs due to tariffs and trade restrictions.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/01/aaon-inc-aaon-q3-2018-earnings-conference-call-tra.aspx"},{"c":"AAON 2018 Q3","e":"aaon","d":"2018-11-01","l":"tariffs","r":"management","s":"Gary Fields","x":"At the same time we've had market pressures from increased steel cost due to the tariff, increased aluminum costs and now component cost.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/01/aaon-inc-aaon-q3-2018-earnings-conference-call-tra.aspx"},{"c":"AAON 2018 Q3","e":"aaon","d":"2018-11-01","l":"pricing_power","r":"management","s":"Gary Fields","x":"We've had price increases that have gone into effect and are becoming effective on the actual equipment shipped, the related impact to that is that we are gaining -- regaining our margin percentages.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/01/aaon-inc-aaon-q3-2018-earnings-conference-call-tra.aspx"},{"c":"AAON 2018 Q3","e":"aaon","d":"2018-11-01","l":"pricing_power","r":"management","s":"Gary Fields","x":"The price increases that we've put into effect are beginning to offset all of those other price increases and we look for this to be somewhat accretive over the next quarter.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/01/aaon-inc-aaon-q3-2018-earnings-conference-call-tra.aspx"},{"c":"AAON 2018 Q4","e":"aaon","d":"2019-02-28","l":"pricing_power","r":"management","s":"Scott Asbjornson","x":"The increase in net sales was the result of price increases made since November of 2017.","url":"https://www.fool.com/earnings/call-transcripts/2019/03/02/aaon-inc-aaon-q4-2018-earnings-conference-call-tra.aspx"},{"c":"AAON 2018 Q4","e":"aaon","d":"2019-02-28","l":"pricing_power","r":"management","s":"Scott Asbjornson","x":"Most of the increase in revenues is due to our price increase from November 2017.","url":"https://www.fool.com/earnings/call-transcripts/2019/03/02/aaon-inc-aaon-q4-2018-earnings-conference-call-tra.aspx"},{"c":"AAON 2019 Q1","e":"aaon","d":"2019-05-02","l":"tariffs","r":"management","s":"Gary D. Fields","x":"While there could still be some that are moving around a little bit, there's nothing on the immediate horizon telling us there's any shakeup like there was back when we had the tariffs and so forth imposed.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/02/aaon-inc-aaon-q1-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q1","e":"aaon","d":"2019-05-02","l":"pricing_power","r":"management","s":"Scott M. Asbjornson","x":"Net sales for the quarter are up due to our price increases from 2018, along with increases in the volume of rooftop units sold.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/02/aaon-inc-aaon-q1-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q1","e":"aaon","d":"2019-05-02","l":"pricing_power","r":"management","s":"Gary D. Fields","x":"The price increases have come along nicely in our backlog.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/02/aaon-inc-aaon-q1-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q2","e":"aaon","d":"2019-08-01","l":"tariffs","r":"management","s":"Gary D. Fields","x":"However, I understand that there was additional announcements of more tariffs yet to come just today.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/05/aaon-inc-aaon-q2-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q2","e":"aaon","d":"2019-08-01","l":"tariffs","r":"management","s":"Gary D. Fields","x":"There are some unknowns, as we say, with these new tariffs that are coming, and there's other pricing pressures that could occur that we've not yet seen.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/05/aaon-inc-aaon-q2-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q2","e":"aaon","d":"2019-08-01","l":"pricing_power","r":"management","s":"Scott M. Asbjornson","x":"Net sales for the quarter are up due to our price increases from 2018 and '19 along with increases in our part and water-source heat pump sales.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/05/aaon-inc-aaon-q2-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q2","e":"aaon","d":"2019-08-01","l":"pricing_power","r":"management","s":"Scott M. Asbjornson","x":"Net sales for the six months ended are up mainly due to the price increases we implemented in 2018 and 2019.","url":"https://www.fool.com/earnings/call-transcripts/2019/08/05/aaon-inc-aaon-q2-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q3","e":"aaon","d":"2019-10-31","l":"pricing_power","r":"management","s":"Scott M. Asbjornson","x":"Net sales for the quarter are up due to our price increases from 2018 and 2019 along with increases in our part and water-source heat pump sales.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/31/aaon-inc-aaon-q3-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q3","e":"aaon","d":"2019-10-31","l":"pricing_power","r":"management","s":"Scott M. Asbjornson","x":"Net sales for the nine months ended are up mainly due to price increases we implemented in 2018 and '19.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/31/aaon-inc-aaon-q3-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q4","e":"aaon","d":"2020-02-27","l":"pricing_power","r":"management","s":"Gary D. Fields","x":"So we have had progressively price increases going back to 2017 but do it with the longer lead time the backlog flow through to actual production and actual sales takes a fair while to happen.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/27/aaon-inc-aaon-q4-2019-earnings-call-transcript.aspx"},{"c":"AAON 2019 Q4","e":"aaon","d":"2020-02-27","l":"pricing_power","r":"management","s":"Gary D. Fields","x":"This will get the price increases through to the sales a little quicker.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/27/aaon-inc-aaon-q4-2019-earnings-call-transcript.aspx"},{"c":"AAON 2020 Q1","e":"aaon","d":"2020-05-07","l":"pricing_power","r":"management","s":"Gary D. Fields","x":"We have not announced any further price increases.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/08/aaon-inc-aaon-q1-2020-earnings-call-transcript.aspx"},{"c":"AAON 2020 Q1","e":"aaon","d":"2020-05-07","l":"pricing_power","r":"management","s":"Gary D. Fields","x":"Now the one thing I do want to say about price increases is on we had two categories of equipment that we had a price increase on in December of 2019.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/08/aaon-inc-aaon-q1-2020-earnings-call-transcript.aspx"},{"c":"AAON 2020 Q2","e":"aaon","d":"2020-08-07","l":"pricing_power","r":"management","s":"Scott M. Asbjornson","x":"Net sales for the quarter are up due primarily to our increased sheet mill production from the additional cell vanina machines of replaced in operation as well as our price increases implemented in 2019.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/07/aaon-inc-aaon-q2-2020-earnings-call-transcript.aspx"},{"c":"AAON 