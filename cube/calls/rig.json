x":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[1,1,0,1.73],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0916,"r5":-0.048,"r20":-0.0916,"r1_spy":-0.0996,"r5_spy":-0.0776,"r20_spy":-0.1495}},{"id":"RIG 2026 Q3","t":"RIG","d":"2026-11-03","time":null,"w":9162,"n":57,"url":"https://www.fool.com/earnings/call-transcripts/2026/11/03/transocean-rig-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0763,"r5":-0.122,"r1_spy":-0.0928,"r5_spy":-0.1162}}],"quotes":[{"c":"RIG 2018 Q3","e":"rig","d":"2018-10-30","l":"pricing_power","r":"analyst","s":"Ian Macpherson","x":"I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/30/transocean-ltd-rig-q3-2018-earnings-conference-cal.aspx"},{"c":"RIG 2019 Q1","e":"rig","d":"2019-04-30","l":"cost_cuts","r":"management","s":"Jeremy D. Thigpen","x":"…had certainly played a role, it's important to recognize that the entire industry has worked together to realize sustainable cost savings including, but certainly not limited to, increased efficiencies in drilling, more tailored field design and greater equipment and facility standardization.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/30/transocean-ltd-rig-q1-2019-earnings-call-transcrip.aspx"},{"c":"RIG 2019 Q2","e":"rig","d":"2019-07-30","l":"cost_cuts","r":"management","s":"Jeremy Lake","x":"As an industry, we continue to streamline operations contributing to the delivery of most ultra deepwater projects at or below fourty dollars per barrel.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/30/transocean-ltd-rig-q2-2019-earnings-call-transcrip.aspx"},{"c":"RIG 2019 Q2","e":"rig","d":"2019-07-30","l":"cost_cuts","r":"management","s":"Jeremy Lake","x":"We will continue to streamline and automate processes and activities and develop new or leverage existing technologies to outperform our customer drilling plans and increase the number of economically viable targets within their respective portfolios.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/30/transocean-ltd-rig-q2-2019-earnings-call-transcrip.aspx"},{"c":"RIG 2019 Q3","e":"rig","d":"2019-10-29","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"We will continue to streamline and automate processes and activities while exploring and ultimately integrating new technologies to outperform our customer drilling plans and increase the number of economically viable targets within their respective portfolios.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/29/transocean-ltd-rig-q3-2019-earnings-call-transcrip.aspx"},{"c":"RIG 2020 Q1","e":"rig","d":"2020-04-30","l":"cost_cuts","r":"management","s":"Mark Mey","x":"But as we do have contracts that run-off later this year or next year, we will take action to rightsize the business to reflect the reduced footprint of the operating rigs.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/30/transocean-ltd-rig-q1-2020-earnings-call-transcrip.aspx"},{"c":"RIG 2020 Q1","e":"rig","d":"2020-04-30","l":"cost_cuts","r":"management","s":"Mark Mey","x":"Clearly, we'll then have to make a decision with regard to how do we rightsize the organization, move those folks around or end up settling some of them in places where either part of country.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/30/transocean-ltd-rig-q1-2020-earnings-call-transcrip.aspx"},{"c":"RIG 2020 Q2","e":"rig","d":"2020-07-30","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"We embarked on this global reduction in force, purely as a result of the unprecedented and unforeseen circumstances.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/31/transocean-rig-q2-2020-earnings-call-transcript.aspx"},{"c":"RIG 2020 Q2","e":"rig","d":"2020-07-30","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"As you know, a number of other contractors have either formally started the restructuring process, or taken steps that indicate that they are likely to do so in the near term.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/31/transocean-rig-q2-2020-earnings-call-transcript.aspx"},{"c":"RIG 2020 Q3","e":"rig","d":"2020-11-03","l":"ai_spend","r":"management","s":"Mark Mey","x":"As it relates to digitization or AI or any other current initiative, there's going to be an investment into that that initially offsets any cost savings you're going to see in that quarter or that year.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/03/transocean-rig-q3-2020-earnings-call-transcript/"},{"c":"RIG 2020 Q3","e":"rig","d":"2020-11-03","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"The majority of our peers have either formally started the restructuring process or taken steps that indicate that they are likely to do so in the near future.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/03/transocean-rig-q3-2020-earnings-call-transcript/"},{"c":"RIG 2020 Q3","e":"rig","d":"2020-11-03","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"…balance sheet transactions, Transocean is in a very different and advantageous position relative to our competitors as we are not currently facing a restructuring decision nor are we experiencing the difficult and sometimes demoralizing and crippling distractions associated with such a process.","url":"https://www.fool.com/earnings/call-transcripts/2020/11/03/transocean-rig-q3-2020-earnings-call-transcript/"},{"c":"RIG 2020 Q4","e":"rig","d":"2021-02-23","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"The majority of our peers have either formally started the restructuring process or have recently emerged.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/23/transocean-rig-q4-2020-earnings-call-transcript/"},{"c":"RIG 2020 Q4","e":"rig","d":"2021-02-23","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"Given our liquidity position and industry-leading backlog, we are not facing a restructuring decision.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/23/transocean-rig-q4-2020-earnings-call-transcript/"},{"c":"RIG 2021 Q1","e":"rig","d":"2021-05-04","l":"pricing_power","r":"management","s":"Ian MacPherson","x":"Jeremy, you did draw, I think, an app comparison to the temperature of the market to where you were just before COVID derailed us for a little bit here with regard to just percolating pricing power.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/04/transocean-rig-q1-2021-earnings-call-transcript/"},{"c":"RIG 2021 Q1","e":"rig","d":"2021-05-04","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"As you may know, many of our peers have recently emerged from restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/04/transocean-rig-q1-2021-earnings-call-transcript/"},{"c":"RIG 2021 Q1","e":"rig","d":"2021-05-04","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"I think that we're going to see drastically different behavior from our competitors post restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/04/transocean-rig-q1-2021-earnings-call-transcript/"},{"c":"RIG 2021 Q2","e":"rig","d":"2021-08-03","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"As many of you know, due to many factors, such as the speculative building or reactivating of assets, undisciplined contract bidding, not to mention the global pandemic, most of our competitors failed, and as a result, entered into financial restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/04/transocean-rig-q2-2021-earnings-call-transcript/"},{"c":"RIG 2021 Q2","e":"rig","d":"2021-08-03","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"Now that most of our competitors have emerged from restructuring, we believe that the new owners understand and appreciate the value of disciplined bidding, the value of industry consolidation and the value of retiring older and less capable assets.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/04/transocean-rig-q2-2021-earnings-call-transcript/"},{"c":"RIG 2021 Q3","e":"rig","d":"2021-11-02","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"Many of our competitors have emerged from restructuring in the past year with another anticipated to emerge from its second filing around the end of the year.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/02/transocean-rig-q3-2021-earnings-call-transcript/"},{"c":"RIG 2021 Q4","e":"rig","d":"2022-02-23","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"We're also encouraged by the additional consolidation of our competitors, including the planned merger of Maersk and Noble announced in November and the ongoing restructuring of the Cedral Group.","url":"https://www.fool.com/earnings/call-transcripts/2022/02/23/transocean-rig-q4-2021-earnings-call-transcript/"},{"c":"RIG 2022 Q1","e":"rig","d":"2022-05-03","l":"theater","r":"analyst","s":"Ian MacPherson","x":"You described how there's going to be a potential deficit of rigs in the harsh environment theater, but possibly some project delays between end of year and the summer of '23 that could push some of these starts out.","url":"https://www.fool.com/earnings/call-transcripts/2022/05/03/transocean-rig-q1-2022-earnings-call-transcript/"},{"c":"RIG 2022 Q2","e":"rig","d":"2022-08-02","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"…the Deepwater Titan in the Deepwater Atlas, both rigs are also outfitted with industry-leading 1,700 short-term hoisting capability, a feature that is unique to these two rigs and has the potential to enable our customers to run fewer casing strings presenting a significant time and cost savings.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/02/transocean-rig-q2-2022-earnings-call-transcript/"},{"c":"RIG 2022 Q4","e":"rig","d":"2023-02-22","l":"cost_cuts","r":"management","s":"Mark Mey","x":"We will now focus on simplifying and rightsizing our balance sheet.","url":"https://www.fool.com/earnings/call-transcripts/2023/02/22/transocean-rig-q4-2022-earnings-call-transcript/"},{"c":"RIG 2022 Q4","e":"rig","d":"2023-02-22","l":"cost_cuts","r":"management","s":"Mark Mey","x":"And if you look at the balance sheets of the drillers, especially those has gone through restructuring, I'm not sure it supports a wholesale reactivation program unless it's paid upfront by the customers.","url":"https://www.fool.com/earnings/call-transcripts/2023/02/22/transocean-rig-q4-2022-earnings-call-transcript/"},{"c":"RIG 2023 Q1","e":"rig","d":"2023-05-02","l":"cost_cuts","r":"analyst","s":"James West","x":"We obviously have had a good amount during the restructuring phase that we saw.","url":"https://www.fool.com/earnings/call-transcripts/2023/05/02/transocean-rig-q1-2023-earnings-call-transcript/"},{"c":"RIG 2023 Q4","e":"rig","d":"2024-02-20","l":"cost_cuts","r":"analyst","s":"David Smith","x":"It's just an amazing achievement to make it through that downturn without restructuring the balance sheet.","url":"https://www.fool.com/earnings/call-transcripts/2024/02/20/transocean-rig-q4-2023-earnings-call-transcript/"},{"c":"RIG 2024 Q3","e":"rig","d":"2024-10-31","l":"pricing_power","r":"management","s":"Robert Thaddeus Vayda","x":"Just to add to that, it's important to note that in our longer-term contracts, we build that into the contract, and we pass it through -- the majority of that inflation through to the customer.","url":"https://www.fool.com/earnings/call-transcripts/2024/10/31/transocean-rig-q3-2024-earnings-call-transcript/"},{"c":"RIG 2024 Q3","e":"rig","d":"2024-10-31","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"It's just the consequence of not restructuring during the downturn.","url":"https://www.fool.com/earnings/call-transcripts/2024/10/31/transocean-rig-q3-2024-earnings-call-transcript/"},{"c":"RIG 2024 Q4","e":"rig","d":"2025-02-18","l":"cost_cuts","r":"management","s":"Jeremy Thigpen","x":"While an incredibly challenging time in offshore drilling, I am proud of the fact that we are the only publicly traded offshore drilling company to survive the downturn without restructuring.","url":"https://www.fool.com/earnings/call-transcripts/2025/02/18/transocean-rig-q4-2024-earnings-call-transcript/"},{"c":"RIG 2025 Q1","e":"rig","d":"2025-04-29","l":"tariffs","r":"management","s":"Thaddeus Vayda","x":"At the present time, we have not explicitly included the potential impact of tariffs in our guidance.","url":"https://www.fool.com/earnings/call-transcripts/2025/12/23/transocean-rig-q1-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q1","e":"rig","d":"2025-04-29","l":"tariffs","r":"management","s":"Thaddeus Vayda","x":"We anticipate that any tariff exposure will fall into two broad categories, direct, meaning directly related to our importation of materials into the U.S. from foreign countries, and indirect, which relates to additional costs our U.S. based suppliers pay to import the goods and materials needed…","url":"https://www.fool.com/earnings/call-transcripts/2025/12/23/transocean-rig-q1-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q1","e":"rig","d":"2025-04-29","l":"pricing_power","r":"management","s":"Thaddeus Vayda","x":"In relation to our indirect exposure to tariffs, we have observed some preemptive supplier price increases, intended to mitigate the potential impact of tariffs on their own supply chains.","url":"https://www.fool.com/earnings/call-transcripts/2025/12/23/transocean-rig-q1-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q1","e":"rig","d":"2025-04-29","l":"pricing_power","r":"management","s":"Thaddeus Vayda","x":"We think that any indirect or pass through cost increases have a greater potential to affect our cost structure over the longer run, if reciprocal tariffs are not curtailed.","url":"https://www.fool.com/earnings/call-transcripts/2025/12/23/transocean-rig-q1-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q1","e":"rig","d":"2025-04-29","l":"cost_cuts","r":"management","s":"Keelan Adamson","x":"This is evidence of our customers continued capital discipline, supply chain delays and business restructuring activities.","url":"https://www.fool.com/earnings/call-transcripts/2025/12/23/transocean-rig-q1-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q1","e":"rig","d":"2025-04-29","l":"cost_cuts","r":"management","s":"Thaddeus Vayda","x":"This reflects our revenue, cost and capital expenditure guidance, and includes the impact of our cost savings initiative to date, our undrawn revolving credit facility and restricted cash of approximately $450 million.","url":"https://www.fool.com/earnings/call-transcripts/2025/12/23/transocean-rig-q1-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q2","e":"rig","d":"2025-08-05","l":"tariffs","r":"management","s":"Thaddeus Vayda","x":"With respect to tariffs, we continue to monitor this fluid situation and have not included any potential impact on our guidance because we currently do not expect the impact of either direct or indirect tariffs to be material.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/05/transocean-rig-q2-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q2","e":"rig","d":"2025-08-05","l":"tariffs","r":"management","s":"Keelan Adamson","x":"There's opportunity based on volatility in the market space, whether it's related to tariffs or related to OPEC or related to oil production and need.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/05/transocean-rig-q2-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q2","e":"rig","d":"2025-08-05","l":"cost_cuts","r":"management","s":"Thaddeus Vayda","x":"This reflects our revenue, cost, and capital expenditure expectations and includes the impact of our cost savings initiative, our undrawn revolving credit facility, and restricted cash of approximately $440 million.","url":"https://www.fool.com/earnings/call-transcripts/2025/08/05/transocean-rig-q2-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q3","e":"rig","d":"2025-10-30","l":"cost_cuts","r":"management","s":"Keelan Adamson","x":"They have also been reducing costs by restructuring their organizations and have largely been sustaining reserves and production levels through acquisitions and consolidation.","url":"https://www.fool.com/earnings/call-transcripts/2025/12/23/transocean-rig-q3-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q3","e":"rig","d":"2025-10-30","l":"cost_cuts","r":"management","s":"R. Vayda","x":"…primarily due to deferred maintenance costs across the fleet and the release of a $10 million provision resulting from the anticipated favorable outcome of a legal dispute, partially offset by severance costs associated with the company's shore-based support reorganization undertaken in August.","url":"https://www.fool.com/earnings/call-transcripts/2025/12/23/transocean-rig-q3-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q4","e":"rig","d":"2026-02-20","l":"cost_cuts","r":"management","s":"Keelan I. Adamson","x":"We completed five major planned out-of-service projects on time and on budget, and we continued to rightsize and high-grade the technical capability of our fleet.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/20/transocean-rig-q4-2025-earnings-call-transcript/"},{"c":"RIG 2025 Q4","e":"rig","d":"2026-02-20","l":"cost_cuts","r":"management","s":"Keelan I. Adamson","x":"We have identified more than GBP 200,000,000 in cost synergies, on top of our ongoing cost reduction initiatives.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/20/transocean-rig-q4-2025-earnings-call-transcript/"},{"c":"RIG 2026 Q1","e":"rig","d":"2026-05-05","l":"cost_cuts","r":"management","s":"Keelan I. Adamson","x":"We remain confident in our ability to achieve over $200 million in cost synergies incremental to our standalone cost reduction initiatives of approximately $250 million that I mentioned earlier.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/05/transocean-rig-q1-2026-earnings-transcript/"}],"trends":{"theater":[[35,1,8054,0,0,0,6473,1185],[36,1,9564,0,0,0,7793,1333],[37,1,8410,0,0,0,6896,1085],[38,1,8576,0,0,0,6328,1764],[39,1,8373,0,0,0,6678,1311],[40,1,8174,0,0,0,6419,1358],[41,1,9407,0,0,0,7809,1189],[42,1,9000,0,0,0,7105,1571],[43,1,9337,0,0,0,7290,1727],[44,1,9016,0,0,0,7445,1257],[45,1,8795,0,0,0,6920,1557],[46,1,8785,0,0,0,6762,1679],[47,1,6660,0,0,0,5691,725],[48,1,6559,0,0,0,5183,1072],[49,1,8025,1,0,1,6485,1254],[50,1,8175,0,0,0,6974,830],[51,1,6126,0,0,0,5274,635],[52,1,8428,0,0,0,6743,1210],[53,1,6966,0,0,0,5443,1200],[54,1,7872,0,0,0,6332,1281],[55,1,8551,0,0,0,6664,1576],[56,1,7920,0,0,0,6540,1026],[57,1,8083,0,0,0,6611,1108],[58,1,7968,0,0,0,6190,1401],[59,1,9240,0,0,0,7400,1399],[60,1,7358,0,0,0,5792,1227],[61,1,6474,0,0,0,5336,907],[62,1,5888,0,0,0,4858,599],[63,1,5789,0,0,0,5264,381],[64,1,6669,0,0,0,5100,1234],[65,1,5877,0,0,0,4941,674],[67,1,9162,0,0,0,7136,1546]],"cinema":[[35,1,8054,0,0,0,6473,1185],[36,1,9564,0,0,0,7793,1333],[37,1,8410,0,0,0,6896,1085],[38,1,8576,0,0,0,6328,1764],[39,1,8373,0,0,0,6678,1311],[40,1,8174,0,0,0,6419,1358],[41,1,9407,0,0,0,7809,1189],[42,1,9000,0,0,0,7105,1571],[43,1,9337,0,0,0,7290,1727],[44,1,9016,0,0,0,7445,1257],[45,1,8795,0,0,0,6920,1557],[46,1,8785,0,0,0,6762,1679],[47,1,6660,0,0,0,5691,725],[48,1,6559,0,0,0,5183,1072],[49,1,8025,0,0,0,6485,1254],[50,1,8175,0,0,0,6974,830],[51,1,6126,0,0,0,5274,635],[52,1,8428,0,0,0,6743,1210],[53,1,6966,0,0,0,5443,1200],[54,1,7872,0,0,0,6332,1281],[55,