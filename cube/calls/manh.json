:[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0592,"r5":0.0403,"r20":0.0039,"r1_spy":0.0491,"r5_spy":0.0294,"r20_spy":-0.0382}},{"id":"MANH 2026 Q3","t":"MANH","d":"2026-10-27","time":"amc","w":7378,"n":60,"url":"https://www.fool.com/earnings/call-transcripts/2026/10/27/manhattan-associates-manh-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[2,2,0,2.76],"cost_cuts":[1,1,0,1.38],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":0.0246,"r5":0.0904,"r1_spy":0.0211,"r5_spy":0.1103}}],"quotes":[{"c":"MANH 2018 Q3","e":"manh","d":"2018-10-23","l":"streaming","r":"management","s":"Eddie Capel","x":"A number of customers, including several multi-billion dollar consumer brand companies have accelerated their upgrade plans in order to take immediate advantage of a new waveless order streaming and warehouse execution system features within WMS 2018.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/24/manhattan-associates-inc-manh-q3-2018-earnings-con.aspx"},{"c":"MANH 2018 Q3","e":"manh","d":"2018-10-23","l":"streaming","r":"management","s":"Eddie Capel","x":"Waveless order streaming optimizes the balance between direct to consumer and wholesale bulk fulfillment within a single distribution center, enabling their customers to more profitably and fluidly manage both the highly efficient bulk wholesale batch fulfillment and rush individual shipments to…","url":"https://www.fool.com/earnings/call-transcripts/2018/10/24/manhattan-associates-inc-manh-q3-2018-earnings-con.aspx"},{"c":"MANH 2018 Q3","e":"manh","d":"2018-10-23","l":"dtc","r":"management","s":"Eddie Capel","x":"This introduction was well timed to meet the market need as we see the distribution sector continuing to accelerate its implementation of new forms of automation to meet increasing direct to consumer volume and raising customer expectations around speed of delivery.","url":"https://www.fool.com/earnings/call-transcripts/2018/10/24/manhattan-associates-inc-manh-q3-2018-earnings-con.aspx"},{"c":"MANH 2018 Q4","e":"manh","d":"2019-02-05","l":"streaming","r":"management","s":"Eddie Capel","x":"I've spoken before about order streaming, the revolutionary machine learning driven reinvention of how type-pan (ph) activities occur in the distribution center.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/05/manhattan-associates-inc-manh-q4-2018-earnings-con.aspx"},{"c":"MANH 2018 Q4","e":"manh","d":"2019-02-05","l":"streaming","r":"management","s":"Eddie Capel","x":"I'm happy to tell you today that a major omni-channel apparel retailer here in the US, is seeing phenomenal early results after activating order streaming.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/05/manhattan-associates-inc-manh-q4-2018-earnings-con.aspx"},{"c":"MANH 2018 Q4","e":"manh","d":"2019-02-05","l":"dtc","r":"management","s":"Eddie Capel","x":"In particular, they're achieving significant operational efficiencies and material reductions in click to ship times and we believe that every significant direct-to-consumer shipper will need order streaming capabilities in order to succeed in the digital arena.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/05/manhattan-associates-inc-manh-q4-2018-earnings-con.aspx"},{"c":"MANH 2018 Q4","e":"manh","d":"2019-02-05","l":"dtc","r":"management","s":"Eddie Capel","x":"Yeah, really it's across the board Brian, it's -- you know, new verticals, frankly, particularly, as you see manufactured or branded folks sort of get into the direct-to-consumer business.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/05/manhattan-associates-inc-manh-q4-2018-earnings-con.aspx"},{"c":"MANH 2019 Q1","e":"manh","d":"2019-04-23","l":"theater","r":"management","s":"Eddie Capel","x":"Our global expansion has also been supported by our move to the cloud as our ability to deploy in additional theaters is now substantially faster and more effective.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/23/manhattan-associates-manh-q1-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q2","e":"manh","d":"2019-07-23","l":"theater","r":"management","s":"Eddie Capel","x":"…momentum with the Manhattan Active Omni solutions as well, particularly interesting in the number of customers rolling out our solution globally, often beginning their rollouts outside the U.S. And with our solution fully localized for multiple countries in Europe, they're beginning that theater.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/24/manhattan-associates-manh-q2-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q2","e":"manh","d":"2019-07-23","l":"theater","r":"management","s":"Dennis Story","x":"It is across the three theaters in which we operate.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/24/manhattan-associates-manh-q2-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q2","e":"manh","d":"2019-07-23","l":"streaming","r":"management","s":"Eddie Capel","x":"And the momentum, customer shared how order streaming capability for example has helped them dramatically improve the number of units pick per hour, while simultaneously and substantially reducing order cycle times, a key metric for digital age distribution.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/24/manhattan-associates-manh-q2-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q2","e":"manh","d":"2019-07-23","l":"streaming","r":"management","s":"Eddie Capel","x":"And then thirdly is sort of that changing -- little bit change in business model where you're seeing manufacturers and wholesalers go direct to consumer and having to deliver to customer expectations, increases the complexity of the supply chain, and so forth.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/24/manhattan-associates-manh-q2-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q2","e":"manh","d":"2019-07-23","l":"tariffs","r":"management","s":"Eddie Capel","x":"The cautionary language really Matt is just around the things that you've alluded to, that we all know about the tariff issues, the Brexit issues and the trickle on and trickle down effects of those.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/24/manhattan-associates-manh-q2-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q2","e":"manh","d":"2019-07-23","l":"tariffs","r":"management","s":"Eddie Capel","x":"Look, some could argue that the tariff issues could be advantageous to us as manufacturers bring manufacturing either near shore or onshore and have to retool for those things.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/24/manhattan-associates-manh-q2-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q2","e":"manh","d":"2019-07-23","l":"guidance","r":"analyst","s":"Matthew Pfau","x":"So maybe you can just talk about raising the guidance and what sort of macro factors are in there?","url":"https://www.fool.com/earnings/call-transcripts/2019/07/24/manhattan-associates-manh-q2-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q4","e":"manh","d":"2020-02-04","l":"streaming","r":"management","s":"Eddie Capel","x":"Now this is measured by the performance of our order management and warehouse management systems, given that the direct-to-consumer portions of our customers' businesses were up pretty much across the board, most with increases well into the double-digit percentages.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/04/manhattan-associates-manh-q4-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q4","e":"manh","d":"2020-02-04","l":"streaming","r":"management","s":"Eddie Capel","x":"In fact, one of our customers processed 28 times their average daily volume on Cyber Monday and another shared with us that our fulfillment solution allowed them to ship nearly 50% of their direct-to-consumer orders from their stores.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/04/manhattan-associates-manh-q4-2019-earnings-call-tr.aspx"},{"c":"MANH 2019 Q4","e":"manh","d":"2020-02-04","l":"dtc","r":"management","s":"Eddie Capel","x":"It works great except for the fact that when you're particularly in a direct-to-consumer world where you've got to get an individual order out, I mean, going through extremes here of course, you've got to get an individual order out of the building very quickly for same-day delivery, it can't be…","url":"https://www.fool.com/earnings/call-transcripts/2020/02/04/manhattan-associates-manh-q4-2019-earnings-call-tr.aspx"},{"c":"MANH 2020 Q1","e":"manh","d":"2020-04-21","l":"streaming","r":"management","s":"Eddie Capel","x":"We actually saw one customer, well-known retailer, transform their entire DC operation from retail replenishment to direct-to-consumer all within a space of six days.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/22/manhattan-associates-manh-q1-2020-earnings-call-tr.aspx"},{"c":"MANH 2020 Q1","e":"manh","d":"2020-04-21","l":"streaming","r":"management","s":"Eddie Capel","x":"And while we typically see our customers use retail replenishment and direct-to-consumer capabilities in tandem, this is the first time that we've seen this type of channel flip to direct-to-consumer in such a short time frame.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/22/manhattan-associates-manh-q1-2020-earnings-call-tr.aspx"},{"c":"MANH 2020 Q1","e":"manh","d":"2020-04-21","l":"dtc","r":"management","s":"Eddie Capel","x":"Now as we think about sort of the shift, clearly, we're seeing during this time a shift, even greater shift toward kind of direct-to-consumer.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/22/manhattan-associates-manh-q1-2020-earnings-call-tr.aspx"},{"c":"MANH 2020 Q1","e":"manh","d":"2020-04-21","l":"dtc","r":"management","s":"Eddie Capel","x":"One of them was a distribution center that was moved from being a retail replenishment, so ship to store DC to a direct-to-consumer facility on a space of a week.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/22/manhattan-associates-manh-q1-2020-earnings-call-tr.aspx"},{"c":"MANH 2020 Q1","e":"manh","d":"2020-04-21","l":"cost_cuts","r":"management","s":"Eddie Capel","x":"We have instituted a hiring freeze, but only for noncritical roles across the organization.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/22/manhattan-associates-manh-q1-2020-earnings-call-tr.aspx"},{"c":"MANH 2020 Q1","e":"manh","d":"2020-04-21","l":"cost_cuts","r":"management","s":"Eddie Capel","x":"These solutions go beyond streamlining and optimizing the supply chain, but are actively generating revenue and saving order volume through modern, adaptive concepts.","url":"https://www.fool.com/earnings/call-transcripts/2020/04/22/manhattan-associates-manh-q1-2020-earnings-call-tr.aspx"},{"c":"MANH 2020 Q2","e":"manh","d":"2020-07-23","l":"streaming","r":"management","s":"Eddie Capel","x":"You've made the point about the branded guys who are going kind of direct-to-consumer.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/23/manhattan-associates-inc-manh-q2-2020-earnings-cal.aspx"},{"c":"MANH 2020 Q2","e":"manh","d":"2020-07-23","l":"streaming","r":"management","s":"Eddie Capel","x":"There are also industries that are starting to go direct-to-consumer that we maybe would have not sort of expected to before and haven't maybe seen as retailers.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/23/manhattan-associates-inc-manh-q2-2020-earnings-cal.aspx"},{"c":"MANH 2020 Q2","e":"manh","d":"2020-07-23","l":"dtc","r":"management","s":"Eddie Capel","x":"You're starting to see those secondary markets look like direct-to-consumer, which is a great opportunity for us, number one.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/23/manhattan-associates-inc-manh-q2-2020-earnings-cal.aspx"},{"c":"MANH 2020 Q2","e":"manh","d":"2020-07-23","l":"dtc","r":"management","s":"Eddie Capel","x":"Now, obviously, the impact of COVID on the global macro and so forth, if we put that aside and to your point, talk about the shift in the dynamics of retail and so forth, we've been on the front end of course of servicing direct-to-consumer omnichannel customers really for more than a decade.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/23/manhattan-associates-inc-manh-q2-2020-earnings-cal.aspx"},{"c":"MANH 2020 Q2","e":"manh","d":"2020-07-23","l":"pricing_power","r":"analyst","s":"Matt Pfau","x":"And last one from me and I'll pass it on.","url":"https://www.fool.com/earnings/call-transcripts/2020/07/23/manhattan-associates-inc-manh-q2-2020-earnings-cal.aspx"},{"c":"MANH 2020 Q3","e":"manh","d":"2020-10-22","l":"streaming","r":"management","s":"Eddie Capel","x":"But as you see customers of ours and industries that have typically been, kind of, heavy wholesale, heavy manufacturing and not had any, kind of, consumer contact or direct-to-consumer strategy, but frankly now are, right?","url":"https://www.fool.com/earnings/call-transcripts/2020/10/22/manhattan-associates-inc-manh-q3-2020-earnings-cal/"},{"c":"MANH 2020 Q3","e":"manh","d":"2020-10-22","l":"streaming","r":"management","s":"Eddie Capel","x":"So it's starting to sell direct-to-consumer and require a good bit more sophistication in the distribution strategy.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/22/manhattan-associates-inc-manh-q3-2020-earnings-cal/"},{"c":"MANH 2020 Q4","e":"manh","d":"2021-02-02","l":"streaming","r":"management","s":"Eddie Capel","x":"The ongoing channel shift from bricks-and-mortar to digital e-commerce continues to benefit our omnichannel business and as we help more customers successfully capture and deliver on their direct-to-consumer orders.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/02/manhattan-associates-inc-manh-q4-2020-earnings-cal/"},{"c":"MANH 2021 Q1","e":"manh","d":"2021-04-27","l":"streaming","r":"management","s":"Eddie Capel","x":"Direct-to-consumer shipments were increasing.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/28/manhattan-associates-inc-manh-q1-2021-earnings-cal/"},{"c":"MANH 2021 Q1","e":"manh","d":"2021-04-27","l":"streaming","r":"management","s":"Eddie Capel","x":"We're starting to see just like here in the U.S., frankly, things begin to open up, direct-to-consumer growing.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/28/manhattan-associates-inc-manh-q1-2021-earnings-cal/"},{"c":"MANH 2021 Q1","e":"manh","d":"2021-04-27","l":"guidance","r":"management","s":"Eddie Capel","x":"With our forward revenue visibility improving and the inherent leverage in our model, we'll be increasing our 2021 guidance across the board.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/28/manhattan-associates-inc-manh-q1-2021-earnings-cal/"},{"c":"MANH 2021 Q1","e":"manh","d":"2021-04-27","l":"guidance","r":"management","s":"Dennis Story","x":"Turning to increased 2021 guidance.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/28/manhattan-associates-inc-manh-q1-2021-earnings-cal/"},{"c":"MANH 2021 Q2","e":"manh","d":"2021-07-27","l":"streaming","r":"management","s":"Eddie Capel","x":"And early reports that customers are seeing significant benefit from innovations like customer-grade mobile experience for warehouse associates, order streaming and its first-of-a-kind employee engagement capability built directly into WMS.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/27/manhattan-associates-inc-manh-q2-2021-earnings-cal/"},{"c":"MANH 2021 Q2","e":"manh","d":"2021-07-27","l":"guidance","r":"management","s":"Eddie Capel","x":"So with momentum accelerating and forward revenue visibility improving, once again, we're increasing our 2021 guidance, including RPO.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/27/manhattan-associates-inc-manh-q2-2021-earnings-cal/"},{"c":"MANH 2021 Q2","e":"manh","d":"2021-07-27","l":"guidance","r":"management","s":"Dennis Story","x":"For adjusted EPS, we are raising our full year guidance range to $2 to $2.06, with a midpoint of $2.03, up 23% from our previous midpoint of $1.65.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/27/manhattan-associates-inc-manh-q2-2021-earnings-cal/"},{"c":"MANH 2021 Q3","e":"manh","d":"2021-10-26","l":"dtc","r":"analyst","s":"Terrell Frederick Tillman","x":"What I'm curious about is, is it something with certain of the active cloud products that is getting you into parts of the retail or the e-commerce-oriented markets that you haven't been before, whether it's DTC or just other types of kind of micro segments?","url":"https://www.fool.com/earnings/call-transcripts/2021/10/26/manhattan-associates-inc-manh-q3-2021-earnings-cal/"},{"c":"MANH 2024 Q4","e":"manh","d":"2025-01-28","l":"tariffs","r":"management","s":"Eddie Capel","x":"From our perspective, no tariffs really we expect on our business.","url":"https://www.fool.com/earnings/call-transcripts/2026/01/26/manhattan-associates-manh-earnings-transcript/"},{"c":"MANH 2024 Q4","e":"manh","d":"2025-01-28","l":"tariffs","r":"analyst","s":"George Kurosawa","x":"Sorry to start with politics here, but maybe just kind of the current house view on how you are thinking about the potential impact of tariffs on your business and if there is any kind of changes to your positioning?","url":"https://www.fool.com/earnings/call-transcripts/2026/01/26/manhattan-associates-manh-earnings-transcript/"},{"c":"MANH 2025 Q2","e":"manh","d":"2025-07-22","l":"tariffs","r":"management","s":"Eric Clark","x":"This execution is encouraging, however, given the inherent flexibility of time and materials contracts, coupled with the ongoing tariff and general market uncertainty, we remain cautious on our services revenue growth.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/22/manhattan-manh-q2-2025-earnings-call-transcript/"},{"c":"MANH 2025 Q2","e":"manh","d":"2025-07-22","l":"pricing_power","r":"management","s":"Eric Clark","x":"Of course, there's also the opportunity for price increases in some cases, and all of this will drive higher RPO and higher subscription revenue.","url":"https://www.fool.com/earnings/call-transcripts/2025/07/22/manhattan-manh-q2-2025-earnings-call-transcript/"},{"c":"MANH 2025 Q4","e":"manh","d":"2026-01-27","l":"pricing_power","r":"management","s":"Dennis B. Story","x":"If a renewal is set to occur, during this four-year period, it renews at current pricing with no churn or price increases assumed.","url":"https://www.fool.com/earnings/call-transcripts/2026/01/27/manhattan-associates-manh-earnings-transcript/"},{"c":"MANH 2025 Q4","e":"manh","d":"2026-01-27","l":"pricing_power","r":"analyst","s":"Eric Clark","x":"So having the opportunity to have another conversation about price increase in three years versus five years is an advantage to us.","url":"https://www.fool.com/earnings/call-transcripts/2026/01/27/manhattan-associates-manh-earnings-transcript/"},{"c":"MANH 2025 Q4","e":"manh","d":"2026-01-27","l":"cost_cuts","r":"analyst","s":"Eric Clark","x":"The reason companies embark on this is because it truly does create efficiency and it does create cost savings and it does create ROI for them.","url":"https://www.fool.com/earnings/call-transcripts/2026/01/27/manhattan-associates-manh-earnings-transcript/"},{"c":"MANH 2026 Q3","e":"manh","d":"2026-10-27","l":"pricing_power","r":"management","s":"Eric Clark","x":"We would love to have the opportunity talk every 3 years about expansion and price increases.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/27/manhattan-associates-manh-q3-2026-earnings-call-transcript/"},{"c":"MANH 2026 Q3","e":"manh","d":"202