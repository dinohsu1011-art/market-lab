0,0.0]},"move":{"r1":0.0506,"r5":0.061,"r20":-0.0151,"r1_spy":0.0522,"r5_spy":0.0575,"r20_spy":-0.0091}},{"id":"ITT 2026 Q3","t":"ITT","d":"2026-11-05","time":"bmo","w":7441,"n":48,"url":"https://www.fool.com/earnings/call-transcripts/2026/11/05/itt-inc-itt-q3-2026-earnings-call-transcript/","lens":{"theater":[0,0,0,0.0],"cinema":[0,0,0,0.0],"imax":[0,0,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[0,0,0,0.0],"tariffs":[0,0,0,0.0],"pricing_power":[0,0,0,0.0],"cost_cuts":[0,0,0,0.0],"guidance":[0,0,0,0.0,{"raise":0,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0254,"r5":0.0695,"r1_spy":0.0187,"r5_spy":0.0787}}],"quotes":[{"c":"ITT 2018 Q2","e":"itt","d":"2018-08-03","l":"tariffs","r":"management","s":"Denise Ramos","x":"With respect to U.S. Section 232 related tariffs on steel and aluminum, and we stated last quarter, ITT procures most of its raw materials, primarily steel, in Europe for our European MT operations.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/06/itt-itt-q2-2018-earnings-conference-call-transcrip.aspx"},{"c":"ITT 2018 Q2","e":"itt","d":"2018-08-03","l":"tariffs","r":"management","s":"Denise Ramos","x":"So these steel tariffs are less of a concern for us.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/06/itt-itt-q2-2018-earnings-conference-call-transcrip.aspx"},{"c":"ITT 2018 Q2","e":"itt","d":"2018-08-03","l":"pricing_power","r":"management","s":"Denise Ramos","x":"…input cost in 2018 through to following actions: we are, and we will continue to selectively raise prices at IP, CCT, and MT Wolverine; we will utilize manufacturing facilities that are best positioned to produce the local market; we will drive incremental supply chain actions; and we will…","url":"https://www.fool.com/earnings/call-transcripts/2018/08/06/itt-itt-q2-2018-earnings-conference-call-transcrip.aspx"},{"c":"ITT 2018 Q2","e":"itt","d":"2018-08-03","l":"pricing_power","r":"analyst","s":"Joe Giordano","x":"In terms of the auto OEMs on MT have you guys have the ability to kind of pushback on contractual price declines a little bit, given commodity price increases?","url":"https://www.fool.com/earnings/call-transcripts/2018/08/06/itt-itt-q2-2018-earnings-conference-call-transcrip.aspx"},{"c":"ITT 2018 Q2","e":"itt","d":"2018-08-03","l":"cost_cuts","r":"management","s":"Denise Ramos","x":"IP's productivity enhancements, supply chain actions, restructuring benefits, and project execution improvements all contributed to IP's 51% growth in adjusted operating income and their 350-basis-point improvement in operating margins.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/06/itt-itt-q2-2018-earnings-conference-call-transcrip.aspx"},{"c":"ITT 2018 Q2","e":"itt","d":"2018-08-03","l":"cost_cuts","r":"management","s":"Denise Ramos","x":"The operating margin expansion of 110 basis points was primarily driven by volume increases across each of our segments as well as significant operating productivity, including supply chain and restructuring actions.","url":"https://www.fool.com/earnings/call-transcripts/2018/08/06/itt-itt-q2-2018-earnings-conference-call-transcrip.aspx"},{"c":"ITT 2018 Q3","e":"itt","d":"2018-11-02","l":"tariffs","r":"management","s":"Thomas Scalera","x":"So let me wrap up on tariffs.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/02/itt-inc-itt-q3-2018-earnings-conference-call-trans.aspx"},{"c":"ITT 2018 Q3","e":"itt","d":"2018-11-02","l":"tariffs","r":"management","s":"Thomas Scalera","x":"We have already taken actions in 2018 to proactively mitigate the projected 2019 tariff exposures we know of today.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/02/itt-inc-itt-q3-2018-earnings-conference-call-trans.aspx"},{"c":"ITT 2018 Q3","e":"itt","d":"2018-11-02","l":"pricing_power","r":"management","s":"Thomas Scalera","x":"At this point, we are deploying a variety of actions, including price increases, improved leverage of our local market manufacturing capabilities and additional supply chain actions.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/02/itt-inc-itt-q3-2018-earnings-conference-call-trans.aspx"},{"c":"ITT 2018 Q3","e":"itt","d":"2018-11-02","l":"cost_cuts","r":"management","s":"Thomas Scalera","x":"The increase was driven by improved short-cycle pricing, higher volumes, favorable mix, restructuring savings, productivity and improved project execution.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/02/itt-inc-itt-q3-2018-earnings-conference-call-trans.aspx"},{"c":"ITT 2018 Q3","e":"itt","d":"2018-11-02","l":"cost_cuts","r":"management","s":"Luca Savi","x":"…as Tom has highlighted though, our more rigorous, diligent and better execution as well as the restructuring action that we have taken in the previous couple of years made us more cost competitive, which means that the profitability of this projects when they're coming in are better for us…","url":"https://www.fool.com/earnings/call-transcripts/2018/11/02/itt-inc-itt-q3-2018-earnings-conference-call-trans.aspx"},{"c":"ITT 2018 Q3","e":"itt","d":"2018-11-02","l":"guidance","r":"management","s":"Denise L. Ramos","x":"These significant advances in our three strategic focus areas are leading us to raise our 2018 guidance once again.","url":"https://www.fool.com/earnings/call-transcripts/2018/11/02/itt-inc-itt-q3-2018-earnings-conference-call-trans.aspx"},{"c":"ITT 2018 Q4","e":"itt","d":"2019-02-22","l":"tariffs","r":"management","s":"Tom Scalera","x":"The expansion will be driven by improved volumes and strong operational execution, partially offset by higher raw material costs, incremental tariffs and strategic investments of 80 basis points.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/22/itt-corp-itt-q4-2018-earnings-conference-call-tran.aspx"},{"c":"ITT 2018 Q4","e":"itt","d":"2019-02-22","l":"tariffs","r":"management","s":"Tom Scalera","x":"The underlying 2019 headwinds we are offsetting with productivity and price actions, include material cost pressures, incremental tariffs and automotive contractual pricing impacts.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/22/itt-corp-itt-q4-2018-earnings-conference-call-tran.aspx"},{"c":"ITT 2018 Q4","e":"itt","d":"2019-02-22","l":"cost_cuts","r":"management","s":"Tom Scalera","x":"CCT segment operating income increased 24% to $26 million and benefit from volume, improved productivity in the connector operations and restructuring gains, partially offset by increased material cost.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/22/itt-corp-itt-q4-2018-earnings-conference-call-tran.aspx"},{"c":"ITT 2018 Q4","e":"itt","d":"2019-02-22","l":"cost_cuts","r":"management","s":"Tom Scalera","x":"The tailwinds primarily include global share gains, increased net productivity, restructuring benefits, lower corporate costs and continued operational improvements from our most recently acquired businesses of Axtone, Wolverine and ECS as they continue to reap the benefits of ITT's management…","url":"https://www.fool.com/earnings/call-transcripts/2019/02/22/itt-corp-itt-q4-2018-earnings-conference-call-tran.aspx"},{"c":"ITT 2019 Q1","e":"itt","d":"2019-05-03","l":"tariffs","r":"management","s":"Tom Scalera","x":"The income expansion was driven by volume and productivity actions partially offset by higher commodity and tariff costs and mix.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/04/itt-inc-itt-q1-2019-earnings-call-transcript.aspx"},{"c":"ITT 2019 Q1","e":"itt","d":"2019-05-03","l":"tariffs","r":"management","s":"Tom Scalera","x":"The Q1 expansion drivers were volume partially offset by mix and productivity, supply chain and restructuring actions that more than offset higher commodity, tariff and labor costs.","url":"https://www.fool.com/earnings/call-transcripts/2019/05/04/itt-inc-itt-q1-2019-earnings-call-transcript.aspx"},{"c":"ITT 2019 Q1","e":"i