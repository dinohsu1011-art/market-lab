,0,0.0],"streaming":[0,0,0,0.0],"dtc":[0,0,0,0.0],"ai_spend":[2,1,1,2.53],"tariffs":[0,0,0,0.0],"pricing_power":[2,0,2,2.53],"cost_cuts":[1,1,0,1.26],"guidance":[1,1,0,1.26,{"raise":1,"reaffirm":0,"cut":0}]},"move":{"r1":0.0175,"r5":0.0459,"r1_spy":0.001,"r5_spy":0.0518}}],"quotes":[{"c":"RPRX 2020 Q4","e":"rprx","d":"2021-02-17","l":"pricing_power","r":"management","s":"Pablo Legorreta","x":"But I'll pass it on to Terry now for the other part of the question.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/17/royalty-pharma-plc-rprx-q4-2020-earnings-call-tran/"},{"c":"RPRX 2021 Q1","e":"rprx","d":"2021-05-11","l":"guidance","r":"management","s":"Pablo Legorreta","x":"Lastly, we're also raising our guidance for adjusted cash receipts for 2021.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/11/royalty-pharma-plc-rprx-q1-2021-earnings-call-tran/"},{"c":"RPRX 2021 Q1","e":"rprx","d":"2021-05-11","l":"guidance","r":"management","s":"Pablo Legorreta","x":"This excellent momentum positions us well to deliver another year of strong performance, as Terry will speak to when he discusses our raised guidance for this year.","url":"https://www.fool.com/earnings/call-transcripts/2021/05/11/royalty-pharma-plc-rprx-q1-2021-earnings-call-tran/"},{"c":"RPRX 2021 Q2","e":"rprx","d":"2021-08-11","l":"guidance","r":"management","s":"Pablo Legorreta","x":"Taken together, based on our strong business dynamics, we're again raising our guidance for adjusted cash receipts for full-year 2021.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/11/royal-pharma-rprx-q2-2021-earnings-call-transcript/"},{"c":"RPRX 2021 Q2","e":"rprx","d":"2021-08-11","l":"guidance","r":"management","s":"Pablo Legorreta","x":"As Terry will speak to what he discusses, our raised guidance for the current year.","url":"https://www.fool.com/earnings/call-transcripts/2021/08/11/royal-pharma-rprx-q2-2021-earnings-call-transcript/"},{"c":"RPRX 2021 Q3","e":"rprx","d":"2021-11-10","l":"guidance","r":"management","s":"Pablo Legorreta","x":"Lastly, based on these strong business dynamics, we're again raising our guidance for adjusted cash receipts for 2021.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/12/royal-pharma-rprx-q3-2021-earnings-call-transcript/"},{"c":"RPRX 2021 Q3","e":"rprx","d":"2021-11-10","l":"guidance","r":"management","s":"Pablo Legorreta","x":"The strong momentum puts us in a tremendous position to deliver another year of strong financial performance in 2021 as Terry will speak to when she discusses our raised guidance for the current year.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/12/royal-pharma-rprx-q3-2021-earnings-call-transcript/"},{"c":"RPRX 2021 Q4","e":"rprx","d":"2022-02-15","l":"cost_cuts","r":"management","s":"Terry Coyne","x":"Our operating and professional costs for 2021 were broadly similar to last year as 2020 included a number of onetime costs related to our restructuring, IPO and inaugural bond offering.","url":"https://www.fool.com/earnings/call-transcripts/2022/02/15/royalty-pharma-plc-rprx-q4-2021-earnings-call-tran/"},{"c":"RPRX 2022 Q1","e":"rprx","d":"2022-05-05","l":"guidance","r":"management","s":"Terry Coyne","x":"Lastly, we are reaffirming our full year guidance for adjusted cash receipts based on the strong underlying performance of our existing portfolio.","url":"https://www.fool.com/earnings/call-transcripts/2022/05/05/royalty-pharma-plc-rprx-q1-2022-earnings-call-tran/"},{"c":"RPRX 2022 Q1","e":"rprx","d":"2022-05-05","l":"guidance","r":"management","s":"Terry Coyne","x":"Despite this, we have maintained our guidance for adjusted cash receipts, again, highlighting the strength of our diversified portfolio.","url":"https://www.fool.com/earnings/call-transcripts/2022/05/05/royalty-pharma-plc-rprx-q1-2022-earnings-call-tran/"},{"c":"RPRX 2022 Q2","e":"rprx","d":"2022-08-04","l":"pricing_power","r":"management","s":"Pablo Legorreta","x":"Maybe just briefly before I pass it on to Marshall.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/05/royalty-pharma-plc-rprx-q2-2022-earnings-call-tran/"},{"c":"RPRX 2022 Q2","e":"rprx","d":"2022-08-04","l":"pricing_power","r":"management","s":"Pablo Legorreta","x":"But Marshall, I'll pass it on to you.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/05/royalty-pharma-plc-rprx-q2-2022-earnings-call-tran/"},{"c":"RPRX 2022 Q2","e":"rprx","d":"2022-08-04","l":"guidance","r":"management","s":"Pablo Legorreta","x":"These important milestones potentially bring this important [Inaudible] Lastly, raising our full year guidance for cash received based on the strong underlying performance of our existing portfolio and the addition of the Trelegy royalties, and we now expect 7% to 10% top-line growth.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/05/royalty-pharma-plc-rprx-q2-2022-earnings-call-tran/"},{"c":"RPRX 2022 Q2","e":"rprx","d":"2022-08-04","l":"guidance","r":"management","s":"Terry Coyne","x":"We are pleased to be raising guidance with our top line now expected to grow 7% to 10% in a year that our business faces LOE pressure from two prior top royalty streams as well as significant FX headwinds.","url":"https://www.fool.com/earnings/call-transcripts/2022/08/05/royalty-pharma-plc-rprx-q2-2022-earnings-call-tran/"},{"c":"RPRX 2025 Q4","e":"rprx","d":"2026-02-11","l":"cost_cuts","r":"management","s":"Terrance Coyne","x":"This significant reduction when compared with 8.9% in 2025 is primarily the result of cost savings from the internalization of the manager.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/11/royalty-pharma-rprx-q4-2025-earnings-transcript/"},{"c":"RPRX 2025 Q4","e":"rprx","d":"2026-02-11","l":"guidance","r":"management","s":"Pablo Legorreta","x":"We raised our guidance three times in the year and delivered full-year results slightly above the top end of our most recent update.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/11/royalty-pharma-rprx-q4-2025-earnings-transcript/"},{"c":"RPRX 2026 Q1","e":"rprx","d":"2026-05-06","l":"cost_cuts","r":"management","s":"Terrance Coyne","x":"Payments for operating and professional costs are still expected to be in the range of approximately 5.5% to 6.5% of portfolio receipts in 2026, reflecting cost savings from the internalization of the manager.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/06/royalty-pharma-rprx-q1-2026-earnings-transcript/"},{"c":"RPRX 2026 Q1","e":"rprx","d":"2026-05-06","l":"guidance","r":"management","s":"Terrance Coyne","x":"We have again raised our guidance, and we expect to deliver another full year of strong financial performance in 2026.","url":"https://www.fool.com/earnings/call-transcripts/2026/05/06/royalty-pharma-rprx-q1-2026-earnings-transcript/"},{"c":"RPRX 2026 Q2","e":"rprx","d":"2026-08-05","l":"cost_cuts","r":"management","s":"Terrance Coyne","x":"Payments for operating and professional costs are still expected to be in the range of 5.5% to 6.5% of portfolio receipts in 2026, reflecting cost savings from the internalization of the manager.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/12/royalty-pharma-rprx-q2-2026-earnings-call-transcript/"},{"c":"RPRX 2026 Q2","e":"rprx","d":"2026-08-05","l":"guidance","r":"management","s":"Terrance Coyne","x":"We have again raised our guidance, and we expect to continue to deliver another full year of strong financial performance in 2026.","url":"https://www.fool.com/earnings/call-transcripts/2026/08/12/royalty-pharma-rprx-q2-2026-earnings-call-transcript/"},{"c":"RPRX 2026 Q3","e":"rprx","d":"2026-11-04","l":"ai_spend","r":"management","s":"Pablo Legorreta","x":"I'll take a first crack at it, but then maybe Marshall can get into some of the specifics of AI and then the investment process.","url":"https://www.fool.com/earnings/call-transcripts/2026/11/04/royalty-pharma-rprx-q3-2026-earnings-call-transcript/