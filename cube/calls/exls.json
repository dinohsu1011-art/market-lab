0,3.15,{"raise":2,"reaffirm":0,"cut":0}],"ai_disruption":[0,0,0,0.0]},"move":{"r1":-0.0051,"r5":0.0293,"r1_spy":-0.0086,"r5_spy":0.0492}}],"quotes":[{"c":"EXLS 2018 Q4","e":"exls","d":"2019-02-28","l":"cost_cuts","r":"management","s":"Rohit Kapoor","x":"We're working on this asset with utmost priority and have already undertaken a full review of the business with the goal to restructure and right size it.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/28/exlservice-holdings-inc-exls-q4-2018-earnings-conf.aspx"},{"c":"EXLS 2018 Q4","e":"exls","d":"2019-02-28","l":"cost_cuts","r":"management","s":"Rohit Kapoor","x":"We will continue to focus on expeditiously restructuring Health Integrated and will provide you with an update in the next earnings calls.","url":"https://www.fool.com/earnings/call-transcripts/2019/02/28/exlservice-holdings-inc-exls-q4-2018-earnings-conf.aspx"},{"c":"EXLS 2019 Q1","e":"exls","d":"2019-04-30","l":"cost_cuts","r":"management","s":"Rohit Kapoor","x":"We have aligned the front-end sales force of SCIO with EXL to streamline our go-to-market strategy across the entire healthcare value chain.","url":"https://www.fool.com/earnings/call-transcripts/2019/04/30/exlservice-holdings-inc-exls-q1-2019-earnings-call.aspx"},{"c":"EXLS 2019 Q2","e":"exls","d":"2019-07-30","l":"cost_cuts","r":"management","s":"Vishal Chhibbar","x":"In addition, we recorded impairment and restructuring charges of $5.6 million for the quarter, which is excluded from our adjusted EPS.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/30/exlservice-holdings-inc-exls-q2-2019-earnings-call.aspx"},{"c":"EXLS 2019 Q2","e":"exls","d":"2019-07-30","l":"cost_cuts","r":"management","s":"Rohit Kapoor","x":"The two fundamental reasons are, as you rightly pointed out, number one is a reduction in workforce in Health Integrated which had an impact in the second quarter.","url":"https://www.fool.com/earnings/call-transcripts/2019/07/30/exlservice-holdings-inc-exls-q2-2019-earnings-call.aspx"},{"c":"EXLS 2019 Q3","e":"exls","d":"2019-10-29","l":"cost_cuts","r":"management","s":"Vishal Chhibbar","x":"In addition, we recorded impairment and restructuring charges of $489,000 for the quarter, which is excluded from the adjusted EPS.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/29/exlservice-holdings-inc-exls-q3-2019-earnings-call.aspx"},{"c":"EXLS 2019 Q3","e":"exls","d":"2019-10-29","l":"cost_cuts","r":"management","s":"Vishal Chhibbar","x":"Year-to-date, we have recorded restructuring charges of $7.3 million and on a full-year basis, we expect to incur pre-tax impairment and restructuring charges in the range of $8.5 million to $10 million as mentioned last quarter.","url":"https://www.fool.com/earnings/call-transcripts/2019/10/29/exlservice-holdings-inc-exls-q3-2019-earnings-call.aspx"},{"c":"EXLS 2019 Q4","e":"exls","d":"2020-02-27","l":"cost_cuts","r":"management","s":"Rohit Kapoor","x":"And there will be no more restructuring charges going forward.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/27/exlservice-holdings-inc-exls-q4-2019-earnings-call.aspx"},{"c":"EXLS 2019 Q4","e":"exls","d":"2020-02-27","l":"cost_cuts","r":"management","s":"Maurizio Nicolelli","x":"In addition for the year, we recorded impairment and restructuring charges of $8.7 million as the exit costs or one-time cost they are excluded from adjusted EPS.","url":"https://www.fool.com/earnings/call-transcripts/2020/02/27/exlservice-holdings-inc-exls-q4-2019-earnings-call.aspx"},{"c":"EXLS 2020 Q1","e":"exls","d":"2020-05-07","l":"cost_cuts","r":"management","s":"Maurizio Nicolelli","x":"As the economic environment remains unclear and the responses of our clients to their business challenges continue to evolve, we have proactively initiated certain cost-saving measures.","url":"https://www.fool.com/earnings/call-transcripts/2020/05/07/exlservice-holdings-inc-exls-q1-2020-earnings-call.aspx"},{"c":"EXLS 2020 Q2","e":"exls","d":"2020-08-06","l":"pricing_power","r":"management","s":"Maurizio Nicolelli","x":"This includes onetime COVID-related pass-through revenue of $3.3 million.","url":"https://www.fool.com/earnings/call-transcripts/2020/08/06/exlservice-holdings-inc-exls-q2-2020-earnings-call.aspx"},{"c":"EXLS 2020 Q3","e":"exls","d":"2020-10-29","l":"pricing_power","r":"management","s":"Maurizio Nicolelli","x":"This includes onetime COVID related pass-through revenue of $4.4 million.","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/exlservice-holdings-inc-exls-q3-2020-earnings-call/"},{"c":"EXLS 2020 Q3","e":"exls","d":"2020-10-29","l":"cost_cuts","r":"analyst","s":"Bryan Bergin","x":"Can you quantify some of the key margin outperformance drivers, particularly within gross margin, the strong level you had there, what type of mix of cost savings are lasting versus short-term discretionary, like T&E type items within 3Q?","url":"https://www.fool.com/earnings/call-transcripts/2020/10/30/exlservice-holdings-inc-exls-q3-2020-earnings-call/"},{"c":"EXLS 2020 Q4","e":"exls","d":"2021-02-25","l":"pricing_power","r":"management","s":"Maurizio Nicolelli","x":"This includes one-time COVID-related pass-through revenue of $1.7 million.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/25/exlservice-holdings-inc-exls-q4-2020-earnings-call/"},{"c":"EXLS 2020 Q4","e":"exls","d":"2021-02-25","l":"cost_cuts","r":"analyst","s":"Moshe Katri","x":"And then final question, just structurally, looking at the new logo wins, is there anything different in terms of how you're restructuring some of these engagements compared to where we were pre-pandemic?","url":"https://www.fool.com/earnings/call-transcripts/2021/02/25/exlservice-holdings-inc-exls-q4-2020-earnings-call/"},{"c":"EXLS 2020 Q4","e":"exls","d":"2021-02-25","l":"ai_disruption","r":"management","s":"Rohit Kapoor","x":"Hosting the solution on cloud allows the clients to leverage our AI accelerators and use the solution output without disrupting their existing operations.","url":"https://www.fool.com/earnings/call-transcripts/2021/02/25/exlservice-holdings-inc-exls-q4-2020-earnings-call/"},{"c":"EXLS 2021 Q1","e":"exls","d":"2021-04-29","l":"streaming","r":"management","s":"Rohit Kapoor","x":"Our clients are investing in highly personalized, direct-to-consumer marketing to enable more effective customer acquisition and retention.","url":"https://www.fool.com/earnings/call-transcripts/2021/04/29/exlservice-holdings-inc-exls-q1-2021-earnings-call/"},{"c":"EXLS 2021 Q2","e":"exls","d":"2021-07-29","l":"ai_spend","r":"management","s":"Rohit Kapoor","x":"Our investment in the advanced analytics, AI capabilities, cloud capabilities and our proprietary data assets gives us a competitive advantage.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/29/exlservice-holdings-inc-exls-q2-2021-earnings-call/"},{"c":"EXLS 2021 Q2","e":"exls","d":"2021-07-29","l":"cost_cuts","r":"management","s":"Rohit Kapoor","x":"The program has already driven significant cost reduction benefits and improved customer experience.","url":"https://www.fool.com/earnings/call-transcripts/2021/07/29/exlservice-holdings-inc-exls-q2-2021-earnings-call/"},{"c":"EXLS 2021 Q3","e":"exls","d":"2021-11-02","l":"ai_spend","r":"management","s":"Rohit Kapoor","x":"To realize our brand promise, we are making significant investments in advanced analytics AI based content extraction, conversational AI and cloud-based operations analytics.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/02/exlservice-holdings-inc-exls-q3-2021-earnings-call/"},{"c":"EXLS 2021 Q3","e":"exls","d":"2021-11-02","l":"ai_spend","r":"management","s":"Maurizio Nicolelli","x":"In terms of capital allocation, we continue to invest in analytics, AI, digital solutions and technology.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/02/exlservice-holdings-inc-exls-q3-2021-earnings-call/"},{"c":"EXLS 2021 Q3","e":"exls","d":"2021-11-02","l":"pricing_power","r":"analyst","s":"David Grossman","x":"…whether -- how you view the structural impact of the hybrid work model -- this industry historically is pretty quickly price efficiencies that could pass-through, and I'm just wondering how you feel about the hybrid work model and the benefits and how enduring if you will, those benefits may be?","url":"https://www.fool.com/earnings/call-transcripts/2021/11/02/exlservice-holdings-inc-exls-q3-2021-earnings-call/"},{"c":"EXLS 2021 Q3","e":"exls","d":"2021-11-02","l":"cost_cuts","r":"management","s":"Rohit Kapoor","x":"It also emphasizes the critical role data plays in driving better decision making and more intelligent operations enabling companies to predict trends, deliver a hyper-personalized customer experiences and streamline workflows.","url":"https://www.fool.com/earnings/call-transcripts/2021/11/02/exlservice-holdings-inc-exls-q3-2021-earnings-call/"},{"c":"EXLS 2025 Q2","e":"exls","d":"2025-07-30","l":"ai_spend","r":"management","s":"Rohit Kapoor","x":"This demonstrates the strength of our competitive position as a recognized leader in embedding AI in the workflow and delivering superior return on investments for our clients.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/28/exls-q2-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q2","e":"exls","d":"2025-07-30","l":"ai_spend","r":"management","s":"Rohit Kapoor","x":"Our decades of domain experience and early investments in data and AI allow us to help clients seamlessly embed AI into operations and achieve tangible results.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/28/exls-q2-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q2","e":"exls","d":"2025-07-30","l":"tariffs","r":"analyst","s":"Matt S. Dezort","x":"How are you seeing that evolve as clients are pressured a little bit by the macro in tariffs and the drive to adopt AI, which you seem to have an advantage in?","url":"https://www.fool.com/earnings/call-transcripts/2026/04/28/exls-q2-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q2","e":"exls","d":"2025-07-30","l":"cost_cuts","r":"management","s":"Maurizio Nicolelli","x":"SG&A expenses as a percentage of revenue declined 130 basis points year-over- year to 19.2%, driven by the onetime restructuring costs we had in the second quarter of last year and lower employee costs.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/28/exls-q2-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q2","e":"exls","d":"2025-07-30","l":"cost_cuts","r":"management","s":"Maurizio Nicolelli","x":"Dave, if you look back in the second quarter of last year, we had a onetime restructuring charge during the period, so that was the biggest driver in that and you see that fall off this year.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/28/exls-q2-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q2","e":"exls","d":"2025-07-30","l":"ai_disruption","r":"management","s":"Rohit Kapoor","x":"We have deliberately avoided low-value work, which is highly vulnerable to disruption from AI.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/28/exls-q2-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q3","e":"exls","d":"2025-10-29","l":"ai_spend","r":"management","s":"Rohit Kapoor","x":"While many enterprises struggle to generate returns from AI investments, ExlService Holdings, Inc.'s unique strengths in domain, data, and AI are delivering meaningful ROI and transforming how businesses operate.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/30/exlservice-exls-q3-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q3","e":"exls","d":"2025-10-29","l":"ai_spend","r":"management","s":"Rohit Kapoor","x":"We have bolstered ExlService Holdings, Inc.'s competitive position by investing in next-generation data and AI capabilities with the launch of exldata.ai.","url":"https://www.fool.com/earnings/call-transcripts/2025/10/30/exlservice-exls-q3-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q4","e":"exls","d":"2026-02-25","l":"ai_spend","r":"management","s":"Rohit Kapoor","x":"Our data and analytics capabilities and our investments in AI give us a clear advantage for winning AI services contracts.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/25/exlservice-exls-q4-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q4","e":"exls","d":"2026-02-25","l":"ai_spend","r":"management","s":"Rohit Kapoor","x":"We continue to invest in training, certifications, and tools such as our AI playground, enabling colleagues to explore, experiment, and build with agentic technologies.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/25/exlservice-exls-q4-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q4","e":"exls","d":"2026-02-25","l":"cost_cuts","r":"management","s":"Rohit Kapoor","x":"There is also a change in terms of shifting the focus from cost takeout to growth, and I think using AI for growth allows companies to be a lot more competitive and to be able to build up their businesses.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/25/exlservice-exls-q4-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q4","e":"exls","d":"2026-02-25","l":"cost_cuts","r":"management","s":"Eleanor Dyke","x":"And then also just was wondering, are you seeing a shift in client priorities between cost takeout mandates versus long-term digital transformation, including AI?","url":"https://www.fool.com/earnings/call-transcripts/2026/02/25/exlservice-exls-q4-2025-earnings-call-transcript/"},{"c":"EXLS 2025 Q4","e":"exls","d":"2026-02-25","l":"ai_disruption","r":"management","s":"Rohit Kapoor","x":"These efforts earned industry recognition, including becoming a globally managed Google Cloud strategic services partner and being named AWS's 2025 AI/ML Market Disruptor of the Year.","url":"https://www.fool.com/earnings/call-transcripts/2026/02/25/exlservice-exls-q4-2025-earnings-call-transcript/"},{"c":"EXLS 2026 Q1","e":"exls","d":"2026-04-29","l":"ai_spend","r":"management","s":"Maurizio Nicolelli","x":"SG&A expenses as a percentage of revenue increased 20 basis points year over year to 20.4%, driven by investments in data and AI-led solutions.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/exlservice-exls-q1-2026-earnings-transcript/"},{"c":"EXLS 2026 Q1","e":"exls","d":"2026-04-29","l":"ai_spend","r":"management","s":"Maurizio Nicolelli","x":"We anticipate increased investments in data and AI capabilities and solutions for the rest of the year to expand our competitive advantage and continue to drive top-line revenue growth.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/exlservice-exls-q1-2026-earnings-transcript/"},{"c":"EXLS 2026 Q1","e":"exls","d":"2026-04-29","l":"pricing_power","r":"management","s":"Rohit Kapoor","x":"I will pass it on to Maurizio to talk about the prudent guidance that we have given.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/exlservice-exls-q1-2026-earnings-transcript/"},{"c":"EXLS 2026 Q1","e":"exls","d":"2026-04-29","l":"guidance","r":"management","s":"Maurizio Nicolelli","x":"While we remain cautious about the current macroeconomic climate and geopolitical uncertainties, we are increasing our guidance for the year based on our current growth momentum and our strong pipeline.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/exlservice-exls-q1-2026-earnings-transcript/"},{"c":"EXLS 2026 Q1","e":"exls","d":"2026-04-29","l":"guidance","r":"management","s":"Rohit Kapoor","x":"So, our growth outlook—you know, we have increased our guidance for the full year.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/exlservice-exls-q1-2026-earnings-transcript/"},{"c":"EXLS 2026 Q1","e":"exls","d":"2026-04-29","l":"ai_disruption","r":"management","s":"Rohit Kapoor","x":"ExlService Holdings, Inc. was recently named Advanced Technology Partner of the Year by NVIDIA, Best New Partner of the Year by Genesys, and AI and Machine Learning Market Disruptor of the Year by AWS.","url":"https://www.fool.com/earnings/call-transcripts/2026/04/29/exlservice-exls-q1-2026-earnings-transcript/"},{"c":"EXLS 2026 Q3","e":"exls","d":"2026-10-28","l":"ai_spend","r":"management","s":"Rohit Kapoor","x":"As enterprises navigate the complexities of AI implementation, their investment areas naturally lend themselves to EXL's expertise, solutions, and services.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/28/exlservice-exls-q3-2026-earnings-call-transcript/"},{"c":"EXLS 2026 Q3","e":"exls","d":"2026-10-28","l":"ai_spend","r":"management","s":"Maurizio Nicolelli","x":"To capitalize on the strong market opportunity and stay ahead in AI, we will continue to invest in go-to-market and Data and AI capabilities through the remainder of the year.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/28/exlservice-exls-q3-2026-earnings-call-transcript/"},{"c":"EXLS 2026 Q3","e":"exls","d":"2026-10-28","l":"pricing_power","r":"analyst","s":"David Koning","x":"I think if we just look at those, it's like 150 basis points or more of year-over-year leverage, but then offset by a pretty big increase in pass-through costs and just infrastructure investments, all good stuff.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/28/exlservice-exls-q3-2026-earnings-call-transcript/"},{"c":"EXLS 2026 Q3","e":"exls","d":"2026-10-28","l":"pricing_power","r":"analyst","s":"David Koning","x":"But as we look forward, you start to leverage the pass-through costs, the infrastructure, the iMerit.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/28/exlservice-exls-q3-2026-earnings-call-transcript/"},{"c":"EXLS 2026 Q3","e":"exls","d":"2026-10-28","l":"guidance","r":"management","s":"Rohit Kapoor","x":"The strength of our third quarter performance gives us the confidence to raise our full-year outlook.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/28/exlservice-exls-q3-2026-earnings-call-transcript/"},{"c":"EXLS 2026 Q3","e":"exls","d":"2026-10-28","l":"guidance","r":"management","s":"Maurizio Nicolelli","x":"However, our strong third-quarter performance, high visibility, and sustained growth momentum provide us with the confidence to raise our outlook for the remainder of the year.","url":"https://www.fool.com/earnings/call-transcripts/2026/10/28/exlservice-exls-q3-2026-earnings-call-transcript/"}],"trends":{"theater":[[36,1,7978,0,0,0,6787,714],[37,1,5439,0,0,0,4752,384],[38,1,6467,0,0,0,5524,654],[39,1,8189,0,0,0,6252,1438],[40,1,8737,0,0,0,7258,1034],[41,1,7133,0,0,0,6049,727],[42,1,8073,0,0,0,6893,773],[43,1,5093,0,0,0,4436,410],[44,1,7454,0,0,0,5905,1035],[45,1,7103,0,0,0,6152,576],[46,1,6962,0,0,0,5941,774],[47,1,6374,0,0,0,5297,804],[62,1,6848,0,0,0,5614,1003],[63,1,7202,0,0,0,5555,1116],[64,1,7178,0,0,0,6059,803],[65,1,6430,0,0,0,5138,915],[67,1,6451,0,0,0,4984,1010]],"cinema":[[36,1,7978,0,0,0,6787,714],[37,1,5439,0,0,0,4752,384],[38,1,6467,0,0,0,5524,654],[39,1,8189,0,0,0,6252,1438],[40,1,8737,0,0,0,7258,1034],[41,1,7133,0,0,0,6049,727],[42,1,8073,0,0,0,6893,773],[43,1,5093,0,0,0,4436,410],[44,1,7454,0,0,0,5905,1035],[45,1,7103,0,0,0,6152,576],[46,1,6962,0,0,0,5941,774],[47,1,6374,0,0,0,5297,804],[62,1,6848,0,0,0,5614,1003],[63,1,7202,0,0,0,5555,1116],[64,1,7178,0,0,0,6059,803],[65,1,6430,0,0,0,5138,915],[67,1,6451,0,0,0,4984,1010]],"imax":[[36,1,7978,0,0,0,6787,714],[37,1,5439,0,0,0,4752,384],[38,1,6467,0,0,0,5524,654],[39,1,8189,0,0,0,6252,1438],[40,1,8737,0,0,0,7258,1034],[41,1,7133,0,0,0,6049,727],[42,1,8073,0,0,0,6893,773],[43,1,5093,0,0,0,4436,410],[44,1,7454,0,0,0,5905,1035],[45,1,7103,0,0,0,6152,576],[46,1,6962,0,0,0,5941,774],[47,1,6374,0,0,0,5297,804],[62,1,6848,0,0,0,5614,1003],[63,1,7202,0,0,0,5555,1116],[64,1,7178,0,0,0,6059,803],[65,1,6430,0,0,0,5138,915],[67,1,6451,0,0,0,4984,1010]],"streaming":[[36,1,7978,0,0,0,6787,714],[37,1,5439,0,0,0,4752,38